/* SayBon levels: cinematic slideshow */
.lv-bg,.lv-scrim{display:none!important}
html{background:#05060a}
body{background:none;min-height:100vh;animation:none!important;opacity:1!important;transform:none!important;filter:none!important}
.cin-bg{opacity:0;position:fixed;inset:0;z-index:-2;background-size:cover;background-position:center;background-repeat:no-repeat;will-change:transform;transform:scale(1.04)}
.cin-bg.k1{animation:kb1 19s ease-out forwards}.cin-bg.k2{animation:kb2 19s ease-out forwards}.cin-bg.k3{animation:kb3 19s ease-out forwards}
@keyframes kb1{from{transform:scale(1.04)}to{transform:scale(1.15) translate(-1.2%,-.8%)}}
@keyframes kb2{from{transform:scale(1.15) translate(1%,0)}to{transform:scale(1.04)}}
@keyframes kb3{from{transform:scale(1.07) translate(1.2%,.6%)}to{transform:scale(1.12) translate(-1.2%,-.6%)}}
.cin-vig{position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 50% 42%,rgba(0,0,0,0) 38%,rgba(0,0,0,.5) 100%),linear-gradient(180deg,rgba(0,0,0,.66) 0%,rgba(0,0,0,.3) 26%,rgba(0,0,0,0) 44%)}
.cin-dip{position:fixed;inset:0;z-index:5;background:#000;opacity:1;pointer-events:none;transition:opacity 1.8s ease}
.cin-dip.on{opacity:1;transition:opacity 1.5s ease}
.cin-dip:not(.on){opacity:0}
.lv-corner-icon{z-index:60}
.lv-page-header h1,.lv-eyebrow{text-shadow:0 2px 16px rgba(0,0,0,.8),0 0 4px rgba(0,0,0,.4)}
.lv-subtitle{text-shadow:0 1px 12px rgba(0,0,0,.7)}

/* cards: crisp, no blur, themed per scene */
body{--cb:rgba(12,14,20,.45);--cbd:rgba(255,255,255,.35);--ct:#ffffff;--cs:rgba(255,255,255,.88);--ca:#f0d08c;--csh:0 14px 34px rgba(0,0,0,.35)}
body[data-scene="1"]{--cb:rgba(78,26,32,.42);--cbd:rgba(255,214,190,.5);--ca:#ffc9a8}
body[data-scene="2"]{--cb:rgba(20,33,61,.52);--cbd:rgba(255,255,255,.45);--ca:#f0d08c}
body[data-scene="3"]{--cb:rgba(32,26,66,.5);--cbd:rgba(255,190,140,.5);--ca:#ffb86b}
body[data-scene="4"]{--cb:rgba(8,44,34,.5);--cbd:rgba(240,184,102,.5);--ca:#f0b866}
body[data-scene="5"]{--cb:rgba(46,20,60,.46);--cbd:rgba(255,160,200,.5);--ca:#ff9cc2}
.levels-grid .level-tile{
  background:var(--cb);border:1px solid var(--cbd);box-shadow:var(--csh);
  backdrop-filter:blur(7px) saturate(1.1);-webkit-backdrop-filter:blur(7px) saturate(1.1);
  gap:3px;padding:22px 22px 20px;
  transition:opacity 1.4s ease,transform 1.5s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,background-color 2.4s ease,border-color 2.4s ease;
}
.levels-grid .level-tile:hover{background:var(--cb);border-color:var(--ca);box-shadow:0 22px 46px rgba(0,0,0,.55)}
.level-tile .lv-tile-accent{display:none}
.level-tile .lv-tile-label{color:var(--ct);min-height:1.2em;text-shadow:0 1px 8px rgba(0,0,0,.35)}
.level-tile .lv-tile-sub{color:#fff;font-size:.8rem;font-weight:500;min-height:1.2em;opacity:1}
.cin-ic{display:none!important;width:22px;height:22px;color:var(--ca);margin-bottom:6px;display:block}
.cin-ic svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.cin-q{display:block;font-family:"Fraunces",Georgia,serif;font-style:italic;font-weight:500;font-size:.76rem;line-height:1.5;margin-top:8px;min-height:2.9em;letter-spacing:.01em;color:var(--qc,#ffc9a8);opacity:0;transition:opacity 1.6s ease,color 2.4s ease}
.cin-q.show{opacity:1}
body[data-scene="1"]{--qc:#ffc9a8}
body[data-scene="2"]{--qc:#d3ebb2}
body[data-scene="3"]{--qc:#ffc19a}
body[data-scene="4"]{--qc:#c2e8b6}
body[data-scene="5"]{--qc:#ffb6d2}
.cin-pic{display:inline-block;height:1.5em;width:1.5em;margin:0 3px 0 0;vertical-align:-.42em;object-fit:contain;-webkit-text-fill-color:initial}
.typing::after{content:"";display:inline-block;width:1px;height:.85em;background:currentColor;margin-left:2px;vertical-align:-.05em;animation:cinBlink .7s steps(1) infinite}
@keyframes cinBlink{50%{opacity:0}}

/* landing styles, one per scene */
.level-tile.pre{opacity:0}
.level-tile.out{opacity:0;transform:translateY(-18px) scale(.97);transition:opacity 1s ease,transform 1.1s ease}

@media (max-width:700px){
  .cin-dip{display:none}
  .lv-subtitle{white-space:nowrap;padding:0;font-size:.78rem}
  .cin-bg.k1{animation:kb1m 19s ease-in-out forwards}.cin-bg.k2{animation:kb2m 19s ease-in-out forwards}.cin-bg.k3{animation:kb3m 19s ease-in-out forwards}
  .lv-stage{padding:84px 20px 56px}
  .lv-page-header{margin-bottom:56px}
  .lv-eyebrow{margin-bottom:12px}
  .lv-page-header h1{margin-bottom:16px}
  .lv-subtitle{line-height:1.55;padding:0 6px}
  .levels-grid{grid-template-columns:1fr;gap:16px}
  .levels-grid .level-tile{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:14px;row-gap:8px;align-items:baseline;padding:20px 22px 18px;border-radius:18px}
  .cin-ic{display:none}
  .level-tile .lv-tile-label{grid-column:1;grid-row:1;font-size:1.75rem;min-height:0}
  .level-tile .lv-tile-sub{grid-column:2;grid-row:1;font-size:.86rem;min-height:1.1em}
  .cin-q{grid-column:1/-1;grid-row:2;margin-top:0;font-size:.8rem;min-height:1.5em}
}
@keyframes kb1m{from{transform:scale(1.08) translate(3.5%,1.5%)}to{transform:scale(1.34) translate(-3.5%,-2%)}}
@keyframes kb2m{from{transform:scale(1.34) translate(-3.5%,-1.5%)}to{transform:scale(1.08) translate(3.5%,1.5%)}}
@keyframes kb3m{from{transform:scale(1.22) translate(4.5%,1%)}to{transform:scale(1.22) translate(-4.5%,-1%)}}
@media (prefers-reduced-motion:reduce){.cin-bg{animation:none!important}}

/* scene change: the cards stay put and just lift for a moment */
.levels-grid .level-tile.sw{transform:translateY(-6px) scale(1.025);box-shadow:0 20px 44px rgba(0,0,0,.5)}

/* eight tiles: two rows of four on a computer, one tile per line on a phone */
@media (min-width:1000px){
  .lv-stage{max-width:1120px}
  .levels-grid{grid-template-columns:repeat(4,1fr);gap:16px}
  .levels-grid .level-tile{padding:20px 18px 18px}
  .level-tile .lv-tile-label{font-size:1.65rem}
  .cin-q{font-size:.72rem}
}
@media (min-width:701px) and (max-width:999px){.levels-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:700px){
  .lv-page-header{margin-bottom:34px}
  .levels-grid{gap:11px}
  .levels-grid .level-tile{padding:15px 20px 13px}
  .level-tile .lv-tile-label{font-size:1.55rem}
}
/* Les Petits: same glass family, warmer and rounder, with a little star */
.levels-grid .level-tile.lv-kids{border-radius:26px;border-color:rgba(255,205,120,.7);background:linear-gradient(160deg,rgba(255,170,90,.26),var(--cb) 70%)}
.level-tile.lv-kids::after{content:"\2726";position:absolute;top:12px;right:16px;font-size:1.05rem;color:#ffd27a;text-shadow:0 0 10px rgba(255,210,122,.7);animation:lvTw 3.2s ease-in-out infinite}
.level-tile.lv-kids .lv-tile-label{color:#ffe3a8}
@keyframes lvTw{50%{transform:scale(1.35) rotate(18deg);opacity:.65}}
@media (prefers-reduced-motion:reduce){.level-tile.lv-kids::after{animation:none}}



/*kids4*/
.levels-grid .level-tile.lv-kids{position:relative;overflow:hidden;border-radius:26px;border-color:rgba(255,184,222,.8);
  background:linear-gradient(155deg,rgba(255,140,200,.34),rgba(176,140,255,.26) 55%,var(--cb) 100%)}
.level-tile.lv-kids::after{content:none!important;display:none!important;animation:none!important}
.level-tile.lv-kids .lv-tile-label{color:#ffcfe8!important;text-shadow:0 0 14px rgba(255,150,210,.55)}
.level-tile.lv-kids .lv-tile-sub{color:#e4d4ff!important}
.level-tile.lv-kids .cin-q{color:#f6c9e4}
.level-tile.lv-kids .kd-stars{position:absolute;inset:0;pointer-events:none;z-index:3}
.level-tile.lv-kids .kd-st{position:absolute;left:var(--hx);top:var(--hy);width:20px;height:20px;animation:kdMove 9s cubic-bezier(.45,0,.25,1) var(--dl) infinite}
.level-tile.lv-kids .kd-st b{display:block;width:100%;height:100%;background:url("data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%220%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23fff2c2%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23ffb8dc%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M12%201.8l2.9%206.3%206.9.8-5.1%204.7%201.4%206.8L12%2017l-6.1%203.4%201.4-6.8L2.2%208.9l6.9-.8z%22%20fill%3D%22url(%23g)%22%20stroke%3D%22%23fff%22%20stroke-width%3D%221%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E") center/contain no-repeat;filter:drop-shadow(0 0 5px rgba(255,170,220,.85));animation:kdDance 2.4s ease-in-out var(--dd) infinite}
@keyframes kdMove{0%,28%{transform:translate(0,0)}46%,74%{transform:translate(var(--dx),var(--dy))}92%,100%{transform:translate(0,0)}}
@keyframes kdDance{0%,100%{transform:rotate(-14deg) scale(1)}25%{transform:rotate(10deg) scale(1.25) translateY(-2px)}50%{transform:rotate(18deg) scale(.95)}75%{transform:rotate(-6deg) scale(1.15)}}
@media (prefers-reduced-motion:reduce){.level-tile.lv-kids .kd-st,.level-tile.lv-kids .kd-st b{animation:none}}
