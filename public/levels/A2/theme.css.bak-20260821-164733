@import url("https://fonts.googleapis.com/css2?family=Nunito:wght@600;800&display=swap");
body{margin:0;min-height:100vh;background:transparent;color:#1a3a3a;font-family:"Nunito",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;color:#fff;}
.page-header h1{font-size:2.2rem;font-weight:800;}
.lesson-grid{max-width:900px;margin:20px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;}
.lesson{padding:20px;border-radius:50%;aspect-ratio:1;border:none;font-weight:800;display:flex;align-items:center;justify-content:center;}
.unlocked{background:#fff;color:#ff6b6b;box-shadow:0 8px 18px rgba(0,0,0,.25);}
.locked{background:rgba(255,255,255,.25);color:#fff;opacity:.7;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:999px;border:none;background:rgba(255,255,255,.3);color:#fff;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}

body::before{content:'';position:fixed;inset:0;background-image:url('/assets/levels/a2.webp');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:-2;}
body::after{content:'';position:fixed;inset:0;background:rgba(8,10,14,.45);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);z-index:-1;}


/* ===== Classy warm neat lesson hub design - unified across all levels ===== */

body{background:transparent !important;}

.page-header h1{
  font-family:"Fraunces",serif !important;
  font-weight:600 !important;
  font-style:normal !important;
  text-shadow:0 2px 16px rgba(0,0,0,.4);
}
.page-header p{
  font-weight:300 !important;
  font-size:.8rem !important;
  opacity:.55 !important;
  letter-spacing:.03em !important;
}

.lesson-grid{
  max-width:900px;margin:24px auto 0;
  display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;
}

.lesson{
  padding:20px 16px !important;
  border-radius:16px !important;
  border:1px solid rgba(255,255,255,.18) !important;
  background:rgba(255,255,255,.08) !important;
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  color:#f6f1e4 !important;
  font-weight:600 !important;
  font-size:.95rem !important;
  font-family:"Manrope",sans-serif !important;
  transform:none !important;
  aspect-ratio:auto !important;
  box-shadow:0 10px 24px rgba(0,0,0,.25);
  transition:transform .15s ease, border-color .15s ease;
}
.lesson span{transform:none !important;display:inline !important;}
.lesson:hover{transform:translateY(-3px) !important;}
.lesson:active{transform:scale(.97) !important;}

.unlocked{
  background:linear-gradient(135deg,rgba(212,175,106,.22),rgba(232,201,138,.15)) !important;
  border-color:rgba(212,175,106,.55) !important;
  color:#f6ecd8 !important;
  box-shadow:0 12px 26px rgba(212,175,106,.2) !important;
}
.locked{
  background:rgba(255,255,255,.04) !important;
  border-color:rgba(255,255,255,.1) !important;
  color:rgba(246,241,228,.4) !important;
  opacity:1 !important;
}

.path-btn{
  border-radius:16px !important;
  background:rgba(255,255,255,.08) !important;
  backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.18) !important;
  color:#f6f1e4 !important;
  font-family:"Manrope",sans-serif !important;
}

.back-btn{
  border-radius:999px !important;
  background:rgba(255,255,255,.08) !important;
  backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.18) !important;
  color:#f6f1e4 !important;
}