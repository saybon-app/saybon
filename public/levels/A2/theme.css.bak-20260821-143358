@import url("https://fonts.googleapis.com/css2?family=Nunito:wght@600;800&display=swap");
body{margin:0;min-height:100vh;background:transparent;color:#1a3a3a;font-family:"Nunito",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;color:#fff;}
.page-header h1{font-size:2.2rem;font-weight:800;}
.lesson-grid{max-width:900px;margin:20px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;}
.lesson{padding:20px;border-radius:50%;aspect-ratio:1;border:none;font-weight:800;display:flex;align-items:center;justify-content:center;}
.unlocked{background:#fff;color:#ff6b6b;box-shadow:0 8px 18px rgba(0,0,0,.25);}
.locked{background:rgba(255,255,255,.25);color:#fff;opacity:.7;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:999px;border:none;background:rgba(255,255,255,.3);color:#fff;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}

body::before{content:'';position:fixed;inset:0;background-image:url('/assets/levels/a2.webp');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:-2;}
body::after{content:'';position:fixed;inset:0;background:rgba(8,10,14,.45);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);z-index:-1;}
