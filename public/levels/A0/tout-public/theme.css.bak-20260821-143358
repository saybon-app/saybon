@import url("https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap");
body{margin:0;min-height:100vh;background:transparent;color:#5c4530;font-family:"Quicksand",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;}
.page-header h1{font-size:2.1rem;font-weight:700;}
.paths{max-width:640px;margin:0 auto;display:flex;gap:16px;justify-content:center;}
.path-btn{padding:18px 28px;border-radius:18px;border:none;font-size:17px;font-weight:700;background:rgba(255,255,255,.6);color:#5c4530;cursor:pointer;}
.lesson-grid{max-width:900px;margin:20px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;}
.lesson{padding:18px;border-radius:16px;border:none;font-weight:700;}
.unlocked{background:linear-gradient(135deg,#f4a261,#f7c59f);color:#4a2e12;}
.locked{background:rgba(255,255,255,.4);color:#a08a70;opacity:.7;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:999px;border:none;background:rgba(255,255,255,.5);color:#5c4530;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}

body::before{content:'';position:fixed;inset:0;background-image:url('/assets/levels/a0.webp');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:-2;}
body::after{content:'';position:fixed;inset:0;background:rgba(8,10,14,.45);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);z-index:-1;}
