.ls-stage{max-width:640px;margin:0 auto;padding:90px 20px 60px;}
.ls-loading{text-align:center;color:rgba(255,255,255,.7);padding:80px 0;}

.ls-part-label{
  font-size:.75rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:#ffd98a;margin-bottom:14px;text-align:center;
}

.ls-card{
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.25);
  border-radius:24px;
  padding:26px 22px;
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  box-shadow:0 16px 34px rgba(0,0,0,.3);
  margin-bottom:20px;
}

.ls-block{margin-bottom:18px;}
.ls-block:last-child{margin-bottom:0;}
.ls-block-text{font-size:1rem;line-height:1.6;color:#fff;}
.ls-block img{width:100%;border-radius:16px;display:block;}
.ls-block audio,.ls-block video{width:100%;border-radius:12px;}

.ls-prompt-bubble{
  background:rgba(255,255,255,.9);
  color:#3a0d22;
  border-radius:18px;
  padding:16px 18px;
  font-weight:700;
  font-size:1.05rem;
  margin-bottom:18px;
  text-align:center;
}

.ls-record-row{display:flex;align-items:center;gap:14px;justify-content:center;margin-bottom:16px;}
.ls-record-btn{
  background:linear-gradient(160deg,#ffd93d,#ff6ec7 60%,#ff4d8d);
  color:#3a0d22;border:none;border-radius:999px;
  padding:14px 28px;font-weight:800;font-size:.95rem;cursor:pointer;
}
.ls-record-btn.ls-recording{background:linear-gradient(160deg,#ff6b6b,#c73f3f);color:#fff;}
.ls-record-status{font-size:.85rem;color:rgba(255,255,255,.8);}

.ls-score{
  text-align:center;font-family:"Baloo 2",cursive;font-weight:800;
  font-size:2.4rem;color:#ffd93d;margin-bottom:10px;
  text-shadow:0 2px 12px rgba(0,0,0,.4);
}

.ls-btn-row{display:flex;gap:12px;margin-top:16px;}
.ls-btn{
  flex:1;border:none;border-radius:16px;padding:15px;
  font-weight:800;font-size:.92rem;cursor:pointer;
}
.ls-btn-primary{background:linear-gradient(160deg,#ffd93d,#ff6ec7 60%,#ff4d8d);color:#3a0d22;}
.ls-btn-primary:disabled{opacity:.4;}
.ls-btn-secondary{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3);}