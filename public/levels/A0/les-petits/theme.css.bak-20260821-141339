@import url("https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&display=swap");
body{margin:0;min-height:100vh;background:linear-gradient(160deg,#ffd6ec,#e0c3fc,#c3f0e0);color:#4a3b5c;font-family:"Baloo 2",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;}
.page-header h1{font-size:2.2rem;font-weight:800;}
.paths{max-width:640px;margin:0 auto;display:flex;gap:16px;justify-content:center;}
.path-btn{padding:18px 28px;border-radius:28px;border:none;font-size:18px;font-weight:800;background:rgba(255,255,255,.55);color:#4a3b5c;cursor:pointer;}
.lesson-grid{max-width:900px;margin:20px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;}
.lesson{padding:20px 16px;border-radius:50%;aspect-ratio:1;border:none;font-weight:800;display:flex;align-items:center;justify-content:center;}
.unlocked{background:linear-gradient(135deg,#ff9ecb,#ffd166);color:#5c3b1e;box-shadow:0 8px 18px rgba(255,150,200,.4);}
.locked{background:rgba(255,255,255,.4);color:#8a7a9a;opacity:.7;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:999px;border:none;background:rgba(255,255,255,.5);color:#4a3b5c;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}