@import url("https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&display=swap");
body{margin:0;min-height:100vh;background:transparent;color:#5c4045;font-family:"Baloo 2",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;}
.page-header h1{font-size:2.2rem;font-weight:800;}
.paths{max-width:640px;margin:0 auto;display:flex;gap:16px;justify-content:center;}
.path-btn{padding:20px 30px;border-radius:24px;border:none;font-size:18px;font-weight:800;background:rgba(255,255,255,.6);color:#5c4045;cursor:pointer;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:999px;border:none;background:rgba(255,255,255,.5);color:#5c4045;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}

body::before{content:'';position:fixed;inset:0;background-image:url('/assets/levels/a0.webp');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:-2;}
body::after{content:'';position:fixed;inset:0;background:rgba(8,10,14,.45);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);z-index:-1;}
