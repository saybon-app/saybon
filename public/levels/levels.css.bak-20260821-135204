*{box-sizing:border-box;margin:0;padding:0;}
html,body{min-height:100%;}
body{
  color:#f6f1e4;
  font-family:"Manrope",-apple-system,BlinkMacSystemFont,sans-serif;
}

.lv-bg{
  position:fixed;
  inset:0;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  z-index:-2;
}
.lv-scrim{
  position:fixed;
  inset:0;
  background:rgba(8,10,14,.55);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  z-index:-1;
}

.lv-corner-icon{
  position:fixed;top:16px;width:40px;height:40px;border-radius:50%;
  background:rgba(255,255,255,.08);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.22);
  display:flex;align-items:center;justify-content:center;
  color:#f6f1e4;cursor:pointer;z-index:50;
  box-shadow:0 4px 14px rgba(0,0,0,.35);
}
.lv-corner-icon svg{width:18px;height:18px;}
.lv-corner-back{left:16px;} .lv-corner-dash{right:16px;}

.lv-stage{max-width:900px;margin:0 auto;padding:90px 20px 60px;position:relative;}

.lv-page-header{text-align:center;margin-bottom:40px;}
.lv-eyebrow{
  font-size:.76rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
  color:#d4af6a;margin-bottom:14px;
}
.lv-page-header h1{
  font-family:"Cormorant Garamond",serif;
  font-weight:600;font-style:italic;
  font-size:clamp(2rem,6vw,2.8rem);
  color:#f6f1e4;margin-bottom:14px;
  text-shadow:0 2px 20px rgba(0,0,0,.4);
}
.lv-subtitle{color:#d9d4c8;font-size:.95rem;max-width:420px;margin:0 auto;line-height:1.6;text-shadow:0 1px 8px rgba(0,0,0,.4);}

.levels-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:18px;
}

.level-tile{
  position:relative;
  padding:26px 24px;
  border-radius:20px;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.08);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  cursor:pointer;
  text-align:left;
  display:flex;
  flex-direction:column;
  gap:6px;
  overflow:hidden;
  transition:transform .2s ease, border-color .2s ease, background .2s ease;
  box-shadow:0 14px 30px rgba(0,0,0,.3);
}
.level-tile:hover{transform:translateY(-4px);border-color:rgba(212,175,106,.5);background:rgba(255,255,255,.12);}
.level-tile:active{transform:scale(.97);}

.lv-tile-accent{
  position:absolute;top:0;left:0;width:100%;height:3px;
  background:linear-gradient(90deg,#d4af6a,#e8c98a);
}
.lv-tile-label{
  font-family:"Cormorant Garamond",serif;
  font-weight:600;font-style:italic;
  font-size:1.9rem;color:#f6f1e4;
}
.lv-tile-sub{font-size:.85rem;color:#d9d4c8;font-weight:600;}

@media (max-width:480px){
  .lv-stage{padding:80px 16px 50px;}
  .levels-grid{grid-template-columns:1fr;}
}