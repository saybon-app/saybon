@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@600;800&display=swap");
body{margin:0;min-height:100vh;background:transparent;color:#3d2b1f;font-family:"Poppins",system-ui,sans-serif;padding:24px;}
.page-header{text-align:center;margin-bottom:24px;}
.page-header h1{font-size:2.2rem;font-weight:800;}
.lesson-grid{max-width:900px;margin:20px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;}
.lesson{padding:18px;border-radius:6px;border:none;font-weight:700;}
.unlocked{background:linear-gradient(135deg,#bc6c25,#dda15e);color:#fff;box-shadow:0 6px 14px rgba(188,108,37,.35);}
.locked{background:rgba(61,43,31,.1);color:#7a6a58;opacity:.7;}
.back-btn{display:block;margin:28px auto 0;padding:12px 20px;border-radius:6px;border:none;background:rgba(61,43,31,.12);color:#3d2b1f;cursor:pointer;}

.page-header p{
  font-weight:300;
  font-size:.8rem;
  opacity:.55;
  letter-spacing:.03em;
}

body::before{content:'';position:fixed;inset:0;background-image:url('/assets/levels/a1.webp');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:-2;}
body::after{content:'';position:fixed;inset:0;background:rgba(8,10,14,.45);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);z-index:-1;}
