<!DOCTYPE html><html lang="en"><head>
<script src="/features/admin/auth/admin-guard.js"></script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Access Control — SayBon Settings</title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fraunces:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:"Manrope",-apple-system,sans-serif;background:linear-gradient(165deg,#0c1016 0%,#151b26 50%,#1b2230 100%);color:#e6e1d3;min-height:100vh;padding:60px 24px;}
.se-stage{max-width:760px;margin:0 auto;}
.se-corner-icon{position:fixed;top:16px;left:16px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.05);backdrop-filter:blur(10px);border:1px solid rgba(212,175,106,.32);display:flex;align-items:center;justify-content:center;color:#d4af6a;cursor:pointer;z-index:50;}
.se-corner-icon svg{width:18px;height:18px;}
.se-eyebrow{font-size:.76rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#d4af6a;margin-bottom:10px;}
.se-title{font-family:"Fraunces",serif;font-weight:600;font-size:1.8rem;color:#f6f1e4;margin-bottom:6px;}
.se-sub{color:#8b92a3;font-size:.88rem;margin-bottom:30px;}
.se-card{background:rgba(255,255,255,.025);border:1px solid rgba(212,175,106,.14);border-radius:20px;padding:24px;margin-bottom:20px;}
.se-card h2{font-family:"Fraunces",serif;font-weight:600;font-size:1.1rem;color:#f6f1e4;margin-bottom:16px;}
.se-field{margin-bottom:14px;}
.se-field label{display:block;font-size:.78rem;color:#8b92a3;margin-bottom:6px;}
.se-field input{width:100%;background:rgba(0,0,0,.2);border:1px solid rgba(212,175,106,.2);border-radius:10px;padding:11px 14px;color:#e6e1d3;font-size:.9rem;font-family:inherit;}
.se-btn{background:linear-gradient(180deg,#e8c98a,#d4af6a);color:#1c1408;border:none;border-radius:14px;padding:13px 24px;font-weight:800;font-size:.88rem;cursor:pointer;}
.se-list{display:flex;flex-direction:column;gap:10px;}
.se-item{background:rgba(255,255,255,.02);border:1px solid rgba(212,175,106,.12);border-radius:14px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;}
.se-item-title{font-weight:700;font-size:.92rem;color:#f6f1e4;}
.se-item-actions button{background:none;border:1px solid rgba(212,175,106,.25);color:#d4af6a;border-radius:8px;padding:5px 10px;font-size:.7rem;cursor:pointer;}
.se-empty{color:#6d7488;font-size:.85rem;text-align:center;padding:20px;}
.se-toggle{position:relative;width:46px;height:26px;flex-shrink:0;}
.se-toggle input{opacity:0;width:0;height:0;}
.se-toggle-slider{position:absolute;inset:0;background:rgba(255,255,255,.15);border-radius:999px;cursor:pointer;transition:.2s;}
.se-toggle-slider::before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;}
.se-toggle input:checked + .se-toggle-slider{background:#7cc576;}
.se-toggle input:checked + .se-toggle-slider::before{transform:translateX(20px);}
.se-note{font-size:.78rem;color:#8b92a3;margin-top:16px;line-height:1.5;background:rgba(212,175,106,.06);border:1px solid rgba(212,175,106,.15);border-radius:12px;padding:12px 14px;}</style></head><body>
<button class="se-corner-icon" onclick="location.href='../'" aria-label="Back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
<div class="se-stage">
<p class="se-eyebrow">Settings</p><p class="se-title">Access Control</p><p class="se-sub">Who is allowed into the Business Admin section.</p>
<div class="se-card"><h2>Add Authorized Email</h2>
<div class="se-field"><label>Email</label><input type="email" id="acEmail" placeholder="name@example.com"></div>
<button class="se-btn" id="acAddBtn">Add</button>
</div>
<div class="se-card"><h2>Authorized Admins</h2><div class="se-list" id="acList"><p class="se-empty">Loading...</p></div>
<p class="se-note">Only emails on this list can access the Business Admin section. Removing the last email would lock everyone out - be careful.</p>
</div>
</div>
<script>
const API_BASE = "https://saybonapp-server.onrender.com";
function loadAdmins(){
  fetch(API_BASE + "/api/accessControlList").then(r=>r.json()).then(function(items){
    const list = document.getElementById("acList");
    if(!items || !items.length){ list.innerHTML = '<p class="se-empty">No authorized emails yet - add yours first</p>'; return; }
    list.innerHTML = items.map(function(it){
      return '<div class="se-item"><div class="se-item-title">'+it.email+'</div><div class="se-item-actions"><button onclick="removeAdmin(\''+it.id+'\')">Remove</button></div></div>';
    }).join("");
  }).catch(function(){ document.getElementById("acList").innerHTML = '<p class="se-empty">Could not load</p>'; });
}
window.removeAdmin = function(id){
  if(!confirm("Remove this admin? They will lose access immediately.")) return;
  fetch(API_BASE + "/api/accessControlRemove", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})}).then(loadAdmins);
};
document.getElementById("acAddBtn").addEventListener("click", function(){
  const email = document.getElementById("acEmail").value.trim().toLowerCase();
  if(!email) return;
  fetch(API_BASE + "/api/accessControlAdd", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email})})
    .then(function(){ document.getElementById("acEmail").value=""; loadAdmins(); });
});
loadAdmins();
</script>
</body></html>