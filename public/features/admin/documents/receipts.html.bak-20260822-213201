<!DOCTYPE html><html lang="en"><head>
<script src="/features/admin/auth/admin-guard.js"></script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Receipts — SayBon Documents</title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fraunces:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:"Manrope",-apple-system,sans-serif;background:linear-gradient(165deg,#0c1016 0%,#151b26 50%,#1b2230 100%);color:#e6e1d3;min-height:100vh;padding:60px 24px;}
.dc-stage{max-width:760px;margin:0 auto;}
.dc-corner-icon{position:fixed;top:16px;left:16px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.05);backdrop-filter:blur(10px);border:1px solid rgba(212,175,106,.32);display:flex;align-items:center;justify-content:center;color:#d4af6a;cursor:pointer;z-index:50;}
.dc-corner-icon svg{width:18px;height:18px;}
.dc-eyebrow{font-size:.76rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#d4af6a;margin-bottom:10px;}
.dc-title{font-family:"Fraunces",serif;font-weight:600;font-size:1.8rem;color:#f6f1e4;margin-bottom:6px;}
.dc-sub{color:#8b92a3;font-size:.88rem;margin-bottom:30px;}
.dc-card{background:rgba(255,255,255,.025);border:1px solid rgba(212,175,106,.14);border-radius:20px;padding:24px;margin-bottom:20px;}
.dc-card h2{font-family:"Fraunces",serif;font-weight:600;font-size:1.1rem;color:#f6f1e4;margin-bottom:16px;}
.dc-field{margin-bottom:14px;}
.dc-field label{display:block;font-size:.78rem;color:#8b92a3;margin-bottom:6px;}
.dc-field input{width:100%;background:rgba(0,0,0,.2);border:1px solid rgba(212,175,106,.2);border-radius:10px;padding:11px 14px;color:#e6e1d3;font-size:.9rem;font-family:inherit;}
.dc-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.dc-btn{background:linear-gradient(180deg,#e8c98a,#d4af6a);color:#1c1408;border:none;border-radius:14px;padding:13px 24px;font-weight:800;font-size:.88rem;cursor:pointer;}
.dc-list{display:flex;flex-direction:column;gap:10px;}
.dc-item{background:rgba(255,255,255,.02);border:1px solid rgba(212,175,106,.12);border-radius:14px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;}
.dc-item-title{font-weight:700;font-size:.92rem;color:#f6f1e4;}
.dc-item-meta{font-size:.75rem;color:#8b92a3;margin-top:4px;}
.dc-item-link{font-size:.72rem;color:#d4af6a;text-decoration:underline;}
.dc-item-actions button{background:none;border:1px solid rgba(212,175,106,.25);color:#d4af6a;border-radius:8px;padding:5px 10px;font-size:.7rem;cursor:pointer;margin-left:6px;}
.dc-empty{color:#6d7488;font-size:.85rem;text-align:center;padding:20px;}
.dc-status{margin-top:10px;font-size:.8rem;color:#8b92a3;}</style></head><body>
<button class="dc-corner-icon" onclick="location.href='../'" aria-label="Back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
<div class="dc-stage">
<p class="dc-eyebrow">Documents</p><p class="dc-title">Receipts</p><p class="dc-sub">General receipts archive, separate from Financials expense entries.</p>
<div class="dc-card"><h2>Add Document</h2>
<div class="dc-field"><label>Title</label><input type="text" id="docTitle" placeholder="Document name"></div>
<div class="dc-row2"><div class="dc-field"><label>Date</label><input type="date" id="docDate"></div><div class="dc-field"><label>Note</label><input type="text" id="docNote" placeholder="Optional"></div></div>
<div class="dc-field"><label>File</label><input type="file" id="docFile"></div>
<button class="dc-btn" id="docAddBtn">Upload</button>
<p class="dc-status" id="docStatus"></p>
</div>
<div class="dc-card"><h2>All Documents</h2><div class="dc-list" id="docList"><p class="dc-empty">Loading...</p></div></div>
</div>
<script type="module">
const API_BASE = "https://saybonapp-server.onrender.com";
import { app, auth } from "/js/firebase-init.js";
import { signInAnonymously } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-storage.js";
const storage = getStorage(app, "gs://saybon-3e3c2.firebasestorage.app");
signInAnonymously(auth).catch(()=>{});

function loadDocs(){
  fetch(API_BASE + "/api/docReceipts" + "List").then(r=>r.json()).then(function(items){
    const list = document.getElementById("docList");
    if(!items || !items.length){ list.innerHTML = '<p class="dc-empty">No documents yet</p>'; return; }
    list.innerHTML = items.map(function(it){
      const link = it.fileUrl ? '<a class="dc-item-link" href="'+it.fileUrl+'" target="_blank">Open</a>' : '';
      return '<div class="dc-item"><div><div class="dc-item-title">'+it.title+'</div><div class="dc-item-meta">'+(it.meta||'')+' '+link+'</div></div><div class="dc-item-actions"><button onclick="deleteDoc(\''+it.id+'\')">Delete</button></div></div>';
    }).join("");
  }).catch(function(){ document.getElementById("docList").innerHTML = '<p class="dc-empty">Could not load</p>'; });
}
window.deleteDoc = function(id){
  if(!confirm("Delete this document?")) return;
  fetch(API_BASE + "/api/docReceipts" + "Delete", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})}).then(loadDocs);
};

document.getElementById("docAddBtn").addEventListener("click", async function(){
  const status = document.getElementById("docStatus");
  const title = document.getElementById("docTitle").value.trim();
  if(!title){ status.textContent = "Title is required"; return; }

  status.textContent = "Saving...";
  const metaText = document.getElementById("docDate").value + " " + document.getElementById("docNote").value;
  const payload = { title, meta: metaText, fileUrl: null };

  const file = document.getElementById("docFile").files[0];
  if(file){
    const storageRef = ref(storage, "companyDocuments/receipts/" + Date.now() + "-" + file.name);
    const snap = await uploadBytes(storageRef, file);
    payload.fileUrl = await getDownloadURL(snap.ref);
  }

  fetch(API_BASE + "/api/docReceipts" + "Add", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)})
    .then(function(){ status.textContent = "Uploaded"; document.getElementById("docTitle").value=""; document.getElementById("docFile").value=""; loadDocs(); })
    .catch(function(){ status.textContent = "Failed to save"; });
});

loadDocs();
</script>
</body></html>