<!DOCTYPE html><html lang="en"><head>
<script src="/features/admin/auth/admin-guard.js"></script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cap Table — SayBon Investors</title><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fraunces:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:"Manrope",-apple-system,sans-serif;background:linear-gradient(165deg,#0c1016 0%,#151b26 50%,#1b2230 100%);color:#e6e1d3;min-height:100vh;padding:60px 24px;}
.iv-stage{max-width:760px;margin:0 auto;}
.iv-corner-icon{position:fixed;top:16px;left:16px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.05);backdrop-filter:blur(10px);border:1px solid rgba(212,175,106,.32);display:flex;align-items:center;justify-content:center;color:#d4af6a;cursor:pointer;z-index:50;}
.iv-corner-icon svg{width:18px;height:18px;}
.iv-eyebrow{font-size:.76rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#d4af6a;margin-bottom:10px;}
.iv-title{font-family:"Fraunces",serif;font-weight:600;font-size:1.8rem;color:#f6f1e4;margin-bottom:6px;}
.iv-sub{color:#8b92a3;font-size:.88rem;margin-bottom:30px;}
.iv-card{background:rgba(255,255,255,.025);border:1px solid rgba(212,175,106,.14);border-radius:20px;padding:24px;margin-bottom:20px;}
.iv-card h2{font-family:"Fraunces",serif;font-weight:600;font-size:1.1rem;color:#f6f1e4;margin-bottom:16px;}
.iv-field{margin-bottom:14px;}
.iv-field label{display:block;font-size:.78rem;color:#8b92a3;margin-bottom:6px;}
.iv-field input, .iv-field textarea{width:100%;background:rgba(0,0,0,.2);border:1px solid rgba(212,175,106,.2);border-radius:10px;padding:11px 14px;color:#e6e1d3;font-size:.9rem;font-family:inherit;}
.iv-field textarea{min-height:80px;resize:vertical;}
.iv-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.iv-btn{background:linear-gradient(180deg,#e8c98a,#d4af6a);color:#1c1408;border:none;border-radius:14px;padding:13px 24px;font-weight:800;font-size:.88rem;cursor:pointer;}
.iv-list{display:flex;flex-direction:column;gap:10px;}
.iv-item{background:rgba(255,255,255,.02);border:1px solid rgba(212,175,106,.12);border-radius:14px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;}
.iv-item-title{font-weight:700;font-size:.92rem;color:#f6f1e4;}
.iv-item-pct{font-family:"Fraunces",serif;font-weight:600;font-size:1.3rem;color:#d4af6a;}
.iv-item-meta{font-size:.75rem;color:#8b92a3;margin-top:4px;}
.iv-item-actions button{background:none;border:1px solid rgba(212,175,106,.25);color:#d4af6a;border-radius:8px;padding:5px 10px;font-size:.7rem;cursor:pointer;margin-left:6px;}
.iv-empty{color:#6d7488;font-size:.85rem;text-align:center;padding:20px;}
.iv-total-bar{height:10px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden;margin-top:14px;}
.iv-total-fill{height:100%;background:linear-gradient(90deg,#d4af6a,#e8c98a);}
.iv-total-label{font-size:.78rem;color:#8b92a3;margin-top:8px;text-align:center;}</style></head><body>
<button class="iv-corner-icon" onclick="location.href='../'" aria-label="Back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
<div class="iv-stage">
<p class="iv-eyebrow">Investors</p><p class="iv-title">Cap Table</p><p class="iv-sub">Who owns what share of SayBon.</p>
<div class="iv-card"><h2>Add Owner</h2>
<div class="iv-row2">
<div class="iv-field"><label>Name</label><input type="text" id="cName" placeholder="e.g. Adlaide Duah"></div>
<div class="iv-field"><label>Percentage Owned</label><input type="number" step="0.01" id="cPercent" placeholder="e.g. 100"></div>
</div>
<div class="iv-field"><label>Date</label><input type="date" id="cDate"></div>
<div class="iv-field"><label>Notes</label><input type="text" id="cNotes" placeholder="Optional"></div>
<button class="iv-btn" id="cAddBtn">Add Owner</button>
<p class="iv-status" id="cStatus" style="margin-top:10px;font-size:.8rem;color:#8b92a3;"></p>
</div>
<div class="iv-card"><h2>Ownership</h2><div class="iv-list" id="cList"><p class="iv-empty">Loading...</p></div>
<div class="iv-total-bar"><div class="iv-total-fill" id="cTotalFill" style="width:0%"></div></div>
<p class="iv-total-label" id="cTotalLabel">0% allocated</p>
</div>
</div>
<script>
const API_BASE = "https://saybonapp-server.onrender.com";
function loadCap(){
  fetch(API_BASE + "/api/capTableList").then(r=>r.json()).then(function(items){
    const list = document.getElementById("cList");
    let total = 0;
    if(!items || !items.length){ list.innerHTML = '<p class="iv-empty">No owners added yet</p>'; }
    else {
      list.innerHTML = items.map(function(it){
        total += Number(it.percent)||0;
        return '<div class="iv-item"><div><div class="iv-item-title">'+it.name+'</div><div class="iv-item-meta">'+(it.date||'')+' '+(it.notes||'')+'</div></div><div style="display:flex;align-items:center;gap:10px;"><div class="iv-item-pct">'+it.percent+'%</div><div class="iv-item-actions"><button onclick="deleteOwner(\''+it.id+'\')">Delete</button></div></div></div>';
      }).join("");
    }
    document.getElementById("cTotalFill").style.width = Math.min(total,100) + "%";
    document.getElementById("cTotalLabel").textContent = total + "% allocated" + (total > 100 ? " (over 100% - check entries)" : "");
  }).catch(function(){ document.getElementById("cList").innerHTML = '<p class="iv-empty">Could not load</p>'; });
}
window.deleteOwner = function(id){
  if(!confirm("Delete this owner?")) return;
  fetch(API_BASE + "/api/capTableDelete", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id})}).then(loadCap);
};
document.getElementById("cAddBtn").addEventListener("click", function(){
  const name = document.getElementById("cName").value.trim();
  const percent = parseFloat(document.getElementById("cPercent").value);
  const status = document.getElementById("cStatus");
  if(!name || isNaN(percent)){ status.textContent = "Name and percentage are required"; return; }
  fetch(API_BASE + "/api/capTableAdd", {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({
    name, percent, date: document.getElementById("cDate").value, notes: document.getElementById("cNotes").value
  })}).then(function(){ status.textContent = "Added"; document.getElementById("cName").value=""; document.getElementById("cPercent").value=""; document.getElementById("cNotes").value=""; loadCap(); });
});
loadCap();
</script>
</body></html>