[{"id":"ng2iLe659WSfHTOIuEDE","level":"b2","lesson":19,"part":1,"type":"text","name":"b2-l19-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, les nuances. Presque, plutôt, assez, sans doute, probablement, à peu près. Ces petits mots rendent votre pensée moins tranchée et votre style plus naturel. C'est ce qui distingue un locuteur avancé.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276264,"_nanoseconds":459000000}},{"id":"xZmG8MAMaXTj4vr4F5IB","level":"b2","lesson":19,"part":2,"type":"text","name":"b2-l19-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎚️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Exprimer des nuances</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276264,"_nanoseconds":464000000}},{"id":"6XyiOopWV0NM6NZ67BXA","level":"b2","lesson":19,"part":2,"type":"text","name":"b2-l19-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Atténuer : plutôt, assez, relativement, à peu près, environ. Probabilité : sans doute, probablement, peut-être, il se pourrait que. Intensifier : tout à fait, absolument, particulièrement. Exprimer l'incertitude : il me semble que, je dirais que.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est plutôt cher.</b><span style=\"opacity:.7;\"> · It's rather expensive.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il viendra sans doute.</b><span style=\"opacity:.7;\"> · He will probably come.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je dirais que c'est environ vingt pour cent.</b><span style=\"opacity:.7;\"> · I'd say it's about twenty percent.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il se pourrait que ce soit trop tard.</b><span style=\"opacity:.7;\"> · It could be too late.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276264,"_nanoseconds":542000000}},{"id":"h7LUYH2ZNFHhqbziP5xi","level":"b2","lesson":19,"part":3,"type":"text","name":"b2-l19-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est plutôt cher.</b></p><p style=\"opacity:.75;margin:0;\">It's rather expensive.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"C'est plutôt cher.","size":null,"created":{"_seconds":1793276264,"_nanoseconds":507000000}},{"id":"xK09dfoCqiEfgkRUagek","level":"b2","lesson":19,"part":4,"type":"text","name":"b2-l19-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il viendra sans doute.</b></p><p style=\"opacity:.75;margin:0;\">He will probably come.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Il viendra sans doute.","size":null,"created":{"_seconds":1793276264,"_nanoseconds":974000000}},{"id":"rr2hKtNy4C8mf4HKmjpF","level":"b2","lesson":19,"part":5,"type":"text","name":"b2-l19-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je dirais que c'est environ vingt pour cent.</b></p><p style=\"opacity:.75;margin:0;\">I'd say it's about twenty percent.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je dirais que c'est environ vingt pour cent.","size":null,"created":{"_seconds":1793276264,"_nanoseconds":975000000}},{"id":"VvNtJuAsKZh7kMIoXFNa","level":"b2","lesson":19,"part":6,"type":"text","name":"b2-l19-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il se pourrait que ce soit trop tard.</b></p><p style=\"opacity:.75;margin:0;\">It could be too late.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Il se pourrait que ce soit trop tard.","size":null,"created":{"_seconds":1793276264,"_nanoseconds":972000000}},{"id":"QdF46HZ2DtcLVd7YtbI6","level":"b2","lesson":19,"part":7,"type":"text","name":"b2-l19-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment était le restaurant hier ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Plutôt bien, même si c'était assez bruyant.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>C'était cher ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Relativement, mais la qualité était particulièrement bonne.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous y retournerez ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Sans doute, mais pas ce mois-ci.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Combien de temps durerait le trajet ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je dirais environ trente minutes, à peu près.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276264,"_nanoseconds":985000000}},{"id":"YpRHk6Se6pouiN19gy5i","level":"b2","lesson":19,"part":8,"type":"text","name":"b2-l19-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment était le restaurant hier ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Plutôt bien, même si c'était assez bruyant.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Plutôt bien, même si c'était assez bruyant.","size":null,"created":{"_seconds":1793276265,"_nanoseconds":373000000}},{"id":"ylTUg4kBKj3LuBA6FKqu","level":"b2","lesson":19,"part":9,"type":"text","name":"b2-l19-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>C'était cher ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Relativement, mais la qualité était particulièrement bonne.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Relativement, mais la qualité était particulièrement bonne.","size":null,"created":{"_seconds":1793276265,"_nanoseconds":378000000}},{"id":"3hKoBi1AaUgwqH2zLM7L","level":"b2","lesson":19,"part":10,"type":"text","name":"b2-l19-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6p