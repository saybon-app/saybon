[{"id":"0oSNjVEBOYvHe4aSGOkw","level":"b2","lesson":3,"part":1,"type":"text","name":"b2-l03-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, la concession : certes... mais. Elle consiste à reconnaître un argument adverse avant de défendre le vôtre. C'est une marque d'élégance et d'honnêteté qui rend votre discours plus crédible.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276228,"_nanoseconds":930000000}},{"id":"5ALlqtQvt8W4kPyZd1R4","level":"b2","lesson":3,"part":2,"type":"text","name":"b2-l03-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎭</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">La concession</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276228,"_nanoseconds":989000000}},{"id":"nkqKufhXqzCLTEouQBkg","level":"b2","lesson":3,"part":2,"type":"text","name":"b2-l03-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Certes... mais, il est vrai que... cependant, bien sûr... toutefois, même si + indicatif, quoique + subjonctif. Elle permet de nuancer sans abandonner votre position.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Certes, c'est cher, mais utile.</b><span style=\"opacity:.7;\"> · Admittedly, it's expensive, but useful.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est vrai que..., cependant...</b><span style=\"opacity:.7;\"> · It's true that..., however...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Même si c'est difficile, j'essaie.</b><span style=\"opacity:.7;\"> · Even if it's difficult, I try.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quoiqu'il soit jeune,...</b><span style=\"opacity:.7;\"> · Although he's young,...</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276229,"_nanoseconds":34000000}},{"id":"X8ADATrVXxxlrvXmeQ0z","level":"b2","lesson":3,"part":3,"type":"text","name":"b2-l03-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Certes, c'est cher, mais utile.</b></p><p style=\"opacity:.75;margin:0;\">Admittedly, it's expensive, but useful.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Certes, c'est cher, mais utile.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":89000000}},{"id":"3VJcpAjIswAaDKVhbJMy","level":"b2","lesson":3,"part":4,"type":"text","name":"b2-l03-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est vrai que..., cependant...</b></p><p style=\"opacity:.75;margin:0;\">It's true that..., however...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Il est vrai que..., cependant...","size":null,"created":{"_seconds":1793276229,"_nanoseconds":420000000}},{"id":"xhB6e8A00d0aoIN91MV4","level":"b2","lesson":3,"part":5,"type":"text","name":"b2-l03-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Même si c'est difficile, j'essaie.</b></p><p style=\"opacity:.75;margin:0;\">Even if it's difficult, I try.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Même si c'est difficile, j'essaie.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":419000000}},{"id":"sHxJ2evXCIlJqahkVhSW","level":"b2","lesson":3,"part":6,"type":"text","name":"b2-l03-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quoiqu'il soit jeune,...</b></p><p style=\"opacity:.75;margin:0;\">Although he's young,...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Quoiqu'il soit jeune,...","size":null,"created":{"_seconds":1793276229,"_nanoseconds":487000000}},{"id":"fjMKhUra6ZZH0sstkHJd","level":"b2","lesson":3,"part":7,"type":"text","name":"b2-l03-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Les voitures électriques sont-elles la solution ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Certes, elles polluent moins en ville, mais leur fabrication reste polluante.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Alors faut-il les abandonner ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, il est vrai qu'elles ont des limites, cependant elles représentent un progrès.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Elles sont chères, pourtant.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Même si elles sont chères aujourd'hui, les prix baisseront avec le temps.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous êtes optimiste.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quoique je reste prudent, je pense que l'avenir est favorable.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276229,"_nanoseconds":506000000}},{"id":"YVUEMAxlsffyaZK0KC2a","level":"b2","lesson":3,"part":8,"type":"text","name":"b2-l03-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Les voitures électriques sont-elles la solution ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Certes, elles polluent moins en ville, mais leur fabrication reste polluante.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Certes, elles polluent moins en ville, mais leur fabrication reste polluante.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":847000000}},{"id":"5bKzu6mmDmdc5r7mXbUE","level":"b2","lesson":3,"part":9,"type":"text","name":"b2-l03-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Alors faut-il les abandonner ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, il est vrai qu'elles ont des limites, cependant elles représentent un progrès.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Non, il est vrai qu'elles ont des limites, cependant elles représentent un progrès.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":873000000}},{"id":"BmxmapZ7MvmUhG136LcV","level":"b2","lesson":3,"part":10,"type":"text","name":"b2-l03-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Elles sont chères, pourtant.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Même si elles sont chères aujourd'hui, les prix baisseront avec le temps.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Même si elles sont chères aujourd'hui, les prix baisseront avec le temps.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":890000000}},{"id":"VDnvtWtqUVAv7RK5uMlA","level":"b2","lesson":3,"part":11,"type":"text","name":"b2-l03-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous êtes optimiste.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Quoique je reste prudent, je pense que l'avenir est favorable.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Quoique je reste prudent, je pense que l'avenir est favorable.","size":null,"created":{"_seconds":1793276229,"_nanoseconds":916000000}},{"id":"6cKbs6Fj6M01xMVOZAM2","level":"b2","lesson":3,"part":12,"type":"text","name":"b2-l03-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Utilisez la concession.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Use concession.</p><p><b>Présentez une opinion en reconnaissant d'abord un argument contraire.</b></p><p style=\"opacity:.7;\">Par exemple: “Certes, la ville est bruyante, mais elle offre beaucoup d'opportunités. Même si c'est fatigant, je l'aime.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Certes, la ville est bruyante, mais elle offre beaucoup d'opportunités. Même si c'est fatigant, je l'aime.","size":null,"created":{"_seconds":1793276230,"_nanoseconds":721000000}},{"id":"isCrpzqtt8hzMUyQgXp6","level":"b2","lesson":3,"part":13,"type":"text","name":"b2-l03-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎭</div><p><b>Concession maîtrisée !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous savez concéder un point pour mieux défendre le vôtre. Votre discours gagne en maturité.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276230,"_nanoseconds":734000000}}]