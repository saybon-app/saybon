[{"id":"71pGkCwANl4RUoQ092Br","level":"b2","lesson":17,"part":1,"type":"text","name":"b2-l17-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, l'économie du quotidien : budget, prix, inflation, épargne. Vous parlez d'argent de façon concrète et raisonnée. Il ne s'agit pas de théorie, mais de la vie de tous les jours.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276261,"_nanoseconds":88000000}},{"id":"HP1N5MheZZ95yz1YWdP8","level":"b2","lesson":17,"part":2,"type":"text","name":"b2-l17-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💰</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">L'économie du quotidien</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276261,"_nanoseconds":93000000}},{"id":"IIVuQ1W11CPV83DLwb4k","level":"b2","lesson":17,"part":2,"type":"text","name":"b2-l17-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Budget : les revenus, les dépenses, épargner, s'endetter, le pouvoir d'achat. Inflation : les prix augmentent, la vie devient plus chère. Conseils : établir un budget, réduire les dépenses, mettre de côté.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le pouvoir d'achat</b><span style=\"opacity:.7;\"> · purchasing power</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>L'inflation</b><span style=\"opacity:.7;\"> · inflation</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mettre de l'argent de côté</b><span style=\"opacity:.7;\"> · to put money aside</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>S'endetter</b><span style=\"opacity:.7;\"> · to go into debt</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276261,"_nanoseconds":130000000}},{"id":"9mo8oE1wxuYGYiFpXWQ4","level":"b2","lesson":17,"part":3,"type":"text","name":"b2-l17-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le pouvoir d'achat</b></p><p style=\"opacity:.75;margin:0;\">purchasing power</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Le pouvoir d'achat","size":null,"created":{"_seconds":1793276261,"_nanoseconds":88000000}},{"id":"Ej3ZOzu0VBbLwn3QqTQN","level":"b2","lesson":17,"part":4,"type":"text","name":"b2-l17-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>L'inflation</b></p><p style=\"opacity:.75;margin:0;\">inflation</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"L'inflation","size":null,"created":{"_seconds":1793276261,"_nanoseconds":698000000}},{"id":"F5FAL8I2BVYigLExf31f","level":"b2","lesson":17,"part":5,"type":"text","name":"b2-l17-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mettre de l'argent de côté</b></p><p style=\"opacity:.75;margin:0;\">to put money aside</p></div>","rec