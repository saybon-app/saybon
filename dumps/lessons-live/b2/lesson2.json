[{"id":"h0oMjyIDKozTCpfDVkg1","level":"b2","lesson":2,"part":1,"type":"text","name":"b2-l02-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, l'argumentation. Défendre une idée, ce n'est pas seulement l'affirmer, c'est la soutenir avec des arguments et des exemples. Vous allez construire un raisonnement en trois temps : la thèse, l'argument, l'exemple.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276226,"_nanoseconds":996000000}},{"id":"2nQ1yUAZePtlU9uV6q6s","level":"b2","lesson":2,"part":2,"type":"text","name":"b2-l02-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚖️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Argumenter</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276227,"_nanoseconds":40000000}},{"id":"J0XUyxYozPf3nWDq10Ow","level":"b2","lesson":2,"part":2,"type":"text","name":"b2-l02-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Thèse : je soutiens que, mon point de vue est que. Argument : en effet, d'une part, d'autre part. Exemple : ainsi, par exemple, c'est le cas de. Conclusion : c'est pourquoi, par conséquent.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je soutiens que...</b><span style=\"opacity:.7;\"> · I maintain that...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>En effet,...</b><span style=\"opacity:.7;\"> · Indeed,...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>D'une part..., d'autre part...</b><span style=\"opacity:.7;\"> · On the one hand..., on the other...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est le cas de...</b><span style=\"opacity:.7;\"> · This is the case of...</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276227,"_nanoseconds":504000000}},{"id":"vyVXoCmbO13rNeGR9GZ7","level":"b2","lesson":2,"part":3,"type":"text","name":"b2-l02-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je soutiens que...</b></p><p style=\"opacity:.75;margin:0;\">I maintain that...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je soutiens que...","size":null,"created":{"_seconds":1793276227,"_nanoseconds":497000000}},{"id":"I9p3LBrKv6IGMqRWoZ5B","level":"b2","lesson":2,"part":4,"type":"text","name":"b2-l02-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>En effet,...</b></p><p style=\"opacity:.75;margin:0;\">Indeed,...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"En effet,...","size":null,"created":{"_seconds":1793276227,"_nanoseconds":548000000}},{"id":"hQb1MuvGwajqwKqQXJec","level":"b2","lesson":2,"part":5,"type":"text","name":"b2-l02-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>D'une part..., d'autre part...</b></p><p style=\"opacity:.75;margin:0;\">On the one hand..., on the other...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"D'une part..., d'autre part...","size":null,"created":{"_seconds":1793276227,"_nanoseconds":594000000}},{"id":"7yfDqAHnX7uPGrvMPIcj","level":"b2","lesson":2,"part":6,"type":"text","name":"b2-l02-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est le cas de...</b></p><p style=\"opacity:.75;margin:0;\">This is the case of...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"C'est le cas de...","size":null,"created":{"_seconds":1793276228,"_nanoseconds":11000000}},{"id":"8liQLuxxSOiCWV9pCNMT","level":"b2","lesson":2,"part":7,"type":"text","name":"b2-l02-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pensez-vous que le télétravail soit une bonne solution ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je soutiens que c'est une solution efficace, à condition qu'elle soit bien organisée.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'une part, les salariés gagnent du temps. D'autre part, ils sont souvent plus concentrés.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Avez-vous un exemple ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est le cas de plusieurs entreprises qui ont constaté une hausse de productivité.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle est donc votre conclusion ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Par conséquent, le télétravail est utile, mais il doit rester un choix.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276228,"_nanoseconds":14000000}},{"id":"S07JnvAf9DFBwHIlyI31","level":"b2","lesson":2,"part":8,"type":"text","name":"b2-l02-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pensez-vous que le télétravail soit une bonne solution ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je soutiens que c'est une solution efficace, à condition qu'elle soit bien organisée.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je soutiens que c'est une solution efficace, à condition qu'elle soit bien organisée.","size":null,"created":{"_seconds":1793276228,"_nanoseconds":64000000}},{"id":"24jnhhKC1FjrNYZgb0Un","level":"b2","lesson":2,"part":9,"type":"text","name":"b2-l02-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'une part, les salariés gagnent du temps. D'autre part, ils sont souvent plus concentrés.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"D'une part, les salariés gagnent du temps. D'autre part, ils sont souvent plus concentrés.","size":null,"created":{"_seconds":1793276228,"_nanoseconds":61000000}},{"id":"6uujbs9I5JnvrxwvGDhW","level":"b2","lesson":2,"part":10,"type":"text","name":"b2-l02-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Avez-vous un exemple ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est le cas de plusieurs entreprises qui ont constaté une hausse de productivité.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'est le cas de plusieurs entreprises qui ont constaté une hausse de productivité.","size":null,"created":{"_seconds":1793276228,"_nanoseconds":572000000}},{"id":"TiyfIZQGZpHcQwkdIcgG","level":"b2","lesson":2,"part":11,"type":"text","name":"b2-l02-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle est donc votre conclusion ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Par conséquent, le télétravail est utile, mais il doit rester un choix.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Par conséquent, le télétravail est utile, mais il doit rester un choix.","size":null,"created":{"_seconds":1793276228,"_nanoseconds":520000000}},{"id":"ZxscnWLIfSxwzRLFxyFX","level":"b2","lesson":2,"part":12,"type":"text","name":"b2-l02-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Argumentez sur un sujet.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Argue on a subject.</p><p><b>Défendez une idée avec une thèse, deux arguments et un exemple.</b></p><p style=\"opacity:.7;\">Par exemple: “Je soutiens que le sport est essentiel. D'une part, il améliore la santé. D'autre part, il crée du lien. Par exemple, les équipes locales rassemblent.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Je soutiens que le sport est essentiel. D'une part, il améliore la santé. D'autre part, il crée du lien. Par exemple, les équipes locales rassemblent.","size":null,"created":{"_seconds":1793276228,"_nanoseconds":573000000}},{"id":"4xct0sYQyi0U3ujJPdjC","level":"b2","lesson":2,"part":13,"type":"text","name":"b2-l02-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚖️</div><p><b>Argument construit !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous construisez un raisonnement complet : thèse, arguments, exemple, conclusion. C'est le cœur du discours persuasif.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276228,"_nanoseconds":669000000}}]