[{"id":"TCkUN6SMm4fvuqENkySN","level":"b2","lesson":4,"part":1,"type":"text","name":"b2-l04-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, le subjonctif avancé. Au niveau B1, vous l'avez rencontré avec il faut que. Ici, vous l'utilisez avec des conjonctions : bien que, pour que, afin que, à condition que, avant que. Elles sont fréquentes à l'écrit comme à l'oral soutenu.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276230,"_nanoseconds":688000000}},{"id":"hdEvNG3OFrbabHK4XJIE","level":"b2","lesson":4,"part":2,"type":"text","name":"b2-l04-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧠</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Le subjonctif avancé</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276230,"_nanoseconds":673000000}},{"id":"uBOr77Znb6lh1pt7Opny","level":"b2","lesson":4,"part":2,"type":"text","name":"b2-l04-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Bien que, quoique (concession) ; pour que, afin que (but) ; à condition que, pourvu que (condition) ; avant que, jusqu'à ce que (temps). Toujours suivies du subjonctif.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bien qu'il soit 