[{"id":"3zrAiL2UYRYbuMNZ6CNP","level":"b2","lesson":1,"part":1,"type":"text","name":"b2-l01-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bienvenue au niveau B2. À partir d'aujourd'hui, nous travaillons presque uniquement en français, à un rythme naturel. Premier objectif : structurer un discours. Une idée claire a toujours un début, un milieu et une fin. Voyons comment les annoncer et les relier.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276225,"_nanoseconds":416000000}},{"id":"T7LTPR4ILpSfGh3FVNzo","level":"b2","lesson":1,"part":2,"type":"text","name":"b2-l01-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🏛️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Structurer un discours</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276225,"_nanoseconds":346000000}},{"id":"QOwHPQoEn9hyUI6DuN1s","level":"b2","lesson":1,"part":2,"type":"text","name":"b2-l01-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Une structure simple : l'introduction (accroche, sujet, plan), le développement (trois points), la conclusion (bilan, ouverture). Annoncez votre plan dès le début, et signalez chaque transition.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,