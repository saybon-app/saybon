[{"id":"7UYvMdAnuwFf82HVzq7M","level":"b2","lesson":14,"part":1,"type":"text","name":"b2-l14-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, l'actualité. Vous commentez des événements récents : vous les présentez, vous donnez le contexte, vous analysez les causes et les conséquences possibles. Il est utile de suivre l'actualité en français pour progresser.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276246,"_nanoseconds":539000000}},{"id":"hXd54ma3ZfP3SZXqikw8","level":"b2","lesson":14,"part":2,"type":"text","name":"b2-l14-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗞️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">L'actualité</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276246,"_nanoseconds":648000000}},{"id":"DM45IBwS0dqUUKZhVGa5","level":"b2","lesson":14,"part":2,"type":"text","name":"b2-l14-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Présenter : selon les informations, on apprend que, il s'est produit. Contextualiser : dans le contexte de, depuis des mois. Analyser : cela risque de, cela pourrait entraîner. Réagir : cela me semble préoccupant, c'est une bonne nouvelle.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Selon les informations,...</b><span style=\"opacity:.7;\"> · According to the news,...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On apprend que...</b><span style=\"opacity:.7;\"> · We learn that...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Cela risque d'entraîner...</b><span style=\"opacity:.7;\"> · This risks leading to...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Cela me semble préoccupant.</b><span style=\"opacity:.7;\"> · This seems worrying to me.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276246,"_nanoseconds":762000000}},{"id":"kktTjVQ46ybxzCWJOhjB","level":"b2","lesson":14,"part":3,"type":"text","name":"b2-l14-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Selon les informations,...</b></p><p style=\"opacity:.75;margin:0;\">According to the news,...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Selon les informations,...","size":null,"created":{"_seconds":1793276247,"_nanoseconds":175000000}},{"id":"6AFYXLY2L77Mg5oJo5fj","level":"b2","lesson":14,"part":4,"type":"text","name":"b2-l14-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On apprend que...</b></p><p style=\"opacity:.75;margin:0;\">We learn that...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"On apprend que...","size":null,"created":{"_seconds":1793276247,"_nanoseconds":230000000}},{"id":"5seslCFp0Z0QjERaw6Qt","level":"b2","lesson":14,"part":5,"type":"text","name":"b2-l14-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div sty