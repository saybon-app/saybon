[{"id":"q1SY0o1FyRwgFsX9EVvL","level":"b2","lesson":21,"part":1,"type":"text","name":"b2-l21-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, raconter avec style. Le récit utilise un mélange de temps : le passé simple à l'écrit, mais à l'oral, surtout le passé composé et l'imparfait, avec des effets de rythme. Vous allez créer du suspense, ralentir, accélérer.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276267,"_nanoseconds":632000000}},{"id":"vMGvcD8RMDDywZjOexVy","level":"b2","lesson":21,"part":2,"type":"text","name":"b2-l21-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎬</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Raconter avec style</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276267,"_nanoseconds":633000000}},{"id":"sBEcVXBZGRSEvIXGmM4w","level":"b2","lesson":21,"part":2,"type":"text","name":"b2-l21-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Rythme : soudain, tout à coup, à ce moment-là, quelques instants plus tard. Détails sensoriels : on entendait, l'air sentait, la lumière tombait. Effet : phrases courtes pour l'action, longues pour la description. Fin : et c'est ainsi que.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tout à coup,...</b><span style=\"opacity:.7;\"> · Suddenly,...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quelques instants plus tard,...</b><span style=\"opacity:.7;\"> · A few moments later,...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>L'air sentait la pluie.</b><span style=\"opacity:.7;\"> · The air smelled of rain.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Et c'est ainsi que...</b><span style=\"opacity:.7;\"> · And that's how...</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276267,"_nanoseconds":671000000}},{"id":"TsCGsYkzqfdpNkMapzBx","level":"b2","lesson":21,"part":3,"type":"text","name":"b2-l21-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tout à coup,...</b></p><p style=\"opacity:.75;margin:0;\">Suddenly,...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Tout à coup,...","size":null,"created":{"_seconds":1793276267,"_nanoseconds":682000000}},{"id":"A6Z3izOXdvW31M9vnXpY","level":"b2","lesson":21,"part":4,"type":"text","name":"b2-l21-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quelques instants plus tard,...</b></p><p style=\"opacity:.75;margin:0;\">A few moments later,...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Quelques instants plus tard,...","size":null,"created":{"_seconds":1793276268,"_nanoseconds":36000000}},{"id":"dS7uICocA6v93oIQOyDE","level":"b2","lesson":21,"part":5,"type":"text","name":"b2-l21-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>L'air sentait la pluie.</b></p><p style=\"opacity:.75;margin:0;\">The air smelled of rain.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"L'air sentait la pluie.","size":null,"created":{"_seconds":1793276268,"_nanoseconds":48000000}},{"id":"WJQ0lv5VN2XiNrCbktLE","level":"b2","lesson":21,"part":6,"type":"text","name":"b2-l21-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Et c'est ainsi que...</b></p><p style=\"opacity:.75;margin:0;\">And that's how...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Et c'est ainsi que...","size":null,"created":{"_seconds":1793276268,"_nanoseconds":63000000}},{"id":"X19TjlRDjUqqqEqazasQ","level":"b2","lesson":21,"part":7,"type":"text","name":"b2-l21-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Racontez-moi un moment de tension que vous avez vécu.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'était un soir d'orage, l'air sentait la pluie et la rue était vide.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Que s'est-il passé ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tout à coup, j'ai entendu un bruit derrière moi. Je me suis arrêté.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ensuite ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quelques instants plus tard, un chat a sauté d'une poubelle. J'ai éclaté de rire.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle conclusion ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Et c'est ainsi que j'ai appris que la peur invente souvent des monstres.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276268,"_nanoseconds":93000000}},{"id":"kct7YT8ShHGNrvSKfEui","level":"b2","lesson":21,"part":8,"type":"text","name":"b2-l21-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Racontez-moi un moment de tension que vous avez vécu.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'était un soir d'orage, l'air sentait la pluie et la rue était vide.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'était un soir d'orage, l'air sentait la pluie et la rue était vide.","size":null,"created":{"_seconds":1793276268,"_nanoseconds":553000000}},{"id":"oI7oIRDSJuNMwKBmOjKs","level":"b2","lesson":21,"part":9,"type":"text","name":"b2-l21-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Que s'est-il passé ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tout à coup, j'ai entendu un bruit derrière moi. Je me suis arrêté.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Tout à coup, j'ai entendu un bruit derrière moi. Je me suis arrêté.","size":null,"created":{"_seconds":1793276268,"_nanoseconds":553000000}},{"id":"dCmT3G8oP171XNfql1vI","level":"b2","lesson":21,"part":10,"type":"text","name":"b2-l21-p10-b1","partTitle":"À vous 3/4","transitionM