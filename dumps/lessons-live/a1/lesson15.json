[{"id":"R1NylEaoJ6tiGQo4HmEF","level":"a1","lesson":15,"part":1,"type":"text","name":"a1-l15-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you speak about the past. Hier, yesterday, I did something. You use the passé composé with avoir, the verb to have, and a past participle. It's the key tense for telling what happened.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275980,"_nanoseconds":2000000}},{"id":"3318Psb5plGEr8Q8c7gs","level":"a1","lesson":15,"part":2,"type":"text","name":"a1-l15-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏪</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Past tense with avoir</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275980,"_nanoseconds":7000000}},{"id":"wc0MrwQ09MUGItr9QtFv","level":"a1","lesson":15,"part":2,"type":"text","name":"a1-l15-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Passé composé with avoir: j'ai + participle. J'ai mangé, j'ai travaillé, j'ai regardé. Irregular ones: j'ai fait, j'ai pris, j'ai vu. The negative goes around avoir: je n'ai pas mangé. Time words: hier, ce matin, la semaine dernière.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai mangé du riz.</b><span style=\"opacity:.7;\"> · I ate rice.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai travaillé hier.</b><span style=\"opacity:.7;\"> · I worked yesterday.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai fait du sport.</b><span style=\"opacity:.7;\"> · I did sport.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je n'ai pas dormi.</b><span style=\"opacity:.7;\"> · I didn't sleep.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275980,"_nanoseconds":15000000}},{"id":"vPQCmaoD9A20Cczz8hmg","level":"a1","lesson":15,"part":3,"type":"text","name":"a1-l15-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai mangé du riz.</b></p><p style=\"opacity:.75;margin:0;\">I ate rice.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai mangé du riz.","size":null,"created":{"_seconds":1793275980,"_nanoseconds":27000000}},{"id":"mj29Ixb1IvatrzSfhfIq","level":"a1","lesson":15,"part":4,"type":"text","name":"a1-l15-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai travaillé hier.</b></p><p style=\"opacity:.75;margin:0;\">I worked yesterday.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai travaillé hier.","size":null,"created":{"_seconds":1793275980,"_nanoseconds":504000000}},{"id":"HH3nYi1BaOhjFLUxyG3w","level":"a1","lesson":15,"part":5,"type":"text","name":"a1-l15-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai fait du sport.</b></p><p style=\"opacity:.75;margin:0;\">I did sport.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai fait du sport.","size":null,"created":{"_seconds":1793275980,"_nanoseconds":512000000}},{"id":"QaYHh8JdM9iIchQ66FYP","level":"a1","lesson":15,"part":6,"type":"text","name":"a1-l15-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je n'ai pas dormi.</b></p><p style=\"opacity:.75;margin:0;\">I didn't sleep.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je n'ai pas dormi.","size":null,"created":{"_seconds":1793275980,"_nanoseconds":520000000}},{"id":"8JJ19iOSnkRmCHMxm9PO","level":"a1","lesson":15,"part":7,"type":"text","name":"a1-l15-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Qu'est-ce que vous avez fait hier ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What did you do yesterday?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Hier, j'ai travaillé jusqu'à cinq heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yesterday I worked until five.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et après ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And after that?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai fait du sport, puis j'ai mangé du riz.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I did sport, then I ate rice.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez regardé la télévision ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you watch television?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je n'ai pas regardé la télévision. J'ai lu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I didn't watch television. I read.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez bien dormi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you sleep well?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai très bien dormi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I slept very well.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275980,"_nanoseconds":523000000}},{"id":"7ljzFifSV7ySLHb7IIBh","level":"a1","lesson":15,"part":8,"type":"text","name":"a1-l15-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Qu'est-ce que vous avez fait hier ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What did you do yesterday?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Hier, j'ai travaillé jusqu'à cinq heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yesterday I worked until five.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Hier, j'ai travaillé jusqu'à cinq heures.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":8000000}},{"id":"8yFVLx4Qe8EkT2ty9U8a","level":"a1","lesson":15,"part":9,"type":"text","name":"a1-l15-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et après ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And after that?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai fait du sport, puis j'ai mangé du riz.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I did sport, then I ate rice.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai fait du sport, puis j'ai mangé du riz.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":26000000}},{"id":"BlbuiuavL5rbL2be40Vo","level":"a1","lesson":15,"part":10,"type":"text","name":"a1-l15-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez regardé la télévision ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you watch television?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je n'ai pas regardé la télévision. J'ai lu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I didn't watch television. I read.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je n'ai pas regardé la télévision. J'ai lu.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":67000000}},{"id":"FkrAyw10NeTXFd7Wgqrw","level":"a1","lesson":15,"part":11,"type":"text","name":"a1-l15-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez bien dormi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you sleep well?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'ai très bien dormi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I slept very well.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'ai très bien dormi.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":64000000}},{"id":"EDpKF9hCWgA1tAkjw09W","level":"a1","lesson":15,"part":12,"type":"text","name":"a1-l15-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Racontez votre hier.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Tell me about your yesterday.</p><p><b>Say three things you did yesterday.</b></p><p style=\"opacity:.7;\">For example: “Hier, j'ai travaillé. J'ai mangé du riz. J'ai regardé un film.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Hier, j'ai travaillé. J'ai mangé du riz. J'ai regardé un film.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":525000000}},{"id":"hIleCTK3TqHm62Ivquo1","level":"a1","lesson":15,"part":13,"type":"text","name":"a1-l15-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏪</div><p><b>Past tense unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say what you did using the passé composé with avoir. This is your first past tense, a huge step.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275981,"_nanoseconds":569000000}}]