[{"id":"hwce82sJuRMJN8RyIlj1","level":"a1","lesson":5,"part":1,"type":"text","name":"a1-l05-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you describe your routine. French uses reflexive verbs for daily actions, such as se lever, to get up. The small word me, te or se comes before the verb. It looks odd at first, but you will hear it everywhere.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275962,"_nanoseconds":697000000}},{"id":"YtTcaPTjVEhYB0Hczs0X","level":"a1","lesson":5,"part":2,"type":"text","name":"a1-l05-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌅</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Reflexive verbs</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275962,"_nanoseconds":682000000}},{"id":"JHlEe72I3oWMx6alqzzb","level":"a1","lesson":5,"part":2,"type":"text","name":"a1-l05-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Reflexive verbs use me, te, se, nous, vous, se before the verb: je me lève, tu te laves, il se couche. Elision: je m'habille. Common ones are se lever, se laver, s'habiller, se coucher.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me lève à six heures.</b><span style=\"opacity:.7;\"> · I get up at six.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me lave.</b><span style=\"opacity:.7;\"> · I wash.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je m'habille.</b><span style=\"opacity:.7;\"> · I get dressed.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me couche à dix heures.</b><span style=\"opacity:.7;\"> · I go to bed at ten.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275962,"_nanoseconds":737000000}},{"id":"S2YlTuV8OON5EMKvTy17","level":"a1","lesson":5,"part":3,"type":"text","name":"a1-l05-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me lève à six heures.</b></p><p style=\"opacity:.75;margin:0;\">I get up at six.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me lève à six heures.","size":null,"created":{"_seconds":1793275962,"_nanoseconds":775000000}},{"id":"cZL2ujyeXTXAcLs9VxTN","level":"a1","lesson":5,"part":4,"type":"text","name":"a1-l05-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me lave.</b></p><p style=\"opacity:.75;margin:0;\">I wash.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me lave.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":204000000}},{"id":"iKiHpTCEECRhCOhQMEF9","level":"a1","lesson":5,"part":5,"type":"text","name":"a1-l05-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je m'habille.</b></p><p style=\"opacity:.75;margin:0;\">I get dressed.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je m'habille.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":209000000}},{"id":"vijE8U9g2ABb006OyJwS","level":"a1","lesson":5,"part":6,"type":"text","name":"a1-l05-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me couche à dix heures.</b></p><p style=\"opacity:.75;margin:0;\">I go to bed at ten.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me couche à dix heures.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":288000000}},{"id":"ZtzCjNlcQjsXzZEE9gTC","level":"a1","lesson":5,"part":7,"type":"text","name":"a1-l05-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parlez-moi de votre matin. Vous vous levez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about your morning. What time do you get up?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je me lève à six heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I get up at six.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And then?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je me lave et je m'habille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I wash and I get dressed.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous prenez le petit déjeuner ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have breakfast?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je mange du pain et je bois du thé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I eat bread and drink tea.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le soir, vous vous couchez tôt ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening, do you go to bed early?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je me couche à dix heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I go to bed at ten.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275963,"_nanoseconds":213000000}},{"id":"LPeze90BibAk1t0r1hto","level":"a1","lesson":5,"part":8,"type":"text","name":"a1-l05-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Parlez-moi de votre matin. Vous vous levez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about your morning. What time do you get up?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je me lève à six heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I get up at six.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je me lève à six heures.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":701000000}},{"id":"EekMOQXu5zpTU66Xucp3","level":"a1","lesson":5,"part":9,"type":"text","name":"a1-l05-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And then?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je me lave et je m'habille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I wash and I get dressed.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je me lave et je m'habille.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":751000000}},{"id":"hfytCIDvVacbkd6yCIDU","level":"a1","lesson":5,"part":10,"type":"text","name":"a1-l05-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous prenez le petit déjeuner ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have breakfast?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je mange du pain et je bois du thé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I eat bread and drink tea.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je mange du pain et je bois du thé.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":704000000}},{"id":"LuqNP2HaIn8BIRpA2lKL","level":"a1","lesson":5,"part":11,"type":"text","name":"a1-l05-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le soir, vous vous couchez tôt ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening, do you go to bed early?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je me couche à dix heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I go to bed at ten.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je me couche à dix heures.","size":null,"created":{"_seconds":1793275963,"_nanoseconds":749000000}},{"id":"CJquop1TnJIm4XdiZrdE","level":"a1","lesson":5,"part":12,"type":"text","name":"a1-l05-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez votre matin.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe your morning.</p><p><b>Describe your morning in three sentences with reflexive verbs.</b></p><p style=\"opacity:.7;\">For example: “Je me lève à six heures. Je me lave. Je m'habille.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je me lève à six heures. Je me lave. Je m'habille.","size":null,"created":{"_seconds":1793275964,"_nanoseconds":152000000}},{"id":"VOiB8nIPp5Eu8QLtNF6y","level":"a1","lesson":5,"part":13,"type":"text","name":"a1-l05-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌅</div><p><b>Morning routine done!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe your morning with reflexive verbs. Practise them with your real day.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275964,"_nanoseconds":136000000}}]