[{"id":"XazC2ol98nXeNXKsA8ge","level":"a1","lesson":4,"part":1,"type":"text","name":"a1-l04-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Salut ! Today a grammar day, but you will speak. French verbs ending in -ir and -re follow patterns. Once you know one, you know many. We will practise with verbs like finir, choisir, attendre and répondre, inside a conversation.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275960,"_nanoseconds":690000000}},{"id":"HScWVHz7LMJWiq2S1lKF","level":"a1","lesson":4,"part":2,"type":"text","name":"a1-l04-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔁</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">-ir and -re verbs</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275960,"_nanoseconds":707000000}},{"id":"8JiOhg4EFO9k4PgADyBd","level":"a1","lesson":4,"part":2,"type":"text","name":"a1-l04-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Verbs in -ir like finir: je finis, tu finis, il finit, nous finissons, vous finissez, ils finissent. Verbs in -re like attendre: j'attends, tu attends, il attend, nous attendons, vous attendez, ils attendent.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je finis à cinq heures.</b><span style=\"opacity:.7;\"> · I finish at five.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous choisissons un café.</b><span style=\"opacity:.7;\"> · We choose a café.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'attends mon ami.</b><span style=\"opacity:.7;\"> · I am waiting for my friend.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous répondez au téléphone.</b><span style=\"opacity:.7;\"> · You answer the phone.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275961,"_nanoseconds":412000000}},{"id":"GuJljrhCFGBMAqbFZsyt","level":"a1","lesson":4,"part":3,"type":"text","name":"a1-l04-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je finis à cinq heures.</b></p><p style=\"opacity:.75;margin:0;\">I finish at five.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je finis à cinq heures.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":427000000}},{"id":"5WLyhXc8AKUsSvr7I4Kp","level":"a1","lesson":4,"part":4,"type":"text","name":"a1-l04-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous choisissons un café.</b></p><p style=\"opacity:.75;margin:0;\">We choose a café.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous choisissons un café.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":481000000}},{"id":"x6nEKyWPo43fG02AdaN0","level":"a1","lesson":4,"part":5,"type":"text","name":"a1-l04-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'attends mon ami.</b></p><p style=\"opacity:.75;margin:0;\">I am waiting for my friend.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'attends mon ami.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":441000000}},{"id":"L8uWWdvj2RYi7hOpC8Oq","level":"a1","lesson":4,"part":6,"type":"text","name":"a1-l04-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous répondez au téléphone.</b></p><p style=\"opacity:.75;margin:0;\">You answer the phone.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vous répondez au téléphone.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":861000000}},{"id":"zTzEbHx3H8qU9JhJPML8","level":"a1","lesson":4,"part":7,"type":"text","name":"a1-l04-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous finissez à quelle heure aujourd'hui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do you finish today?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je finis à cinq heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I finish at five.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, j'attends mon frère. Vous attendez quelqu'un ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm waiting for my brother. Are you waiting for someone?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'attends mon ami Paul.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm waiting for my friend Paul.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>On choisit un café ensemble ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Shall we choose a café together?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, nous choisissons ce café.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, we choose this café.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre téléphone sonne. Vous répondez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your phone is ringing. Are you answering?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je réponds. Allô ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm answering. Hello?</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275961,"_nanoseconds":870000000}},{"id":"i0fmqN9mdLf33mp9Cj7Q","level":"a1","lesson":4,"part":8,"type":"text","name":"a1-l04-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous finissez à quelle heure aujourd'hui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do you finish today?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je finis à cinq heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I finish at five.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je finis à cinq heures.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":915000000}},{"id":"tV2VWDvjMKGOlqGxhVVb","level":"a1","lesson":4,"part":9,"type":"text","name":"a1-l04-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, j'attends mon frère. Vous attendez quelqu'un ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm waiting for my brother. Are you waiting for someone?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'attends mon ami Paul.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm waiting for my friend Paul.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'attends mon ami Paul.","size":null,"created":{"_seconds":1793275961,"_nanoseconds":952000000}},{"id":"TKDXjmdHh87MPvOm6YQz","level":"a1","lesson":4,"part":10,"type":"text","name":"a1-l04-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>On choisit un café ensemble ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Shall we choose a café together?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, nous choisissons ce café.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, we choose this café.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, nous choisissons ce café.","size":null,"created":{"_seconds":1793275962,"_nanoseconds":275000000}},{"id":"NSxCv7gAWyPyboEGEThb","level":"a1","lesson":4,"part":11,"type":"text","name":"a1-l04-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Votre téléphone sonne. Vous répondez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your phone is ringing. Are you answering?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je réponds. Allô ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm answering. Hello?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je réponds. Allô ?","size":null,"created":{"_seconds":1793275962,"_nanoseconds":272000000}},{"id":"toI3qB0j9jIcICPiP3aj","level":"a1","lesson":4,"part":12,"type":"text","name":"a1-l04-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Que faites-vous après le travail ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you do after work?</p><p><b>Use at least two -ir or -re verbs to say what you do.</b></p><p style=\"opacity:.7;\">For example: “Je finis à cinq heures. J'attends mon ami. Nous choisissons un café.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je finis à cinq heures. J'attends mon ami. Nous choisissons un café.","size":null,"created":{"_seconds":1793275962,"_nanoseconds":323000000}},{"id":"NxZYbYEfYSLin7TuEFSI","level":"a1","lesson":4,"part":13,"type":"text","name":"a1-l04-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔁</div><p><b>Verbs on repeat!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can conjugate -ir and -re verbs aloud. Say the patterns often, and they become automatic.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275962,"_nanoseconds":355000000}}]