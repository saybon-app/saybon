[{"id":"9r9dThcPj3VXnHj9Yuic","level":"a1","lesson":14,"part":1,"type":"text","name":"a1-l14-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you talk about your free time and sports. You say what you like doing, using jouer à for games and faire du for activities. We also reuse j'aime and je n'aime pas from the beginner lessons.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275978,"_nanoseconds":146000000}},{"id":"OjB1N36Qm6QXt6ZVtdLI","level":"a1","lesson":14,"part":2,"type":"text","name":"a1-l14-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚽</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Hobbies and sport</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275978,"_nanoseconds":194000000}},{"id":"MLj8K0YrHUegParY0FKm","level":"a1","lesson":14,"part":2,"type":"text","name":"a1-l14-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Jouer au football, jouer au tennis. Faire du sport, faire de la danse, faire de la natation. J'aime lire, j'aime écouter de la musique. Add souvent, quelquefois, rarement, jamais to say how often.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je joue au football.</b><span style=\"opacity:.7;\"> · I play football.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je fais de la danse.</b><span style=\"opacity:.7;\"> · I do dancing.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'aime lire.</b><span style=\"opacity:.7;\"> · I like to read.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je ne joue jamais au tennis.</b><span style=\"opacity:.7;\"> · I never play tennis.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275978,"_nanoseconds":654000000}},{"id":"IVevEP3qAAqQ3bHPtU4z","level":"a1","lesson":14,"part":3,"type":"text","name":"a1-l14-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je joue au football.</b></p><p style=\"opacity:.75;margin:0;\">I play football.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je joue au football.","size":null,"created":{"_seconds":1793275978,"_nanoseconds":655000000}},{"id":"U3m3avwn8xJBowr2NizU","level":"a1","lesson":14,"part":4,"type":"text","name":"a1-l14-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je fais de la danse.</b></p><p style=\"opacity:.75;margin:0;\">I do dancing.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je fais de la danse.","size":null,"created":{"_seconds":1793275978,"_nanoseconds":657000000}},{"id":"mbsji4Zm9LpzS7t9AXOd","level":"a1","lesson":14,"part":5,"type":"text","name":"a1-l14-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'aime lire.</b></p><p style=\"opacity:.75;margin:0;\">I like to read.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'aime lire.","size":null,"created":{"_seconds":1793275978,"_nanoseconds":655000000}},{"id":"no9TEWLyeYKgv1SzRzWP","level":"a1","lesson":14,"part":6,"type":"text","name":"a1-l14-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je ne joue jamais au tennis.</b></p><p style=\"opacity:.75;margin:0;\">I never play tennis.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je ne joue jamais au tennis.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":68000000}},{"id":"g2XLF2G3WW1A21h0GInm","level":"a1","lesson":14,"part":7,"type":"text","name":"a1-l14-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous faites pendant votre temps libre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do in your free time?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je joue au football et j'aime lire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I play football and I like reading.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous jouez souvent ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you play often?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je joue le samedi, deux fois par mois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I play on Saturdays, twice a month.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous faites autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you do anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je fais de la danse le dimanche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I do dancing on Sundays.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous aimez le tennis ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like tennis?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je ne joue jamais au tennis.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I never play tennis.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275979,"_nanoseconds":71000000}},{"id":"IHgWPsUhmvZZCahkUZs9","level":"a1","lesson":14,"part":8,"type":"text","name":"a1-l14-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous faites pendant votre temps libre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do in your free time?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je joue au football et j'aime lire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I play football and I like reading.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je joue au football et j'aime lire.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":75000000}},{"id":"vjPvMtuqYZu25AM9P7PS","level":"a1","lesson":14,"part":9,"type":"text","name":"a1-l14-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous jouez souvent ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you play often?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je joue le samedi, deux fois par mois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I play on Saturdays, twice a month.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je joue le samedi, deux fois par mois.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":70000000}},{"id":"jNz29hiP6jpCI6f6ITsU","level":"a1","lesson":14,"part":10,"type":"text","name":"a1-l14-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous faites autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you do anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je fais de la danse le dimanche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I do dancing on Sundays.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je fais de la danse le dimanche.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":575000000}},{"id":"FhBLIqgFpOUvwQEHU4pt","level":"a1","lesson":14,"part":11,"type":"text","name":"a1-l14-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous aimez le tennis ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like tennis?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je ne joue jamais au tennis.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I never play tennis.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je ne joue jamais au tennis.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":578000000}},{"id":"M7q91FJDWs3wvrvvZC1y","level":"a1","lesson":14,"part":12,"type":"text","name":"a1-l14-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Que faites-vous le week-end ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you do at weekends?</p><p><b>Name two activities and say how often.</b></p><p style=\"opacity:.7;\">For example: “Je joue au football le samedi. Je fais de la danse. Je ne joue jamais au tennis.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je joue au football le samedi. Je fais de la danse. Je ne joue jamais au tennis.","size":null,"created":{"_seconds":1793275979,"_nanoseconds":623000000}},{"id":"7CHLSA9zCQjZpyFeLf4p","level":"a1","lesson":14,"part":13,"type":"text","name":"a1-l14-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚽</div><p><b>Hobbies shared!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about hobbies and how often you do them. A great topic for easy conversations.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275979,"_nanoseconds":624000000}}]