[{"id":"ongbeFj9sZwrTXz2qfdF","level":"a1","lesson":16,"part":1,"type":"text","name":"a1-l16-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Last time you used avoir for the past. Today a small group of verbs use être instead: mostly verbs of movement, like aller, venir, partir, arriver. Then the participle agrees with the subject. Listen to the e at the end for women.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275981,"_nanoseconds":526000000}},{"id":"qeOAUwKt8YLYyDR4uxjQ","level":"a1","lesson":16,"part":2,"type":"text","name":"a1-l16-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧳</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Past tense with être</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275981,"_nanoseconds":525000000}},{"id":"BHPQmRGUOyFlGYENQAHL","level":"a1","lesson":16,"part":2,"type":"text","name":"a1-l16-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je suis allé, tu es allé, il est allé. A woman says je suis allée. Others: je suis parti, arrivé, venu, entré, sorti, resté. Reflexive verbs also use être: je me suis levé.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis allé au marché.</b><span style=\"opacity:.7;\"> · I went to the market. (m.)</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle est partie à six heures.</b><span style=\"opacity:.7;\"> · She left at six.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous sommes arrivés hier.</b><span style=\"opacity:.7;\"> · We arrived yesterday.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me suis levé tôt.</b><span style=\"opacity:.7;\"> · I got up early.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275981,"_nanoseconds":991000000}},{"id":"dXBcwoZnTpnsXmdqjyv6","level":"a1","lesson":16,"part":3,"type":"text","name":"a1-l16-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis allé au marché.</b></p><p style=\"opacity:.75;margin:0;\">I went to the market. (m.)</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis allé au marché.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":997000000}},{"id":"jxEkUkdmkd1rm24Od0rY","level":"a1","lesson":16,"part":4,"type":"text","name":"a1-l16-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle est partie à six heures.</b></p><p style=\"opacity:.75;margin:0;\">She left at six.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle est partie à six heures.","size":null,"created":{"_seconds":1793275981,"_nanoseconds":999000000}},{"id":"LT55Cvrd99K9awepAtcB","level":"a1","lesson":16,"part":5,"type":"text","name":"a1-l16-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous sommes arrivés hier.</b></p><p style=\"opacity:.75;margin:0;\">We arrived yesterday.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous sommes arrivés hier.","size":null,"created":{"_seconds":1793275982,"_nanoseconds":43000000}},{"id":"xd51n4p3WiXHIBb5KcTa","level":"a1","lesson":16,"part":6,"type":"text","name":"a1-l16-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me suis levé tôt.</b></p><p style=\"opacity:.75;margin:0;\">I got up early.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me suis levé tôt.","size":null,"created":{"_seconds":1793275982,"_nanoseconds":397000000}},{"id":"DNUukchkDGBNcEyPkBR6","level":"a1","lesson":16,"part":7,"type":"text","name":"a1-l16-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Où êtes-vous allé le week-end dernier ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where did you go last weekend?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis allé à Kumasi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I went to Kumasi.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous êtes parti à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time did you leave?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis parti à sept heures. Je suis arrivé à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I left at seven. I arrived at noon.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous êtes resté combien de temps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And how long did you stay?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis resté deux jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I stayed two days.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous êtes rentré quand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When did you come back?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis rentré dimanche soir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I came back Sunday evening.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275982,"_nanoseconds":402000000}},{"id":"WWLQJ03nMPnqdCKYNJd1","level":"a1","lesson":16,"part":8,"type":"text","name":"a1-l16-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Où êtes-vous allé le week-end dernier ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where did you go last weekend?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis allé à Kumasi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I went to Kumasi.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis allé à Kumasi.","size":null,"created":{"_seconds":1793275982,"_nanoseconds":400000000}},{"id":"MmxqiTffVMMLTuTmAw21","level":"a1","lesson":16,"part":9,"type":"text","name":"a1-l16-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous êtes parti à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time did you leave?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis parti à sept heures. Je suis arrivé à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I left at seven. I arrived at noon.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis parti à sept heures. Je suis arrivé à midi.","size":null,"created":{"_seconds":1793275982,"_nanoseconds":454000000}},{"id":"HB5y1Q697PkdVZFTpADk","level":"a1","lesson":16,"part":10,"type":"text","name":"a1-l16-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous êtes resté combien de temps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And how long did you stay?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis resté deux jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I stayed two days.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis resté deux jours.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":49000000}},{"id":"lDHNTAyg6uXDEn4adNwT","level":"a1","lesson":16,"part":11,"type":"text","name":"a1-l16-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous êtes rentré quand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When did you come back?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis rentré dimanche soir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I came back Sunday evening.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis rentré dimanche soir.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":57000000}},{"id":"JirtG39UJXcJbr7IORHm","level":"a1","lesson":16,"part":12,"type":"text","name":"a1-l16-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Où êtes-vous allé le week-end dernier ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Where did you go last weekend?</p><p><b>Say where you went, when you left and when you came back.</b></p><p style=\"opacity:.7;\">For example: “Je suis allé à Kumasi. Je suis parti samedi. Je suis rentré dimanche.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je suis allé à Kumasi. Je suis parti samedi. Je suis rentré dimanche.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":88000000}},{"id":"pZZLgtQrDW4P63j4g3KM","level":"a1","lesson":16,"part":13,"type":"text","name":"a1-l16-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧳</div><p><b>Travel stories ready!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can use the passé composé with être. Now you can tell where you went and when.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275983,"_nanoseconds":112000000}}]