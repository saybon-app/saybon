[{"id":"01Q7CtEh745j4NpI7l9Y","level":"a1","lesson":13,"part":1,"type":"text","name":"a1-l13-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today we visit the doctor. You name parts of the body, say where it hurts and understand simple advice. The key phrase is j'ai mal à, I have a pain in. Take your time with the body words.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275976,"_nanoseconds":503000000}},{"id":"B4dcyO3fQhqzsWdCEAfa","level":"a1","lesson":13,"part":2,"type":"text","name":"a1-l13-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🩺</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">At the doctor</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275976,"_nanoseconds":502000000}},{"id":"qvoE464PQHZTvJ1QdUDX","level":"a1","lesson":13,"part":2,"type":"text","name":"a1-l13-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 J'ai mal à la tête, I have a headache. J'ai mal au ventre, a stomach ache. J'ai mal aux dents, tooth ache. Use au for masculine words, à la for feminine, aux for plurals. The doctor says depuis quand, since when.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai mal à la tête.</b><span style=\"opacity:.7;\"> · I have a headache.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai mal au dos.</b><span style=\"opacity:.7;\"> · My back hurts.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Depuis hier</b><span style=\"opacity:.7;\"> · since yesterday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis fatigué.</b><span style=\"opacity:.7;\"> · I'm tired.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275976,"_nanoseconds":552000000}},{"id":"ZCqmWtf6LRdupBztHN2B","level":"a1","lesson":13,"part":3,"type":"text","name":"a1-l13-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai mal à la tête.</b></p><p style=\"opacity:.75;margin:0;\">I have a headache.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai mal à la tête.","size":null,"created":{"_seconds":1793275976,"_nanoseconds":601000000}},{"id":"IuE0ZoY0oDzzYdP6k9u0","level":"a1","lesson":13,"part":4,"type":"text","name":"a1-l13-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai mal au dos.</b></p><p style=\"opacity:.75;margin:0;\">My back hurts.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai mal au dos.","size":null,"created":{"_seconds":1793275976,"_nanoseconds":927000000}},{"id":"glYpDUHNyguMH0nbOgxO","level":"a1","lesson":13,"part":5,"type":"text","name":"a1-l13-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Depuis hier</b></p><p style=\"opacity:.75;margin:0;\">since yesterday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Depuis hier","size":null,"created":{"_seconds":1793275976,"_nanoseconds":957000000}},{"id":"MJo5WiqwYbmPOTbbRFxZ","level":"a1","lesson":13,"part":6,"type":"text","name":"a1-l13-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis fatigué.</b></p><p style=\"opacity:.75;margin:0;\">I'm tired.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis fatigué.","size":null,"created":{"_seconds":1793275976,"_nanoseconds":980000000}},{"id":"UEi0TkwtasGZEmBmTrnq","level":"a1","lesson":13,"part":7,"type":"text","name":"a1-l13-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour. Qu'est-ce qui ne va pas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello. What's wrong?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai mal à la tête et j'ai mal au ventre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a headache and a stomach ache.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Depuis quand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Since when?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Depuis hier. Je suis aussi très fatigué.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Since yesterday. I'm also very tired.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez de la fièvre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a fever?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je ne pense pas.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't think so.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Reposez-vous et buvez beaucoup d'eau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Rest and drink lots of water.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'accord. Merci, docteur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. Thank you, doctor.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275977,"_nanoseconds":44000000}},{"id":"oSvxCVmDZmceIPn6Inzj","level":"a1","lesson":13,"part":8,"type":"text","name":"a1-l13-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour. Qu'est-ce qui ne va pas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello. What's wrong?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai mal à la tête et j'ai mal au ventre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a headache and a stomach ache.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai mal à la tête et j'ai mal au ventre.","size":null,"created":{"_seconds":1793275977,"_nanoseconds":695000000}},{"id":"pPZZ80RVHUjT0hmtG5KZ","level":"a1","lesson":13,"part":9,"type":"text","name":"a1-l13-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Depuis quand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Since when?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Depuis hier. Je suis aussi très fatigué.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Since yesterday. I'm also very tired.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Depuis hier. Je suis aussi très fatigué.","size":null,"created":{"_seconds":1793275977,"_nanoseconds":688000000}},{"id":"e3Ij2fgbSnpaEtSUnMLo","level":"a1","lesson":13,"part":10,"type":"text","name":"a1-l13-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez de la fièvre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a fever?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je ne pense pas.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't think so.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je ne pense pas.","size":null,"created":{"_seconds":1793275977,"_nanoseconds":695000000}},{"id":"Hca9Ls19AvSAkoIsWTI3","level":"a1","lesson":13,"part":11,"type":"text","name":"a1-l13-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Reposez-vous et buvez beaucoup d'eau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Rest and drink lots of water.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'accord. Merci, docteur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. Thank you, doctor.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"D'accord. Merci, docteur.","size":null,"created":{"_seconds":1793275977,"_nanoseconds":700000000}},{"id":"RRYJtM5DoYk1lIo2DCJv","level":"a1","lesson":13,"part":12,"type":"text","name":"a1-l13-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Expliquez au médecin ce qui ne va pas.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Explain to the doctor what is wrong.</p><p><b>Say where it hurts and since when.</b></p><p style=\"opacity:.7;\">For example: “J'ai mal à la tête depuis hier. Je suis très fatigué.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai mal à la tête depuis hier. Je suis très fatigué.","size":null,"created":{"_seconds":1793275978,"_nanoseconds":143000000}},{"id":"q4HWUzxtfUFmboxkcFDh","level":"a1","lesson":13,"part":13,"type":"text","name":"a1-l13-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🩺</div><p><b>Health vocabulary done!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say where it hurts and since when. A very useful emergency skill.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275978,"_nanoseconds":148000000}}]