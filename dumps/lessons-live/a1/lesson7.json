[{"id":"zUeJw86WxcJyBo71dgka","level":"a1","lesson":7,"part":1,"type":"text","name":"a1-l07-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you are at the restaurant. You will order a starter, a main dish and a drink, ask for the bill, and use the polite forms you already know. The new key words are the menu, the starter, the main course and the dessert.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275966,"_nanoseconds":162000000}},{"id":"yYZlt7Mge3CLstVR7ztN","level":"a1","lesson":7,"part":2,"type":"text","name":"a1-l07-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍽️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">At the restaurant</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275966,"_nanoseconds":159000000}},{"id":"aEvfZdy8pruOloNRxwPO","level":"a1","lesson":7,"part":2,"type":"text","name":"a1-l07-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Ordering: je voudrais, I would like, or je vais prendre, I'll have. The courses: l'entrée, le plat, le dessert. To ask for the bill: l'addition, s'il vous plaît. The waiter might say vous avez choisi, have you chosen.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais le menu.</b><span style=\"opacity:.7;\"> · I would like the menu.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je vais prendre le poisson.</b><span style=\"opacity:.7;\"> · I'll have the fish.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Comme boisson, de l'eau.</b><span style=\"opacity:.7;\"> · To drink, water.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>L'addition, s'il vous plaît.</b><span style=\"opacity:.7;\"> · The bill, please.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275966,"_nanoseconds":167000000}},{"id":"Eyz8yN6bC0RYhdr4HQRT","level":"a1","lesson":7,"part":3,"type":"text","name":"a1-l07-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais le menu.</b></p><p style=\"opacity:.75;margin:0;\">I would like the menu.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais le menu.","size":null,"created":{"_seconds":1793275966,"_nanoseconds":164000000}},{"id":"caTTqzEVvSEngj6uRuhj","level":"a1","lesson":7,"part":4,"type":"text","name":"a1-l07-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je vais prendre le poisson.</b></p><p style=\"opacity:.75;margin:0;\">I'll have the fish.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je vais prendre le poisson.","size":null,"created":{"_seconds":1793275966,"_nanoseconds":831000000}},{"id":"GALEoeeyHL7lJ5U4zIzE","level":"a1","lesson":7,"part":5,"type":"text","name":"a1-l07-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Comme boisson, de l'eau.</b></p><p style=\"opacity:.75;margin:0;\">To drink, water.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Comme boisson, de l'eau.","size":null,"created":{"_seconds":1793275966,"_nanoseconds":852000000}},{"id":"ncyNXs3HHCRzNkgyFecu","level":"a1","lesson":7,"part":6,"type":"text","name":"a1-l07-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>L'addition, s'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">The bill, please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"L'addition, s'il vous plaît.","size":null,"created":{"_seconds":1793275966,"_nanoseconds":864000000}},{"id":"ZyqG0XKEIr7fe8ffBaNj","level":"a1","lesson":7,"part":7,"type":"text","name":"a1-l07-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonsoir ! Voici le menu. Vous avez choisi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening! Here is the menu. Have you chosen?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, comme entrée, je voudrais une salade.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, as a starter, I would like a salad.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Et comme plat ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. And as a main course?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je vais prendre le poisson avec du riz.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'll have the fish with rice.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et comme boisson ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And to drink?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>De l'eau, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Water, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà. Bon appétit !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Enjoy your meal!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci. L'addition, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. The bill, please.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275966,"_nanoseconds":889000000}},{"id":"cTEeMEVC1bBOutuTgfvd","level":"a1","lesson":7,"part":8,"type":"text","name":"a1-l07-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonsoir ! Voici le menu. Vous avez choisi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening! Here is the menu. Have you chosen?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, comme entrée, je voudrais une salade.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, as a starter, I would like a salad.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, comme entrée, je voudrais une salade.","size":null,"created":{"_seconds":1793275967,"_nanoseconds":317000000}},{"id":"YJcIvj5CZ8hFuUNpNLKf","level":"a1","lesson":7,"part":9,"type":"text","name":"a1-l07-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Et comme plat ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. And as a main course?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je vais prendre le poisson avec du riz.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'll have the fish with rice.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je vais prendre le poisson avec du riz.","size":null,"created":{"_seconds":1793275967,"_nanoseconds":322000000}},{"id":"2aQCVeJRKkHl5aXkeiEH","level":"a1","lesson":7,"part":10,"type":"text","name":"a1-l07-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et comme boisson ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And to drink?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">De l'eau, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Water, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"De l'eau, s'il vous plaît.","size":null,"created":{"_seconds":1793275967,"_nanoseconds":367000000}},{"id":"OR0NQd41nGeGrS7tHPqn","level":"a1","lesson":7,"part":11,"type":"text","name":"a1-l07-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà. Bon appétit !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Enjoy your meal!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci. L'addition, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. The bill, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci. L'addition, s'il vous plaît.","size":null,"created":{"_seconds":1793275967,"_nanoseconds":326000000}},{"id":"DTFsaxr6MV0QhYWcGDPc","level":"a1","lesson":7,"part":12,"type":"text","name":"a1-l07-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous êtes au restaurant. Commandez !</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You're at the restaurant. Order!</p><p><b>Order a starter, a main dish and a drink, then ask for the bill.</b></p><p style=\"opacity:.7;\">For example: “Comme entrée, je voudrais une salade. Je vais prendre le poisson. De l'eau, s'il vous plaît. L'addition, s'il vous plaît.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Comme entrée, je voudrais une salade. Je vais prendre le poisson. De l'eau, s'il vous plaît. L'addition, s'il vous plaît.","size":null,"created":{"_seconds":1793275967,"_nanoseconds":808000000}},{"id":"LIZwTHASP5xk28RITUQK","level":"a1","lesson":7,"part":13,"type":"text","name":"a1-l07-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍽️</div><p><b>Table for one!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can order a full meal and ask for the bill. You could do this in France tomorrow.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275967,"_nanoseconds":809000000}}]