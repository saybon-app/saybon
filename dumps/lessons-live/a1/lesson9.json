ugtubQP9gqngRecdxh","level":"a1","lesson":9,"part":12,"type":"text","name":"a1-l09-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous cherchez un vêtement. Parlez au vendeur.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You're looking for a garment. Talk to the seller.</p><p><b>Say what you're looking for, your size and whether you take it.</b></p><p style=\"opacity:.7;\">For example: “Je cherche une chemise bleue. Je fais du quarante. Je la prends.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je cherche une chemise bleue. Je fais du quarante. Je la prends.","size":null,"created":{"_seconds":1793275971,"_nanoseconds":180000000}},{"id":"citrVgehujyhEQKfxPYt","level":"a1","lesson":9,"part":13,"type":"text","name":"a1-l09-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👗</div><p><b>Fashion confident!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can shop for clothes, give a size and try things on. You are building real-life French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275971,"_nanoseconds":183000000}}]