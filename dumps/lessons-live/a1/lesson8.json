[{"id":"jQvdMbRAkPo8KEqm3BOU","level":"a1","lesson":8,"part":1,"type":"text","name":"a1-l08-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you shop at the market. You buy fruit and vegetables, ask about prices and quantities, and respond to the seller. The key words are un kilo, une livre, une bouteille and combien ça coûte.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275967,"_nanoseconds":810000000}},{"id":"ZORaNqS62uVy0SBTc8rl","level":"a1","lesson":8,"part":2,"type":"text","name":"a1-l08-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍅</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">At the market</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275967,"_nanoseconds":805000000}},{"id":"wa9CxpmIpjX5xmOA5c9u","level":"a1","lesson":8,"part":2,"type":"text","name":"a1-l08-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Quantities use de: un kilo de tomates, une bouteille d'eau, un peu de sel. Ask the price with c'est combien or ça coûte combien. The seller asks vous désirez, and you answer je voudrais.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un kilo de tomates</b><span style=\"opacity:.7;\"> · a kilo of tomatoes</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une bouteille d'eau</b><span style=\"opacity:.7;\"> · a bottle of water</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est combien ?</b><span style=\"opacity:.7;\"> · How much is it?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est tout.</b><span style=\"opacity:.7;\"> · That's all.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275968,"_nanoseconds":309000000}},{"id":"ZbC20fA4syZE21GbS0hd","level":"a1","lesson":8,"part":3,"type":"text","name":"a1-l08-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un kilo de tomates</b></p><p style=\"opacity:.75;margin:0;\">a kilo of tomatoes</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un kilo de tomates","size":null,"created":{"_seconds":1793275968,"_nanoseconds":322000000}},{"id":"7iLQpdiPrVGiizuNSAJq","level":"a1","lesson":8,"part":4,"type":"text","name":"a1-l08-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une bouteille d'eau</b></p><p style=\"opacity:.75;margin:0;\">a bottle of water</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Une bouteille d'eau","size":null,"created":{"_seconds":1793275968,"_nanoseconds":361000000}},{"id":"akTYFxGivoWAiZjvawl0","level":"a1","lesson":8,"part":5,"type":"text","name":"a1-l08-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est combien ?</b></p><p style=\"opacity:.75;margin:0;\">How much is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est combien ?","size":null,"created":{"_seconds":1793275968,"_nanoseconds":364000000}},{"id":"sbdcrMCfoQRXtS68zojD","level":"a1","lesson":8,"part":6,"type":"text","name":"a1-l08-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est tout.</b></p><p style=\"opacity:.75;margin:0;\">That's all.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est tout.","size":null,"created":{"_seconds":1793275968,"_nanoseconds":739000000}},{"id":"cuwsXnVr66RD97d1am91","level":"a1","lesson":8,"part":7,"type":"text","name":"a1-l08-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Qu'est-ce que je vous sers ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What can I get you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je voudrais un kilo de tomates, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a kilo of tomatoes, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà. Et avec ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. And with that?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Deux mangues et une bouteille d'eau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Two mangoes and a bottle of water.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, c'est tout. C'est combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, that's all. How much is it?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça fait douze euros cinquante.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's twelve euros fifty.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voilà. Merci, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Thank you, have a good day!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275968,"_nanoseconds":724000000}},{"id":"ubgLAmyprhNpezJAFsPT","level":"a1","lesson":8,"part":8,"type":"text","name":"a1-l08-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Qu'est-ce que je vous sers ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What can I get you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je voudrais un kilo de tomates, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a kilo of tomatoes, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je voudrais un kilo de tomates, s'il vous plaît.","size":null,"created":{"_seconds":1793275968,"_nanoseconds":767000000}},{"id":"G65HX9vYQeBzYAOSV9gk","level":"a1","lesson":8,"part":9,"type":"text","name":"a1-l08-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà. Et avec ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. And with that?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Deux mangues et une bouteille d'eau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Two mangoes and a bottle of water.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Deux mangues et une bouteille d'eau.","size":null,"created":{"_seconds":1793275968,"_nanoseconds":789000000}},{"id":"BZLcjxwLs852oMWwVNhd","level":"a1","lesson":8,"part":10,"type":"text","name":"a1-l08-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, c'est tout. C'est combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, that's all. How much is it?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, c'est tout. C'est combien ?","size":null,"created":{"_seconds":1793275969,"_nanoseconds":232000000}},{"id":"iQRu6oq7mWu1OppHsrqV","level":"a1","lesson":8,"part":11,"type":"text","name":"a1-l08-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça fait douze euros cinquante.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's twelve euros fifty.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Voilà. Merci, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Thank you, have a good day!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Voilà. Merci, bonne journée !","size":null,"created":{"_seconds":1793275969,"_nanoseconds":240000000}},{"id":"ErSRdVuAdHn8XEKWxMUP","level":"a1","lesson":8,"part":12,"type":"text","name":"a1-l08-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous êtes au marché. Que voulez-vous acheter ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You're at the market. What do you want to buy?</p><p><b>Buy two things with quantities and ask the price.</b></p><p style=\"opacity:.7;\">For example: “Je voudrais un kilo de tomates et une bouteille d'eau. C'est combien ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je voudrais un kilo de tomates et une bouteille d'eau. C'est combien ?","size":null,"created":{"_seconds":1793275969,"_nanoseconds":292000000}},{"id":"MEdg6VGnPH2pIEoQB0JW","level":"a1","lesson":8,"part":13,"type":"text","name":"a1-l08-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍅</div><p><b>Market ready!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can buy food with quantities and ask the price. Markets are great places to practise.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275969,"_nanoseconds":337000000}}]