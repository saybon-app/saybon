[{"id":"0FFHHUycZ5Mx3QiqDxjW","level":"a1","lesson":19,"part":1,"type":"text","name":"a1-l19-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today we talk about the seasons and celebrations. In France there are four seasons. In Ghana, you have the dry season and the rainy season. You will describe a celebration you love, with the food, the people and the activities.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275986,"_nanoseconds":847000000}},{"id":"dHXHMCn9NxNC1aFVCCB0","level":"a1","lesson":19,"part":2,"type":"text","name":"a1-l19-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎉</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Seasons and celebrations</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275986,"_nanoseconds":895000000}},{"id":"8dBUNpSjUbRQQJkXcU3x","level":"a1","lesson":19,"part":2,"type":"text","name":"a1-l19-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le printemps, l'été, l'automne, l'hiver. En été, in summer. Au printemps, in spring. Celebrations: Noël, Pâques, un anniversaire, un mariage. Use on fête, we celebrate, and on mange, on danse.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>En été, il fait chaud.</b><span style=\"opacity:.7;\"> · In summer, it's hot.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est la saison des pluies.</b><span style=\"opacity:.7;\"> · It's the rainy season.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On fête Noël en décembre.</b><span style=\"opacity:.7;\"> · We celebrate Christmas in December.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On mange et on danse.</b><span style=\"opacity:.7;\"> · We eat and we dance.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275986,"_nanoseconds":843000000}},{"id":"4HRHLNqIG9GKG6v5HlB1","level":"a1","lesson":19,"part":3,"type":"text","name":"a1-l19-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>En été, il fait chaud.</b></p><p style=\"opacity:.75;margin:0;\">In summer, it's hot.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"En été, il fait chaud.","size":null,"created":{"_seconds":1793275986,"_nanoseconds":936000000}},{"id":"8MQzggLXGcpR4DGuy9hS","level":"a1","lesson":19,"part":4,"type":"text","name":"a1-l19-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est la saison des pluies.</b></p><p style=\"opacity:.75;margin:0;\">It's the rainy season.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est la saison des pluies.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":407000000}},{"id":"SAY1CQ9WyILrzIuejoJS","level":"a1","lesson":19,"part":5,"type":"text","name":"a1-l19-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On fête Noël en décembre.</b></p><p style=\"opacity:.75;margin:0;\">We celebrate Christmas in December.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"On fête Noël en décembre.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":420000000}},{"id":"UtydZyeJ2HHPnLVuVzMx","level":"a1","lesson":19,"part":6,"type":"text","name":"a1-l19-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On mange et on danse.</b></p><p style=\"opacity:.75;margin:0;\">We eat and we dance.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"On mange et on danse.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":357000000}},{"id":"IllEyoXoDyS6lP7lKrOR","level":"a1","lesson":19,"part":7,"type":"text","name":"a1-l19-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle est votre saison préférée ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your favourite season?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime la saison sèche parce qu'il fait chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like the dry season because it's hot.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle fête vous aimez le plus ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which celebration do you like most?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime Noël. On fête Noël en décembre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like Christmas. We celebrate Christmas in December.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous faites ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>On mange ensemble et on danse.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We eat together and we dance.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qui vient à la fête ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Who comes to the party?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ma famille et mes amis viennent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My family and my friends come.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275987,"_nanoseconds":422000000}},{"id":"1V9Up1KDsskO2CDiUkfu","level":"a1","lesson":19,"part":8,"type":"text","name":"a1-l19-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle est votre saison préférée ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your favourite season?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime la saison sèche parce qu'il fait chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like the dry season because it's hot.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime la saison sèche parce qu'il fait chaud.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":799000000}},{"id":"NPRExfBwUit1rsMeLEDL","level":"a1","lesson":19,"part":9,"type":"text","name":"a1-l19-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle fête vous aimez le plus ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which celebration do you like most?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime Noël. On fête Noël en décembre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like Christmas. We celebrate Christmas in December.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime Noël. On fête Noël en décembre.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":820000000}},{"id":"eFBq9Vt4W1rX1mKtdFVD","level":"a1","lesson":19,"part":10,"type":"text","name":"a1-l19-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous faites ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">On mange ensemble et on danse.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We eat together and we dance.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"On mange ensemble et on danse.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":816000000}},{"id":"7tgq4nCZbvq7MTEGrZsU","level":"a1","lesson":19,"part":11,"type":"text","name":"a1-l19-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qui vient à la fête ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Who comes to the party?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ma famille et mes amis viennent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My family and my friends come.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ma famille et mes amis viennent.","size":null,"created":{"_seconds":1793275987,"_nanoseconds":820000000}},{"id":"P2mJnRzRhSiPHFRPzWGu","level":"a1","lesson":19,"part":12,"type":"text","name":"a1-l19-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez une fête que vous aimez.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe a celebration you like.</p><p><b>Say which celebration, when, and what you do.</b></p><p style=\"opacity:.7;\">For example: “On fête Noël en décembre. On mange ensemble et on danse.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"On fête Noël en décembre. On mange ensemble et on danse.","size":null,"created":{"_seconds":1793275988,"_nanoseconds":593000000}},{"id":"moYVSnaEbfNSF4BBrBzq","level":"a1","lesson":19,"part":13,"type":"text","name":"a1-l19-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎉</div><p><b>Celebration time!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe seasons and celebrations. Culture is part of language.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275988,"_nanoseconds":540000000}}]