[{"id":"ZHhdUg8b5Gcl3HgahaLj","level":"a1","lesson":1,"part":1,"type":"text","name":"a1-l01-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bienvenue ! Welcome to level A1. Today we start with the most useful thing in any language: introducing yourself. You already know a few words. Now we put them together into a proper introduction, with your name, where you are from, your age and what you do. Listen first, then speak.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275955,"_nanoseconds":818000000}},{"id":"azffBFZ9IqgKPFoaZ9zA","level":"a1","lesson":1,"part":2,"type":"text","name":"a1-l01-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙋</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Introducing yourself</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275955,"_nanoseconds":867000000}},{"id":"eq3mH4xklMqHpVKPMei1","level":"a1","lesson":1,"part":2,"type":"text","name":"a1-l01-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To introduce yourself you chain short sentences: je m'appelle for your name, je viens de for your origin, j'ai ... ans for your age, je suis for your job. Add j'habite à for where you live.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je m'appelle Alex.</b><span style=\"opacity:.7;\"> · My name is Alex.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je viens du Ghana.</b><span style=\"opacity:.7;\"> · I come from Ghana.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai vingt-cinq ans.</b><span style=\"opacity:.7;\"> · I am twenty-five.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'habite à Accra.</b><span style=\"opacity:.7;\"> · I live in Accra.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275955,"_nanoseconds":866000000}},{"id":"Frsy7cqs2BrwjruX0nCy","level":"a1","lesson":1,"part":3,"type":"text","name":"a1-l01-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je m'appelle Alex.</b></p><p style=\"opacity:.75;margin:0;\">My name is Alex.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275955,"_nanoseconds":871000000}},{"id":"E4jULNip7YVeXAGc8qR7","level":"a1","lesson":1,"part":4,"type":"text","name":"a1-l01-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je viens du Ghana.</b></p><p style=\"opacity:.75;margin:0;\">I come from Ghana.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je viens du Ghana.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":256000000}},{"id":"C5g4AQOm4WBBWDA8lbCO","level":"a1","lesson":1,"part":5,"type":"text","name":"a1-l01-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai vingt-cinq ans.</b></p><p style=\"opacity:.75;margin:0;\">I am twenty-five.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai vingt-cinq ans.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":269000000}},{"id":"98eHAJb0HrfX2Rxr5970","level":"a1","lesson":1,"part":6,"type":"text","name":"a1-l01-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'habite à Accra.</b></p><p style=\"opacity:.75;margin:0;\">I live in Accra.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'habite à Accra.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":298000000}},{"id":"15i3ZjQmR5IwGXSxnDxP","level":"a1","lesson":1,"part":7,"type":"text","name":"a1-l01-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What is your name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Enchantée, Alex. D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex. Where are you from?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je viens du Ghana, mais j'habite à Accra.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana, but I live in Accra.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai vingt-cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty-five.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et qu'est-ce que vous faites dans la vie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what do you do for a living?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis professeur. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am a teacher. And you?</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275956,"_nanoseconds":318000000}},{"id":"8UkHY0ZqHQgp3fcqtH0C","level":"a1","lesson":1,"part":8,"type":"text","name":"a1-l01-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What is your name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":747000000}},{"id":"Qpi7tOwoIfzt2vMhUTQt","level":"a1","lesson":1,"part":9,"type":"text","name":"a1-l01-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Enchantée, Alex. D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex. Where are you from?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je viens du Ghana, mais j'habite à Accra.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana, but I live in Accra.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je viens du Ghana, mais j'habite à Accra.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":855000000}},{"id":"w7pHzmqJw8FAEUaaASfF","level":"a1","lesson":1,"part":10,"type":"text","name":"a1-l01-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai vingt-cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty-five.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai vingt-cinq ans.","size":null,"created":{"_seconds":1793275956,"_nanoseconds":752000000}},{"id":"FLrwNZGk2b71lvgSvgIB","level":"a1","lesson":1,"part":11,"type":"text","name":"a1-l01-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et qu'est-ce que vous faites dans la vie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what do you do for a living?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis professeur. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am a teacher. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis professeur. Et vous ?","size":null,"created":{"_seconds":1793275956,"_nanoseconds":793000000}},{"id":"aBbRmKDD8kslnB5twRaV","level":"a1","lesson":1,"part":12,"type":"text","name":"a1-l01-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Présentez-vous !</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Introduce yourself!</p><p><b>Give your name, origin, age and job in four sentences.</b></p><p style=\"opacity:.7;\">For example: “Je m'appelle Alex. Je viens du Ghana. J'ai vingt-cinq ans. Je suis professeur.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je m'appelle Alex. Je viens du Ghana. J'ai vingt-cinq ans. Je suis professeur.","size":null,"created":{"_seconds":1793275957,"_nanoseconds":362000000}},{"id":"kMNNeuHh9Hnq3pKdJIwW","level":"a1","lesson":1,"part":13,"type":"text","name":"a1-l01-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙋</div><p><b>Introduction complete!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can now give a full introduction in four sentences. This is the base for every conversation in A1.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275957,"_nanoseconds":265000000}}]