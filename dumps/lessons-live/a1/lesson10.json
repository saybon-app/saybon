[{"id":"nrs90EdPQ1BnvdsjIv0i","level":"a1","lesson":10,"part":1,"type":"text","name":"a1-l10-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you travel. You buy a ticket, ask about a time, and understand announcements. We use the numbers and times you already know. The new words are un billet, un aller simple, un aller-retour and le quai.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275971,"_nanoseconds":233000000}},{"id":"M1azVcsQlXRTdfFJDVq9","level":"a1","lesson":10,"part":2,"type":"text","name":"a1-l10-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🚆</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Transport</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275971,"_nanoseconds":193000000}},{"id":"maBRmcGCnBs4a9Jnd13M","level":"a1","lesson":10,"part":2,"type":"text","name":"a1-l10-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je voudrais un billet pour Lyon. Un aller simple is one way, un aller-retour is a return. Ask the time of the train with à quelle heure part le train. The platform is le quai.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un billet pour Lyon</b><span style=\"opacity:.7;\"> · a ticket to Lyon</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un aller-retour</b><span style=\"opacity:.7;\"> · a return ticket</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le train part à quelle heure ?</b><span style=\"opacity:.7;\"> · What time does the train leave?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le quai numéro trois</b><span style=\"opacity:.7;\"> · platform three</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275971,"_nanoseconds":618000000}},{"id":"Id8f7HhNjCUiLzn96F2U","level":"a1","lesson":10,"part":3,"type":"text","name":"a1-l10-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un billet pour Lyon</b></p><p style=\"opacity:.75;margin:0;\">a ticket to Lyon</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un billet pour Lyon","size":null,"created":{"_seconds":1793275971,"_nanoseconds":629000000}},{"id":"Es9SfTM2DeBLsq2vBvhK","level":"a1","lesson":10,"part":4,"type":"text","name":"a1-l10-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un aller-retour</b></p><p style=\"opacity:.75;margin:0;\">a return ticket</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un aller-retour","size":null,"created":{"_seconds":1793275971,"_nanoseconds":633000000}},{"id":"5dglAlmjMgZPIoqsU01M","level":"a1","lesson":10,"part":5,"type":"text","name":"a1-l10-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le train part à quelle heure ?</b></p><p style=\"opacity:.75;margin:0;\">What time does the train leave?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le train part à quelle heure ?","size":null,"created":{"_seconds":1793275971,"_nanoseconds":639000000}},{"id":"1pcCXafaYAHUDD0tbgwz","level":"a1","lesson":10,"part":6,"type":"text","name":"a1-l10-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le quai numéro trois</b></p><p style=\"opacity:.75;margin:0;\">platform three</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le quai numéro trois","size":null,"created":{"_seconds":1793275972,"_nanoseconds":351000000}},{"id":"5dv7IkWPhzYGn0qzMIP8","level":"a1","lesson":10,"part":7,"type":"text","name":"a1-l10-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je voudrais un billet pour Lyon, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I would like a ticket to Lyon, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Un aller simple ou un aller-retour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">One way or return?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Un aller-retour, s'il vous plaît. Le train part à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">A return, please. What time does the train leave?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il part à quinze heures dix, quai numéro trois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It leaves at 15:10, from platform three.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quai numéro trois, d'accord. C'est combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Platform three, all right. How much?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quarante-cinq euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Forty-five euros.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voilà. Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Thank you very much!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275972,"_nanoseconds":460000000}},{"id":"7n3byfHHtewr6lss8Lc8","level":"a1","lesson":10,"part":8,"type":"text","name":"a1-l10-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je voudrais un billet pour Lyon, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I would like a ticket to Lyon, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je voudrais un billet pour Lyon, s'il vous plaît.","size":null,"created":{"_seconds":1793275972,"_nanoseconds":373000000}},{"id":"p7NR6cyuQW2CUUCHa6nR","level":"a1","lesson":10,"part":9,"type":"text","name":"a1-l10-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Un aller simple ou un aller-retour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">One way or return?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Un aller-retour, s'il vous plaît. Le train part à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">A return, please. What time does the train leave?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Un aller-retour, s'il vous plaît. Le train part à quelle heure ?","size":null,"created":{"_seconds":1793275972,"_nanoseconds":414000000}},{"id":"uK9SIsGxRkjPYcdvnQNy","level":"a1","lesson":10,"part":10,"type":"text","name":"a1-l10-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il part à quinze heures dix, quai numéro trois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It leaves at 15:10, from platform three.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Quai numéro trois, d'accord. C'est combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Platform three, all right. How much?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Quai numéro trois, d'accord. C'est combien ?","size":null,"created":{"_seconds":1793275972,"_nanoseconds":867000000}},{"id":"7aCwmHiya60CE9CWwzgU","level":"a1","lesson":10,"part":11,"type":"text","name":"a1-l10-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quarante-cinq euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Forty-five euros.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Voilà. Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Thank you very much!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Voilà. Merci beaucoup !","size":null,"created":{"_seconds":1793275972,"_nanoseconds":819000000}},{"id":"zKX9Yqn7qbdpKdqNpxim","level":"a1","lesson":10,"part":12,"type":"text","name":"a1-l10-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Achetez un billet de train.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Buy a train ticket.</p><p><b>Ask for a ticket, say one-way or return, and ask the time.</b></p><p style=\"opacity:.7;\">For example: “Je voudrais un aller-retour pour Lyon. Le train part à quelle heure ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je voudrais un aller-retour pour Lyon. Le train part à quelle heure ?","size":null,"created":{"_seconds":1793275972,"_nanoseconds":821000000}},{"id":"qbIBRzbLomedXsmw4WGU","level":"a1","lesson":10,"part":13,"type":"text","name":"a1-l10-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🚆</div><p><b>All aboard!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can buy a ticket and ask times. Travel in French is now much less stressful.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275972,"_nanoseconds":870000000}}]