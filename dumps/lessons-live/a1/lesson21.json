[{"id":"XOMNczFcYlSSn1gcFlPq","level":"a1","lesson":21,"part":1,"type":"text","name":"a1-l21-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you use the telephone. On the phone, you cannot see the other person, so clear phrases matter. You'll introduce yourself, ask for someone, and make an appointment. Take it slowly.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275990,"_nanoseconds":540000000}},{"id":"NB5JuNKq0IthcPgetiO9","level":"a1","lesson":21,"part":2,"type":"text","name":"a1-l21-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📞</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">On the phone</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275990,"_nanoseconds":534000000}},{"id":"AUWThrETTpf2sCaiMPaV","level":"a1","lesson":21,"part":2,"type":"text","name":"a1-l21-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Allô, bonjour, je m'appelle Alex. Je voudrais parler à Madame Diallo. Je voudrais prendre rendez-vous. Quel jour vous convient ? Lundi à dix heures, ça vous va ? Pouvez-vous répéter ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais prendre rendez-vous.</b><span style=\"opacity:.7;\"> · I'd like to make an appointment.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça vous va ?</b><span style=\"opacity:.7;\"> · Does that suit you?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pouvez-vous répéter ?</b><span style=\"opacity:.7;\"> · Can you repeat?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je vous rappelle.</b><span style=\"opacity:.7;\"> · I'll call you back.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275990,"_nanoseconds":532000000}},{"id":"Nb8yWpq7we3FcwI7fLTG","level":"a1","lesson":21,"part":3,"type":"text","name":"a1-l21-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais prendre rendez-vous.</b></p><p style=\"opacity:.75;margin:0;\">I'd like to make an appointment.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais prendre rendez-vous.","size":null,"created":{"_seconds":1793275990,"_nanoseconds":619000000}},{"id":"2hoKFiUWMc7bxCGqAmBY","level":"a1","lesson":21,"part":4,"type":"text","name":"a1-l21-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça vous va ?</b></p><p style=\"opacity:.75;margin:0;\">Does that suit you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça vous va ?","size":null,"created":{"_seconds":1793275990,"_nanoseconds":946000000}},{"id":"catC5Wkz7MBpC27jJ2w1","level":"a1","lesson":21,"part":5,"type":"text","name":"a1-l21-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pouvez-vous répéter ?</b></p><p style=\"opacity:.75;margin:0;\">Can you repeat?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pouvez-vous répéter ?","size":null,"created":{"_seconds":1793275990,"_nanoseconds":944000000}},{"id":"YYZs0SOR3K04ARiVvHtm","level":"a1","lesson":21,"part":6,"type":"text","name":"a1-l21-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je vous rappelle.</b></p><p style=\"opacity:.75;margin:0;\">I'll call you back.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je vous rappelle.","size":null,"created":{"_seconds":1793275990,"_nanoseconds":955000000}},{"id":"zVdjW20KNQK7gXQQ39mJ","level":"a1","lesson":21,"part":7,"type":"text","name":"a1-l21-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Cabinet du docteur Diallo, bonjour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Doctor Diallo's office, hello.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour, je voudrais prendre rendez-vous, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, I would like to make an appointment, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Quel jour vous convient ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Which day suits you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Lundi, si possible.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Monday, if possible.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Lundi à dix heures, ça vous va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Monday at ten, does that suit you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, c'est parfait.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, that's perfect.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quel est votre nom ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex Mensah. Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex Mensah. Thank you, goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275991,"_nanoseconds":14000000}},{"id":"TocgWGbi0WlZonigsSnB","level":"a1","lesson":21,"part":8,"type":"text","name":"a1-l21-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Cabinet du docteur Diallo, bonjour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Doctor Diallo's office, hello.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour, je voudrais prendre rendez-vous, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, I would like to make an appointment, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour, je voudrais prendre rendez-vous, s'il vous plaît.","size":null,"created":{"_seconds":1793275991,"_nanoseconds":360000000}},{"id":"0FElH6KpFZBGltW62lD5","level":"a1","lesson":21,"part":9,"type":"text","name":"a1-l21-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Quel jour vous convient ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Which day suits you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Lundi, si possible.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Monday, if possible.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Lundi, si possible.","size":null,"created":{"_seconds":1793275991,"_nanoseconds":358000000}},{"id":"HWAbs1Ybvz0S71WdFv50","level":"a1","lesson":21,"part":10,"type":"text","name":"a1-l21-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Lundi à dix heures, ça vous va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Monday at ten, does that suit you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, c'est parfait.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, that's perfect.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, c'est parfait.","size":null,"created":{"_seconds":1793275991,"_nanoseconds":411000000}},{"id":"1I5Jz9WWZAZKXPhIkj4T","level":"a1","lesson":21,"part":11,"type":"text","name":"a1-l21-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quel est votre nom ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex Mensah. Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex Mensah. Thank you, goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex Mensah. Merci, au revoir !","size":null,"created":{"_seconds":1793275991,"_nanoseconds":437000000}},{"id":"Hm6Xg1dhSFZNbwhgljuc","level":"a1","lesson":21,"part":12,"type":"text","name":"a1-l21-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Appelez pour prendre rendez-vous.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Call to make an appointment.</p><p><b>Ask for an appointment, suggest a day and give your name.</b></p><p style=\"opacity:.7;\">For example: “Bonjour, je voudrais prendre rendez-vous lundi à dix heures. Je m'appelle Alex.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Bonjour, je voudrais prendre rendez-vous lundi à dix heures. Je m'appelle Alex.","size":null,"created":{"_seconds":1793275991,"_nanoseconds":865000000}},{"id":"3TW2xcvmlhKKNtbi90pn","level":"a1","lesson":21,"part":13,"type":"text","name":"a1-l21-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📞</div><p><b>Phone confident!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can make an appointment by phone. That is real independence in French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275991,"_nanoseconds":868000000}}]