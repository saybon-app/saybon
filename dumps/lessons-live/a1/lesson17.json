ed":{"_seconds":1793275984,"_nanoseconds":450000000}},{"id":"u1l6qcbHIwJ9s7YIbjtU","level":"a1","lesson":17,"part":12,"type":"text","name":"a1-l17-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Quels sont vos projets pour demain ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What are your plans for tomorrow?</p><p><b>Say three things you're going to do.</b></p><p style=\"opacity:.7;\">For example: “Demain, je vais travailler. Ce soir, je vais regarder un film.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Demain, je vais travailler. Ce soir, je vais regarder un film.","size":null,"created":{"_seconds":1793275984,"_nanoseconds":900000000}},{"id":"zzE9j3jnV8ggv4ZBtKc8","level":"a1","lesson":17,"part":13,"type":"text","name":"a1-l17-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔜</div><p><b>Plans in motion!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about your plans with aller plus infinitive. One of the most useful structures in French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275984,"_nanoseconds":953000000}}]