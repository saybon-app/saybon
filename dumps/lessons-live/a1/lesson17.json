[{"id":"EleEeS3bHN4nDKC63KQE","level":"a1","lesson":17,"part":1,"type":"text","name":"a1-l17-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Now we look forward. The near future is easy: aller plus the infinitive. Je vais manger, I'm going to eat. With this tool, you can talk about tomorrow, next week, and your plans with confidence.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275983,"_nanoseconds":489000000}},{"id":"XlG4o3CGoX59DHZTpUUi","level":"a1","lesson":17,"part":2,"type":"text","name":"a1-l17-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔜</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Near future</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275983,"_nanoseconds":522000000}},{"id":"SzoYtMCLYiZKDiPehDVb","level":"a1","lesson":17,"part":2,"type":"text","name":"a1-l17-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je vais + infinitive. Je vais travailler, tu vas partir, il va manger, nous allons voyager. Time words: demain, ce soir, la semaine prochaine, dans deux jours.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je vais travailler demain.</b><span style=\"opacity:.7;\"> · I'm going to work tomorrow.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On va manger ensemble.</b><span style=\"opacity:.7;\"> · We're going to eat together.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle va partir ce soir.</b><span style=\"opacity:.7;\"> · She's going to leave tonight.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous allons voyager.</b><span style=\"opacity:.7;\"> · We're going to travel.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275983,"_nanoseconds":520000000}},{"id":"oDXoIEShmaQUHAGUa6IK","level":"a1","lesson":17,"part":3,"type":"text","name":"a1-l17-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je vais travailler demain.</b></p><p style=\"opacity:.75;margin:0;\">I'm going to work tomorrow.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je vais travailler demain.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":539000000}},{"id":"ws8JpFJxmtYdzdylzBqa","level":"a1","lesson":17,"part":4,"type":"text","name":"a1-l17-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On va manger ensemble.</b></p><p style=\"opacity:.75;margin:0;\">We're going to eat together.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"On va manger ensemble.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":994000000}},{"id":"48aI7knPuMQhAjGqHIWj","level":"a1","lesson":17,"part":5,"type":"text","name":"a1-l17-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle va partir ce soir.</b></p><p style=\"opacity:.75;margin:0;\">She's going to leave tonight.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle va partir ce soir.","size":null,"created":{"_seconds":1793275984,"_nanoseconds":26000000}},{"id":"CZOkqxgdv4XAWTuHaanb","level":"a1","lesson":17,"part":6,"type":"text","name":"a1-l17-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous allons voyager.</b></p><p style=\"opacity:.75;margin:0;\">We're going to travel.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous allons voyager.","size":null,"created":{"_seconds":1793275983,"_nanoseconds":977000000}},{"id":"1Z5szMaFLEp1io1ngAGO","level":"a1","lesson":17,"part":7,"type":"text","name":"a1-l17-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous allez faire demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What are you going to do tomorrow?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Demain, je vais travailler le matin.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tomorrow I'm going to work in the morning.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et l'après-midi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the afternoon?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je vais faire du sport avec mon frère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm going to do sport with my brother.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ce soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And tonight?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce soir, je vais regarder un film.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tonight I'm going to watch a film.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le week-end ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the weekend?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Le week-end, nous allons voyager à Cape Coast.</b><br><span style=\"opacity:.7;font-size:.9rem;\">At the weekend, we're going to travel to Cape Coast.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275983,"_nanoseconds":994000000}},{"id":"Y9hWbPWwwaUxNwnb9PEF","level":"a1","lesson":17,"part":8,"type":"text","name":"a1-l17-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous allez faire demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What are you going to do tomorrow?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Demain, je vais travailler le matin.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tomorrow I'm going to work in the morning.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Demain, je vais travailler le matin.","size":null,"created":{"_seconds":1793275984,"_nanoseconds":399000000}},{"id":"OzWK0j6iYIikHTpdJgo2","level":"a1","lesson":17,"part":9,"type":"text","name":"a1-l17-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et l'après-midi ?</b><br><span style=\"opacit