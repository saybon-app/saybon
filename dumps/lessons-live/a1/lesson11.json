[{"id":"kR5QL6SxKGdJilJwIyJd","level":"a1","lesson":11,"part":1,"type":"text","name":"a1-l11-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you ask your way and give directions. You know où est from the beginner course. Now you add more direction words and understand answers. Listen for tourner, traverser and continuer.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275973,"_nanoseconds":335000000}},{"id":"cT9vIR2aXFvIlsSwH7WK","level":"a1","lesson":11,"part":2,"type":"text","name":"a1-l11-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧭</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Asking directions</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275973,"_nanoseconds":330000000}},{"id":"ggiGnuvd2m6efPMjGwKP","level":"a1","lesson":11,"part":2,"type":"text","name":"a1-l11-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Tout droit, straight on. Tournez à gauche or à droite. Traversez la rue, cross the street. Prenez la première rue à gauche. C'est en face de, opposite; à côté de, next to; au coin, on the corner.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Continuez tout droit.</b><span style=\"opacity:.7;\"> · Keep going straight.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tournez à droite.</b><span style=\"opacity:.7;\"> · Turn right.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Traversez la place.</b><span style=\"opacity:.7;\"> · Cross the square.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est à côté de la banque.</b><span style=\"opacity:.7;\"> · It's next to the bank.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275973,"_nanoseconds":335000000}},{"id":"9bm8nfYubRelsvMzv4AG","level":"a1","lesson":11,"part":3,"type":"text","name":"a1-l11-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Continuez tout droit.</b></p><p style=\"opacity:.75;margin:0;\">Keep going straight.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Continuez tout droit.","size":null,"created":{"_seconds":1793275973,"_nanoseconds":330000000}},{"id":"abwGWKdGIgu12Hj94VcQ","level":"a1","lesson":11,"part":4,"type":"text","name":"a1-l11-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tournez à droite.</b></p><p style=\"opacity:.75;margin:0;\">Turn right.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tournez à droite.","size":null,"created":{"_seconds":1793275973,"_nanoseconds":802000000}},{"id":"GXJS0qBuPZnpaKJRbqeZ","level":"a1","lesson":11,"part":5,"type":"text","name":"a1-l11-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Traversez la place.</b></p><p style=\"opacity:.75;margin:0;\">Cross the square.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Traversez la place.","size":null,"created":{"_seconds":1793275973,"_nanoseconds":753000000}},{"id":"YZTzC2JT3ZH3emyfineA","level":"a1","lesson":11,"part":6,"type":"text","name":"a1-l11-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est à côté de la banque.</b></p><p style=\"opacity:.75;margin:0;\">It's next to the bank.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est à côté de la banque.","size":null,"created":{"_seconds":1793275973,"_nanoseconds":770000000}},{"id":"SAOAgLKjb5Xjz0Ffy4ee","level":"a1","lesson":11,"part":7,"type":"text","name":"a1-l11-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Can I help you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Excusez-moi, où est la poste, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, where is the post office, please?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Continuez tout droit, puis tournez à gauche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Keep going straight, then turn left.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tout droit, puis à gauche. C'est loin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Straight, then left. Is it far?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Non, c'est à cinq minutes. C'est à côté de la banque.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, it's five minutes away. It's next to the bank.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À côté de la banque, très bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Next to the bank, very good.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous traversez la place et c'est là.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You cross the square and it's there.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much, goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275973,"_nanoseconds":756000000}},{"id":"3HZRApiK16gxlfegQYKk","level":"a1","lesson":11,"part":8,"type":"text","name":"a1-l11-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Can I help you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Excusez-moi, où est la poste, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, where is the post office, please?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Excusez-moi, où est la poste, s'il vous plaît ?","size":null,"created":{"_seconds":1793275974,"_nanoseconds":264000000}},{"id":"gkUkcoSqzGk5sAq6EzSK","level":"a1","lesson":11,"part":9,"type":"text","name":"a1-l11-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Continuez tout droit, puis tournez à gauche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Keep going straight, then turn left.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tout droit, puis à gauche. C'est loin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Straight, then left. Is it far?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Tout droit, puis à gauche. C'est loin ?","size":null,"created":{"_seconds":1793275974,"_nanoseconds":250000000}},{"id":"660Xh8gqLZ2tSzaDEltu","level":"a1","lesson":11,"part":10,"type":"text","name":"a1-l11-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Non, c'est à cinq minutes. C'est à côté de la banque.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, it's five minutes away. It's next to the bank.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À côté de la banque, très bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Next to the bank, very good.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À côté de la banque, très bien.","size":null,"created":{"_seconds":1793275974,"_nanoseconds":251000000}},{"id":"ffQXsGTZdCPoFXAfhdju","level":"a1","lesson":11,"part":11,"type":"text","name":"a1-l11-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous traversez la place et c'est là.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You cross the square and it's there.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much, goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup, au revoir !","size":null,"created":{"_seconds":1793275974,"_nanoseconds":251000000}},{"id":"e5r2Nj1pMSNfjb3WEne3","level":"a1","lesson":11,"part":12,"type":"text","name":"a1-l11-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Un touriste cherche la gare. Aidez-le.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">A tourist is looking for the station. Help them.</p><p><b>Give directions: go straight, turn, say what it's next to.</b></p><p style=\"opacity:.7;\">For example: “Continuez tout droit, puis tournez à droite. La gare est à côté de la banque.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Continuez tout droit, puis tournez à droite. La gare est à côté de la banque.","size":null,"created":{"_seconds":1793275974,"_nanoseconds":759000000}},{"id":"idBEmOUglYNisNY9EpKh","level":"a1","lesson":11,"part":13,"type":"text","name":"a1-l11-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧭</div><p><b>Navigator!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can ask for and give directions. A very practical skill, in both directions.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275974,"_nanoseconds":809000000}}]