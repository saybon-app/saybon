[{"id":"mfSIXxzAHss5gLePsQyk","level":"a1","lesson":23,"part":1,"type":"text","name":"a1-l23-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you give reasons. So far you said what you like. Now you say why, with parce que, because. A reason makes your speech much richer and more natural, and it is easy to add.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275993,"_nanoseconds":882000000}},{"id":"RVkpvVv0UVe8EYwAMaxG","level":"a1","lesson":23,"part":2,"type":"text","name":"a1-l23-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💬</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Expressing tastes</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275993,"_nanoseconds":901000000}},{"id":"kJvCcbe1RrZVoQH0IyXv","level":"a1","lesson":23,"part":2,"type":"text","name":"a1-l23-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Parce que gives a reason. J'aime le Ghana parce que les gens sont gentils. Pourquoi ? is why. Answer with parce que. Use aussi, également, and mais to add or contrast.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pourquoi ?</b><span style=\"opacity:.7;\"> · Why?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Parce que c'est facile.</b><span style=\"opacity:.7;\"> · Because it's easy.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'adore la cuisine parce qu'elle est bonne.</b><span style=\"opacity:.7;\"> · I love the cuisine because it's good.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mais je n'aime pas le froid.</b><span style=\"opacity:.7;\"> · But I don't like the cold.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275993,"_nanoseconds":913000000}},{"id":"sWaYZkoNp7mf4uHEb8au","level":"a1","lesson":23,"part":3,"type":"text","name":"a1-l23-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pourquoi ?</b></p><p style=\"opacity:.75;margin:0;\">Why?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pourquoi ?","size":null,"created":{"_seconds":1793275993,"_nanoseconds":900000000}},{"id":"a8juKPF5xkak80pDe7UZ","level":"a1","lesson":23,"part":4,"type":"text","name":"a1-l23-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Parce que c'est facile.</b></p><p style=\"opacity:.75;margin:0;\">Because it's easy.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Parce que c'est facile.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":327000000}},{"id":"0VsHpoPMI1N1SYzJuJE0","level":"a1","lesson":23,"part":5,"type":"text","name":"a1-l23-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'adore la cuisine parce qu'elle est bonne.</b></p><p style=\"opacity:.75;margin:0;\">I love the cuisine because it's good.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'adore la cuisine parce qu'elle est bonne.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":343000000}},{"id":"F4ue6ja3mNNg1WdkeLYm","level":"a1","lesson":23,"part":6,"type":"text","name":"a1-l23-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mais je n'aime pas le froid.</b></p><p style=\"opacity:.75;margin:0;\">But I don't like the cold.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Mais je n'aime pas le froid.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":329000000}},{"id":"U6hCdmF3sSDYJFog9XAm","level":"a1","lesson":23,"part":7,"type":"text","name":"a1-l23-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous aimez votre ville ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like your city?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'aime ma ville parce qu'elle est animée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like my city because it's lively.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous aimez le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you like French?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'adore le français parce que c'est une belle langue.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I love French because it's a beautiful language.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi vous apprenez le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why are you learning French?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Parce que je veux voyager en France.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Because I want to travel to France.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous aimez le froid ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like the cold?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je n'aime pas le froid parce que j'ai toujours froid !</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't like the cold because I'm always cold!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275994,"_nanoseconds":325000000}},{"id":"ABP1rquHMhYDBWEQVgeU","level":"a1","lesson":23,"part":8,"type":"text","name":"a1-l23-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous aimez votre ville ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like your city?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'aime ma ville parce qu'elle est animée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like my city because it's lively.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'aime ma ville parce qu'elle est animée.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":737000000}},{"id":"OM9t6K2FeuysZQlp0Ep1","level":"a1","lesson":23,"part":9,"type":"text","name":"a1-l23-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous aimez le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you like French?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'adore le français parce que c'est une belle langue.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I love French because it's a beautiful language.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'adore le français parce que c'est une belle langue.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":741000000}},{"id":"s6yXRpKY5ZrgaCkfw1lK","level":"a1","lesson":23,"part":10,"type":"text","name":"a1-l23-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi vous apprenez le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why are you learning French?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Parce que je veux voyager en France.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Because I want to travel to France.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Parce que je veux voyager en France.","size":null,"created":{"_seconds":1793275994,"_nanoseconds":739000000}},{"id":"binTLXj035NFRgCT9uyQ","level":"a1","lesson":23,"part":11,"type":"text","name":"a1-l23-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous aimez le froid ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like the cold?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je n'aime pas le froid parce que j'ai toujours froid !</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't like the cold because I'm always cold!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je n'aime pas le froid parce que j'ai toujours froid !","size":null,"created":{"_seconds":1793275994,"_nanoseconds":738000000}},{"id":"hsyCRFPxUPgCCrlUxP60","level":"a1","lesson":23,"part":12,"type":"text","name":"a1-l23-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Pourquoi apprenez-vous le français ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Why are you learning French?</p><p><b>Give a reason, then one thing you like and why.</b></p><p style=\"opacity:.7;\">For example: “J'apprends le français parce que j'aime voyager. J'aime Paris parce que c'est beau.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'apprends le français parce que j'aime voyager. J'aime Paris parce que c'est beau.","size":null,"created":{"_seconds":1793275995,"_nanoseconds":401000000}},{"id":"qQOwCg5S8D9K6JZRX1eU","level":"a1","lesson":23,"part":13,"type":"text","name":"a1-l23-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💬</div><p><b>Reasons given!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can give reasons with parce que. Your speech now sounds more complete.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275995,"_nanoseconds":379000000}}]