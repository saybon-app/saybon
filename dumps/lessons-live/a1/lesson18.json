[{"id":"vqfjbbVw0uGeLEwQUPMH","level":"a1","lesson":18,"part":1,"type":"text","name":"a1-l18-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you compare things: bigger, smaller, as good as. The words are plus, moins and aussi, and they work with adjectives. You will compare cities, people and things around you.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275984,"_nanoseconds":919000000}},{"id":"Zksyuo1V8X7hSuMBzu4a","level":"a1","lesson":18,"part":2,"type":"text","name":"a1-l18-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚖️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Comparing</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275984,"_nanoseconds":916000000}},{"id":"KiJBo7ZiSPiK7BVrgTIj","level":"a1","lesson":18,"part":2,"type":"text","name":"a1-l18-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Plus + adjective + que means more than. Moins + adjective + que means less than. Aussi + adjective + que means as ... as. Irregulars: meilleur, better, and mieux, better as an adverb.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est plus grand que moi.</b><span style=\"opacity:.7;\"> · He is taller than me.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Cette robe est moins chère.</b><span style=\"opacity:.7;\"> · This dress is cheaper.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle est aussi sympa que lui.</b><span style=\"opacity:.7;\"> · She is as nice as him.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est meilleur.</b><span style=\"opacity:.7;\"> · It's better.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275985,"_nanoseconds":465000000}},{"id":"enh0bFzfFtPgztJHgJUO","level":"a1","lesson":18,"part":3,"type":"text","name":"a1-l18-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est plus grand que moi.</b></p><p style=\"opacity:.75;margin:0;\">He is taller than me.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est plus grand que moi.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":417000000}},{"id":"otojm8CGLJHQedaIfY7a","level":"a1","lesson":18,"part":4,"type":"text","name":"a1-l18-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Cette robe est moins chère.</b></p><p style=\"opacity:.75;margin:0;\">This dress is cheaper.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Cette robe est moins chère.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":415000000}},{"id":"irEwE27MT4NRn0bV1whg","level":"a1","lesson":18,"part":5,"type":"text","name":"a1-l18-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle est aussi sympa que lui.</b></p><p style=\"opacity:.75;margin:0;\">She is as nice as him.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle est aussi sympa que lui.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":418000000}},{"id":"pExoutkB4DYbeQ8dN4Zy","level":"a1","lesson":18,"part":6,"type":"text","name":"a1-l18-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est meilleur.</b></p><p style=\"opacity:.75;margin:0;\">It's better.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est meilleur.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":927000000}},{"id":"g6J6XK7EJO2vEHnYdcD3","level":"a1","lesson":18,"part":7,"type":"text","name":"a1-l18-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Regardez ces deux sacs. Lequel est plus grand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at these two bags. Which is bigger?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Le sac rouge est plus grand que le sac noir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The red bag is bigger than the black bag.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et lequel est moins cher ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And which is cheaper?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Le sac noir est moins cher.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The black bag is cheaper.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre ville est plus grande que Kumasi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Is your city bigger than Kumasi?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Accra est plus grande, mais Kumasi est aussi belle.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Accra is bigger, but Kumasi is just as beautiful.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le riz, c'est meilleur que le pain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And rice, is it better than bread?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Pour moi, c'est meilleur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For me, it's better.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275985,"_nanoseconds":934000000}},{"id":"ZGRo7ZdiVsT5Hf9sIu9b","level":"a1","lesson":18,"part":8,"type":"text","name":"a1-l18-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Regardez ces deux sacs. Lequel est plus grand ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at these two bags. Which is bigger?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Le sac rouge est plus grand que le sac noir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The red bag is bigger than the black bag.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Le sac rouge est plus grand que le sac noir.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":932000000}},{"id":"98E827gJ8NNK1Y8QduP1","level":"a1","lesson":18,"part":9,"type":"text","name":"a1-l18-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et lequel est moins cher ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And which is cheaper?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Le sac noir est moins cher.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The black bag is cheaper.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Le sac noir est moins cher.","size":null,"created":{"_seconds":1793275985,"_nanoseconds":936000000}},{"id":"ZGWgVOr8puwp8OHRXiTv","level":"a1","lesson":18,"part":10,"type":"text","name":"a1-l18-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Votre ville est plus grande que Kumasi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Is your city bigger than Kumasi?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Accra est plus grande, mais Kumasi est aussi belle.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Accra is bigger, but Kumasi is just as beautiful.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Accra est plus grande, mais Kumasi est aussi belle.","size":null,"created":{"_seconds":1793275986,"_nanoseconds":441000000}},{"id":"7WGPq0mE9oBCJVpr96jU","level":"a1","lesson":18,"part":11,"type":"text","name":"a1-l18-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le riz, c'est meilleur que le pain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And rice, is it better than bread?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Pour moi, c'est meilleur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For me, it's better.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Pour moi, c'est meilleur.","size":null,"created":{"_seconds":1793275986,"_nanoseconds":438000000}},{"id":"VLYtX2WOUA6iJF6fBpww","level":"a1","lesson":18,"part":12,"type":"text","name":"a1-l18-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Comparez deux choses que vous connaissez.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Compare two things you know.</p><p><b>Compare two things using plus, moins or aussi.</b></p><p style=\"opacity:.7;\">For example: “Accra est plus grande que Kumasi. Le riz est meilleur que le pain.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Accra est plus grande que Kumasi. Le riz est meilleur que le pain.","size":null,"created":{"_seconds":1793275986,"_nanoseconds":490000000}},{"id":"UPJAGAzWTlAsZGdQAGLm","level":"a1","lesson":18,"part":13,"type":"text","name":"a1-l18-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚖️</div><p><b>Comparisons made!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can compare things with plus, moins and aussi. You'll use this to give opinions too.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275986,"_nanoseconds":440000000}}]