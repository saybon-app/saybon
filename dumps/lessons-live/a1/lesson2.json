[{"id":"6V7zwbrWwBwn2ltXNpBK","level":"a1","lesson":2,"part":1,"type":"text","name":"a1-l02-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello again! Last time you introduced yourself. Today you describe people: how they look and what they are like. In French, adjectives agree with the noun, so we will listen for the small changes between masculine and feminine. Je vous écoute.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275957,"_nanoseconds":313000000}},{"id":"L7nJYTROl4bDkMw2C6p3","level":"a1","lesson":2,"part":2,"type":"text","name":"a1-l02-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧑</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Describing people</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275957,"_nanoseconds":272000000}},{"id":"GGcaKCTnDQYVj6wvUhvW","level":"a1","lesson":2,"part":2,"type":"text","name":"a1-l02-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Use il est or elle est, then an adjective. Many adjectives add an e for the feminine: grand becomes grande, petit becomes petite. Some stay the same, like sympa and jeune. For hair and eyes, use il a or elle a: les cheveux noirs, les yeux marron.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est grand.</b><span style=\"opacity:.7;\"> · He is tall.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle est petite.</b><span style=\"opacity:.7;\"> · She is short.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle est sympa.</b><span style=\"opacity:.7;\"> · She is nice.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il a les cheveux noirs.</b><span style=\"opacity:.7;\"> · He has black hair.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275957,"_nanoseconds":766000000}},{"id":"NN1mAHM5nMN0bUhJ52vc","level":"a1","lesson":2,"part":3,"type":"text","name":"a1-l02-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est grand.</b></p><p style=\"opacity:.75;margin:0;\">He is tall.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est grand.","size":null,"created":{"_seconds":1793275957,"_nanoseconds":770000000}},{"id":"KBkb6Pt0n2lErCXpaYer","level":"a1","lesson":2,"part":4,"type":"text","name":"a1-l02-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle est petite.</b></p><p style=\"opacity:.75;margin:0;\">She is short.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle est petite.","size":null,"created":{"_seconds":1793275957,"_nanoseconds":771000000}},{"id":"tqrb8NPgcDNKq4vPNBmz","level":"a1","lesson":2,"part":5,"type":"text","name":"a1-l02-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle est sympa.</b></p><p style=\"opacity:.75;margin:0;\">She is nice.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle est sympa.","size":null,"created":{"_seconds":1793275957,"_nanoseconds":772000000}},{"id":"Lt6UDu9IRe02dMgIDXNF","level":"a1","lesson":2,"part":6,"type":"text","name":"a1-l02-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il a les cheveux noirs.</b></p><p style=\"opacity:.75;margin:0;\">He has black hair.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il a les cheveux noirs.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":282000000}},{"id":"nKAEr3RqX917jWME2S5L","level":"a1","lesson":2,"part":7,"type":"text","name":"a1-l02-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je m'appelle Camille. Vous avez une photo de votre famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I'm Camille. Do you have a photo of your family?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, voici mon frère. Il est grand et sympa.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, here is my brother. He is tall and nice.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il a les cheveux noirs, comme vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Does he have black hair, like you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, il a les cheveux noirs et les yeux marron.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, he has black hair and brown eyes.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et la femme à côté de lui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the woman next to him?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est ma sœur. Elle est petite et très drôle.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's my sister. She is short and very funny.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Elle a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is she?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Elle a vingt-deux ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She is twenty-two.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275958,"_nanoseconds":279000000}},{"id":"KxiN0hSvJa6X476CHFML","level":"a1","lesson":2,"part":8,"type":"text","name":"a1-l02-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je m'appelle Camille. Vous avez une photo de votre famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I'm Camille. Do you have a photo of your family?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, voici mon frère. Il est grand et sympa.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, here is my brother. He is tall and nice.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, voici mon frère. Il est grand et sympa.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":284000000}},{"id":"sw6IioXV8PxWpEEZ4MfP","level":"a1","lesson":2,"part":9,"type":"text","name":"a1-l02-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il a les cheveux noirs, comme vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Does he have black hair, like you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, il a les cheveux noirs et les yeux marron.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, he has black hair and brown eyes.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, il a les cheveux noirs et les yeux marron.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":283000000}},{"id":"ERwrOWWEb9d8fcxxQ6Mr","level":"a1","lesson":2,"part":10,"type":"text","name":"a1-l02-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et la femme à côté de lui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the woman next to him?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est ma sœur. Elle est petite et très drôle.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's my sister. She is short and very funny.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est ma sœur. Elle est petite et très drôle.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":793000000}},{"id":"uAuv1xqfgWiO8y3KUgs9","level":"a1","lesson":2,"part":11,"type":"text","name":"a1-l02-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Elle a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is she?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Elle a vingt-deux ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She is twenty-two.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Elle a vingt-deux ans.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":680000000}},{"id":"vADLzuy5GrQs0PnNh0lZ","level":"a1","lesson":2,"part":12,"type":"text","name":"a1-l02-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez une personne que vous aimez.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe a person you love.</p><p><b>Describe one person: looks and character, in three sentences.</b></p><p style=\"opacity:.7;\">For example: “Ma mère est grande et sympa. Elle a les cheveux courts. Elle est très drôle.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Ma mère est grande et sympa. Elle a les cheveux courts. Elle est très drôle.","size":null,"created":{"_seconds":1793275958,"_nanoseconds":791000000}},{"id":"bxe3jcujoiFZZ1RPfzVD","level":"a1","lesson":2,"part":13,"type":"text","name":"a1-l02-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧑</div><p><b>People described!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe people and you noticed how adjectives change with the gender. Keep listening for those small endings.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275958,"_nanoseconds":690000000}}]