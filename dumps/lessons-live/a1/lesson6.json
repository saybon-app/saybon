[{"id":"2Dbk5pfE43qxes2uhL8e","level":"a1","lesson":6,"part":1,"type":"text","name":"a1-l06-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we combine time and daily life. You tell the time, say when you do things, and build a schedule. This brings together your numbers, the days of the week and your reflexive verbs. A real conversation about a real day.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275964,"_nanoseconds":160000000}},{"id":"de7CxGcoxrSWCLer10FI","level":"a1","lesson":6,"part":2,"type":"text","name":"a1-l06-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏰</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Time and daily life</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275964,"_nanoseconds":169000000}},{"id":"5V5E6TDH9O7jYjtbLgip","level":"a1","lesson":6,"part":2,"type":"text","name":"a1-l06-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Il est huit heures. Il est huit heures et quart. Il est huit heures et demie. Il est neuf heures moins le quart. To say at what time, use à: à huit heures. Use d'abord, ensuite, puis, enfin to sequence.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À huit heures et quart</b><span style=\"opacity:.7;\"> · at quarter past eight</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À midi</b><span style=\"opacity:.7;\"> · at noon</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>D'abord, puis, ensuite</b><span style=\"opacity:.7;\"> · first, then, next</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est neuf heures moins le quart.</b><span style=\"opacity:.7;\"> · It's quarter to nine.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275964,"_nanoseconds":648000000}},{"id":"K8ulEhs8FTLuZaVS9Rnx","level":"a1","lesson":6,"part":3,"type":"text","name":"a1-l06-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À huit heures et quart</b></p><p style=\"opacity:.75;margin:0;\">at quarter past eight</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À huit heures et quart","size":null,"created":{"_seconds":1793275964,"_nanoseconds":653000000}},{"id":"7bQ1HKoL6oJFsM0YujHr","level":"a1","lesson":6,"part":4,"type":"text","name":"a1-l06-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À midi</b></p><p style=\"opacity:.75;margin:0;\">at noon</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À midi","size":null,"created":{"_seconds":1793275964,"_nanoseconds":644000000}},{"id":"HFUKmSVr5GtdB3Ig1i4v","level":"a1","lesson":6,"part":5,"type":"text","name":"a1-l06-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>D'abord, puis, ensuite</b></p><p style=\"opacity:.75;margin:0;\">first, then, next</p></div>","recordPrompt":"Listen, then say it!","expectedText":"D'abord, puis, ensuite","size":null,"created":{"_seconds":1793275964,"_nanoseconds":651000000}},{"id":"gP7MyQrvDlA7wM40f6xo","level":"a1","lesson":6,"part":6,"type":"text","name":"a1-l06-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est neuf heures moins le quart.</b></p><p style=\"opacity:.75;margin:0;\">It's quarter to nine.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est neuf heures moins le quart.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":194000000}},{"id":"7SY0AEwXWKMLSD17gUnE","level":"a1","lesson":6,"part":7,"type":"text","name":"a1-l06-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Quelle heure est-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What time is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il est neuf heures moins le quart.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's quarter to nine.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci. Votre cours commence à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks. What time does your class start?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il commence à neuf heures et quart.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It starts at quarter past nine.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et après, qu'est-ce que vous faites ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And after that, what do you do?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'abord, je travaille. Ensuite, je mange à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">First, I work. Then I eat at noon.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Puis je rentre à six heures et demie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I go home at half past six.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275965,"_nanoseconds":200000000}},{"id":"CBdtZVqruwA4USRBue0i","level":"a1","lesson":6,"part":8,"type":"text","name":"a1-l06-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Quelle heure est-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What time is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il est neuf heures moins le quart.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's quarter to nine.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il est neuf heures moins le quart.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":146000000}},{"id":"o7rRTWuGcgs79JbCMv2C","level":"a1","lesson":6,"part":9,"type":"text","name":"a1-l06-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci. Votre cours commence à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks. What time does your class start?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il commence à neuf heures et quart.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It starts at quarter past nine.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il commence à neuf heures et quart.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":143000000}},{"id":"nBCl1wjjkVuaPBN4kP3M","level":"a1","lesson":6,"part":10,"type":"text","name":"a1-l06-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et après, qu'est-ce que vous faites ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And after that, what do you do?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'abord, je travaille. Ensuite, je mange à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">First, I work. Then I eat at noon.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"D'abord, je travaille. Ensuite, je mange à midi.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":651000000}},{"id":"w90SqlP5eDrek7zy20QF","level":"a1","lesson":6,"part":11,"type":"text","name":"a1-l06-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Puis je rentre à six heures et demie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I go home at half past six.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Puis je rentre à six heures et demie.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":659000000}},{"id":"1VpA5LYj7lnTMG0QU2O9","level":"a1","lesson":6,"part":12,"type":"text","name":"a1-l06-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Quel est votre emploi du temps un lundi ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What is your schedule on a Monday?</p><p><b>Give a three-step schedule with times.</b></p><p style=\"opacity:.7;\">For example: “D'abord, je me lève à six heures. Ensuite, je travaille à huit heures. Puis je rentre à six heures.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"D'abord, je me lève à six heures. Ensuite, je travaille à huit heures. Puis je rentre à six heures.","size":null,"created":{"_seconds":1793275965,"_nanoseconds":669000000}},{"id":"G02T1a0lIDWAWIbgztUS","level":"a1","lesson":6,"part":13,"type":"text","name":"a1-l06-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏰</div><p><b>Schedule ready!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can tell the time and describe a schedule in steps. This will help in every future plan.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275965,"_nanoseconds":708000000}}]