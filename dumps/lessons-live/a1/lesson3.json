[{"id":"xeAB97Rf86qPmC4J2vIL","level":"a1","lesson":3,"part":1,"type":"text","name":"a1-l03-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Today the topic is family. You can already describe people, so now you talk about who is who: mother, father, brothers, sisters and cousins. French uses mon, ma and mes for my, depending on the word. That is the main new idea.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275959,"_nanoseconds":94000000}},{"id":"pBChk8XkAjOi379CXYsE","level":"a1","lesson":3,"part":2,"type":"text","name":"a1-l03-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧‍👦</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Talking about family</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275959,"_nanoseconds":98000000}},{"id":"XzpgmXJMjHwn9iPi5jkM","level":"a1","lesson":3,"part":2,"type":"text","name":"a1-l03-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 My is mon for masculine words, ma for feminine words, and mes for plurals. Mon père, ma mère, mes parents. Before a vowel, use mon even for feminine words: mon amie.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mon père et ma mère</b><span style=\"opacity:.7;\"> · my father and my mother</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mes parents</b><span style=\"opacity:.7;\"> · my parents</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai deux frères.</b><span style=\"opacity:.7;\"> · I have two brothers.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ma tante s'appelle Nana.</b><span style=\"opacity:.7;\"> · My aunt is called Nana.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275959,"_nanoseconds":197000000}},{"id":"b9t0A6CNeyBuM8tBuWm9","level":"a1","lesson":3,"part":3,"type":"text","name":"a1-l03-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mon père et ma mère</b></p><p style=\"opacity:.75;margin:0;\">my father and my mother</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Mon père et ma mère","size":null,"created":{"_seconds":1793275959,"_nanoseconds":198000000}},{"id":"Vw214gjBQh9ykK6Bn3cQ","level":"a1","lesson":3,"part":4,"type":"text","name":"a1-l03-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mes parents</b></p><p style=\"opacity:.75;margin:0;\">my parents</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Mes parents","size":null,"created":{"_seconds":1793275959,"_nanoseconds":622000000}},{"id":"qmmygy8cr7wGvF32kQxV","level":"a1","lesson":3,"part":5,"type":"text","name":"a1-l03-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai deux frères.</b></p><p style=\"opacity:.75;margin:0;\">I have two brothers.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai deux frères.","size":null,"created":{"_seconds":1793275959,"_nanoseconds":623000000}},{"id":"BLuE0hryYRMv9f83bOmk","level":"a1","lesson":3,"part":6,"type":"text","name":"a1-l03-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ma tante s'appelle Nana.</b></p><p style=\"opacity:.75;margin:0;\">My aunt is called Nana.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ma tante s'appelle Nana.","size":null,"created":{"_seconds":1793275959,"_nanoseconds":619000000}},{"id":"I7Mzkg4K1kBClUQk0GaG","level":"a1","lesson":3,"part":7,"type":"text","name":"a1-l03-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Parlez-moi de votre famille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Tell me about your family.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai deux frères et une sœur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have two brothers and a sister.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vos parents ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your parents?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Mon père est professeur et ma mère est infirmière.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My father is a teacher and my mother is a nurse.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ils habitent où ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where do they live?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ils habitent à Kumasi. Ma grand-mère habite avec eux.</b><br><span style=\"opacity:.7;font-size:.9rem;\">They live in Kumasi. My grandmother lives with them.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Elle a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is she?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Elle a soixante-quinze ans. Elle est très gentille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She is seventy-five. She is very kind.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275959,"_nanoseconds":617000000}},{"id":"QJv9O25j05kIwkluh4c6","level":"a1","lesson":3,"part":8,"type":"text","name":"a1-l03-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Parlez-moi de votre famille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Tell me about your family.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai deux frères et une sœur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have two brothers and a sister.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai deux frères et une sœur.","size":null,"created":{"_seconds":1793275960,"_nanoseconds":146000000}},{"id":"S7JabuV3p6nFXOOM9HIJ","level":"a1","lesson":3,"part":9,"type":"text","name":"a1-l03-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vos parents ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your parents?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Mon père est professeur et ma mère est infirmière.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My father is a teacher and my mother is a nurse.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Mon père est professeur et ma mère est infirmière.","size":null,"created":{"_seconds":1793275960,"_nanoseconds":194000000}},{"id":"TcXVhBGFKOHj10m90Suo","level":"a1","lesson":3,"part":10,"type":"text","name":"a1-l03-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ils habitent où ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where do they live?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ils habitent à Kumasi. Ma grand-mère habite avec eux.</b><br><span style=\"opacity:.7;font-size:.9rem;\">They live in Kumasi. My grandmother lives with them.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ils habitent à Kumasi. Ma grand-mère habite avec eux.","size":null,"created":{"_seconds":1793275960,"_nanoseconds":149000000}},{"id":"4U9Tjx47ysZFUMUI8CjS","level":"a1","lesson":3,"part":11,"type":"text","name":"a1-l03-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Elle a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is she?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Elle a soixante-quinze ans. Elle est très gentille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She is seventy-five. She is very kind.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Elle a soixante-quinze ans. Elle est très gentille.","size":null,"created":{"_seconds":1793275960,"_nanoseconds":197000000}},{"id":"ICAijzuESYcPlgE4wIkb","level":"a1","lesson":3,"part":12,"type":"text","name":"a1-l03-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez-moi de votre famille.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Tell me about your family.</p><p><b>Name three family members and say one thing about each.</b></p><p style=\"opacity:.7;\">For example: “Mon père est professeur. Ma mère est infirmière. Mes frères sont grands.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Mon père est professeur. Ma mère est infirmière. Mes frères sont grands.","size":null,"created":{"_seconds":1793275960,"_nanoseconds":641000000}},{"id":"Xai1oUzhPuyZffi5ltqc","level":"a1","lesson":3,"part":13,"type":"text","name":"a1-l03-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧‍👦</div><p><b>Family talk unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about your family using mon, ma and mes. These small words come back constantly.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275960,"_nanoseconds":687000000}}]