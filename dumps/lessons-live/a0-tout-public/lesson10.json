[{"id":"rwHXj9mEKmml2LpQB7Jt","level":"a0-tout-public","lesson":10,"part":1,"type":"text","name":"ab-adults-l10-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we talk about family. You learn to say who is in your family and how many brothers or sisters you have. We build on everything so far. Notice how you keep recycling the same phrases: that is how French starts to feel natural.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275881,"_nanoseconds":486000000}},{"id":"nxtzwKdMFdQJ7I79jcDh","level":"a0-tout-public","lesson":10,"part":2,"type":"text","name":"ab-adults-l10-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A family photo on a shelf</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275881,"_nanoseconds":637000000}},{"id":"lxngUIuNT9IXj8MxoEqe","level":"a0-tout-public","lesson":10,"part":2,"type":"text","name":"ab-adults-l10-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Ma famille is my family. Un frère is a brother, une sœur a sister, un enfant a child. To say I have, say j'ai. To ask if someone has a brother, say vous avez un frère. Use il s'appelle, he is called, or elle s'appelle, she is called.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai un frère.</b><span style=\"opacity:.7;\"> · I have a brother.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai une sœur.</b><span style=\"opacity:.7;\"> · I have a sister.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il s'appelle Paul.</b><span style=\"opacity:.7;\"> · He is called Paul.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous avez des enfants ?</b><span style=\"opacity:.7;\"> · Do you have children?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275881,"_nanoseconds":719000000}},{"id":"o2Qd8fjMDkJXZr1rrg4y","level":"a0-tout-public","lesson":10,"part":3,"type":"text","name":"ab-adults-l10-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai un frère.</b></p><p style=\"opacity:.75;margin:0;\">I have a brother.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai un frère.","size":null,"created":{"_seconds":1793275881,"_nanoseconds":866000000}},{"id":"8hZWWuSBayORUuuUPZHK","level":"a0-tout-public","lesson":10,"part":4,"type":"text","name":"ab-adults-l10-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai une sœur.</b></p><p style=\"opacity:.75;margin:0;\">I have a sister.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai une sœur.","size":null,"created":{"_seconds":1793275881,"_nanoseconds":904000000}},{"id":"ZoXzis4LV4Lo6lEw5AQA","level":"a0-tout-public","lesson":10,"part":5,"type":"text","name":"ab-adults-l10-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il s'appelle Paul.</b></p><p style=\"opacity:.75;margin:0;\">He is called Paul.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il s'appelle Paul.","size":null,"created":{"_seconds":1793275882,"_nanoseconds":48000000}},{"id":"wHNGCqjmjkSNwsq7ZC7I","level":"a0-tout-public","lesson":10,"part":6,"type":"text","name":"ab-adults-l10-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous avez des enfants ?</b></p><p style=\"opacity:.75;margin:0;\">Do you have children?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vous avez des enfants ?","size":null,"created":{"_seconds":1793275882,"_nanoseconds":380000000}},{"id":"EnvZTXWEr0HBDnna19qH","level":"a0-tout-public","lesson":10,"part":7,"type":"text","name":"ab-adults-l10-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Vous avez une famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Do you have a family?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai un frère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a brother.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il s'appelle comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is he called?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il s'appelle Paul.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is called Paul.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous avez une sœur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you have a sister?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai une sœur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a sister.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il a quel âge, votre frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is your brother?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il a dix-huit ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is eighteen.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275882,"_nanoseconds":582000000}},{"id":"AwqknXoV0Wn327YB4W2C","level":"a0-tout-public","lesson":10,"part":8,"type":"text","name":"ab-adults-l10-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275882,"_nanoseconds":667000000}},{"id":"Vtj2sMlN7okwEXbD4Ba8","level":"a0-tout-public","lesson":10,"part":9,"type":"text","name":"ab-adults-l10-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Vous avez une famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Do you have a family?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'ai un frère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a brother.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'ai un frère.","size":null,"created":{"_seconds":1793275882,"_nanoseconds":595000000}},{"id":"nOBhou7jL8RmcsiS53FN","level":"a0-tout-public","lesson":10,"part":10,"type":"text","name":"ab-adults-l10-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il s'appelle comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is he called?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il s'appelle Paul.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is called Paul.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il s'appelle Paul.","size":null,"created":{"_seconds":1793275882,"_nanoseconds":786000000}},{"id":"lthyR0kTZsQ6CWuHkgTK","level":"a0-tout-public","lesson":10,"part":11,"type":"text","name":"ab-adults-l10-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous avez une sœur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you have a sister?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'ai une sœur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a sister.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'ai une sœur.","size":null,"created":{"_seconds":1793275883,"_nanoseconds":23000000}},{"id":"OAxbLuRAyYz9PZlo5Di3","level":"a0-tout-public","lesson":10,"part":12,"type":"text","name":"ab-adults-l10-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il a quel âge, votre frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is your brother?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il a dix-huit ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is eighteen.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il a dix-huit ans.","size":null,"created":{"_seconds":1793275883,"_nanoseconds":68000000}},{"id":"PoSQRbtMpaRdstA6eb7B","level":"a0-tout-public","lesson":10,"part":13,"type":"text","name":"ab-adults-l10-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez-moi de votre famille.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Tell me about your family.</p><p><b>Say who is in your family, with one name.</b></p><p style=\"opacity:.7;\">For example: “J'ai un frère et une sœur. Il s'appelle Paul.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai un frère et une sœur. Il s'appelle Paul.","size":null,"created":{"_seconds":1793275883,"_nanoseconds":87000000}},{"id":"MpNMcNRIRVbkpTVy0jt1","level":"a0-tout-public","lesson":10,"part":14,"type":"text","name":"ab-adults-l10-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧</div><p><b>Family introduced!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe your family in short, clear sentences. Practise these with real names from your own life.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275883,"_nanoseconds":200000000}}]