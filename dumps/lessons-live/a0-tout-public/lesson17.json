[{"id":"OYpeMg3YmyJZE2NpHCYr","level":"a0-tout-public","lesson":17,"part":1,"type":"text","name":"ab-adults-l17-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you shop. In a bakery, a market or a shop, you will use je voudrais again, with quantities. The new words are un kilo, une baguette, un billet. We keep the polite phrases from last lesson. And always say bonjour when you walk in, it is the rule.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275895,"_nanoseconds":328000000}},{"id":"NuuaeeK8piM2LFkiFaaY","level":"a0-tout-public","lesson":17,"part":2,"type":"text","name":"ab-adults-l17-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🥖</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A bakery counter with baguettes and a basket of apples</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275895,"_nanoseconds":326000000}},{"id":"CIlQpcRCN7Ve41fcckUO","level":"a0-tout-public","lesson":17,"part":2,"type":"text","name":"ab-adults-l17-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To buy something, say je voudrais, then the item. For quantities, use un kilo de, a kilo of, or deux, trois. Une baguette is a loaf of bread, un billet a ticket. When someone says autre chose, they ask if you want anything else. Answer c'est tout, merci, that's all.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais une baguette.</b><span style=\"opacity:.7;\"> · I would like a baguette.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un kilo de pommes.</b><span style=\"opacity:.7;\"> · A kilo of apples.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Autre chose ?</b><span style=\"opacity:.7;\"> · Anything else?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est tout, merci.</b><span style=\"opacity:.7;\"> · That's all, thank you.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275895,"_nanoseconds":818000000}},{"id":"sPlsipTpQStK5TFYxws4","level":"a0-tout-public","lesson":17,"part":3,"type":"text","name":"ab-adults-l17-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais une baguette.</b></p><p style=\"opacity:.75;margin:0;\">I would like a baguette.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais une baguette.","size":null,"created":{"_seconds":1793275895,"_nanoseconds":843000000}},{"id":"f8MnNOpKE8262x1pP66n","level":"a0-tout-public","lesson":17,"part":4,"type":"text","name":"ab-adults-l17-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un kilo de pommes.</b></p><p style=\"opacity:.75;margin:0;\">A kilo of apples.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un kilo de pommes.","size":null,"created":{"_seconds":1793275895,"_nanoseconds":815000000}},{"id":"jXphw3pqvdEN6Kyt3lD7","level":"a0-tout-public","lesson":17,"part":5,"type":"text","name":"ab-adults-l17-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Autre chose ?</b></p><p style=\"opacity:.75;margin:0;\">Anything else?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Autre chose ?","size":null,"created":{"_seconds":1793275895,"_nanoseconds":813000000}},{"id":"jaiyqgUO1Vi9BtbMsrKv","level":"a0-tout-public","lesson":17,"part":6,"type":"text","name":"ab-adults-l17-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est tout, merci.</b></p><p style=\"opacity:.75;margin:0;\">That's all, thank you.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est tout, merci.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":352000000}},{"id":"jsxQa6w4syp7l2zxrVWJ","level":"a0-tout-public","lesson":17,"part":7,"type":"text","name":"ab-adults-l17-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je voudrais une baguette, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a baguette, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, un kilo de pommes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a kilo of apples.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Rouges ou vertes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red or green?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Rouges, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est tout, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's all, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà. Bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Have a good day!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275896,"_nanoseconds":362000000}},{"id":"GyqH33Cj7JCMTsrJY7sk","level":"a0-tout-public","lesson":17,"part":8,"type":"text","name":"ab-adults-l17-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je voudrais une baguette, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a baguette, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je voudrais une baguette, s'il vous plaît.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":355000000}},{"id":"OqrDlFabKkdBN5n45ZsO","level":"a0-tout-public","lesson":17,"part":9,"type":"text","name":"ab-adults-l17-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, un kilo de pommes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a kilo of apples.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, un kilo de pommes.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":355000000}},{"id":"r54pKALoxuENvQLW8X8a","level":"a0-tout-public","lesson":17,"part":10,"type":"text","name":"ab-adults-l17-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Rouges ou vertes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red or green?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Rouges, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Rouges, s'il vous plaît.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":845000000}},{"id":"B6SA6Q0UKOfkXYjsAuQt","level":"a0-tout-public","lesson":17,"part":11,"type":"text","name":"ab-adults-l17-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est tout, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's all, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est tout, merci.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":853000000}},{"id":"7M3SymnF2BogTfkNeVEw","level":"a0-tout-public","lesson":17,"part":12,"type":"text","name":"ab-adults-l17-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà. Bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Have a good day!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci, au revoir !","size":null,"created":{"_seconds":1793275896,"_nanoseconds":855000000}},{"id":"B4PeKgTOgJzdXCipFK94","level":"a0-tout-public","lesson":17,"part":13,"type":"text","name":"ab-adults-l17-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous êtes à la boulangerie. Que voulez-vous ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You're at the bakery. What do you want?</p><p><b>Order two things and say that's all.</b></p><p style=\"opacity:.7;\">For example: “Je voudrais une baguette et deux croissants. C'est tout, merci.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je voudrais une baguette et deux croissants. C'est tout, merci.","size":null,"created":{"_seconds":1793275896,"_nanoseconds":896000000}},{"id":"Hqwb1QzNyKP3FIViIB9Y","level":"a0-tout-public","lesson":17,"part":14,"type":"text","name":"ab-adults-l17-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🥖</div><p><b>Shopping done!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can shop in French, with quantities, and end politely. Shopping is a very good place to practise.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275897,"_nanoseconds":343000000}}]