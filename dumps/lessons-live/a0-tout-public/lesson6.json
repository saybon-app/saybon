[{"id":"cbtFYmDMLswKDR0vP30s","level":"a0-tout-public","lesson":6,"part":1,"type":"text","name":"ab-adults-l06-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! In French life, you often need to spell your name: at the doctor, at a hotel, on the phone. Today you learn the French alphabet, and how to answer comment ça s'écrit, how do you spell it. The letters sound very different from English, so listen well.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275875,"_nanoseconds":299000000}},{"id":"Q17xgDdEjJVOlnmp1vvG","level":"a0-tout-public","lesson":6,"part":2,"type":"text","name":"ab-adults-l06-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔤</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A hotel reception desk with a registration form</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275875,"_nanoseconds":412000000}},{"id":"mr8dCfj41fqjO2SY8lsL","level":"a0-tout-public","lesson":6,"part":2,"type":"text","name":"ab-adults-l06-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 The alphabet in French: a, bé, cé, dé, e, ef, gé, ache, i, ji, ka, el, em, en, o, pé, ku, er, es, té, u, vé, double vé, iks, i grec, zède. And the question is comment ça s'écrit.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>A, B, C, D, E</b><span style=\"opacity:.7;\"> · A, B, C, D, E</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Comment ça s'écrit ?</b><span style=\"opacity:.7;\"> · How do you spell it?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça s'écrit A, L, E, X.</b><span style=\"opacity:.7;\"> · It's spelled A, L, E, X.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275875,"_nanoseconds":456000000}},{"id":"OCmX3pjNMuAednyxi7PK","level":"a0-tout-public","lesson":6,"part":3,"type":"text","name":"ab-adults-l06-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>A, B, C, D, E</b></p><p style=\"opacity:.75;margin:0;\">A, B, C, D, E</p></div>","recordPrompt":"Listen, then say it!","expectedText":"A, B, C, D, E","size":null,"created":{"_seconds":1793275875,"_nanoseconds":554000000}},{"id":"kVZhS9vQZgynJYnK2zjZ","level":"a0-tout-public","lesson":6,"part":4,"type":"text","name":"ab-adults-l06-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Comment ça s'écrit ?</b></p><p style=\"opacity:.75;margin:0;\">How do you spell it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Comment ça s'écrit ?","size":null,"created":{"_seconds":1793275875,"_nanoseconds":741000000}},{"id":"qU5WCWBHXUTNkpZTZPwb","level":"a0-tout-public","lesson":6,"part":5,"type":"text","name":"ab-adults-l06-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça s'écrit A, L, E, X.</b></p><p style=\"opacity:.75;margin:0;\">It's spelled A, L, E, X.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça s'écrit A, L, E, X.","size":null,"created":{"_seconds":1793275875,"_nanoseconds":830000000}},{"id":"JapY2gUIVPvZeCPtLSiF","level":"a0-tout-public","lesson":6,"part":6,"type":"text","name":"ab-adults-l06-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What is your name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment ça s'écrit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How is it spelled?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça s'écrit A, L, E, X.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's spelled A, L, E, X.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci ! Et vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! And how old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va bien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you well?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Camille. Ça s'écrit C, A, M, I, L, L, E.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. It's spelled C, A, M, I, L, L, E.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci, Camille. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, Camille. Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275875,"_nanoseconds":900000000}},{"id":"ETNMzeegUn3gaW7fjUMw","level":"a0-tout-public","lesson":6,"part":7,"type":"text","name":"ab-adults-l06-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What is your name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275875,"_nanoseconds":986000000}},{"id":"BBfXiyQU61eV2miHo5or","level":"a0-tout-public","lesson":6,"part":8,"type":"text","name":"ab-adults-l06-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment ça s'écrit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How is it spelled?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça s'écrit A, L, E, X.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's spelled A, L, E, X.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça s'écrit A, L, E, X.","size":null,"created":{"_seconds":1793275876,"_nanoseconds":156000000}},{"id":"7MsoKEDxadeRr2m33JXU","level":"a0-tout-public","lesson":6,"part":9,"type":"text","name":"ab-adults-l06-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci ! Et vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! And how old are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai vingt ans.","size":null,"created":{"_seconds":1793275876,"_nanoseconds":259000000}},{"id":"cQ4OkkGJnu2XYMckdxJJ","level":"a0-tout-public","lesson":6,"part":10,"type":"text","name":"ab-adults-l06-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça va bien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you well?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275876,"_nanoseconds":318000000}},{"id":"f48OsEzgfTkv0Wyiz2rW","level":"a0-tout-public","lesson":6,"part":11,"type":"text","name":"ab-adults-l06-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Camille. Ça s'écrit C, A, M, I, L, L, E.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. It's spelled C, A, M, I, L, L, E.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci, Camille. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, Camille. Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci, Camille. Au revoir !","size":null,"created":{"_seconds":1793275876,"_nanoseconds":405000000}},{"id":"tNEsM60OxcUYoaznJThl","level":"a0-tout-public","lesson":6,"part":12,"type":"text","name":"ab-adults-l06-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Comment vous appelez-vous ? Comment ça s'écrit ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What is your name? How do you spell it?</p><p><b>Say your name and spell it.</b></p><p style=\"opacity:.7;\">For example: “Je m'appelle Alex. Ça s'écrit A, L, E, X.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je m'appelle Alex. Ça s'écrit A, L, E, X.","size":null,"created":{"_seconds":1793275876,"_nanoseconds":559000000}},{"id":"hsWw5C0oRIq6QdYQ14Zg","level":"a0-tout-public","lesson":6,"part":13,"type":"text","name":"ab-adults-l06-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔤</div><p><b>Spelled it out!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can spell your name in French and ask how something is written. You will use this often.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275876,"_nanoseconds":922000000}}]