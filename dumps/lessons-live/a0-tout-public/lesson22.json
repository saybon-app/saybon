[{"id":"QfkTY9GlxCMB83JBiTIB","level":"a0-tout-public","lesson":22,"part":1,"type":"text","name":"ab-adults-l22-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you share your opinions in the simplest way: what you like and what you do not like. It makes conversations come alive. The key words are j'aime, I like, je n'aime pas, I do not like, and je déteste, I hate. We use them with food, colours, jobs, anything we have seen.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275905,"_nanoseconds":262000000}},{"id":"MgLlWfNPmfIt2ZG5hKYE","level":"a0-tout-public","lesson":22,"part":2,"type":"text","name":"ab-adults-l22-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👍</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A thumbs up next to a bar of chocolate</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275905,"_nanoseconds":290000000}},{"id":"rHt9S3cMyAwShfkn97Gc","level":"a0-tout-public","lesson":22,"part":2,"type":"text","name":"ab-adults-l22-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 J'aime means I like. Je n'aime pas means I don't like. Je déteste means I hate. Add j'adore for I love. After these verbs, use le, la or les: j'aime le fromage, je n'aime pas les légumes.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'aime le fromage.</b><span style=\"opacity:.7;\"> · I like cheese.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je n'aime pas les légumes.</b><span style=\"opacity:.7;\"> · I don't like vegetables.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je déteste le café froid.</b><span style=\"opacity:.7;\"> · I hate cold coffee.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'adore le chocolat.</b><span style=\"opacity:.7;\"> · I love chocolate.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275905,"_nanoseconds":322000000}},{"id":"RlGC6HKZXfOKXhI4FnQO","level":"a0-tout-public","lesson":22,"part":3,"type":"text","name":"ab-adults-l22-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'aime le fromage.</b></p><p style=\"opacity:.75;margin:0;\">I like cheese.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'aime le fromage.","size":null,"created":{"_seconds":1793275905,"_nanoseconds":773000000}},{"id":"VSB7aSGmqplsTnWIgfmr","level":"a0-tout-public","lesson":22,"part":4,"type":"text","name":"ab-adults-l22-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je n'aime pas les légumes.</b></p><p style=\"opacity:.75;margin:0;\">I don't like vegetables.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je n'aime pas les légumes.","size":null,"created":{"_seconds":1793275905,"_nanoseconds":768000000}},{"id":"4AtORypKD6iO89cIb07h","level":"a0-tout-public","lesson":22,"part":5,"type":"text","name":"ab-adults-l22-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je déteste le café froid.</b></p><p style=\"opacity:.75;margin:0;\">I hate cold coffee.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je déteste le café froid.","size":null,"created":{"_seconds":1793275905,"_nanoseconds":762000000}},{"id":"AWf4EuPDOutvKJdWaLbz","level":"a0-tout-public","lesson":22,"part":6,"type":"text","name":"ab-adults-l22-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'adore le chocolat.</b></p><p style=\"opacity:.75;margin:0;\">I love chocolate.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'adore le chocolat.","size":null,"created":{"_seconds":1793275905,"_nanoseconds":776000000}},{"id":"yxptTrkP5hC3F9FW4DUA","level":"a0-tout-public","lesson":22,"part":7,"type":"text","name":"ab-adults-l22-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Vous aimez le fromage ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Do you like cheese?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'aime le fromage.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like cheese.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et les légumes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And vegetables?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je n'aime pas les légumes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I don't like vegetables.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle est votre couleur préférée ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your favourite colour?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime le bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like blue.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, j'adore le chocolat !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I love chocolate!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Moi aussi ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too! Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275906,"_nanoseconds":371000000}},{"id":"jd9EYiT7KzKrxJe7PFqQ","level":"a0-tout-public","lesson":22,"part":8,"type":"text","name":"ab-adults-l22-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275906,"_nanoseconds":374000000}},{"id":"5Ap1YDjmSvCCUr1DCtgb","level":"a0-tout-public","lesson":22,"part":9,"type":"text","name":"ab-adults-l22-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Vous aimez le fromage ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Do you like cheese?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'aime le fromage.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like cheese.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'aime le fromage.","size":null,"created":{"_seconds":1793275906,"_nanoseconds":376000000}},{"id":"HPf56TriBwQQhbQXKrH9","level":"a0-tout-public","lesson":22,"part":10,"type":"text","name":"ab-adults-l22-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et les légumes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And vegetables?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je n'aime pas les légumes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I don't like vegetables.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je n'aime pas les légumes.","size":null,"created":{"_seconds":1793275906,"_nanoseconds":426000000}},{"id":"GVgwSwFKOc87rotEAnYj","level":"a0-tout-public","lesson":22,"part":11,"type":"text","name":"ab-adults-l22-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle est votre couleur préférée ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your favourite colour?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime le bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like blue.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime le bleu.","size":null,"created":{"_seconds":1793275906,"_nanoseconds":871000000}},{"id":"X8c90m98dET5pFLjlfN5","level":"a0-tout-public","lesson":22,"part":12,"type":"text","name":"ab-adults-l22-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, j'adore le chocolat !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I love chocolate!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Moi aussi ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too! Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Moi aussi ! Au revoir !","size":null,"created":{"_seconds":1793275906,"_nanoseconds":869000000}},{"id":"KY3ZSjRRlna8qgtHy971","level":"a0-tout-public","lesson":22,"part":13,"type":"text","name":"ab-adults-l22-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Qu'est-ce que vous aimez ? Qu'est-ce que vous détestez ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you like? What do you hate?</p><p><b>Say one thing you like and one you don't.</b></p><p style=\"opacity:.7;\">For example: “J'aime le chocolat. Je n'aime pas le café froid.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'aime le chocolat. Je n'aime pas le café froid.","size":null,"created":{"_seconds":1793275906,"_nanoseconds":920000000}},{"id":"4IsIUD4kq0iYSvGRdZJP","level":"a0-tout-public","lesson":22,"part":14,"type":"text","name":"ab-adults-l22-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👍</div><p><b>Opinions unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can express tastes in French. You will now be able to keep a conversation going by giving an opinion.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275906,"_nanoseconds":925000000}}]