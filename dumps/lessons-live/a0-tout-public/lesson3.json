[{"id":"OGhqBY5ZisKtQRRDHYma","level":"a0-tout-public","lesson":3,"part":1,"type":"text","name":"ab-adults-l03-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello again. Today you will learn how to ask how someone is, and how to answer. In French, ça va is the key phrase. It works for the question and the answer. We will add it to what you already know: greetings and names.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275870,"_nanoseconds":180000000}},{"id":"BPaodk8RDTHH1i2Fcnud","level":"a0-tout-public","lesson":3,"part":2,"type":"text","name":"ab-adults-l03-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">😊</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two colleagues chatting by a coffee machine</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275870,"_nanoseconds":364000000}},{"id":"u8wHn4ynPtVRtZqooq57","level":"a0-tout-public","lesson":3,"part":2,"type":"text","name":"ab-adults-l03-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Ça va means how are you, and also I'm fine. Answer with ça va bien, très bien, pas mal for not bad, or comme ci, comme ça for so-so. Always add merci, thank you, and et vous, and you.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va ?</b><span style=\"opacity:.7;\"> · How are you?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va très bien, merci.</b><span style=\"opacity:.7;\"> · I'm very well, thank you.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pas mal.</b><span style=\"opacity:.7;\"> · Not bad.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Comme ci, comme ça.</b><span style=\"opacity:.7;\"> · So-so.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275870,"_nanoseconds":363000000}},{"id":"Iz3e29der913sFtRv43e","level":"a0-tout-public","lesson":3,"part":3,"type":"text","name":"ab-adults-l03-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va ?</b></p><p style=\"opacity:.75;margin:0;\">How are you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va ?","size":null,"created":{"_seconds":1793275870,"_nanoseconds":531000000}},{"id":"rxidYeNX8tavEESVYyez","level":"a0-tout-public","lesson":3,"part":4,"type":"text","name":"ab-adults-l03-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va très bien, merci.</b></p><p style=\"opacity:.75;margin:0;\">I'm very well, thank you.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275870,"_nanoseconds":652000000}},{"id":"5rykfRmg6MOTw9tqUzmX","level":"a0-tout-public","lesson":3,"part":5,"type":"text","name":"ab-adults-l03-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pas mal.</b></p><p style=\"opacity:.75;margin:0;\">Not bad.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pas mal.","size":null,"created":{"_seconds":1793275870,"_nanoseconds":786000000}},{"id":"P84VqzFN0oZFjNC5uduX","level":"a0-tout-public","lesson":3,"part":6,"type":"text","name":"ab-adults-l03-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Comme ci, comme ça.</b></p><p style=\"opacity:.75;margin:0;\">So-so.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Comme ci, comme ça.","size":null,"created":{"_seconds":1793275870,"_nanoseconds":819000000}},{"id":"gFKHRouSl0PHKIosQ2dO","level":"a0-tout-public","lesson":3,"part":7,"type":"text","name":"ab-adults-l03-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je m'appelle Camille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Enchantée. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you. How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pas mal, merci. Un peu fatiguée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Not bad, thank you. A bit tired.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oh, désolé !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, sorry!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ce n'est pas grave. Et vous, ça va vraiment bien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's not serious. And you, are you really fine?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Comme ci, comme ça.</b><br><span style=\"opacity:.7;font-size:.9rem;\">So-so.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>D'accord. À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. See you soon!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275870,"_nanoseconds":950000000}},{"id":"IckMtTRlFPgsnog5QPaj","level":"a0-tout-public","lesson":3,"part":8,"type":"text","name":"ab-adults-l03-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je m'appelle Camille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je m'appelle Alex.","size":null,"created":{"_seconds":1793275871,"_nanoseconds":401000000}},{"id":"Inyc7TUK4sE78BLgpflE","level":"a0-tout-public","lesson":3,"part":9,"type":"text","name":"ab-adults-l03-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Enchantée. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you. How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275871,"_nanoseconds":235000000}},{"id":"HYY7RU1qxW9oHhp0yo0W","level":"a0-tout-public","lesson":3,"part":10,"type":"text","name":"ab-adults-l03-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pas mal, merci. Un peu fatiguée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Not bad, thank you. A bit tired.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oh, désolé !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, sorry!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oh, désolé !","size":null,"created":{"_seconds":1793275871,"_nanoseconds":494000000}},{"id":"uB6mNkyS1rO7fwMks852","level":"a0-tout-public","lesson":3,"part":11,"type":"text","name":"ab-adults-l03-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ce n'est pas grave. Et vous, ça va vraiment bien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's not serious. And you, are you really fine?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Comme ci, comme ça.</b><br><span style=\"opacity:.7;font-size:.9rem;\">So-so.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Comme ci, comme ça.","size":null,"created":{"_seconds":1793275871,"_nanoseconds":602000000}},{"id":"vsUtvXk7aVjBPAeZQB20","level":"a0-tout-public","lesson":3,"part":12,"type":"text","name":"ab-adults-l03-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>D'accord. À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. See you soon!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793275871,"_nanoseconds":642000000}},{"id":"gvj9Dy8mYmgpZJeVVzMw","level":"a0-tout-public","lesson":3,"part":13,"type":"text","name":"ab-adults-l03-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Bonjour ! Ça va ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Hello! How are you?</p><p><b>Answer how you are and ask back.</b></p><p style=\"opacity:.7;\">For example: “Ça va bien, merci. Et vous ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Ça va bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275871,"_nanoseconds":817000000}},{"id":"kYMZ4I9EamP3czJsRrbK","level":"a0-tout-public","lesson":3,"part":14,"type":"text","name":"ab-adults-l03-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">😊</div><p><b>You can small-talk!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can ask and answer ça va in several ways, and say merci. You are already holding a short conversation.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275871,"_nanoseconds":903000000}}]