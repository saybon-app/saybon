[{"id":"kxirGHEDlCbOtxhqNfEY","level":"a0-tout-public","lesson":21,"part":1,"type":"text","name":"ab-adults-l21-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you talk about food and meals. In France, food is a big part of life, and people love to talk about it. You learn simple words for foods and for meals, and how to say what you eat. Everything from earlier lessons keeps appearing in the conversation.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275902,"_nanoseconds":982000000}},{"id":"GTvoxaEjOlkXU2DfYi9c","level":"a0-tout-public","lesson":21,"part":2,"type":"text","name":"ab-adults-l21-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍽️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A table with bread, cheese, rice and fish</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275902,"_nanoseconds":987000000}},{"id":"QTb27cXSmoVkzjj6Os4H","level":"a0-tout-public","lesson":21,"part":2,"type":"text","name":"ab-adults-l21-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le pain is bread, le fromage cheese, le riz rice, la viande meat, le poisson fish, les légumes vegetables. Meals are le petit déjeuner, le déjeuner and le dîner. To say what you eat, say je mange, I eat, as in je mange du riz.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le pain, le fromage</b><span style=\"opacity:.7;\"> · Bread, cheese</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le riz, le poisson</b><span style=\"opacity:.7;\"> · Rice, fish</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je mange du riz.</b><span style=\"opacity:.7;\"> · I eat rice.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le petit déjeuner, le déjeuner, le dîner</b><span style=\"opacity:.7;\"> · Breakfast, lunch, dinner</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275903,"_nanoseconds":500000000}},{"id":"cW0e9QsFs2LTT2kPOWHZ","level":"a0-tout-public","lesson":21,"part":3,"type":"text","name":"ab-adults-l21-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le pain, le fromage</b></p><p style=\"opacity:.75;margin:0;\">Bread, cheese</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le pain, le fromage","size":null,"created":{"_seconds":1793275903,"_nanoseconds":493000000}},{"id":"XJC7zqtqE0dZojWqaC5i","level":"a0-tout-public","lesson":21,"part":4,"type":"text","name":"ab-adults-l21-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le riz, le poisson</b></p><p style=\"opacity:.75;margin:0;\">Rice, fish</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le riz, le poisson","size":null,"created":{"_seconds":1793275903,"_nanoseconds":499000000}},{"id":"a3hXrTN6iKJfmLgXzQzy","level":"a0-tout-public","lesson":21,"part":5,"type":"text","name":"ab-adults-l21-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je mange du riz.</b></p><p style=\"opacity:.75;margin:0;\">I eat rice.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je mange du riz.","size":null,"created":{"_seconds":1793275903,"_nanoseconds":540000000}},{"id":"CgDY4Vif4PX3CjWiAmkw","level":"a0-tout-public","lesson":21,"part":6,"type":"text","name":"ab-adults-l21-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le petit déjeuner, le déjeuner, le dîner</b></p><p style=\"opacity:.75;margin:0;\">Breakfast, lunch, dinner</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le petit déjeuner, le déjeuner, le dîner","size":null,"created":{"_seconds":1793275904,"_nanoseconds":308000000}},{"id":"Iak2C0hz7p8UViNQDPiF","level":"a0-tout-public","lesson":21,"part":7,"type":"text","name":"ab-adults-l21-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À midi, qu'est-ce que vous mangez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At noon, what do you eat?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je mange du riz et du poisson.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat rice and fish.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le matin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the morning?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au petit déjeuner, je mange du pain.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For breakfast, I eat bread.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous buvez du café ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you drink coffee?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je voudrais un café, s'il vous plaît !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I would like a coffee, please!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go! See you soon!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275904,"_nanoseconds":328000000}},{"id":"urgb91r9iQ4TTHSQacht","level":"a0-tout-public","lesson":21,"part":8,"type":"text","name":"ab-adults-l21-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275904,"_nanoseconds":330000000}},{"id":"gVZNKdRTJz8FsDsr08fJ","level":"a0-tout-public","lesson":21,"part":9,"type":"text","name":"ab-adults-l21-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À midi, qu'est-ce que vous mangez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At noon, what do you eat?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je mange du riz et du poisson.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat rice and fish.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je mange du riz et du poisson.","size":null,"created":{"_seconds":1793275904,"_nanoseconds":332000000}},{"id":"lUWfulwECcE9FvXc1Hy5","level":"a0-tout-public","lesson":21,"part":10,"type":"text","name":"ab-adults-l21-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le matin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the morning?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au petit déjeuner, je mange du pain.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For breakfast, I eat bread.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au petit déjeuner, je mange du pain.","size":null,"created":{"_seconds":1793275904,"_nanoseconds":821000000}},{"id":"sW2r7kQEcEW495ABHjcW","level":"a0-tout-public","lesson":21,"part":11,"type":"text","name":"ab-adults-l21-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous buvez du café ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you drink coffee?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je voudrais un café, s'il vous plaît !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I would like a coffee, please!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je voudrais un café, s'il vous plaît !","size":null,"created":{"_seconds":1793275904,"_nanoseconds":827000000}},{"id":"68jyT2WCkkpSJHvr5W17","level":"a0-tout-public","lesson":21,"part":12,"type":"text","name":"ab-adults-l21-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go! See you soon!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci, au revoir !","size":null,"created":{"_seconds":1793275904,"_nanoseconds":826000000}},{"id":"QqA2ln1XGFSrS01kf6hW","level":"a0-tout-public","lesson":21,"part":13,"type":"text","name":"ab-adults-l21-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Qu'est-ce que vous mangez à midi ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you eat at noon?</p><p><b>Say what you eat for lunch.</b></p><p style=\"opacity:.7;\">For example: “Je mange du riz et du poisson.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je mange du riz et du poisson.","size":null,"created":{"_seconds":1793275904,"_nanoseconds":839000000}},{"id":"Zfj1i8v2i2vZ7977rwCx","level":"a0-tout-public","lesson":21,"part":14,"type":"text","name":"ab-adults-l21-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🍽️</div><p><b>Bon appétit!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about food and meals. Try describing your real meals to practise.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275905,"_nanoseconds":275000000}}]