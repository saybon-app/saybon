[{"id":"DsFdfAvg8skjCivSpYUv","level":"a0-tout-public","lesson":1,"part":1,"type":"text","name":"ab-adults-l01-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Welcome! In this course you will speak French from the very first minute. Today is simple: how to greet someone and how to say goodbye. In France, people greet each other all the time, in shops, in lifts, at work, so these few words will be useful from day one. Listen to a short conversation, then say your part.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275866,"_nanoseconds":828000000}},{"id":"fyTZbPxWRflow3NS84cJ","level":"a0-tout-public","lesson":1,"part":2,"type":"text","name":"ab-adults-l01-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👋</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two people greeting each other at a shop door in the morning</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275866,"_nanoseconds":879000000}},{"id":"f9579Xn7HgUsNOcvENuX","level":"a0-tout-public","lesson":1,"part":2,"type":"text","name":"ab-adults-l01-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Bonjour is hello, and you can use it until the evening. Bonsoir is good evening. Salut is a casual hi, for friends. Au revoir is goodbye, and à bientôt means see you soon.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bonjour !</b><span style=\"opacity:.7;\"> · Hello!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bonsoir !</b><span style=\"opacity:.7;\"> · Good evening!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Au revoir !</b><span style=\"opacity:.7;\"> · Goodbye!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À bientôt !</b><span style=\"opacity:.7;\"> · See you soon!</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275866,"_nanoseconds":808000000}},{"id":"evQqlxlvz1NGacKlLjtM","level":"a0-tout-public","lesson":1,"part":3,"type":"text","name":"ab-adults-l01-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bonjour !</b></p><p style=\"opacity:.75;margin:0;\">Hello!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bonjour !","size":null,"created":{"_seconds":1793275866,"_nanoseconds":831000000}},{"id":"q6hiSIMR83NnApLB8oR2","level":"a0-tout-public","lesson":1,"part":4,"type":"text","name":"ab-adults-l01-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bonsoir !</b></p><p style=\"opacity:.75;margin:0;\">Good evening!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bonsoir !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":420000000}},{"id":"tfxqUH4BHIH6iCBbVdgi","level":"a0-tout-public","lesson":1,"part":5,"type":"text","name":"ab-adults-l01-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Au revoir !</b></p><p style=\"opacity:.75;margin:0;\">Goodbye!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":425000000}},{"id":"broTLoQShAACBEvsoCHW","level":"a0-tout-public","lesson":1,"part":6,"type":"text","name":"ab-adults-l01-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À bientôt !</b></p><p style=\"opacity:.75;margin:0;\">See you soon!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À bientôt !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":415000000}},{"id":"dZpkSwLWfeWvPUPtDjQj","level":"a0-tout-public","lesson":1,"part":7,"type":"text","name":"ab-adults-l01-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonsoir ! Oh, pardon, il est dix-huit heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening! Oh, sorry, it's six in the evening.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonsoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275867,"_nanoseconds":477000000}},{"id":"nc2yZJ8UqeNtG9vOsFoT","level":"a0-tout-public","lesson":1,"part":8,"type":"text","name":"ab-adults-l01-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":934000000}},{"id":"rzFXa9N1Vsu5MXMXsBqP","level":"a0-tout-public","lesson":1,"part":9,"type":"text","name":"ab-adults-l01-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonsoir ! Oh, pardon, il est dix-huit heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening! Oh, sorry, it's six in the evening.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonsoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonsoir !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":910000000}},{"id":"N4d9PPK37uYvWkHI8wLG","level":"a0-tout-public","lesson":1,"part":10,"type":"text","name":"ab-adults-l01-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À bientôt !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":903000000}},{"id":"XkXZsr67AUb8Dpc2ywBt","level":"a0-tout-public","lesson":1,"part":11,"type":"text","name":"ab-adults-l01-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793275867,"_nanoseconds":937000000}},{"id":"qKcmGOmHGGHDKTgRUFLD","level":"a0-tout-public","lesson":1,"part":12,"type":"text","name":"ab-adults-l01-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous entrez dans un magasin. Vous voyez le vendeur.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You walk into a shop and see the shop assistant.</p><p><b>Greet the assistant, then say goodbye when you leave.</b></p><p style=\"opacity:.7;\">For example: “Bonjour ! ... Au revoir !”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Bonjour ! ... Au revoir !","size":null,"created":{"_seconds":1793275868,"_nanoseconds":400000000}},{"id":"ZvV3F1B5SvsNT9ZV3eR4","level":"a0-tout-public","lesson":1,"part":13,"type":"text","name":"ab-adults-l01-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👋</div><p><b>First words spoken!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can now greet people at any time of day and say goodbye in two ways. That is a real start.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275868,"_nanoseconds":428000000}}]