[{"id":"6kzBdxhVTh6ncHPzXywX","level":"a0-tout-public","lesson":23,"part":1,"type":"text","name":"ab-adults-l23-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you describe your day in simple steps. You learn a few daily verbs and put them with times. It uses numbers, hours and meals from earlier lessons. At the end, you will be able to say what you do, and when, from morning to evening.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275907,"_nanoseconds":312000000}},{"id":"avCJZnlDpyg1A7t385Z3","level":"a0-tout-public","lesson":23,"part":2,"type":"text","name":"ab-adults-l23-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌅</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A daily timeline from sunrise to evening</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275907,"_nanoseconds":315000000}},{"id":"L7JQIVSxqJNiIJncGGA1","level":"a0-tout-public","lesson":23,"part":2,"type":"text","name":"ab-adults-l23-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Useful verbs: je travaille, I work. Je mange, I eat. Je rentre, I go home. Je dors, I sleep. Je me lève, I get up. Put them with à plus the hour, as in je me lève à six heures. Use le matin, l'après-midi and le soir for morning, afternoon and evening.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me lève à six heures.</b><span style=\"opacity:.7;\"> · I get up at six.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je travaille à neuf heures.</b><span style=\"opacity:.7;\"> · I start work at nine.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je mange à midi.</b><span style=\"opacity:.7;\"> · I eat at noon.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je rentre le soir.</b><span style=\"opacity:.7;\"> · I go home in the evening.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275907,"_nanoseconds":333000000}},{"id":"xrFCaheNa6NVu3EmGoSH","level":"a0-tout-public","lesson":23,"part":3,"type":"text","name":"ab-adults-l23-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me lève à six heures.</b></p><p style=\"opacity:.75;margin:0;\">I get up at six.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me lève à six heures.","size":null,"created":{"_seconds":1793275907,"_nanoseconds":358000000}},{"id":"EKkNWkorQsufasiOPR9f","level":"a0-tout-public","lesson":23,"part":4,"type":"text","name":"ab-adults-l23-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je travaille à neuf heures.</b></p><p style=\"opacity:.75;margin:0;\">I start work at nine.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je travaille à neuf heures.","size":null,"created":{"_seconds":1793275907,"_nanoseconds":847000000}},{"id":"LEIusy3cF7i2r0R1Cx0J","level":"a0-tout-public","lesson":23,"part":5,"type":"text","name":"ab-adults-l23-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je mange à midi.</b></p><p style=\"opacity:.75;margin:0;\">I eat at noon.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je mange à midi.","size":null,"created":{"_seconds":1793275907,"_nanoseconds":795000000}},{"id":"eVGIzcojwAO3eZCN2aZp","level":"a0-tout-public","lesson":23,"part":6,"type":"text","name":"ab-adults-l23-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je rentre le soir.</b></p><p style=\"opacity:.75;margin:0;\">I go home in the evening.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je rentre le soir.","size":null,"created":{"_seconds":1793275907,"_nanoseconds":803000000}},{"id":"7ZZ1wO09GMs9q5EivQRd","level":"a0-tout-public","lesson":23,"part":7,"type":"text","name":"ab-adults-l23-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parlez-moi de votre journée. Vous vous levez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about your day. What time do you get up?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je me lève à six heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I get up at six.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous travaillez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And when do you work?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je travaille à neuf heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I start work at nine.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À midi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At noon?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je mange à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat at noon.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je rentre le soir. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I go home in the evening. Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275907,"_nanoseconds":840000000}},{"id":"B1P72BJPnMTf5MiT86MT","level":"a0-tout-public","lesson":23,"part":8,"type":"text","name":"ab-adults-l23-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275908,"_nanoseconds":325000000}},{"id":"9rGqjvMOr4bxtYeokQI8","level":"a0-tout-public","lesson":23,"part":9,"type":"text","name":"ab-adults-l23-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Parlez-moi de votre journée. Vous vous levez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about your day. What time do you get up?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je me lève à six heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I get up at six.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je me lève à six heures.","size":null,"created":{"_seconds":1793275908,"_nanoseconds":329000000}},{"id":"uOSw1yKYKvrYomdqM1oB","level":"a0-tout-public","lesson":23,"part":10,"type":"text","name":"ab-adults-l23-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous travaillez à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And when do you work?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je travaille à neuf heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I start work at nine.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je travaille à neuf heures.","size":null,"created":{"_seconds":1793275908,"_nanoseconds":330000000}},{"id":"ZkQhrHqh32f6uw68TmHc","level":"a0-tout-public","lesson":23,"part":11,"type":"text","name":"ab-adults-l23-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À midi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At noon?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je mange à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat at noon.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je mange à midi.","size":null,"created":{"_seconds":1793275908,"_nanoseconds":329000000}},{"id":"lcoLNQwoVTucLcvkSybt","level":"a0-tout-public","lesson":23,"part":12,"type":"text","name":"ab-adults-l23-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je rentre le soir. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I go home in the evening. Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je rentre le soir. Au revoir !","size":null,"created":{"_seconds":1793275908,"_nanoseconds":819000000}},{"id":"bDqTK3OspVp7RJ8StjXg","level":"a0-tout-public","lesson":23,"part":13,"type":"text","name":"ab-adults-l23-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez votre journée.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe your day.</p><p><b>Say three things you do, with times.</b></p><p style=\"opacity:.7;\">For example: “Je me lève à six heures. Je travaille à neuf heures. Je mange à midi.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je me lève à six heures. Je travaille à neuf heures. Je mange à midi.","size":null,"created":{"_seconds":1793275908,"_nanoseconds":816000000}},{"id":"OnD31cHt2YOZRT2M5bRI","level":"a0-tout-public","lesson":23,"part":14,"type":"text","name":"ab-adults-l23-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌅</div><p><b>Day described!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe your day with times. That is a big step toward real conversation.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275908,"_nanoseconds":820000000}}]