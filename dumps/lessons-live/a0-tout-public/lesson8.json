[{"id":"FUxuqbM6KdPlzkXkQ4pS","level":"a0-tout-public","lesson":8,"part":1,"type":"text","name":"ab-adults-l08-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you will talk about languages: which ones you speak, and how well. This is very natural in French conversations, since people often ask. The new words are je parle, I speak, and un peu, a little. We keep everything from before in the conversation.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275878,"_nanoseconds":603000000}},{"id":"KD46t5ezhKa47n8Xp8hw","level":"a0-tout-public","lesson":8,"part":2,"type":"text","name":"ab-adults-l08-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗣️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Speech bubbles in French and English</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275878,"_nanoseconds":612000000}},{"id":"73vghv2h67wXKbi4Qg2T","level":"a0-tout-public","lesson":8,"part":2,"type":"text","name":"ab-adults-l08-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je parle anglais means I speak English. Je parle français means I speak French. Add un peu for a little, as in je parle un peu français. To ask, say vous parlez quelles langues.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je parle anglais.</b><span style=\"opacity:.7;\"> · I speak English.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je parle un peu français.</b><span style=\"opacity:.7;\"> · I speak a little French.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous parlez quelles langues ?</b><span style=\"opacity:.7;\"> · Which languages do you speak?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275878,"_nanoseconds":720000000}},{"id":"IPNI264OhJQLvlVwu0jt","level":"a0-tout-public","lesson":8,"part":3,"type":"text","name":"ab-adults-l08-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je parle anglais.</b></p><p style=\"opacity:.75;margin:0;\">I speak English.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je parle anglais.","size":null,"created":{"_seconds":1793275878,"_nanoseconds":835000000}},{"id":"xVqo8T0n3CaFPJd8Fh4U","level":"a0-tout-public","lesson":8,"part":4,"type":"text","name":"ab-adults-l08-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je parle un peu français.</b></p><p style=\"opacity:.75;margin:0;\">I speak a little French.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je parle un peu français.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":13000000}},{"id":"RUQ8OaRn5AYewyxMZBsk","level":"a0-tout-public","lesson":8,"part":5,"type":"text","name":"ab-adults-l08-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous parlez quelles langues ?</b></p><p style=\"opacity:.75;margin:0;\">Which languages do you speak?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vous parlez quelles langues ?","size":null,"created":{"_seconds":1793275879,"_nanoseconds":33000000}},{"id":"55twx5Rc3xSvTAmamI2P","level":"a0-tout-public","lesson":8,"part":6,"type":"text","name":"ab-adults-l08-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je m'appelle Camille. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille. And you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where are you from?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je viens du Ghana.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous parlez quelles langues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which languages do you speak?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je parle anglais.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I speak English.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And French?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je parle un peu français.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I speak a little French.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>C'est très bien ! Moi, je parle français et anglais.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's very good! I speak French and English.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bravo ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great! Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275879,"_nanoseconds":146000000}},{"id":"RDp7QXLgsBHWm0wJPNAU","level":"a0-tout-public","lesson":8,"part":7,"type":"text","name":"ab-adults-l08-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je m'appelle Camille. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille. And you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":257000000}},{"id":"B8s0O7a4g5pIc7rKUxn4","level":"a0-tout-public","lesson":8,"part":8,"type":"text","name":"ab-adults-l08-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where are you from?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je viens du Ghana.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je viens du Ghana.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":413000000}},{"id":"z2MVhzliRnlhO7AwgIXR","level":"a0-tout-public","lesson":8,"part":9,"type":"text","name":"ab-adults-l08-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous parlez quelles langues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which languages do you speak?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je parle anglais.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I speak English.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je parle anglais.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":438000000}},{"id":"4t381LlH3UdUSOB7uWJ9","level":"a0-tout-public","lesson":8,"part":10,"type":"text","name":"ab-adults-l08-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le français ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And French?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je parle un peu français.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I speak a little French.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je parle un peu français.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":548000000}},{"id":"dalxLtnjAfNyqFGqk4HE","level":"a0-tout-public","lesson":8,"part":11,"type":"text","name":"ab-adults-l08-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>C'est très bien ! Moi, je parle français et anglais.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's very good! I speak French and English.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bravo ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great! Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bravo ! Au revoir !","size":null,"created":{"_seconds":1793275879,"_nanoseconds":667000000}},{"id":"2qPfMDdrEdrjUKdzh5v2","level":"a0-tout-public","lesson":8,"part":12,"type":"text","name":"ab-adults-l08-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous parlez quelles langues ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Which languages do you speak?</p><p><b>Say which languages you speak, and how well you speak French.</b></p><p style=\"opacity:.7;\">For example: “Je parle anglais. Je parle un peu français.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je parle anglais. Je parle un peu français.","size":null,"created":{"_seconds":1793275879,"_nanoseconds":809000000}},{"id":"qkj0iT4BkMHY7qwd6gSS","level":"a0-tout-public","lesson":8,"part":13,"type":"text","name":"ab-adults-l08-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗣️</div><p><b>Languages unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say which languages you speak and how well. You also practised nationalities without any tricky endings.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275879,"_nanoseconds":843000000}}]