[{"id":"xGFXANGJELmYzXqPM01r","level":"a0-tout-public","lesson":14,"part":1,"type":"text","name":"ab-adults-l14-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you tell the time. French people say il est, followed by the hour, with heures for hours. It is a lot like the numbers you already know. We also add minutes, a quarter, and half an hour. Keep your numbers from lesson five in mind.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275889,"_nanoseconds":471000000}},{"id":"B2c1hDugekgbEjJs0MDA","level":"a0-tout-public","lesson":14,"part":2,"type":"text","name":"ab-adults-l14-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏰</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A clock showing half past ten</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275889,"_nanoseconds":516000000}},{"id":"vXN2DOgPBsIeyxA8frHt","level":"a0-tout-public","lesson":14,"part":2,"type":"text","name":"ab-adults-l14-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Il est trois heures means it's three o'clock. Add et quart for quarter past, et demie for half past, moins le quart for quarter to. Midi is noon, minuit is midnight. To ask, say quelle heure est-il.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quelle heure est-il ?</b><span style=\"opacity:.7;\"> · What time is it?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est trois heures.</b><span style=\"opacity:.7;\"> · It's three o'clock.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est dix heures et demie.</b><span style=\"opacity:.7;\"> · It's half past ten.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il est midi.</b><span style=\"opacity:.7;\"> · It's noon.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275889,"_nanoseconds":471000000}},{"id":"PYSxYie8NX3pxpFKZ0Fa","level":"a0-tout-public","lesson":14,"part":3,"type":"text","name":"ab-adults-l14-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quelle heure est-il ?</b></p><p style=\"opacity:.75;margin:0;\">What time is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Quelle heure est-il ?","size":null,"created":{"_seconds":1793275889,"_nanoseconds":983000000}},{"id":"DzRzn710MudqIN5XTV7d","level":"a0-tout-public","lesson":14,"part":4,"type":"text","name":"ab-adults-l14-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est trois heures.</b></p><p style=\"opacity:.75;margin:0;\">It's three o'clock.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est trois heures.","size":null,"created":{"_seconds":1793275889,"_nanoseconds":982000000}},{"id":"ZEJaZvtzpTIvFMDI5OYy","level":"a0-tout-public","lesson":14,"part":5,"type":"text","name":"ab-adults-l14-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est dix heures et demie.</b></p><p style=\"opacity:.75;margin:0;\">It's half past ten.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est dix heures et demie.","size":null,"created":{"_seconds":1793275889,"_nanoseconds":985000000}},{"id":"wLBh5dbxihQvaKEyaNS9","level":"a0-tout-public","lesson":14,"part":6,"type":"text","name":"ab-adults-l14-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il est midi.</b></p><p style=\"opacity:.75;margin:0;\">It's noon.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il est midi.","size":null,"created":{"_seconds":1793275889,"_nanoseconds":990000000}},{"id":"qLDy2oOKB0rX6WT3Z4aC","level":"a0-tout-public","lesson":14,"part":7,"type":"text","name":"ab-adults-l14-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle heure est-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il est trois heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's three o'clock.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et maintenant ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And now?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il est dix heures et demie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's half past ten.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À quelle heure vous déjeunez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do you have lunch?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je déjeune à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have lunch at noon.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parfait ! Quel jour est la réunion ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect! What day is the meeting?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>La réunion est lundi à neuf heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The meeting is Monday at nine.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275890,"_nanoseconds":505000000}},{"id":"o8gWGKvxlxcLFTZnMnF0","level":"a0-tout-public","lesson":14,"part":8,"type":"text","name":"ab-adults-l14-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275890,"_nanoseconds":516000000}},{"id":"rF6tMdYTE5Rkr65QkUud","level":"a0-tout-public","lesson":14,"part":9,"type":"text","name":"ab-adults-l14-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle heure est-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il est trois heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's three o'clock.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il est trois heures.","size":null,"created":{"_seconds":1793275890,"_nanoseconds":498000000}},{"id":"nU8YvslNv1QnzmpKkeUK","level":"a0-tout-public","lesson":14,"part":10,"type":"text","name":"ab-adults-l14-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et maintenant ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And now?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il est dix heures et demie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's half past ten.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il est dix heures et demie.","size":null,"created":{"_seconds":1793275890,"_nanoseconds":502000000}},{"id":"w5GF0XKDQ68WMZyzcrIe","level":"a0-tout-public","lesson":14,"part":11,"type":"text","name":"ab-adults-l14-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À quelle heure vous déjeunez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do you have lunch?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je déjeune à midi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have lunch at noon.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je déjeune à midi.","size":null,"created":{"_seconds":1793275891,"_nanoseconds":5000000}},{"id":"1heXzyQwGlFzEC3XfzAI","level":"a0-tout-public","lesson":14,"part":12,"type":"text","name":"ab-adults-l14-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Parfait ! Quel jour est la réunion ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect! What day is the meeting?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">La réunion est lundi à neuf heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The meeting is Monday at nine.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"La réunion est lundi à neuf heures.","size":null,"created":{"_seconds":1793275891,"_nanoseconds":98000000}},{"id":"RB5UaKhU8ThXQitZeX56","level":"a0-tout-public","lesson":14,"part":13,"type":"text","name":"ab-adults-l14-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Quelle heure est-il maintenant ? À quelle heure vous déjeunez ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What time is it now? When do you have lunch?</p><p><b>Say a time, and when you have lunch.</b></p><p style=\"opacity:.7;\">For example: “Il est trois heures. Je déjeune à midi.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Il est trois heures. Je déjeune à midi.","size":null,"created":{"_seconds":1793275891,"_nanoseconds":52000000}},{"id":"4LczAUnZ1h06o2Oq9KA0","level":"a0-tout-public","lesson":14,"part":14,"type":"text","name":"ab-adults-l14-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⏰</div><p><b>On time!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can tell the time and say when you do things. Combine it with days from last lesson for plans.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275891,"_nanoseconds":12000000}}]