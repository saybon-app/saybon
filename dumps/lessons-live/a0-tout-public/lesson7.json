[{"id":"1iiBDnAFveiT1nBEdh2s","level":"a0-tout-public","lesson":7,"part":1,"type":"text","name":"ab-adults-l07-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Where are you from? It is one of the first questions people ask. Today you learn to say your country or city and to ask the same back. We add this to everything you already have: greetings, names, how you are, your age and spelling.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275876,"_nanoseconds":979000000}},{"id":"xDuW4h0rSaxkhkfZemrZ","level":"a0-tout-public","lesson":7,"part":2,"type":"text","name":"ab-adults-l07-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌍</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A world map with a pin on Ghana and a pin on Lyon</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275877,"_nanoseconds":66000000}},{"id":"6GAOlr0eUsOHCCy5OzeB","level":"a0-tout-public","lesson":7,"part":2,"type":"text","name":"ab-adults-l07-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To ask where someone is from, say vous venez d'où, or d'où venez-vous. To answer, say je viens de, then the place. With countries that start with a vowel or are feminine, use de, as in je viens de France. For masculine countries, use du, as in je viens du Ghana.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>D'où venez-vous ?</b><span style=\"opacity:.7;\"> · Where are you from?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je viens du Ghana.</b><span style=\"opacity:.7;\"> · I come from Ghana.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je viens de France.</b><span style=\"opacity:.7;\"> · I come from France.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Et vous ?</b><span style=\"opacity:.7;\"> · And you?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275876,"_nanoseconds":975000000}},{"id":"Io4v02FzAGMYZ8QhhEgh","level":"a0-tout-public","lesson":7,"part":3,"type":"text","name":"ab-adults-l07-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>D'où venez-vous ?</b></p><p style=\"opacity:.75;margin:0;\">Where are you from?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"D'où venez-vous ?","size":null,"created":{"_seconds":1793275877,"_nanoseconds":328000000}},{"id":"cdkJDwx9Irbhed70TUkQ","level":"a0-tout-public","lesson":7,"part":4,"type":"text","name":"ab-adults-l07-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je viens du Ghana.</b></p><p style=\"opacity:.75;margin:0;\">I come from Ghana.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je viens du Ghana.","size":null,"created":{"_seconds":1793275877,"_nanoseconds":396000000}},{"id":"P8tFKyeqgy4epUK0lPwT","level":"a0-tout-public","lesson":7,"part":5,"type":"text","name":"ab-adults-l07-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je viens de France.</b></p><p style=\"opacity:.75;margin:0;\">I come from France.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je viens de France.","size":null,"created":{"_seconds":1793275877,"_nanoseconds":384000000}},{"id":"xL7yIk94Nt5GN9azaHKY","level":"a0-tout-public","lesson":7,"part":6,"type":"text","name":"ab-adults-l07-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Et vous ?</b></p><p style=\"opacity:.75;margin:0;\">And you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Et vous ?","size":null,"created":{"_seconds":1793275877,"_nanoseconds":480000000}},{"id":"TG9b9yrnB684ggBn6eXu","level":"a0-tout-public","lesson":7,"part":7,"type":"text","name":"ab-adults-l07-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Where are you from?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je viens du Ghana.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ah, le Ghana ! Moi, je viens de Lyon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, Ghana! I'm from Lyon.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Lyon, en France ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Lyon, in France?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, exactement. Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, exactly. How old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Enchantée. À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you. See you soon!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275877,"_nanoseconds":774000000}},{"id":"naJg3rrzgpnooArhHwz5","level":"a0-tout-public","lesson":7,"part":8,"type":"text","name":"ab-adults-l07-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275877,"_nanoseconds":785000000}},{"id":"CeZhos1A0eZbmYYg37u8","level":"a0-tout-public","lesson":7,"part":9,"type":"text","name":"ab-adults-l07-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. D'où venez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Where are you from?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je viens du Ghana.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I come from Ghana.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je viens du Ghana.","size":null,"created":{"_seconds":1793275877,"_nanoseconds":802000000}},{"id":"dYSncwRlVqGTGXSLNuvB","level":"a0-tout-public","lesson":7,"part":10,"type":"text","name":"ab-adults-l07-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ah, le Ghana ! Moi, je viens de Lyon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, Ghana! I'm from Lyon.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Lyon, en France ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Lyon, in France?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Lyon, en France ?","size":null,"created":{"_seconds":1793275877,"_nanoseconds":915000000}},{"id":"qU6RauqJ6KSRmUlwcB5U","level":"a0-tout-public","lesson":7,"part":11,"type":"text","name":"ab-adults-l07-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, exactement. Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, exactly. How old are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai vingt ans.","size":null,"created":{"_seconds":1793275878,"_nanoseconds":199000000}},{"id":"USmiDQpjWc1hOEOccQmE","level":"a0-tout-public","lesson":7,"part":12,"type":"text","name":"ab-adults-l07-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Enchantée. À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you. See you soon!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">See you soon!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À bientôt !","size":null,"created":{"_seconds":1793275878,"_nanoseconds":208000000}},{"id":"ILhDDhYeJ7iJCLjzzb9M","level":"a0-tout-public","lesson":7,"part":13,"type":"text","name":"ab-adults-l07-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>D'où venez-vous ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Where are you from?</p><p><b>Say where you come from, and ask the teacher.</b></p><p style=\"opacity:.7;\">For example: “Je viens du Ghana. Et vous ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je viens du Ghana. Et vous ?","size":null,"created":{"_seconds":1793275878,"_nanoseconds":263000000}},{"id":"Hf17NKvgSLM8RjbsXffI","level":"a0-tout-public","lesson":7,"part":14,"type":"text","name":"ab-adults-l07-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌍</div><p><b>Passport stamped!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say where you come from and ask the same. That alone makes many conversations start easily.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275878,"_nanoseconds":381000000}}]