[{"id":"CFW56J2tw5L0CNKkSG6G","level":"a0-tout-public","lesson":24,"part":1,"type":"text","name":"ab-adults-l24-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! This is the most useful survival lesson. When you do not understand, you do not need to panic. You just say so, in French, and ask the other person to repeat or to speak slowly. French people are happy to help when you try. These phrases will make you feel safe in any conversation.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275908,"_nanoseconds":824000000}},{"id":"f4dt45aRCfCRckx022NO","level":"a0-tout-public","lesson":24,"part":2,"type":"text","name":"ab-adults-l24-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛟</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A lifebuoy beside a speech bubble with a question mark</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275909,"_nanoseconds":229000000}},{"id":"ElQzY6ThC0fDdkxWDWvE","level":"a0-tout-public","lesson":24,"part":2,"type":"text","name":"ab-adults-l24-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je ne comprends pas means I don't understand. Pouvez-vous répéter, s'il vous plaît, means can you repeat please. Parlez plus lentement means speak more slowly. Qu'est-ce que ça veut dire means what does that mean. And comment dit-on in French means how do you say.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je ne comprends pas.</b><span style=\"opacity:.7;\"> · I don't understand.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pouvez-vous répéter, s'il vous plaît ?</b><span style=\"opacity:.7;\"> · Can you repeat, please?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Parlez plus lentement, s'il vous plaît.</b><span style=\"opacity:.7;\"> · Speak more slowly, please.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Qu'est-ce que ça veut dire ?</b><span style=\"opacity:.7;\"> · What does that mean?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275909,"_nanoseconds":226000000}},{"id":"YpkrrfXAqT6mVcy9sXwj","level":"a0-tout-public","lesson":24,"part":3,"type":"text","name":"ab-adults-l24-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je ne comprends pas.</b></p><p style=\"opacity:.75;margin:0;\">I don't understand.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je ne comprends pas.","size":null,"created":{"_seconds":1793275909,"_nanoseconds":230000000}},{"id":"Biy6aqIUT28TLCNsrzt8","level":"a0-tout-public","lesson":24,"part":4,"type":"text","name":"ab-adults-l24-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pouvez-vous répéter, s'il vous plaît ?</b></p><p style=\"opacity:.75;margin:0;\">Can you repeat, please?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pouvez-vous répéter, s'il vous plaît ?","size":null,"created":{"_seconds":1793275909,"_nanoseconds":228000000}},{"id":"Jg4x9wwq9qqmjYJF99ha","level":"a0-tout-public","lesson":24,"part":5,"type":"text","name":"ab-adults-l24-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Parlez plus lentement, s'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">Speak more slowly, please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Parlez plus lentement, s'il vous plaît.","size":null,"created":{"_seconds":1793275910,"_nanoseconds":102000000}},{"id":"6cYfPeor9BJtSqlOBkPr","level":"a0-tout-public","lesson":24,"part":6,"type":"text","name":"ab-adults-l24-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Qu'est-ce que ça veut dire ?</b></p><p style=\"opacity:.75;margin:0;\">What does that mean?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Qu'est-ce que ça veut dire ?","size":null,"created":{"_seconds":1793275910,"_nanoseconds":98000000}},{"id":"2ZOEFKwHGcHuINT6pdAr","level":"a0-tout-public","lesson":24,"part":7,"type":"text","name":"ab-adults-l24-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Votre carte d'identité, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Your ID card, please.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Pardon, je ne comprends pas.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Sorry, I don't understand.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre carte d'identité.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your ID card.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Pouvez-vous répéter, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Can you repeat, please?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre carte, madame ou monsieur, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your card, please.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Parlez plus lentement, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Speak more slowly, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ah, d'accord. Votre... carte... d'identité.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, all right. Your... card... of identity.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ah, d'accord ! Voilà.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, I see! Here you go.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Are you OK?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, merci beaucoup. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, thank you very much. Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275910,"_nanoseconds":152000000}},{"id":"MCZqOd1tZQzQ3J4JnOv0","level":"a0-tout-public","lesson":24,"part":8,"type":"text","name":"ab-adults-l24-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Votre carte d'identité, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Your ID card, please.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Pardon, je ne comprends pas.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Sorry, I don't understand.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Pardon, je ne comprends pas.","size":null,"created":{"_seconds":1793275910,"_nanoseconds":126000000}},{"id":"zddCVa7k6kMt0mK5hY7d","level":"a0-tout-public","lesson":24,"part":9,"type":"text","name":"ab-adults-l24-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Votre carte d'identité.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your ID card.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Pouvez-vous répéter, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Can you repeat, please?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Pouvez-vous répéter, s'il vous plaît ?","size":null,"created":{"_seconds":1793275910,"_nanoseconds":558000000}},{"id":"YAyE5ybsg1BTczQ4JX4j","level":"a0-tout-public","lesson":24,"part":10,"type":"text","name":"ab-adults-l24-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Votre carte, madame ou monsieur, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Your card, please.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Parlez plus lentement, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Speak more slowly, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Parlez plus lentement, s'il vous plaît.","size":null,"created":{"_seconds":1793275910,"_nanoseconds":577000000}},{"id":"nujCtXBzE6dErgEFJfkh","level":"a0-tout-public","lesson":24,"part":11,"type":"text","name":"ab-adults-l24-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ah, d'accord. Votre... carte... d'identité.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, all right. Your... card... of identity.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ah, d'accord ! Voilà.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Ah, I see! Here you go.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ah, d'accord ! Voilà.","size":null,"created":{"_seconds":1793275910,"_nanoseconds":563000000}},{"id":"VN3bbtR2TG75dRJLkSVM","level":"a0-tout-public","lesson":24,"part":12,"type":"text","name":"ab-adults-l24-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Are you OK?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, merci beaucoup. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, thank you very much. Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, merci beaucoup. Au revoir !","size":null,"created":{"_seconds":1793275910,"_nanoseconds":559000000}},{"id":"0LVT3MZnbWg4Shy2f4uq","level":"a0-tout-public","lesson":24,"part":13,"type":"text","name":"ab-adults-l24-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Quelqu'un parle trop vite. Que dites-vous ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Someone speaks too fast. What do you say?</p><p><b>Say you don't understand, and ask them to repeat slowly.</b></p><p style=\"opacity:.7;\">For example: “Je ne comprends pas. Pouvez-vous répéter plus lentement, s'il vous plaît ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je ne comprends pas. Pouvez-vous répéter plus lentement, s'il vous plaît ?","size":null,"created":{"_seconds":1793275910,"_nanoseconds":967000000}},{"id":"ltJZZMNp9ZlOYuMpUJdZ","level":"a0-tout-public","lesson":24,"part":14,"type":"text","name":"ab-adults-l24-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛟</div><p><b>Lifeline in your pocket!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You now have the lifeline phrases for any conversation: you can ask for help in French. Use them without shame.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275910,"_nanoseconds":969000000}}]