[{"id":"nggFajOWlDwGADgAUcFi","level":"a0-tout-public","lesson":16,"part":1,"type":"text","name":"ab-adults-l16-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we look closely at politeness. French people notice politeness a lot, and a few formulas make a big difference. You learn when to say s'il vous plaît, merci beaucoup, de rien, pardon and excusez-moi. We use them in a conversation in the street.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275893,"_nanoseconds":227000000}},{"id":"KP8nI2SXtYj4uHNAL5cZ","level":"a0-tout-public","lesson":16,"part":2,"type":"text","name":"ab-adults-l16-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙏</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two strangers on a busy street, one asking the time</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275893,"_nanoseconds":770000000}},{"id":"uXpQoPA6jdtc7T4tyy9N","level":"a0-tout-public","lesson":16,"part":2,"type":"text","name":"ab-adults-l16-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 S'il vous plaît means please. Merci or merci beaucoup means thank you or thank you very much. De rien or je vous en prie means you're welcome. Excusez-moi is for getting attention, pardon for apologising or when you bump into someone.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Excusez-moi !</b><span style=\"opacity:.7;\"> · Excuse me!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>S'il vous plaît.</b><span style=\"opacity:.7;\"> · Please.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Merci beaucoup.</b><span style=\"opacity:.7;\"> · Thank you very much.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>De rien. / Je vous en prie.</b><span style=\"opacity:.7;\"> · You're welcome.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275893,"_nanoseconds":772000000}},{"id":"NmmJfSE3YTGicbWD9L7O","level":"a0-tout-public","lesson":16,"part":3,"type":"text","name":"ab-adults-l16-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Excusez-moi !</b></p><p style=\"opacity:.75;margin:0;\">Excuse me!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Excusez-moi !","size":null,"created":{"_seconds":1793275893,"_nanoseconds":823000000}},{"id":"aZqUDW2Q613v9E1dEs1S","level":"a0-tout-public","lesson":16,"part":4,"type":"text","name":"ab-adults-l16-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>S'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">Please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"S'il vous plaît.","size":null,"created":{"_seconds":1793275893,"_nanoseconds":773000000}},{"id":"pmEC0JQqUNsCUb7ZM8zf","level":"a0-tout-public","lesson":16,"part":5,"type":"text","name":"ab-adults-l16-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Merci beaucoup.</b></p><p style=\"opacity:.75;margin:0;\">Thank you very much.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Merci beaucoup.","size":null,"created":{"_seconds":1793275894,"_nanoseconds":280000000}},{"id":"QEg5NHFdEJFxhR1Db4el","level":"a0-tout-public","lesson":16,"part":6,"type":"text","name":"ab-adults-l16-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>De rien. / Je vous en prie.</b></p><p style=\"opacity:.75;margin:0;\">You're welcome.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"De rien. / Je vous en prie.","size":null,"created":{"_seconds":1793275894,"_nanoseconds":278000000}},{"id":"6u88qKOOhNWw3y7fq99E","level":"a0-tout-public","lesson":16,"part":7,"type":"text","name":"ab-adults-l16-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Excusez-moi, vous avez l'heure, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Excuse me, do you have the time, please?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui. Il est quatre heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes. It's four o'clock.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>De rien. Oh, pardon, j'ai marché sur votre pied !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Oh, sorry, I stepped on your foot!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce n'est pas grave.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's not serious.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you all right?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, ça va, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm fine, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, have a nice day!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275894,"_nanoseconds":285000000}},{"id":"XKDSzI0sZeGTh8knlC0m","level":"a0-tout-public","lesson":16,"part":8,"type":"text","name":"ab-adults-l16-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Excusez-moi, vous avez l'heure, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Excuse me, do you have the time, please?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Excusez-moi, vous avez l'heure, s'il vous plaît ?","size":null,"created":{"_seconds":1793275894,"_nanoseconds":281000000}},{"id":"k5SsC2oZz0OGH3GSTmWW","level":"a0-tout-public","lesson":16,"part":9,"type":"text","name":"ab-adults-l16-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui. Il est quatre heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes. It's four o'clock.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup !","size":null,"created":{"_seconds":1793275894,"_nanoseconds":814000000}},{"id":"6QB9BcouSAL16e9zUWMX","level":"a0-tout-public","lesson":16,"part":10,"type":"text","name":"ab-adults-l16-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>De rien. Oh, pardon, j'ai marché sur votre pied !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Oh, sorry, I stepped on your foot!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ce n'est pas grave.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's not serious.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ce n'est pas grave.","size":null,"created":{"_seconds":1793275894,"_nanoseconds":812000000}},{"id":"kwjEIXdZUXTMQESMUIoX","level":"a0-tout-public","lesson":16,"part":11,"type":"text","name":"ab-adults-l16-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you all right?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, ça va, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm fine, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, ça va, merci.","size":null,"created":{"_seconds":1793275894,"_nanoseconds":826000000}},{"id":"CkKzwy1dbjtJDII08txu","level":"a0-tout-public","lesson":16,"part":12,"type":"text","name":"ab-adults-l16-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, have a nice day!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir, bonne journée !","size":null,"created":{"_seconds":1793275894,"_nanoseconds":826000000}},{"id":"w2aInvrhwyo9hQSZvqWW","level":"a0-tout-public","lesson":16,"part":13,"type":"text","name":"ab-adults-l16-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous voulez demander l'heure à un inconnu.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You want to ask a stranger the time.</p><p><b>Ask politely, then thank the person.</b></p><p style=\"opacity:.7;\">For example: “Excusez-moi, vous avez l'heure, s'il vous plaît ? Merci beaucoup !”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Excusez-moi, vous avez l'heure, s'il vous plaît ? Merci beaucoup !","size":null,"created":{"_seconds":1793275895,"_nanoseconds":372000000}},{"id":"pDxqfHDvDoVEBBwEh0Q2","level":"a0-tout-public","lesson":16,"part":14,"type":"text","name":"ab-adults-l16-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙏</div><p><b>Perfectly polite!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You now have the polite formulas the French really expect. Using them makes everything go more smoothly.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275895,"_nanoseconds":326000000}}]