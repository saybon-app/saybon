[{"id":"YKHZbGP1ALu9w1lOd4Hb","level":"a0-tout-public","lesson":18,"part":1,"type":"text","name":"ab-adults-l18-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we go beyond twenty. You learn the tens, and how prices are said, in euros. French counting has some surprises, like seventy being sixty-ten. But the pattern is regular once you see it. Practise out loud, because your mouth needs the repetition.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275897,"_nanoseconds":405000000}},{"id":"c2z7ZnYkHjk1uFOPxj8x","level":"a0-tout-public","lesson":18,"part":2,"type":"text","name":"ab-adults-l18-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💶</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A shop price tag of forty euros</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275897,"_nanoseconds":346000000}},{"id":"a1IBqF1iOKRJRxmVx5jz","level":"a0-tout-public","lesson":18,"part":2,"type":"text","name":"ab-adults-l18-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Vingt is twenty, trente thirty, quarante forty, cinquante fifty, soixante sixty. Seventy is soixante-dix, sixty-ten. Eighty is quatre-vingts, four twenties. Ninety is quatre-vingt-dix. And cent is one hundred. For prices, say deux euros cinquante.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Trente, quarante, cinquante</b><span style=\"opacity:.7;\"> · Thirty, forty, fifty</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Soixante, soixante-dix</b><span style=\"opacity:.7;\"> · Sixty, seventy</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quatre-vingts, quatre-vingt-dix, cent</b><span style=\"opacity:.7;\"> · Eighty, ninety, one hundred</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça coûte combien ?</b><span style=\"opacity:.7;\"> · How much is it?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275897,"_nanoseconds":349000000}},{"id":"7r37jwhpDY4qlun53nG0","level":"a0-tout-public","lesson":18,"part":3,"type":"text","name":"ab-adults-l18-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Trente, quarante, cinquante</b></p><p style=\"opacity:.75;margin:0;\">Thirty, forty, fifty</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Trente, quarante, cinquante","size":null,"created":{"_seconds":1793275897,"_nanoseconds":807000000}},{"id":"38Cab7GNc4TsEnx5q27k","level":"a0-tout-public","lesson":18,"part":4,"type":"text","name":"ab-adults-l18-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Soixante, soixante-dix</b></p><p style=\"opacity:.75;margin:0;\">Sixty, seventy</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Soixante, soixante-dix","size":null,"created":{"_seconds":1793275897,"_nanoseconds":784000000}},{"id":"09RNVnwYuuC9FstVOSHu","level":"a0-tout-public","lesson":18,"part":5,"type":"text","name":"ab-adults-l18-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quatre-vingts, quatre-vingt-dix, cent</b></p><p style=\"opacity:.75;margin:0;\">Eighty, ninety, one hundred</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Quatre-vingts, quatre-vingt-dix, cent","size":null,"created":{"_seconds":1793275897,"_nanoseconds":766000000}},{"id":"15Au97lQLCTMfcj3odjc","level":"a0-tout-public","lesson":18,"part":6,"type":"text","name":"ab-adults-l18-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça coûte combien ?</b></p><p style=\"opacity:.75;margin:0;\">How much is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça coûte combien ?","size":null,"created":{"_seconds":1793275897,"_nanoseconds":811000000}},{"id":"la7d8zYu5rRRXKz0yORS","level":"a0-tout-public","lesson":18,"part":7,"type":"text","name":"ab-adults-l18-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je voudrais un sac, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a bag, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà. Il est noir ou rouge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Black or red?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Noir, s'il vous plaît. Ça coûte combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Black, please. How much is it?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça coûte quarante euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It costs forty euros.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quarante euros, d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Forty euros, all right.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le livre ? Soixante-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the book? Seventy euros.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est cher ! Quatre-vingts euros en tout ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's expensive! Eighty euros in total?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Non, cent dix euros. Mais je vous fais un prix.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, one hundred ten euros. But I'll give you a deal.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275898,"_nanoseconds":525000000}},{"id":"1rmXmb81MTLIilsm53ae","level":"a0-tout-public","lesson":18,"part":8,"type":"text","name":"ab-adults-l18-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je voudrais un sac, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a bag, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je voudrais un sac, s'il vous plaît.","size":null,"created":{"_seconds":1793275898,"_nanoseconds":529000000}},{"id":"4ZtHTj9EhlZQiLWLdZz8","level":"a0-tout-public","lesson":18,"part":9,"type":"text","name":"ab-adults-l18-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà. Il est noir ou rouge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go. Black or red?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Noir, s'il vous plaît. Ça coûte combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Black, please. How much is it?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Noir, s'il vous plaît. Ça coûte combien ?","size":null,"created":{"_seconds":1793275898,"_nanoseconds":538000000}},{"id":"8LBvtiVWcT4LMP69EV9m","level":"a0-tout-public","lesson":18,"part":10,"type":"text","name":"ab-adults-l18-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça coûte quarante euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It costs forty euros.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Quarante euros, d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Forty euros, all right.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Quarante euros, d'accord.","size":null,"created":{"_seconds":1793275898,"_nanoseconds":541000000}},{"id":"Vy9I556kRflp6BDEzZaT","level":"a0-tout-public","lesson":18,"part":11,"type":"text","name":"ab-adults-l18-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le livre ? Soixante-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the book? Seventy euros.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est cher ! Quatre-vingts euros en tout ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's expensive! Eighty euros in total?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est cher ! Quatre-vingts euros en tout ?","size":null,"created":{"_seconds":1793275899,"_nanoseconds":185000000}},{"id":"6u7V8JSI0LC1f5eCFzvT","level":"a0-tout-public","lesson":18,"part":12,"type":"text","name":"ab-adults-l18-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Non, cent dix euros. Mais je vous fais un prix.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, one hundred ten euros. But I'll give you a deal.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup !","size":null,"created":{"_seconds":1793275898,"_nanoseconds":992000000}},{"id":"QFNYjziEuevhTlo9zJtA","level":"a0-tout-public","lesson":18,"part":13,"type":"text","name":"ab-adults-l18-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Ça coûte combien ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">How much does it cost?</p><p><b>Ask a price and repeat the answer.</b></p><p style=\"opacity:.7;\">For example: “Ça coûte combien ? Quarante euros, d'accord.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Ça coûte combien ? Quarante euros, d'accord.","size":null,"created":{"_seconds":1793275899,"_nanoseconds":56000000}},{"id":"qB1k0phrwosrfdEDAeUH","level":"a0-tout-public","lesson":18,"part":14,"type":"text","name":"ab-adults-l18-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💶</div><p><b>Prices understood!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can count to a hundred and ask prices. That is a big step for travel and daily life.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275898,"_nanoseconds":990000000}}]