[{"id":"Y8leQdknImnh4QafDxuW","level":"a0-tout-public","lesson":5,"part":1,"type":"text","name":"ab-adults-l05-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you learn to count to twenty and to say your age. Numbers are everywhere: prices, phone numbers, times. We will use them inside a conversation, along with your greetings, your name and ça va. Take a breath. We go slowly.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275873,"_nanoseconds":629000000}},{"id":"DbqdQ6QbPG5K6yvUCUa5","level":"a0-tout-public","lesson":5,"part":2,"type":"text","name":"ab-adults-l05-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔢</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Numbers 0 to 20 on a row of cards</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275873,"_nanoseconds":710000000}},{"id":"cofO1DFDmMLEWd3gmvK8","level":"a0-tout-public","lesson":5,"part":2,"type":"text","name":"ab-adults-l05-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Zéro, un, deux, trois, quatre, cinq, six, sept, huit, neuf, dix. Then onze, douze, treize, quatorze, quinze, seize, dix-sept, dix-huit, dix-neuf, vingt. To say your age, use j'ai, I have, then the number, then ans, as in j'ai vingt ans.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un, deux, trois, quatre, cinq</b><span style=\"opacity:.7;\"> · One to five</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Six, sept, huit, neuf, dix</b><span style=\"opacity:.7;\"> · Six to ten</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Onze, douze, treize, quinze, vingt</b><span style=\"opacity:.7;\"> · Eleven, twelve, thirteen, fifteen, twenty</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai vingt ans.</b><span style=\"opacity:.7;\"> · I am twenty years old.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275873,"_nanoseconds":887000000}},{"id":"7UwjxuhM0GWHdyOHctJV","level":"a0-tout-public","lesson":5,"part":3,"type":"text","name":"ab-adults-l05-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un, deux, trois, quatre, cinq</b></p><p style=\"opacity:.75;margin:0;\">One to five</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un, deux, trois, quatre, cinq","size":null,"created":{"_seconds":1793275874,"_nanoseconds":40000000}},{"id":"NGjo71Vq8Wu4VskO6ddV","level":"a0-tout-public","lesson":5,"part":4,"type":"text","name":"ab-adults-l05-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Six, sept, huit, neuf, dix</b></p><p style=\"opacity:.75;margin:0;\">Six to ten</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Six, sept, huit, neuf, dix","size":null,"created":{"_seconds":1793275874,"_nanoseconds":36000000}},{"id":"WWYxUPf0GJdNiKCnxYzd","level":"a0-tout-public","lesson":5,"part":5,"type":"text","name":"ab-adults-l05-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Onze, douze, treize, quinze, vingt</b></p><p style=\"opacity:.75;margin:0;\">Eleven, twelve, thirteen, fifteen, twenty</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Onze, douze, treize, quinze, vingt","size":null,"created":{"_seconds":1793275874,"_nanoseconds":121000000}},{"id":"DK5eErnUvAuiEz7amIcc","level":"a0-tout-public","lesson":5,"part":6,"type":"text","name":"ab-adults-l05-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai vingt ans.</b></p><p style=\"opacity:.75;margin:0;\">I am twenty years old.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai vingt ans.","size":null,"created":{"_seconds":1793275874,"_nanoseconds":320000000}},{"id":"d0uSHHCpz6l9Za32N26I","level":"a0-tout-public","lesson":5,"part":7,"type":"text","name":"ab-adults-l05-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je m'appelle Camille. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille. How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci. Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Enchantée, Alex. Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex. How old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, j'ai trente ans. Comptez avec moi : un, deux, trois !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm thirty. Count with me: one, two, three!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Un, deux, trois, quatre, cinq !</b><br><span style=\"opacity:.7;font-size:.9rem;\">One, two, three, four, five!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Encore !</b><br><span style=\"opacity:.7;font-size:.9rem;\">More!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Six, sept, huit, neuf, dix !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Six, seven, eight, nine, ten!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bravo ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Well done! See you soon!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275874,"_nanoseconds":445000000}},{"id":"HfAlFtlc9w1dJpxvquZC","level":"a0-tout-public","lesson":5,"part":8,"type":"text","name":"ab-adults-l05-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je m'appelle Camille. Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Camille. How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci. Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you. My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien, merci. Je m'appelle Alex.","size":null,"created":{"_seconds":1793275874,"_nanoseconds":470000000}},{"id":"OO1mf6wCvh5vvvJfI0XL","level":"a0-tout-public","lesson":5,"part":9,"type":"text","name":"ab-adults-l05-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Enchantée, Alex. Vous avez quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex. How old are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai vingt ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am twenty.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai vingt ans.","size":null,"created":{"_seconds":1793275874,"_nanoseconds":590000000}},{"id":"RXxtiItZ1Tbzb4kYvCA1","level":"a0-tout-public","lesson":5,"part":10,"type":"text","name":"ab-adults-l05-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, j'ai trente ans. Comptez avec moi : un, deux, trois !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm thirty. Count with me: one, two, three!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Un, deux, trois, quatre, cinq !</b><br><span style=\"opacity:.7;font-size:.9rem;\">One, two, three, four, five!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Un, deux, trois, quatre, cinq !","size":null,"created":{"_seconds":1793275874,"_nanoseconds":733000000}},{"id":