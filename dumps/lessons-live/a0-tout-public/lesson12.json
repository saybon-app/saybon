[{"id":"6WhVIlwfsu3Anvkvsp4t","level":"a0-tout-public","lesson":12,"part":1,"type":"text","name":"ab-adults-l12-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you learn colours. Colours let you describe things, and in French, the colour comes after the noun. A red bag is un sac rouge. Let's use the objects from last lesson, and describe them. We also bring back greetings, your name and how you are.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275885,"_nanoseconds":185000000}},{"id":"ZAaM9uzOc5QoGzUlMr4M","level":"a0-tout-public","lesson":12,"part":2,"type":"text","name":"ab-adults-l12-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎨</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A red bag, a black key and a blue book on a table</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275885,"_nanoseconds":648000000}},{"id":"2L7M3qlSv5mKuk4mfu9k","level":"a0-tout-public","lesson":12,"part":2,"type":"text","name":"ab-adults-l12-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 The colours: rouge, bleu, vert, jaune, noir, blanc. For feminine nouns, some colours change. Blanc becomes blanche, vert becomes verte, but rouge, bleu and jaune stay the same. To ask a colour, say de quelle couleur est.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Rouge</b><span style=\"opacity:.7;\"> · Red</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bleu</b><span style=\"opacity:.7;\"> · Blue</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vert, jaune</b><span style=\"opacity:.7;\"> · Green, yellow</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Noir, blanc</b><span style=\"opacity:.7;\"> · Black, white</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275885,"_nanoseconds":598000000}},{"id":"YDHsqgDZNkETWfbtgWou","level":"a0-tout-public","lesson":12,"part":3,"type":"text","name":"ab-adults-l12-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Rouge</b></p><p style=\"opacity:.75;margin:0;\">Red</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Rouge","size":null,"created":{"_seconds":1793275885,"_nanoseconds":592000000}},{"id":"PsQcPx201RPyUZAs8ZH1","level":"a0-tout-public","lesson":12,"part":4,"type":"text","name":"ab-adults-l12-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bleu</b></p><p style=\"opacity:.75;margin:0;\">Blue</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bleu","size":null,"created":{"_seconds":1793275885,"_nanoseconds":713000000}},{"id":"ZC2bm0VzE4DoGYOzSftB","level":"a0-tout-public","lesson":12,"part":5,"type":"text","name":"ab-adults-l12-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vert, jaune</b></p><p style=\"opacity:.75;margin:0;\">Green, yellow</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vert, jaune","size":null,"created":{"_seconds":1793275886,"_nanoseconds":114000000}},{"id":"XgVOvsi0dgwCfVnTYmx3","level":"a0-tout-public","lesson":12,"part":6,"type":"text","name":"ab-adults-l12-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Noir, blanc</b></p><p style=\"opacity:.75;margin:0;\">Black, white</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Noir, blanc","size":null,"created":{"_seconds":1793275886,"_nanoseconds":90000000}},{"id":"Q46DDBfhRdJGX59TUQR4","level":"a0-tout-public","lesson":12,"part":7,"type":"text","name":"ab-adults-l12-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bien. Regardez : qu'est-ce que c'est ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good. Look: what is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un sac.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a bag.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>De quelle couleur est le sac ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What colour is the bag?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un sac rouge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a red bag.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ma clé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And my key?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est une clé noire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a black key.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parfait ! Et le livre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect! And the book?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un livre bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a blue book.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275886,"_nanoseconds":141000000}},{"id":"Metdt75o95eCEkKVEnry","level":"a0-tout-public","lesson":12,"part":8,"type":"text","name":"ab-adults-l12-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275886,"_nanoseconds":161000000}},{"id":"bgJgTCK7MQCTiLQSASW5","level":"a0-tout-public","lesson":12,"part":9,"type":"text","name":"ab-adults-l12-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bien. Regardez : qu'est-ce que c'est ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good. Look: what is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un sac.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a bag.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un sac.","size":null,"created":{"_seconds":1793275886,"_nanoseconds":603000000}},{"id":"6lG4fAtMF4c98OA8CwNo","level":"a0-tout-public","lesson":12,"part":10,"type":"text","name":"ab-adults-l12-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>De quelle couleur est le sac ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What colour is the bag?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un sac rouge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a red bag.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un sac rouge.","size":null,"created":{"_seconds":1793275886,"_nanoseconds":648000000}},{"id":"6N9d17PWfh6Pl6I6Oqo1","level":"a0-tout-public","lesson":12,"part":11,"type":"text","name":"ab-adults-l12-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et ma clé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And my key?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est une clé noire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a black key.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est une clé noire.","size":null,"created":{"_seconds":1793275886,"_nanoseconds":698000000}},{"id":"x7pYMWrzzXon6JUPBm6Q","level":"a0-tout-public","lesson":12,"part":12,"type":"text","name":"ab-adults-l12-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Parfait ! Et le livre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect! And the book?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un livre bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a blue book.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un livre bleu.","size":null,"created":{"_seconds":1793275886,"_nanoseconds":707000000}},{"id":"HZSR2QcsaxAS9hCXM08j","level":"a0-tout-public","lesson":12,"part":13,"type":"text","name":"ab-adults-l12-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez un objet avec sa couleur.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe an object with its colour.</p><p><b>Name an object and say its colour.</b></p><p style=\"opacity:.7;\">For example: “C'est un sac noir.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"C'est un sac noir.","size":null,"created":{"_seconds":1793275887,"_nanoseconds":115000000}},{"id":"dpv4V0yAXDjOzdDcTG53","level":"a0-tout-public","lesson":12,"part":14,"type":"text","name":"ab-adults-l12-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎨</div><p><b>Colourful French!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe objects with colours, and you saw colours change for feminine nouns. Notice that the colour follows the noun.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275887,"_nanoseconds":130000000}}]