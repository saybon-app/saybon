[{"id":"2at3EQaaDSzuVPL9mjfs","level":"a0-tout-public","lesson":2,"part":1,"type":"text","name":"ab-adults-l02-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Welcome back. Today you will say your name and ask someone theirs. We keep our greetings from lesson one, and add the most important sentence for meeting people: je m'appelle, my name is. You will also hear enchanté, which means pleased to meet you.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275868,"_nanoseconds":391000000}},{"id":"eDUZRygAV4sDPZKvTPYZ","level":"a0-tout-public","lesson":2,"part":2,"type":"text","name":"ab-adults-l02-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🏷️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two name badges on a table: 'Camille' and a blank one</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275868,"_nanoseconds":702000000}},{"id":"IqqNcOUgXSa6Oq0UG6bW","level":"a0-tout-public","lesson":2,"part":2,"type":"text","name":"ab-adults-l02-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To say your name, say je m'appelle, then your name. To ask someone's name, say comment vous appelez-vous. And when you meet someone, you can say enchanté, pleased to meet you.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je m'appelle Alex.</b><span style=\"opacity:.7;\"> · My name is Alex.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Comment vous appelez-vous ?</b><span style=\"opacity:.7;\"> · What is your name?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Enchanté !</b><span style=\"opacity:.7;\"> · Pleased to meet you!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Et vous ?</b><span style=\"opacity:.7;\"> · And you?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275868,"_nanoseconds":840000000}},{"id":"saElBqFshqleuq8YedxR","level":"a0-tout-public","lesson":2,"part":3,"type":"text","name":"ab-adults-l02-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je m'appelle Alex.</b></p><p style=\"opacity:.75;margin:0;\">My name is Alex.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275868,"_nanoseconds":849000000}},{"id":"urmExfgmqAlqLQyr2FCy","level":"a0-tout-public","lesson":2,"part":4,"type":"text","name":"ab-adults-l02-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Comment vous appelez-vous ?</b></p><p style=\"opacity:.75;margin:0;\">What is your name?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Comment vous appelez-vous ?","size":null,"created":{"_seconds":1793275868,"_nanoseconds":853000000}},{"id":"Mholb9sdBx9byOvDiwc7","level":"a0-tout-public","lesson":2,"part":5,"type":"text","name":"ab-adults-l02-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Enchanté !</b></p><p style=\"opacity:.75;margin:0;\">Pleased to meet you!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Enchanté !","size":null,"created":{"_seconds":1793275869,"_nanoseconds":125000000}},{"id":"iFJPAbbJHm0Xo2k4DjGw","level":"a0-tout-public","lesson":2,"part":6,"type":"text","name":"ab-adults-l02-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Et vous ?</b></p><p style=\"opacity:.75;margin:0;\">And you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Et vous ?","size":null,"created":{"_seconds":1793275869,"_nanoseconds":314000000}},{"id":"nFhVUj3dnLHdv3asXgtF","level":"a0-tout-public","lesson":2,"part":7,"type":"text","name":"ab-adults-l02-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Camille. Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. What is your name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Enchantée, Alex !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Enchanté ! Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you! And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, je suis Camille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm Camille.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your name?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Camille, comme je disais !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm Camille, as I said!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir, Camille !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, Camille!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275869,"_nanoseconds":265000000}},{"id":"dCJxdteyDD4EhOcdTWE0","level":"a0-tout-public","lesson":2,"part":8,"type":"text","name":"ab-adults-l02-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour !","size":null,"created":{"_seconds":1793275869,"_nanoseconds":272000000}},{"id":"ePYEEWSCxYEWSp4BkZSn","level":"a0-tout-public","lesson":2,"part":9,"type":"text","name":"ab-adults-l02-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Camille. Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. What is your name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275869,"_nanoseconds":548000000}},{"id":"f7ecA5Y9eDGkJB0uo0LP","level":"a0-tout-public","lesson":2,"part":10,"type":"text","name":"ab-adults-l02-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Enchantée, Alex !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you, Alex!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Enchanté ! Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Pleased to meet you! And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Enchanté ! Et vous ?","size":null,"created":{"_seconds":1793275869,"_nanoseconds":688000000}},{"id":"ZVigK7ZwcQwzPFozlmp1","level":"a0-tout-public","lesson":2,"part":11,"type":"text","name":"ab-adults-l02-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, je suis Camille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm Camille.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Comment vous appelez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your name?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Comment vous appelez-vous ?","size":null,"created":{"_seconds":1793275869,"_nanoseconds":740000000}},{"id":"UAX56TN9P99FPDPyIzsS","level":"a0-tout-public","lesson":2,"part":12,"type":"text","name":"ab-adults-l02-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Camille, comme je disais !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm Camille, as I said!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir, Camille !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, Camille!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir, Camille !","size":null,"created":{"_seconds":1793275869,"_nanoseconds":751000000}},{"id":"h10tNfznOB5dE30dW3ga","level":"a0-tout-public","lesson":2,"part":13,"type":"text","name":"ab-adults-l02-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Bonjour ! Comment vous appelez-vous ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Hello! What is your name?</p><p><b>Greet, say your name, and ask the teacher's name.</b></p><p style=\"opacity:.7;\">For example: “Bonjour ! Je m'appelle Alex. Et vous ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Bonjour ! Je m'appelle Alex. Et vous ?","size":null,"created":{"_seconds":1793275869,"_nanoseconds":947000000}},{"id":"o1D1FLMP69qoLhr6O82p","level":"a0-tout-public","lesson":2,"part":14,"type":"text","name":"ab-adults-l02-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🏷️</div><p><b>Introductions unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can introduce yourself, ask for a name, and say enchanté. That is how almost every French conversation starts.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275870,"_nanoseconds":110000000}}]