[{"id":"Xg34ToRMvYSRsTpAroUa","level":"a0-tout-public","lesson":20,"part":1,"type":"text","name":"ab-adults-l20-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you give your contact details: your address and your phone number. This is common in forms, hotels and shops. The numbers are said two by two in France, so a phone number sounds like a short sequence of pairs. Listen for the rhythm.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275901,"_nanoseconds":163000000}},{"id":"3fyyLgwwXsrJA2d0MEbD","level":"a0-tout-public","lesson":20,"part":2,"type":"text","name":"ab-adults-l20-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📞</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A registration form with address and phone fields</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275901,"_nanoseconds":616000000}},{"id":"O2orJdDqZoou9BvjpNq7","level":"a0-tout-public","lesson":20,"part":2,"type":"text","name":"ab-adults-l20-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To ask for an address, say quelle est votre adresse. To answer, say j'habite, I live, then the place. For a phone number, ask quel est votre numéro de téléphone. French numbers are said in pairs: zéro six, douze, trente-quatre, cinquante-six, soixante-dix-huit.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quelle est votre adresse ?</b><span style=\"opacity:.7;\"> · What is your address?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'habite à Accra.</b><span style=\"opacity:.7;\"> · I live in Accra.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mon numéro est le zéro six.</b><span style=\"opacity:.7;\"> · My number is zero six.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Douze, trente-quatre, cinquante-six</b><span style=\"opacity:.7;\"> · Twelve, thirty-four, fifty-six</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275901,"_nanoseconds":562000000}},{"id":"yjI9V3bEFMdinH6bY43d","level":"a0-tout-public","lesson":20,"part":3,"type":"text","name":"ab-adults-l20-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quelle est votre adresse ?</b></p><p style=\"opacity:.75;margin:0;\">What is your address?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Quelle est votre adresse ?","size":null,"created":{"_seconds":1793275901,"_nanoseconds":563000000}},{"id":"4bNTAWmR6FkqaToBpfHm","level":"a0-tout-public","lesson":20,"part":4,"type":"text","name":"ab-adults-l20-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'habite à Accra.</b></p><p style=\"opacity:.75;margin:0;\">I live in Accra.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'habite à Accra.","size":null,"created":{"_seconds":1793275901,"_nanoseconds":571000000}},{"id":"hjd77ITLcROkGJaNW8c2","level":"a0-tout-public","lesson":20,"part":5,"type":"text","name":"ab-adults-l20-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mon numéro est le zéro six.</b></p><p style=\"opacity:.75;margin:0;\">My number is zero six.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Mon numéro est le zéro six.","size":null,"created":{"_seconds":1793275902,"_nanoseconds":31000000}},{"id":"4cFws0vJx48f9Qpw0EDE","level":"a0-tout-public","lesson":20,"part":6,"type":"text","name":"ab-adults-l20-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Douze, trente-quatre, cinquante-six</b></p><p style=\"opacity:.75;margin:0;\">Twelve, thirty-four, fifty-six</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Douze, trente-quatre, cinquante-six","size":null,"created":{"_seconds":1793275902,"_nanoseconds":34000000}},{"id":"CE9xvJ2nlrwrVi4dnz7a","level":"a0-tout-public","lesson":20,"part":7,"type":"text","name":"ab-adults-l20-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Pour l'inscription, quel est votre nom ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! For registration, what is your name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment ça s'écrit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How is it spelled?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça s'écrit A, L, E, X.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's spelled A, L, E, X.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci. Où habitez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Where do you live?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'habite à Accra.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I live in Accra.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quel est votre numéro de téléphone ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is your phone number?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Mon numéro est le zéro six, douze, trente-quatre, cinquante-six.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My number is zero six, twelve, thirty-four, fifty-six.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parfait. Merci, et bienvenue !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect. Thank you, and welcome!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci, au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275902,"_nanoseconds":28000000}},{"id":"0a5zQri0yaH2Y9rCplP2","level":"a0-tout-public","lesson":20,"part":8,"type":"text","name":"ab-adults-l20-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Pour l'inscription, quel est votre nom ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! For registration, what is your name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex.","size":null,"created":{"_seconds":1793275902,"_nanoseconds":29000000}},{"id":"iGDfOIB2oag9WCVgEKKs","level":"a0-tout-public","lesson":20,"part":9,"type":"text","name":"ab-adults-l20-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment ça s'écrit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How is it spelled?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça s'écrit A, L, E, X.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's spelled A, L, E, X.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça s'écrit A, L, E, X.","size":null,"created":{"_seconds":1793275902,"_nanoseconds":476000000}},{"id":"yD308jpYpODn4s5P7XRs","level":"a0-tout-public","lesson":20,"part":10,"type":"text","name":"ab-adults-l20-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci. Où habitez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Where do you live?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'habite à Accra.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I live in Accra.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'habite à Accra.","size":null,"created":{"_seconds":1793275902,"_nanoseconds":477000000}},{"id":"L5qxMl2EXkFQ3sDLh2iG","level":"a0-tout-public",