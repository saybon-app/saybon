[{"id":"Ilvdaja4SU1CqS83W26z","level":"a0-tout-public","lesson":11,"part":1,"type":"text","name":"ab-adults-l11-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you learn to name everyday objects, and to ask what something is. In French, every noun is masculine or feminine, so you say un or une. Do not memorise rules for now: always learn the word with its un or une. We practise it in a conversation about things on a table.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275883,"_nanoseconds":475000000}},{"id":"TRzzBIThmUWwGmrb7pAS","level":"a0-tout-public","lesson":11,"part":2,"type":"text","name":"ab-adults-l11-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📱</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A table with a phone, a key and a book</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275883,"_nanoseconds":504000000}},{"id":"pxAg0Uw2AGOJt5IZgga4","level":"a0-tout-public","lesson":11,"part":2,"type":"text","name":"ab-adults-l11-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Un is for masculine nouns, like un téléphone, un livre, un sac. Une is for feminine ones, like une clé, une table, une chaise. To ask what something is, say qu'est-ce que c'est. To answer, say c'est un or c'est une.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Qu'est-ce que c'est ?</b><span style=\"opacity:.7;\"> · What is it?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est un téléphone.</b><span style=\"opacity:.7;\"> · It's a phone.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est une clé.</b><span style=\"opacity:.7;\"> · It's a key.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est un livre.</b><span style=\"opacity:.7;\"> · It's a book.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275883,"_nanoseconds":526000000}},{"id":"nyCrjxIsoPrHv684YVob","level":"a0-tout-public","lesson":11,"part":3,"type":"text","name":"ab-adults-l11-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Qu'est-ce que c'est ?</b></p><p style=\"opacity:.75;margin:0;\">What is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Qu'est-ce que c'est ?","size":null,"created":{"_seconds":1793275883,"_nanoseconds":619000000}},{"id":"zayhANSHPt9cHniD4GbY","level":"a0-tout-public","lesson":11,"part":4,"type":"text","name":"ab-adults-l11-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est un téléphone.</b></p><p style=\"opacity:.75;margin:0;\">It's a phone.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est un téléphone.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":174000000}},{"id":"7LcN5PtI1eASqiwn2SNd","level":"a0-tout-public","lesson":11,"part":5,"type":"text","name":"ab-adults-l11-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est une clé.</b></p><p style=\"opacity:.75;margin:0;\">It's a key.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est une clé.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":47000000}},{"id":"RMwsb27oAfImFUguI1Sp","level":"a0-tout-public","lesson":11,"part":6,"type":"text","name":"ab-adults-l11-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est un livre.</b></p><p style=\"opacity:.75;margin:0;\">It's a book.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est un livre.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":59000000}},{"id":"C0viyUqVpsrHAq35sQTI","level":"a0-tout-public","lesson":11,"part":7,"type":"text","name":"ab-adults-l11-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Regardez la table. Qu'est-ce que c'est ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at the table. What is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un téléphone.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a phone.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And this?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est une clé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a key.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui. Et ça, c'est quoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes. And this, what is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un livre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a book.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien ! Vous parlez déjà bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very good! You already speak well.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275884,"_nanoseconds":125000000}},{"id":"QaV90KU0lwPJXO4ANRoG","level":"a0-tout-public","lesson":11,"part":8,"type":"text","name":"ab-adults-l11-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien, merci.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":620000000}},{"id":"ZmEADue5qL1ND9umTAsG","level":"a0-tout-public","lesson":11,"part":9,"type":"text","name":"ab-adults-l11-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Regardez la table. Qu'est-ce que c'est ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at the table. What is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un téléphone.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a phone.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un téléphone.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":583000000}},{"id":"2z7pkSzAoUDa6UooyNge","level":"a0-tout-public","lesson":11,"part":10,"type":"text","name":"ab-adults-l11-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And this?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est une clé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a key.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est une clé.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":602000000}},{"id":"HOIDfcyy2D5snoU9N0UR","level":"a0-tout-public","lesson":11,"part":11,"type":"text","name":"ab-adults-l11-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui. Et ça, c'est quoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes. And this, what is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un livre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a book.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un livre.","size":null,"created":{"_seconds":1793275884,"_nanoseconds":668000000}},{"id":"2zkqrVlWLRAFxBOblb8B","level":"a0-tout-public","lesson":11,"part":12,"type":"text","name":"ab-adults-l11-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien ! Vous parlez déjà bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very good! You already speak well.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci ! Au revoir !","size":null,"created":{"_seconds":1793275885,"_nanoseconds":102000000}},{"id":"8RPYgsvuMiwyFNFBlQHn","level":"a0-tout-public","lesson":11,"part":13,"type":"text","name":"ab-adults-l11-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Qu'est-ce que c'est ? Regardez autour de vous.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What is it? Look around you.</p><p><b>Name two objects near you with un or une.</b></p><p style=\"opacity:.7;\">For example: “C'est un téléphone. C'est une table.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"C'est un téléphone. C'est une table.","size":null,"created":{"_seconds":1793275885,"_nanoseconds":67000000}},{"id":"jEODQXVNDEdn2qSUHRQP","level":"a0-tout-public","lesson":11,"part":14,"type":"text","name":"ab-adults-l11-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📱</div><p><b>Objects named!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can name objects and say what they are, with the right un or une. Use the habit of learning every word with its article.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275885,"_nanoseconds":107000000}}]