[{"id":"quQ6HtFlgtUJyELoVJu7","level":"a0-tout-public","lesson":19,"part":1,"type":"text","name":"ab-adults-l19-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you learn to ask where things are, and understand simple directions. Lost in a French town? You will know what to say. We use où est, where is, and the direction words: tout droit, à gauche, à droite. We keep our polite phrases in every question.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275899,"_nanoseconds":498000000}},{"id":"bGHOjkrQN59pk8b4EYwp","level":"a0-tout-public","lesson":19,"part":2,"type":"text","name":"ab-adults-l19-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧭</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A street corner with a sign pointing to the station</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275899,"_nanoseconds":507000000}},{"id":"znYlnqXvVQGRLZv3pe17","level":"a0-tout-public","lesson":19,"part":2,"type":"text","name":"ab-adults-l19-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Où est la gare means where is the station. Où est la pharmacie, where is the pharmacy. Tout droit means straight ahead, à gauche means left, à droite means right. Add c'est loin, it's far, or c'est près, it's close.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Où est la gare ?</b><span style=\"opacity:.7;\"> · Where is the station?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tout droit</b><span style=\"opacity:.7;\"> · Straight ahead</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À gauche, à droite</b><span style=\"opacity:.7;\"> · Left, right</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est près d'ici.</b><span style=\"opacity:.7;\"> · It's close to here.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275899,"_nanoseconds":539000000}},{"id":"kOgIkqZhz2hxII20n2Kj","level":"a0-tout-public","lesson":19,"part":3,"type":"text","name":"ab-adults-l19-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Où est la gare ?</b></p><p style=\"opacity:.75;margin:0;\">Where is the station?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Où est la gare ?","size":null,"created":{"_seconds":1793275899,"_nanoseconds":668000000}},{"id":"Xer3VE5oBaTGJekwnUlH","level":"a0-tout-public","lesson":19,"part":4,"type":"text","name":"ab-adults-l19-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tout droit</b></p><p style=\"opacity:.75;margin:0;\">Straight ahead</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tout droit","size":null,"created":{"_seconds":1793275900,"_nanoseconds":9000000}},{"id":"uzVJhrvQgKxVD7boiQSs","level":"a0-tout-public","lesson":19,"part":5,"type":"text","name":"ab-adults-l19-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À gauche, à droite</b></p><p style=\"opacity:.75;margin:0;\">Left, right</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À gauche, à droite","size":null,"created":{"_seconds":1793275900,"_nanoseconds":11000000}},{"id":"PVDCNS77LrdwWoUvxXg3","level":"a0-tout-public","lesson":19,"part":6,"type":"text","name":"ab-adults-l19-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est près d'ici.</b></p><p style=\"opacity:.75;margin:0;\">It's close to here.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est près d'ici.","size":null,"created":{"_seconds":1793275900,"_nanoseconds":15000000}},{"id":"8tnHHbeqxJvZvj0iwGGF","level":"a0-tout-public","lesson":19,"part":7,"type":"text","name":"ab-adults-l19-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Excusez-moi, où est la gare, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, where is the station, please?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>La gare ? Allez tout droit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The station? Go straight ahead.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tout droit, d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Straight ahead, all right.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Puis tournez à gauche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then turn left.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À gauche. C'est loin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Left. Is it far?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Non, c'est près d'ici. Cinq minutes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, it's close. Five minutes.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je vous en prie. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, have a nice day!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275900,"_nanoseconds":98000000}},{"id":"nY3x8BWoAB04ey8hMMye","level":"a0-tout-public","lesson":19,"part":8,"type":"text","name":"ab-adults-l19-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Excusez-moi, où est la gare, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, where is the station, please?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Excusez-moi, où est la gare, s'il vous plaît ?","size":null,"created":{"_seconds":1793275900,"_nanoseconds":652000000}},{"id":"IFbF41HKo7uoRzoDnDYM","level":"a0-tout-public","lesson":19,"part":9,"type":"text","name":"ab-adults-l19-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>La gare ? Allez tout droit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">The station? Go straight ahead.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tout droit, d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Straight ahead, all right.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Tout droit, d'accord.","size":null,"created":{"_seconds":1793275900,"_nanoseconds":654000000}},{"id":"Vxhuwb3UipQXiwjwUbrk","level":"a0-tout-public","lesson":19,"part":10,"type":"text","name":"ab-adults-l19-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Puis tournez à gauche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then turn left.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À gauche. C'est loin ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Left. Is it far?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À gauche. C'est loin ?","size":null,"created":{"_seconds":1793275900,"_nanoseconds":656000000}},{"id":"K9pigeCpzEc0jbqog9ND","level":"a0-tout-public","lesson":19,"part":11,"type":"text","name":"ab-adults-l19-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Non, c'est près d'ici. Cinq minutes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, it's close. Five minutes.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup !","size":null,"created":{"_seconds":1793275900,"_nanoseconds":703000000}},{"id":"fvPnIgORZo8wEfC8G5JN","level":"a0-tout-public","lesson":19,"part":12,"type":"text","name":"ab-adults-l19-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je vous en prie. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir, bonne journée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye, have a nice day!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir, bonne journée !","size":null,"created":{"_seconds":1793275901,"_nanoseconds":157000000}},{"id":"yNQvjTMvTMvJVx9RcuCK","level":"a0-tout-public","lesson":19,"part":13,"type":"text","name":"ab-adults-l19-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Vous cherchez la pharmacie. Que dites-vous ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">You're looking for the pharmacy. What do you say?</p><p><b>Ask where the pharmacy is, politely.</b></p><p style=\"opacity:.7;\">For example: “Excusez-moi, où est la pharmacie, s'il vous plaît ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Excusez-moi, où est la pharmacie, s'il vous plaît ?","size":null,"created":{"_seconds":1793275901,"_nanoseconds":156000000}},{"id":"La6iTJpyDROeNKs5GYKg","level":"a0-tout-public","lesson":19,"part":14,"type":"text","name":"ab-adults-l19-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧭</div><p><b>Not lost anymore!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can ask for places and follow basic directions. This is very useful as a traveller.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275901,"_nanoseconds":160000000}}]