[{"id":"3XSdNRW10i9VBhN61SaL","level":"a0-tout-public","lesson":9,"part":1,"type":"text","name":"ab-adults-l09-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! After names and countries, the next question is almost always about work. Today you learn to say what you do and where you work. The key question is qu'est-ce que vous faites dans la vie, what do you do for a living. The conversation also revisits earlier lessons.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275879,"_nanoseconds":996000000}},{"id":"9wVyXS8CUo9pwB8j37Qj","level":"a0-tout-public","lesson":9,"part":2,"type":"text","name":"ab-adults-l09-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💼</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A desk with a laptop, a notebook and a name tag</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275880,"_nanoseconds":66000000}},{"id":"wphjY9n84aDmPmmxpL6N","level":"a0-tout-public","lesson":9,"part":2,"type":"text","name":"ab-adults-l09-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To ask about work, say qu'est-ce que vous faites dans la vie. To answer, say je suis, then your job, like je suis professeur, médecin or journaliste. Or say je travaille dans, then the place, like une école, un hôpital, une banque.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Qu'est-ce que vous faites dans la vie ?</b><span style=\"opacity:.7;\"> · What do you do for a living?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis professeur.</b><span style=\"opacity:.7;\"> · I'm a teacher.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je travaille dans une école.</b><span style=\"opacity:.7;\"> · I work in a school.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis journaliste.</b><span style=\"opacity:.7;\"> · I'm a journalist.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275880,"_nanoseconds":214000000}},{"id":"UjZsCpt33BlkH45dL3Hc","level":"a0-tout-public","lesson":9,"part":3,"type":"text","name":"ab-adults-l09-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Qu'est-ce que vous faites dans la vie ?</b></p><p style=\"opacity:.75;margin:0;\">What do you do for a living?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Qu'est-ce que vous faites dans la vie ?","size":null,"created":{"_seconds":1793275880,"_nanoseconds":246000000}},{"id":"yc4zM59GljtFRXqn92YR","level":"a0-tout-public","lesson":9,"part":4,"type":"text","name":"ab-adults-l09-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis professeur.</b></p><p style=\"opacity:.75;margin:0;\">I'm a teacher.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis professeur.","size":null,"created":{"_seconds":1793275880,"_nanoseconds":409000000}},{"id":"OhEnJnyt0xWpkau6zXI5","level":"a0-tout-public","lesson":9,"part":5,"type":"text","name":"ab-adults-l09-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je travaille dans une école.</b></p><p style=\"opacity:.75;margin:0;\">I work in a school.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je travaille dans une école.","size":null,"created":{"_seconds":1793275880,"_nanoseconds":481000000}},{"id":"O4w1sIvzQt8normE0oF6","level":"a0-tout-public","lesson":9,"part":6,"type":"text","name":"ab-adults-l09-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis journaliste.</b></p><p style=\"opacity:.75;margin:0;\">I'm a journalist.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis journaliste.","size":null,"created":{"_seconds":1793275880,"_nanoseconds":619000000}},{"id":"1h4AGA1BYfO2DskGW3Pt","level":"a0-tout-public","lesson":9,"part":7,"type":"text","name":"ab-adults-l09-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Camille. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. And you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Alex. Enchanté !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex. Pleased to meet you!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous faites dans la vie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do for a living?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis professeur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm a teacher.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Où travaillez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where do you work?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je travaille dans une école.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I work in a school.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, je suis journaliste. J'aime mon travail.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm a journalist. I like my job.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Très bien ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very good! See you soon!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275880,"_nanoseconds":658000000}},{"id":"ErMluY3hVbsx3Ez8l1Qz","level":"a0-tout-public","lesson":9,"part":8,"type":"text","name":"ab-adults-l09-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci.","size":null,"created":{"_seconds":1793275880,"_nanoseconds":813000000}},{"id":"lIqEKP2BEEs5gM7jJBKE","level":"a0-tout-public","lesson":9,"part":9,"type":"text","name":"ab-adults-l09-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Camille. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Camille. And you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Alex. Enchanté !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Alex. Pleased to meet you!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Alex. Enchanté !","size":null,"created":{"_seconds":1793275880,"_nanoseconds":907000000}},{"id":"s1cOVzrUYJGLslDeqvoK","level":"a0-tout-public","lesson":9,"part":10,"type":"text","name":"ab-adults-l09-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous faites dans la vie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you do for a living?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis professeur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm a teacher.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je suis professeur.","size":null,"created":{"_seconds":1793275881,"_nanoseconds":46000000}},{"id":"PtsDhdp7sNPfoPPpBmIp","level":"a0-tout-public","lesson":9,"part":11,"type":"text","name":"ab-adults-l09-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Où travaillez-vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Where do you work?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je travaille dans une école.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I work in a school.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je travaille dans une école.","size":null,"created":{"_seconds":1793275881,"_nanoseconds":87000000}},{"id":"rJ0ZGTncTNyuZoFRwrVk","level":"a0-tout-public","lesson":9,"part":12,"type":"text","name":"ab-adults-l09-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, je suis journaliste. J'aime mon travail.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm a journalist. I like my job.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Très bien ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very good! See you soon!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Très bien ! À bientôt !","size":null,"created":{"_seconds":1793275881,"_nanoseconds":232000000}},{"id":"cUryIceE3TnGizdOGaBR","level":"a0-tout-public","lesson":9,"part":13,"type":"text","name":"ab-adults-l09-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Qu'est-ce que vous faites dans la vie ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you do for a living?</p><p><b>Say your job and where you work.</b></p><p style=\"opacity:.7;\">For example: “Je suis professeur. Je travaille dans une école.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je suis professeur. Je travaille dans une école.","size":null,"created":{"_seconds":1793275881,"_nanoseconds":305000000}},{"id":"cuwLv3R2Mg8RNR2g43nU","level":"a0-tout-public","lesson":9,"part":14,"type":"text","name":"ab-adults-l09-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💼</div><p><b>Work talk, done!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about your job and where you work. That is an easy bridge into longer conversations.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275881,"_nanoseconds":448000000}}]