[{"id":"CQ04Ko0lgcrIiKWcfGdh","level":"a0-tout-public","lesson":15,"part":1,"type":"text","name":"ab-adults-l15-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you order a drink and something to eat in a café. It is a very typical situation in France. You use je voudrais, I would like, which is polite and easy. We keep everything from before: greetings, politeness, numbers and so on.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275891,"_nanoseconds":525000000}},{"id":"WD5isDBf2jjc4i1rsU2p","level":"a0-tout-public","lesson":15,"part":2,"type":"text","name":"ab-adults-l15-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">☕</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A café terrace with a coffee and a croissant</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275891,"_nanoseconds":576000000}},{"id":"iFBFTBRRIqESM3rAQhvH","level":"a0-tout-public","lesson":15,"part":2,"type":"text","name":"ab-adults-l15-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je voudrais means I would like, and it is polite. Un café is a coffee, un thé a tea, de l'eau water, un croissant a croissant. And always add s'il vous plaît, please.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais un café, s'il vous plaît.</b><span style=\"opacity:.7;\"> · I would like a coffee, please.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un thé, s'il vous plaît.</b><span style=\"opacity:.7;\"> · A tea, please.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>De l'eau, s'il vous plaît.</b><span style=\"opacity:.7;\"> · Water, please.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un croissant.</b><span style=\"opacity:.7;\"> · A croissant.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275891,"_nanoseconds":578000000}},{"id":"pdqSIuVw8rheQw64qxz2","level":"a0-tout-public","lesson":15,"part":3,"type":"text","name":"ab-adults-l15-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais un café, s'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">I would like a coffee, please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais un café, s'il vous plaît.","size":null,"created":{"_seconds":1793275891,"_nanoseconds":528000000}},{"id":"tFsjzVkyWEtKvrmoai0k","level":"a0-tout-public","lesson":15,"part":4,"type":"text","name":"ab-adults-l15-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un thé, s'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">A tea, please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un thé, s'il vous plaît.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":32000000}},{"id":"BFdVyqhgzbJepZsXWeei","level":"a0-tout-public","lesson":15,"part":5,"type":"text","name":"ab-adults-l15-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>De l'eau, s'il vous plaît.</b></p><p style=\"opacity:.75;margin:0;\">Water, please.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"De l'eau, s'il vous plaît.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":34000000}},{"id":"NiPddNAVvN6y7XttBiBL","level":"a0-tout-public","lesson":15,"part":6,"type":"text","name":"ab-adults-l15-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un croissant.</b></p><p style=\"opacity:.75;margin:0;\">A croissant.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un croissant.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":27000000}},{"id":"x25K4JNPcaiuuSHphu9E","level":"a0-tout-public","lesson":15,"part":7,"type":"text","name":"ab-adults-l15-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je voudrais un café, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a coffee, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Un café. Et avec ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">One coffee. Anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Un croissant, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">A croissant, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Vous voulez de l'eau ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Would you like water?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, de l'eau, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, water, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je vous en prie. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye! See you soon!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275892,"_nanoseconds":28000000}},{"id":"ZTpld9UBRKcKWZlKeWrn","level":"a0-tout-public","lesson":15,"part":8,"type":"text","name":"ab-adults-l15-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Vous désirez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! What would you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je voudrais un café, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! I would like a coffee, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je voudrais un café, s'il vous plaît.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":469000000}},{"id":"MmnEkFQ5vzAVII2x7iQT","level":"a0-tout-public","lesson":15,"part":9,"type":"text","name":"ab-adults-l15-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Un café. Et avec ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">One coffee. Anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Un croissant, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">A croissant, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Un croissant, s'il vous plaît.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":467000000}},{"id":"xIsfOCgCXkxbodZHC4fg","level":"a0-tout-public","lesson":15,"part":10,"type":"text","name":"ab-adults-l15-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Vous voulez de l'eau ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Would you like water?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, de l'eau, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, water, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, de l'eau, s'il vous plaît.","size":null,"created":{"_seconds":1793275892,"_nanoseconds":520000000}},{"id":"iUuWb007KJeK4DzQMMZg","level":"a0-tout-public","lesson":15,"part":11,"type":"text","name":"ab-adults-l15-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup !","size":null,"created":{"_seconds":1793275892,"_nanoseconds":523000000}},{"id":"41cesNKCM4BRDS1r1uNe","level":"a0-tout-public","lesson":15,"part":12,"type":"text","name":"ab-adults-l15-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je vous en prie. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome. Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir ! À bientôt !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye! See you soon!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir ! À bientôt !","size":null,"created":{"_seconds":1793275893,"_nanoseconds":221000000}},{"id":"ODiFdINSqK7r0jCdOZ6X","level":"a0-tout-public","lesson":15,"part":13,"type":"text","name":"ab-adults-l15-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Bonjour ! Vous désirez ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Hello! What would you like?</p><p><b>Order a drink and something to eat, politely.</b></p><p style=\"opacity:.7;\">For example: “Je voudrais un thé et un croissant, s'il vous plaît.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je voudrais un thé et un croissant, s'il vous plaît.","size":null,"created":{"_seconds":1793275893,"_nanoseconds":216000000}},{"id":"VZbsQAfhYJj2RRES600L","level":"a0-tout-public","lesson":15,"part":14,"type":"text","name":"ab-adults-l15-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">☕</div><p><b>Café ready!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can order in a café, politely, with je voudrais and s'il vous plaît. You could do this in France tomorrow.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275893,"_nanoseconds":263000000}}]