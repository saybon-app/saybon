tle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📅</div><p><b>Calendar mastered!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say days, months and dates. These will return in nearly every plan you make in French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275889,"_nanoseconds":468000000}}]