[{"id":"zFSe0UaErMhRxB0WesBB","level":"a0-tout-public","lesson":13,"part":1,"type":"text","name":"ab-adults-l13-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you learn the days of the week and the months. These are essential for plans and appointments. In French, days and months are not capitalised. We will also say today's date. Take your time with the pronunciation, because some of these words are long.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275887,"_nanoseconds":165000000}},{"id":"RHzmkd5Mdb6NxfXQtRzH","level":"a0-tout-public","lesson":13,"part":2,"type":"text","name":"ab-adults-l13-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📅</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A wall calendar with March circled</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275887,"_nanoseconds":176000000}},{"id":"AaNi5XVEEkejm1b1RCa0","level":"a0-tout-public","lesson":13,"part":2,"type":"text","name":"ab-adults-l13-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 The days: lundi, mardi, mercredi, jeudi, vendredi, samedi, dimanche. The months: janvier, février, mars, avril, mai, juin, juillet, août, septembre, octobre, novembre, décembre. To ask the day, say quel jour sommes-nous. To say the date: c'est le cinq mars.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Lundi, mardi, mercredi</b><span style=\"opacity:.7;\"> · Monday, Tuesday, Wednesday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Jeudi, vendredi, samedi, dimanche</b><span style=\"opacity:.7;\"> · Thursday to Sunday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Janvier, février, mars</b><span style=\"opacity:.7;\"> · January, February, March</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quel jour sommes-nous ?</b><span style=\"opacity:.7;\"> · What day is it?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275887,"_nanoseconds":869000000}},{"id":"3BkJCY7DL6LASGtit2sz","level":"a0-tout-public","lesson":13,"part":3,"type":"text","name":"ab-adults-l13-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Lundi, mardi, mercredi</b></p><p style=\"opacity:.75;margin:0;\">Monday, Tuesday, Wednesday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Lundi, mardi, mercredi","size":null,"created":{"_seconds":1793275887,"_nanoseconds":924000000}},{"id":"3JfiwUEyZr7QaoLCyeL6","level":"a0-tout-public","lesson":13,"part":4,"type":"text","name":"ab-adults-l13-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Jeudi, vendredi, samedi, dimanche</b></p><p style=\"opacity:.75;margin:0;\">Thursday to Sunday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Jeudi, vendredi, samedi, dimanche","size":null,"created":{"_seconds":1793275887,"_nanoseconds":882000000}},{"id":"qYhZlmnxjVHoGdqwApx9","level":"a0-tout-public","lesson":13,"part":5,"type":"text","name":"ab-adults-l13-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Janvier, février, mars</b></p><p style=\"opacity:.75;margin:0;\">January, February, March</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Janvier, février, mars","size":null,"created":{"_seconds":1793275887,"_nanoseconds":918000000}},{"id":"7KHJsZySjikITksfKM7Z","level":"a0-tout-public","lesson":13,"part":6,"type":"text","name":"ab-adults-l13-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quel jour sommes-nous ?</b></p><p style=\"opacity:.75;margin:0;\">What day is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Quel jour sommes-nous ?","size":null,"created":{"_seconds":1793275888,"_nanoseconds":403000000}},{"id":"3sAk4zQJIFZbQdacRG6V","level":"a0-tout-public","lesson":13,"part":7,"type":"text","name":"ab-adults-l13-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quel jour sommes-nous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What day is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Nous sommes lundi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's Monday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And tomorrow?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Demain, c'est mardi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tomorrow is Tuesday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous êtes né en quel mois ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which month were you born?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis né en mars.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I was born in March.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>C'est le combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What date?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est le cinq mars.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's the fifth of March.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275888,"_nanoseconds":346000000}},{"id":"Quae3UEXfCmBJzFAPjgt","level":"a0-tout-public","lesson":13,"part":8,"type":"text","name":"ab-adults-l13-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm fine, thank 