[{"id":"S4ck16Vo6raefLTz3L9R","level":"a0-tout-public","lesson":4,"part":1,"type":"text","name":"ab-adults-l04-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we look at sounds that do not exist in English: the French u, the ou, the French r, and the nasal sounds. Do not worry about being perfect. Listen, copy the shape of my mouth, and speak. The conversation will use words with exactly these sounds.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275872,"_nanoseconds":49000000}},{"id":"jnUcbDSTK68TTRrq0kBl","level":"a0-tout-public","lesson":4,"part":2,"type":"text","name":"ab-adults-l04-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👄</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A close-up of lips shaped to say the French 'u'</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275872,"_nanoseconds":45000000}},{"id":"jRrpqNcJD8wPfwZb4Uo3","level":"a0-tout-public","lesson":4,"part":2,"type":"text","name":"ab-adults-l04-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Three sounds to know. For u, round your lips as if to say oo, but say ee. In salut, rue and tu. For ou, a normal oo sound, like in bonjour and vous. And the nasal sounds, where air goes through your nose: bon, en, vin.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Salut</b><span style=\"opacity:.7;\"> · Hi</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous</b><span style=\"opacity:.7;\"> · You</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une rue</b><span style=\"opacity:.7;\"> · A street</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bon, enchanté.</b><span style=\"opacity:.7;\"> · Good, pleased to meet you.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275872,"_nanoseconds":237000000}},{"id":"HTqFGtLdevHa6HHKAmHY","level":"a0-tout-public","lesson":4,"part":3,"type":"text","name":"ab-adults-l04-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Salut</b></p><p style=\"opacity:.75;margin:0;\">Hi</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Salut","size":null,"created":{"_seconds":1793275872,"_nanoseconds":333000000}},{"id":"BhbiNjEJiGiY6xoaC61A","level":"a0-tout-public","lesson":4,"part":4,"type":"text","name":"ab-adults-l04-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous</b></p><p style=\"opacity:.75;margin:0;\">You</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vous","size":null,"created":{"_seconds":1793275872,"_nanoseconds":475000000}},{"id":"Gy48WpaznXoC9YSjmP0g","level":"a0-tout-public","lesson":4,"part":5,"type":"text","name":"ab-adults-l04-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une rue</b></p><p style=\"opacity:.75;margin:0;\">A street</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Une rue","size":null,"created":{"_seconds":1793275872,"_nanoseconds":524000000}},{"id":"qiLR55qTCAEsYcYnAcnN","level":"a0-tout-public","lesson":4,"part":6,"type":"text","name":"ab-adults-l04-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bon, enchanté.</b></p><p style=\"opacity:.75;margin:0;\">Good, pleased to meet you.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bon, enchanté.","size":null,"created":{"_seconds":1793275872,"_nanoseconds":665000000}},{"id":"93CcfUOmqj7C5WYwGH8M","level":"a0-tout-public","lesson":4,"part":7,"type":"text","name":"ab-adults-l04-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Répétez : salut.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Repeat: salut.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Salut.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Maintenant : vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Now: vous.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le mot « rue » ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the word 'rue'?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Une rue.</b><br><span style=\"opacity:.7;font-size:.9rem;\">A street.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bravo ! Dernier mot : bon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Well done! Last word: bon.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bon, enchanté. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good, pleased to meet you. Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793275872,"_nanoseconds":747000000}},{"id":"lUFLX8FRAcc9Cw31DPoU","level":"a0-tout-public","lesson":4,"part":8,"type":"text","name":"ab-adults-l04-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien, merci. Et vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very well, thank you. And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien, merci. Et vous ?","size":null,"created":{"_seconds":1793275872,"_nanoseconds":895000000}},{"id":"GYWHZMVZn7RljiTsX42y","level":"a0-tout-public","lesson":4,"part":9,"type":"text","name":"ab-adults-l04-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Répétez : salut.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very well. Repeat: salut.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Salut.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Salut.","size":null,"created":{"_seconds":1793275872,"_nanoseconds":952000000}},{"id":"ITvJ7AzjAXlSlHGSHHh5","level":"a0-tout-public","lesson":4,"part":10,"type":"text","name":"ab-adults-l04-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Maintenant : vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Now: vous.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Vous.","size":null,"created":{"_seconds":1793275873,"_nanoseconds":83000000}},{"id":"89fbWoG6tj6thaM7bhk7","level":"a0-tout-public","lesson":4,"part":11,"type":"text","name":"ab-adults-l04-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le mot « rue » ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And the word 'rue'?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Une rue.</b><br><span style=\"opacity:.7;font-size:.9rem;\">A street.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Une rue.","size":null,"created":{"_seconds":1793275873,"_nanoseconds":201000000}},{"id":"pDoIiieQAu450rbbcHxL","level":"a0-tout-public","lesson":4,"part":12,"type":"text","name":"ab-adults-l04-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bravo ! Dernier mot : bon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Well done! Last word: bon.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bon, enchanté. Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good, pleased to meet you. Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bon, enchanté. Au revoir !","size":null,"created":{"_seconds":1793275873,"_nanoseconds":305000000}},{"id":"j8wgupeZYYGjgqGA6kGL","level":"a0-tout-public","lesson":4,"part":13,"type":"text","name":"ab-adults-l04-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Dites ces mots : salut, vous, une rue, bon.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Say these words: salut, vous, une rue, bon.</p><p><b>Say the four words clearly.</b></p><p style=\"opacity:.7;\">For example: “Salut. Vous. Une rue. Bon.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Salut. Vous. Une rue. Bon.","size":null,"created":{"_seconds":1793275873,"_nanoseconds":467000000}},{"id":"b9O10rZ8zp923bP5i8fn","level":"a0-tout-public","lesson":4,"part":14,"type":"text","name":"ab-adults-l04-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👄</div><p><b>Sounds practised!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You have met three tricky French sounds. You will keep hearing them in every lesson, so they will get easier.</p>","recordPrompt":null,"expectedText":null,"size":null,"creat