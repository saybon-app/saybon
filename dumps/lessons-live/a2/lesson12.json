[{"id":"7fabyVMZ12v03xNYdUSq","level":"a2","lesson":12,"part":1,"type":"text","name":"a2-l12-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you go shopping, compare, and negotiate. You've compared things at A1. Now you use it in a real situation: asking for a better price, a different size, or a discount. Politeness and clarity help here.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276047,"_nanoseconds":528000000}},{"id":"x0sDfWYsZAFA8JLi5l5y","level":"a2","lesson":12,"part":2,"type":"text","name":"a2-l12-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛍️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Shopping</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276047,"_nanoseconds":560000000}},{"id":"4zC4HMRny0gh9wHpBg7Z","level":"a2","lesson":12,"part":2,"type":"text","name":"a2-l12-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 C'est trop cher ! Vous pouvez faire un prix ? Auriez-vous moins cher ? Je prends les deux, vous pouvez me faire une réduction ? Le plus beau, le moins cher, le meilleur.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est trop cher.</b><span style=\"opacity:.7;\"> · It's too expensive.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous pouvez faire un prix ?</b><span style=\"opacity:.7;\"> · Can you give me a better price?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je prends les deux.</b><span style=\"opacity:.7;\"> · I'll take both.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est le moins cher.</b><span style=\"opacity:.7;\"> · It's the cheapest.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276048,"_nanoseconds":34000000}},{"id":"IZeveNDhOMwNJzWWG7Yy","level":"a2","lesson":12,"part":3,"type":"text","name":"a2-l12-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est trop cher.</b></p><p style=\"opacity:.75;margin:0;\">It's too expensive.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est trop cher.","size":null,"created":{"_seconds":1793276047,"_nanoseconds":991000000}},{"id":"nAcvlQtagsBXPFnwTRpS","level":"a2","lesson":12,"part":4,"type":"text","name":"a2-l12-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous pouvez faire un prix ?</b></p><p style=\"opacity:.75;margin:0;\">Can you give me a better price?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vous pouvez faire un prix ?","size":null,"created":{"_seconds":1793276047,"_nanoseconds":986000000}},{"id":"xjvW0cHCChvIVq8PDC7L","level":"a2","lesson":12,"part":5,"type":"text","name":"a2-l12-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je prends les deux.</b></p><p style=\"opacity:.75;margin:0;\">I'll take both.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je prends les deux.","size":null,"created":{"_seconds":1793276048,"_nanoseconds":35000000}},{"id":"PBaHJ0wQs8jWFkHgUO8T","level":"a2","lesson":12,"part":6,"type":"text","name":"a2-l12-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est le moins cher.</b></p><p style=\"opacity:.75;margin:0;\">It's the cheapest.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"C'est le moins cher.","size":null,"created":{"_seconds":1793276048,"_nanoseconds":489000000}},{"id":"lH81DUdEmB5IZvAlQWt8","level":"a2","lesson":12,"part":7,"type":"text","name":"a2-l12-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour, je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, can I help you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, combien coûte ce sac ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, how much is this bag?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il coûte soixante-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It costs seventy euros.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un peu cher. Vous pouvez faire un prix ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a bit expensive. Can you give me a better price?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Si vous prenez les deux, je peux faire quatre-vingt-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">If you take both, I can do ninety euros.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Alors je prends les deux. C'est le meilleur prix ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I'll take both. Is that the best price?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, c'est mon dernier prix.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, that's my final price.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'accord, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right, thank you.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276048,"_nanoseconds":493000000}},{"id":"EH57Y30tJmkztoT0JKFP","level":"a2","lesson":12,"part":8,"type":"text","name":"a2-l12-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour, je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, can I help you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, combien coûte ce sac ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, how much is this bag?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, combien coûte ce sac ?","size":null,"created":{"_seconds":1793276048,"_nanoseconds":490000000}},{"id":"14bHAGr5W5Z635IFEaqt","level":"a2","lesson":12,"part":9,"type":"text","name":"a2-l12-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il coûte soixante-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It costs seventy euros.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est un peu cher. Vous pouvez faire un prix ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a bit expensive. Can you give me a better price?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est un peu cher. Vous pouvez faire un prix ?","size":null,"created":{"_seconds":1793276048,"_nanoseconds":493000000}},{"id":"PWa1qurzBL7xwEbSMeLL","level":"a2","lesson":12,"part":10,"type":"text","name":"a2-l12-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Si vous prenez les deux, je peux faire quatre-vingt-dix euros.</b><br><span style=\"opacity:.7;font-size:.9rem;\">If you take both, I can do ninety euros.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Alors je prends les deux. C'est le meilleur prix ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I'll take both. Is that the best price?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Alors je prends les deux. C'est le meilleur prix ?","size":null,"created":{"_seconds":1793276048,"_nanoseconds":974000000}},{"id":"U0Pqzx0IGcLTn9izELSl","level":"a2","lesson":12,"part":11,"type":"text","name":"a2-l12-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, c'est mon dernier prix.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, that's my final price.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'accord, merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right, thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"D'accord, merci.","size":null,"created":{"_seconds":1793276048,"_nanoseconds":978000000}},{"id":"WQdMBt8Latz3818D04KH","level":"a2","lesson":12,"part":12,"type":"text","name":"a2-l12-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Négociez un prix.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Negotiate a price.</p><p><b>Say it's expensive, ask for a better price and decide.</b></p><p style=\"opacity:.7;\">For example: “C'est un peu cher. Vous pouvez faire un prix ? Je prends les deux.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"C'est un peu cher. Vous pouvez faire un prix ? Je prends les deux.","size":null,"created":{"_seconds":1793276048,"_nanoseconds":980000000}},{"id":"UlS0BtUPD2iXPLF1xHgv","level":"a2","lesson":12,"part":13,"type":"text","name":"a2-l12-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛍️</div><p><b>Bargain made!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can compare and negotiate politely. Useful at any market.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276048,"_nanoseconds":979000000}}]