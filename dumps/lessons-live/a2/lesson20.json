[{"id":"fug0ZxnenWJ6Wcu1xbE9","level":"a2","lesson":20,"part":1,"type":"text","name":"a2-l20-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you give your opinion simply. Je pense que, à mon avis, je trouve que. You can also agree or disagree. L'important est de justifier votre opinion avec une raison.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276060,"_nanoseconds":516000000}},{"id":"IADFDqhibaapGaSUK7sf","level":"a2","lesson":20,"part":2,"type":"text","name":"a2-l20-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗨️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Simple opinions</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276060,"_nanoseconds":567000000}},{"id":"VLCBQ57XIXmiRBdemxf9","level":"a2","lesson":20,"part":2,"type":"text","name":"a2-l20-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je pense que... À mon avis... Je trouve que... Je crois que... Pour agree: je suis d'accord. Pour disagree: je ne suis pas d'accord. Add parce que for your reason.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je pense que c'est une bonne idée.</b><span style=\"opacity:.7;\"> · I think it's a good idea.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À mon avis, c'est trop cher.</b><span style=\"opacity:.7;\"> · In my opinion, it's too expensive.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis d'accord avec toi.</b><span style=\"opacity:.7;\"> · I agree with you.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je ne suis pas d'accord.</b><span style=\"opacity:.7;\"> · I disagree.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276060,"_nanoseconds":696000000}},{"id":"2G2JLxhrHZraJ15nc6s2","level":"a2","lesson":20,"part":3,"type":"text","name":"a2-l20-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je pense que c'est une bonne idée.</b></p><p style=\"opacity:.75;margin:0;\">I think it's a good idea.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je pense que c'est une bonne idée.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":791000000}},{"id":"oKPrMShbmG6Xs4dGcSn7","level":"a2","lesson":20,"part":4,"type":"text","name":"a2-l20-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À mon avis, c'est trop cher.</b></p><p style=\"opacity:.75;margin:0;\">In my opinion, it's too expensive.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À mon avis, c'est trop cher.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":909000000}},{"id":"ydXbcvOBhZiP3uzU9us9","level":"a2","lesson":20,"part":5,"type":"text","name":"a2-l20-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis d'accord avec toi.</b></p><p style=\"opacity:.75;margin:0;\">I agree with you.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis d'accord avec toi.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":989000000}},{"id":"X3QbwkyDqEkaC7KVGCud","level":"a2","lesson":20,"part":6,"type":"text","name":"a2-l20-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je ne suis pas d'accord.</b></p><p style=\"opacity:.75;margin:0;\">I disagree.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je ne suis pas d'accord.","size":null,"created":{"_seconds":1793276061,"_nanoseconds":97000000}},{"id":"qKD1VjVyx80MTZB8fNix","level":"a2","lesson":20,"part":7,"type":"text","name":"a2-l20-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Que pensez-vous des réseaux sociaux ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you think of social networks?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je pense que c'est utile pour communiquer.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think it's useful for communicating.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et pour les enfants ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for children?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À mon avis, c'est dangereux parce qu'ils passent trop de temps dessus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In my opinion, it's dangerous because they spend too much time on them.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je ne suis pas d'accord, ça dépend.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I don't agree, it depends.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, tu as raison, ça dépend de l'âge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, you're right, it depends on the age.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Alors, que faut-il faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So what should be done?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je trouve qu'il faut limiter l'usage, c'est tout.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think we should limit usage, that's all.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276061,"_nanoseconds":207000000}},{"id":"G2Y1L3ZQ8NsFyEj4tSKx","level":"a2","lesson":20,"part":8,"type":"text","name":"a2-l20-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Que pensez-vous des réseaux sociaux ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you think of social networks?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je pense que c'est utile pour communiquer.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think it's useful for communicating.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je pense que c'est utile pour communiquer.","size":null,"created":{"_seconds":1793276061,"_nanoseconds":314000000}},{"id":"rSiBHyRkEDX6aitSCE4L","level":"a2","lesson":20,"part":9,"type":"text","name":"a2-l20-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et pour les enfants ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for children?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À mon avis, c'est dangereux parce qu'ils passent trop de temps dessus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In my opinion, it's dangerous because they spend too much time on them.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À mon avis, c'est dangereux parce qu'ils passent trop de temps dessus.","size":null,"created":{"_seconds":1793276061,"_nanoseconds":390000000}},{"id":"Vw4YAGND8XWLIBGhSHrL","level":"a2","lesson":20,"part":10,"type":"text","name":"a2-l20-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je ne suis pas d'accord, ça dépend.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I don't agree, it depends.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, tu as raison, ça dépend de l'âge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, you're right, it depends on the age.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, tu as raison, ça dépend de l'âge.","size":null,"created":{"_seconds":1793276061,"_nanoseconds":773000000}},{"id":"L2hvwgG46hKOn6sGExld","level":"a2","lesson":20,"part":11,"type":"text","name":"a2-l20-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Alors, que faut-il faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So what should be done?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je trouve qu'il faut limiter l'usage, c'est tout.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think we should limit usage, that's all.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je trouve qu'il faut limiter l'usage, c'est tout.","size":null,"created":{"_seconds":1793276061,"_nanoseconds":856000000}},{"id":"dOr5iZX9aLBHgu0wMU2q","level":"a2","lesson":20,"part":12,"type":"text","name":"a2-l20-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Donnez votre opinion sur un sujet.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Give your opinion on a topic.</p><p><b>Give an opinion on a topic with a reason.</b></p><p style=\"opacity:.7;\">For example: “Je pense que le sport est important parce que c'est bon pour la santé.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je pense que le sport est important parce que c'est bon pour la santé.","size":null,"created":{"_seconds":1793276062,"_nanoseconds":14000000}},{"id":"z4PD2HmhdXvzihZF8Q8M","level":"a2","lesson":20,"part":13,"type":"text","name":"a2-l20-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗨️</div><p><b>Opinion voiced!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can give and justify an opinion, and agree or disagree politely.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276061,"_nanoseconds":931000000}}]