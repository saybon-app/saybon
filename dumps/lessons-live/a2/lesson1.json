[{"id":"durr1Lp3zG9bz5MJw6YH","level":"a2","lesson":1,"part":1,"type":"text","name":"a2-l01-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bienvenue en A2 ! Welcome to A2. Au niveau A1, vous avez parlé de votre vie. Now we make your speech flow. Today you describe your day in a clear sequence, using d'abord, ensuite, puis and enfin. Écoutez, puis parlez.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276029,"_nanoseconds":34000000}},{"id":"7PkXSz4AEJJPuRKm25EE","level":"a2","lesson":1,"part":2,"type":"text","name":"a2-l01-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🕒</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Describing my day</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276029,"_nanoseconds":33000000}},{"id":"z5s8S5hTGNy1YT6uQGME","level":"a2","lesson":1,"part":2,"type":"text","name":"a2-l01-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Les mots de séquence: d'abord, ensuite, puis, après, enfin. They link your sentences into a story. Add les heures: à sept heures, vers midi, en fin d'après-midi.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>D'abord, je me lève.</b><span style=\"opacity:.7;\"> · First, I get up.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ensuite, je prends le bus.</b><span style=\"opacity:.7;\"> · Then I take the bus.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vers midi, je mange.</b><span style=\"opacity:.7;\"> · Around noon, I eat.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Enfin, je me couche.</b><span style=\"opacity:.7;\"> · Finally, I go to bed.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276029,"_nanoseconds":81000000}},{"id":"e890aWWwGzrSOzS2zJab","level":"a2","lesson":1,"part":3,"type":"text","name":"a2-l01-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>D'abord, je me lève.</b></p><p style=\"opacity:.75;margin:0;\">First, I get up.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"D'abord, je me lève.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":35000000}},{"id":"YSlXQXaCSZeCXGdSvRCS","level":"a2","lesson":1,"part":4,"type":"text","name":"a2-l01-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ensuite, je prends le bus.</b></p><p style=\"opacity:.75;margin:0;\">Then I take the bus.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ensuite, je prends le bus.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":455000000}},{"id":"9I56mioI6l8Z97DXfbIc","level":"a2","lesson":1,"part":5,"type":"text","name":"a2-l01-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vers midi, je mange.</b></p><p style=\"opacity:.75;margin:0;\">Around noon, I eat.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Vers midi, je mange.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":448000000}},{"id":"sgm1JDEIOQHZ9cYKuUbO","level":"a2","lesson":1,"part":6,"type":"text","name":"a2-l01-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Enfin, je me couche.</b></p><p style=\"opacity:.75;margin:0;\">Finally, I go to bed.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Enfin, je me couche.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":445000000}},{"id":"t8jmrK1FdNnOw9q6m5ZB","level":"a2","lesson":1,"part":7,"type":"text","name":"a2-l01-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Racontez-moi une journée normale.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Tell me about a normal day.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'abord, je me lève à six heures et je prends le petit déjeuner.</b><br><span style=\"opacity:.7;font-size:.9rem;\">First, I get up at six and have breakfast.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ensuite, je prends le bus pour aller au travail.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I take the bus to go to work.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et à midi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And at noon?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Vers midi, je mange avec mes collègues.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Around noon, I eat with my colleagues.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Enfin, je rentre à la maison, je cuisine et je me couche tôt.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Finally, I go home, I cook and I go to bed early.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276029,"_nanoseconds":491000000}},{"id":"qrpgyClXFTdyPlZl47nH","level":"a2","lesson":1,"part":8,"type":"text","name":"a2-l01-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Racontez-moi une journée normale.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! Tell me about a normal day.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'abord, je me lève à six heures et je prends le petit déjeuner.</b><br><span style=\"opacity:.7;font-size:.9rem;\">First, I get up at six and have breakfast.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"D'abord, je me lève à six heures et je prends le petit déjeuner.","size":null,"created":{"_seconds":1793276030,"_nanoseconds":21000000}},{"id":"YPlEssFpOKrtNd0gtDjK","level":"a2","lesson":1,"part":9,"type":"text","name":"a2-l01-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ensuite, je prends le bus pour aller au travail.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Then I take the bus to go to work.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ensuite, je prends le bus pour aller au travail.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":957000000}},{"id":"BwX4SgJM9mtdEGHncULx","level":"a2","lesson":1,"part":10,"type":"text","name":"a2-l01-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et à midi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And at noon?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Vers midi, je mange avec mes collègues.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Around noon, I eat with my colleagues.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Vers midi, je mange avec mes collègues.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":962000000}},{"id":"8WGYTdsEEp1kXYXE5lOX","level":"a2","lesson":1,"part":11,"type":"text","name":"a2-l01-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et le soir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the evening?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Enfin, je rentre à la maison, je cuisine et je me couche tôt.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Finally, I go home, I cook and I go to bed early.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Enfin, je rentre à la maison, je cuisine et je me couche tôt.","size":null,"created":{"_seconds":1793276029,"_nanoseconds":965000000}},{"id":"zsLW1iYO5NmXlM68XFhJ","level":"a2","lesson":1,"part":12,"type":"text","name":"a2-l01-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez votre journée.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe your day.</p><p><b>Describe your day in five sentences with sequence words.</b></p><p style=\"opacity:.7;\">For example: “D'abord, je me lève à six heures. Ensuite, je travaille. Puis je mange. Après, je rentre. Enfin, je me couche.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"D'abord, je me lève à six heures. Ensuite, je travaille. Puis je mange. Après, je rentre. Enfin, je me couche.","size":null,"created":{"_seconds":1793276030,"_nanoseconds":576000000}},{"id":"dY8q3IHjuefGrxaTFzby","level":"a2","lesson":1,"part":13,"type":"text","name":"a2-l01-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🕒</div><p><b>Day described!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe a whole day in a clear sequence. This shapes everything you'll say next.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276030,"_nanoseconds":573000000}}]