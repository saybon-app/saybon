[{"id":"TxtO1LFrLB9SQll1x6rS","level":"a2","lesson":21,"part":1,"type":"text","name":"a2-l21-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Today you learn to complain politely. In a hotel or a restaurant, things can go wrong. French people appreciate a calm and polite complaint. Tone matters: say the problem, then ask for a solution.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276062,"_nanoseconds":184000000}},{"id":"PtC30eMddD2fHnUOszij","level":"a2","lesson":21,"part":2,"type":"text","name":"a2-l21-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛎️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Polite complaints</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276062,"_nanoseconds":258000000}},{"id":"rh6v1nbuqSWOhNkLGTpf","level":"a2","lesson":21,"part":2,"type":"text","name":"a2-l21-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Excusez-moi, il y a un problème. La chambre n'est pas propre. Le plat est froid. Je suis désolé de vous déranger, mais... Pourriez-vous régler ça ? Je voudrais être remboursé.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il y a un problème.</b><span style=\"opacity:.7;\"> · There is a problem.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le plat est froid.</b><span style=\"opacity:.7;\"> · The dish is cold.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pourriez-vous régler ça ?</b><span style=\"opacity:.7;\"> · Could you sort this out?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais être remboursé.</b><span style=\"opacity:.7;\"> · I'd like a refund.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276062,"_nanoseconds":337000000}},{"id":"oqPlNKua4NDk7Q4Aps0M","level":"a2","lesson":21,"part":3,"type":"text","name":"a2-l21-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il y a un problème.</b></p><p style=\"opacity:.75;margin:0;\">There is a problem.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il y a un problème.","size":null,"created":{"_seconds":1793276062,"_nanoseconds":411000000}},{"id":"T8IWSA6C59UGaIjZ1IVK","level":"a2","lesson":21,"part":4,"type":"text","name":"a2-l21-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le plat est froid.</b></p><p style=\"opacity:.75;margin:0;\">The dish is cold.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le plat est froid.","size":null,"created":{"_seconds":1793276062,"_nanoseconds":638000000}},{"id":"uGOUACvAKM1vewnqR4iO","level":"a2","lesson":21,"part":5,"type":"text","name":"a2-l21-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pourriez-vous régler ça ?</b></p><p style=\"opacity:.75;margin:0;\">Could you sort this out?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pourriez-vous régler ça ?","size":null,"created":{"_seconds":1793276062,"_nanoseconds":656000000}},{"id":"nNWz8rxHmGEpjEmXTsKU","level":"a2","lesson":21,"part":6,"type":"text","name":"a2-l21-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais être remboursé.</b></p><p style=\"opacity:.75;margin:0;\">I'd like a refund.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais être remboursé.","size":null,"created":{"_seconds":1793276062,"_nanoseconds":779000000}},{"id":"uLRJQhDYPAg3jM8etbZx","level":"a2","lesson":21,"part":7,"type":"text","name":"a2-l21-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonsoir, tout va bien pour vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening, is everything fine for you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Excusez-moi, il y a un petit problème. Mon plat est froid.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, there's a small problem. My dish is cold.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oh, je suis désolée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, I'm sorry.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Pourriez-vous le réchauffer, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Could you heat it up, please?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bien sûr. Je vous apporte un autre plat.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course. I'll bring you another dish.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est très gentil. Merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's very kind. Thank you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je vous offre le dessert.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'll offer you the dessert.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci beaucoup, c'est très aimable.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much, that's very kind.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276062,"_nanoseconds":817000000}},{"id":"6iG5QN6l11yIqZrhanET","level":"a2","lesson":21,"part":8,"type":"text","name":"a2-l21-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonsoir, tout va bien pour vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Good evening, is everything fine for you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Excusez-moi, il y a un petit problème. Mon plat est froid.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excuse me, there's a small problem. My dish is cold.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Excusez-moi, il y a un petit problème. Mon plat est froid.","size":null,"created":{"_seconds":1793276063,"_nanoseconds":31000000}},{"id":"sfCi5jusa7VCRQVQU7yv","level":"a2","lesson":21,"part":9,"type":"text","name":"a2-l21-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oh, je suis désolée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, I'm sorry.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Pourriez-vous le réchauffer, s'il vous plaît ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Could you heat it up, please?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Pourriez-vous le réchauffer, s'il vous plaît ?","size":null,"created":{"_seconds":1793276063,"_nanoseconds":49000000}},{"id":"sD5e5FEXHlwUk93EW8te","level":"a2","lesson":21,"part":10,"type":"text","name":"a2-l21-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bien sûr. Je vous apporte un autre plat.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course. I'll bring you another dish.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est très gentil. Merci.</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's very kind. Thank you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'est très gentil. Merci.","size":null,"created":{"_seconds":1793276063,"_nanoseconds":200000000}},{"id":"xfuX48ST7BkOnZXSunZB","level":"a2","lesson":21,"part":11,"type":"text","name":"a2-l21-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je vous offre le dessert.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'll offer you the dessert.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci beaucoup, c'est très aimable.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you very much, that's very kind.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci beaucoup, c'est très aimable.","size":null,"created":{"_seconds":1793276063,"_nanoseconds":211000000}},{"id":"zbV8mQmgkDqeC4GhqNKJ","level":"a2","lesson":21,"part":12,"type":"text","name":"a2-l21-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Plaignez-vous poliment.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Complain politely.</p><p><b>Describe the problem, ask for a solution, and thank.</b></p><p style=\"opacity:.7;\">For example: “Excusez-moi, il y a un problème. La chambre n'est pas propre. Pourriez-vous la nettoyer ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Excusez-moi, il y a un problème. La chambre n'est pas propre. Pourriez-vous la nettoyer ?","size":null,"created":{"_seconds":1793276063,"_nanoseconds":426000000}},{"id":"WvAnqe6z8HGAlPbGIE9U","level":"a2","lesson":21,"part":13,"type":"text","name":"a2-l21-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🛎️</div><p><b>Complaint handled!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can complain politely and effectively. Calm, clear French gets results.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276063,"_nanoseconds":449000000}}]