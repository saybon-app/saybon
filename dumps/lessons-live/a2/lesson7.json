[{"id":"FIOvtDQSaBVeOAyR9Thc","level":"a2","lesson":7,"part":1,"type":"text","name":"a2-l07-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Aujourd'hui, nous parlons du futur simple. We already know the near future. The futur simple is used for predictions, promises and more formal plans. It's formed with the infinitive plus -ai, -as, -a, -ons, -ez, -ont.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276039,"_nanoseconds":370000000}},{"id":"n8ZkbQsoffBUSgrw7mjY","level":"a2","lesson":7,"part":2,"type":"text","name":"a2-l07-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔮</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Future</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276039,"_nanoseconds":378000000}},{"id":"7Cym1q8wlXIIIGKGBhLn","level":"a2","lesson":7,"part":2,"type":"text","name":"a2-l07-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Infinitive + endings: je parlerai, tu parleras, il parlera, nous parlerons, vous parlerez, ils parleront. Irregulars: être (je serai), avoir (j'aurai), aller (j'irai), faire (je ferai).</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Demain, il fera beau.</b><span style=\"opacity:.7;\"> · Tomorrow the weather will be nice.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je serai à la maison.</b><span style=\"opacity:.7;\"> · I will be at home.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'irai en France.</b><span style=\"opacity:.7;\"> · I will go to France.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous parlerons plus tard.</b><span style=\"opacity:.7;\"> · We will talk later.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276039,"_nanoseconds":389000000}},{"id":"krB4duXdaaERejJzIxHI","level":"a2","lesson":7,"part":3,"type":"text","name":"a2-l07-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Demain, il fera beau.</b></p><p style=\"opacity:.75;margin:0;\">Tomorrow the weather will be nice.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Demain, il fera beau.","size":null,"created":{"_seconds":1793276039,"_nanoseconds":376000000}},{"id":"8jryzvi013iUT1haNvrY","level":"a2","lesson":7,"part":4,"type":"text","name":"a2-l07-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je serai à la maison.</b></p><p style=\"opacity:.75;margin:0;\">I will be at home.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je serai à la maison.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":45000000}},{"id":"l5PV8JrfAQnZgIrqrD8y","level":"a2","lesson":7,"part":5,"type":"text","name":"a2-l07-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'irai en France.</b></p><p style=\"opacity:.75;margin:0;\">I will go to France.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'irai en France.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":54000000}},{"id":"3bWKXmInbmjLmk9xemnh","level":"a2","lesson":7,"part":6,"type":"text","name":"a2-l07-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous parlerons plus tard.</b></p><p style=\"opacity:.75;margin:0;\">We will talk later.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous parlerons plus tard.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":101000000}},{"id":"PopjlWuX0lxcPW0Q5UYE","level":"a2","lesson":7,"part":7,"type":"text","name":"a2-l07-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous ferez l'année prochaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do next year?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>L'année prochaine, j'irai en France.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Next year, I will go to France.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous ferez là-bas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do there?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je visiterai Paris et j'étudierai le français.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I will visit Paris and study French.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il fera froid ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Will it be cold?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, il fera froid, mais je serai content.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, it will be cold, but I'll be happy.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous parlerez bien français alors ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">You'll speak French well then?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je l'espère ! Je parlerai tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I hope so! I'll speak every day.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276040,"_nanoseconds":104000000}},{"id":"d1zviff8bnMpNOGd4f0U","level":"a2","lesson":7,"part":8,"type":"text","name":"a2-l07-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous ferez l'année prochaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do next year?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">L'année prochaine, j'irai en France.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Next year, I will go to France.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"L'année prochaine, j'irai en France.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":528000000}},{"id":"CHoPlFMb7HWA7RDdrdv6","level":"a2","lesson":7,"part":9,"type":"text","name":"a2-l07-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous ferez là-bas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do there?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je visiterai Paris et j'étudierai le français.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I will visit Paris and study French.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je visiterai Paris et j'étudierai le français.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":506000000}},{"id":"prGHYG2Yjv3hP0Ovcuyf","level":"a2","lesson":7,"part":10,"type":"text","name":"a2-l07-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il fera froid ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Will it be cold?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, il fera froid, mais je serai content.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, it will be cold, but I'll be happy.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, il fera froid, mais je serai content.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":505000000}},{"id":"YaHwEtns2HawtRHPJsQ0","level":"a2","lesson":7,"part":11,"type":"text","name":"a2-l07-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous parlerez bien français alors ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">You'll speak French well then?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je l'espère ! Je parlerai tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I hope so! I'll speak every day.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je l'espère ! Je parlerai tous les jours.","size":null,"created":{"_seconds":1793276040,"_nanoseconds":502000000}},{"id":"KUehlJWyZ1JIARjaer0Y","level":"a2","lesson":7,"part":12,"type":"text","name":"a2-l07-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Faites des prédictions sur votre avenir.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Make predictions about your future.</p><p><b>Make three predictions about next year.</b></p><p style=\"opacity:.7;\">For example: “L'année prochaine, j'irai en France. Je parlerai mieux français. Je serai heureux.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"L'année prochaine, j'irai en France. Je parlerai mieux français. Je serai heureux.","size":null,"created":{"_seconds":1793276041,"_nanoseconds":18000000}},{"id":"Vi8Dk32BNlOIx1dSNk65","level":"a2","lesson":7,"part":13,"type":"text","name":"a2-l07-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔮</div><p><b>Future forecast!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about the future with le futur simple. Great for dreams and predictions.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276041,"_nanoseconds":21000000}}]