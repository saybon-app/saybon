[{"id":"HOXE2eanSlnU2fI6Qwuz","level":"a2","lesson":10,"part":1,"type":"text","name":"a2-l10-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you talk about health: symptoms, medicines, and advice. At A1 you could say where it hurts. Now you explain more, understand questions, and follow the doctor's advice. C'est une situation très utile.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276044,"_nanoseconds":247000000}},{"id":"R1OVSeI5TUQ9aVX8SVVF","level":"a2","lesson":10,"part":2,"type":"text","name":"a2-l10-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💊</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Health</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276044,"_nanoseconds":196000000}},{"id":"MNbKobKlAbtcLpJdjDK6","level":"a2","lesson":10,"part":2,"type":"text","name":"a2-l10-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Symptômes: j'ai de la fièvre, j'ai mal à la gorge, je tousse, je suis enrhumé. Le médecin dit: Prenez ce médicament deux fois par jour. Vous devez vous reposer. Depuis combien de temps ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai de la fièvre.</b><span style=\"opacity:.7;\"> · I have a fever.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je tousse beaucoup.</b><span style=\"opacity:.7;\"> · I cough a lot.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Deux fois par jour</b><span style=\"opacity:.7;\"> · twice a day</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je dois me reposer.</b><span style=\"opacity:.7;\"> · I must rest.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276044,"_nanoseconds":602000000}},{"id":"5ZKXeVM2fwvzed3aMbVe","level":"a2","lesson":10,"part":3,"type":"text","name":"a2-l10-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai de la fièvre.</b></p><p style=\"opacity:.75;margin:0;\">I have a fever.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai de la fièvre.","size":null,"created":{"_seconds":1793276044,"_nanoseconds":599000000}},{"id":"g6GJG3yn7GoXoYxfWOZU","level":"a2","lesson":10,"part":4,"type":"text","name":"a2-l10-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je tousse beaucoup.</b></p><p style=\"opacity:.75;margin:0;\">I cough a lot.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je tousse beaucoup.","size":null,"created":{"_seconds":1793276044,"_nanoseconds":603000000}},{"id":"Ge8pdTwIEmRfzEl7jE2B","level":"a2","lesson":10,"part":5,"type":"text","name":"a2-l10-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Deux fois par jour</b></p><p style=\"opacity:.75;margin:0;\">twice a day</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Deux fois par jour","size":null,"created":{"_seconds":1793276044,"_nanoseconds":648000000}},{"id":"CcdKvw3HSm1JAqEcgNBH","level":"a2","lesson":10,"part":6,"type":"text","name":"a2-l10-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je dois me reposer.</b></p><p style=\"opacity:.75;margin:0;\">I must rest.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je dois me reposer.","size":null,"created":{"_seconds":1793276045,"_nanoseconds":16000000}},{"id":"EYA2pMvlWNACcn3qA3Nv","level":"a2","lesson":10,"part":7,"type":"text","name":"a2-l10-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour, qu'est-ce qui vous arrive ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, what's the matter?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je tousse beaucoup et j'ai mal à la gorge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I cough a lot and I have a sore throat.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Depuis combien de temps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">For how long?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Depuis trois jours. J'ai aussi de la fièvre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For three days. I also have a fever.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Prenez ce médicament deux fois par jour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Take this medicine twice a day.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je dois le prendre avant ou après les repas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Should I take it before or after meals?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Après les repas. Et reposez-vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">After meals. And rest.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'accord, merci beaucoup, docteur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right, thank you very much, doctor.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276045,"_nanoseconds":49000000}},{"id":"iG17U4FGwzJScuGNsTV0","level":"a2","lesson":10,"part":8,"type":"text","name":"a2-l10-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour, qu'est-ce qui vous arrive ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, what's the matter?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je tousse beaucoup et j'ai mal à la gorge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I cough a lot and I have a sore throat.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je tousse beaucoup et j'ai mal à la gorge.","size":null,"created":{"_seconds":1793276045,"_nanoseconds":37000000}},{"id":"9rs2TdwlYR6KnWenwrtE","level":"a2","lesson":10,"part":9,"type":"text","name":"a2-l10-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Depuis combien de temps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">For how long?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Depuis trois jours. J'ai aussi de la fièvre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">For three days. I also have a fever.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Depuis trois jours. J'ai aussi de la fièvre.","size":null,"created":{"_seconds":1793276045,"_nanoseconds":53000000}},{"id":"nWY0txOysTAqiERZyXHf","level":"a2","lesson":10,"part":10,"type":"text","name":"a2-l10-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Prenez ce médicament deux fois par jour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Take this medicine twice a day.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je dois le prendre avant ou après les repas ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Should I take it before or after meals?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je dois le prendre avant ou après les repas ?","size":null,"created":{"_seconds":1793276045,"_nanoseconds":693000000}},{"id":"nDi0bFPPh9eZHHjoOXiI","level":"a2","lesson":10,"part":11,"type":"text","name":"a2-l10-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Après les repas. Et reposez-vous.</b><br><span style=\"opacity:.7;font-size:.9rem;\">After meals. And rest.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'accord, merci beaucoup, docteur.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right, thank you very much, doctor.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"D'accord, merci beaucoup, docteur.","size":null,"created":{"