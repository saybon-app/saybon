[{"id":"3yX3ccIehnL0LHpc56zG","level":"a2","lesson":24,"part":1,"type":"text","name":"a2-l24-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, vous racontez un événement en trois minutes. Un voyage, un mariage, une fête, un incident. Vous utilisez tout: passé composé, imparfait, mots de liaison, émotions. Ça demande un peu de préparation mentale.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276066,"_nanoseconds":516000000}},{"id":"YSDuBVfokCrRsfM2odAp","level":"a2","lesson":24,"part":2,"type":"text","name":"a2-l24-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📣</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Telling an event</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276066,"_nanoseconds":569000000}},{"id":"26uiZXaaxpqBsjjMxv2s","level":"a2","lesson":24,"part":2,"type":"text","name":"a2-l24-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Structure de récit: 1. Le contexte (imparfait). 2. Les actions (passé composé). 3. La fin et l'émotion. Mots utiles: un jour, soudain, pendant ce temps, finalement, heureusement, malheureusement.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un jour, soudain...</b><span style=\"opacity:.7;\"> · One day, suddenly...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pendant ce temps...</b><span style=\"opacity:.7;\"> · Meanwhile...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Heureusement, tout s'est bien passé.</b><span style=\"opacity:.7;\"> · Fortunately, everything went well.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Finalement, nous sommes arrivés.</b><span style=\"opacity:.7;\"> · Finally, we arrived.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276066,"_nanoseconds":685000000}},{"id":"lNhaZcRqdtRXy3WHaPO9","level":"a2","lesson":24,"part":3,"type":"text","name":"a2-l24-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un jour, soudain...</b></p><p style=\"opacity:.75;margin:0;\">One day, suddenly...</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un jour, soudain...","size":null,"created":{"_seconds":1793276066,"_nanoseconds":727000000}},{"id":"idOFTiVIkLPlB7dekQAb","level":"a2","lesson":24,"part":4,"type":"text","name":"a2-l24-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pendant ce temps...</b></p><p style=\"opacity:.75;margin:0;\">Meanwhile...</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pendant ce temps...","size":null,"created":{"_seconds":1793276066,"_nanoseconds":923000000}},{"id":"bE51NatWNOTbBjVX4N70","level":"a2","lesson":24,"part":5,"type":"text","name":"a2-l24-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Heureusement, tout s'est bien passé.</b></p><p style=\"opacity:.75;margin:0;\">Fortunately, everything went well.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Heureusement, tout s'est bien passé.","size":null,"created":{"_seconds":1793276066,"_nanoseconds":988000000}},{"id":"xs4fDs2AqPxMS73bThDx","level":"a2","lesson":24,"part":6,"type":"text","name":"a2-l24-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Finalement, nous sommes arrivés.</b></p><p style=\"opacity:.75;margin:0;\">Finally, we arrived.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Finalement, nous sommes arrivés.","size":null,"created":{"_seconds":1793276067,"_nanoseconds":391000000}},{"id":"RXLQa7cU4gEFLkDmcYJV","level":"a2","lesson":24,"part":7,"type":"text","name":"a2-l24-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Racontez-moi un événement important de votre vie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about an important event in your life.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Un jour, j'étais en voyage avec ma famille.</b><br><span style=\"opacity:.7;font-size:.9rem;\">One day, I was travelling with my family.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce qui s'est passé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What happened?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Soudain, la voiture est tombée en panne.</b><br><span style=\"opacity:.7;font-size:.9rem;\">