[{"id":"Ceyhc9qPdBTVO6f6eigw","level":"a2","lesson":6,"part":1,"type":"text","name":"a2-l06-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today two tiny words with a big job: y and en. Y replaces a place, comme à Paris. En replaces a quantity or something with de. They help you answer quickly, like a real native speaker.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276037,"_nanoseconds":330000000}},{"id":"WboBRKKWlbW7XXsevio5","level":"a2","lesson":6,"part":2,"type":"text","name":"a2-l06-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚡</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Y and en</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276037,"_nanoseconds":346000000}},{"id":"fJWv5X21tDUBa53It9Hl","level":"a2","lesson":6,"part":2,"type":"text","name":"a2-l06-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Y replaces à + a place: Tu vas à Paris ? Oui, j'y vais. En replaces du, de la, des + a noun: Tu manges du riz ? Oui, j'en mange. With a number: J'en ai deux.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'y vais demain.</b><span style=\"opacity:.7;\"> · I'm going there tomorrow.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'y habite depuis longtemps.</b><span style=\"opacity:.7;\"> · I've lived there for a long time.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'en mange souvent.</b><span style=\"opacity:.7;\"> · I eat it often.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'en ai deux.</b><span style=\"opacity:.7;\"> · I have two.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276037,"_nanoseconds":870000000}},{"id":"gLGzGuxFKKQMEkO2KqPI","level":"a2","lesson":6,"part":3,"type":"text","name":"a2-l06-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'y vais demain.</b></p><p style=\"opacity:.75;margin:0;\">I'm going there tomorrow.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'y vais demain.","size":null,"created":{"_seconds":1793276037,"_nanoseconds":870000000}},{"id":"L8lAwirpPIRyF5EJZmD3","level":"a2","lesson":6,"part":4,"type":"text","name":"a2-l06-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'y habite depuis longtemps.</b></p><p style=\"opacity:.75;margin:0;\">I've lived there for a long time.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'y habite depuis longtemps.","size":null,"created":{"_seconds":1793276037,"_nanoseconds":860000000}},{"id":"hjuHRkv1i3WjeMuRCBAq","level":"a2","lesson":6,"part":5,"type":"text","name":"a2-l06-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'en mange souvent.</b></p><p style=\"opacity:.75;margin:0;\">I eat it often.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'en mange souvent.","size":null,"created":{"_seconds":1793276037,"_nanoseconds":860000000}},{"id":"cizJbS9I1453FSZTye4u","level":"a2","lesson":6,"part":6,"type":"text","name":"a2-l06-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'en ai deux.</b></p><p style=\"opacity:.75;margin:0;\">I have two.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'en ai deux.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":365000000}},{"id":"7tiQ3iXQ2WG6y8TZ8dgE","level":"a2","lesson":6,"part":7,"type":"text","name":"a2-l06-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous allez au marché demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you going to the market tomorrow?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'y vais le matin.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm going there in the morning.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous achetez des mangues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you buy mangoes?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'en achète deux kilos.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I buy two kilos of them.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous mangez du poisson ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you eat fish?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'en mange souvent, mais je n'en mange pas le lundi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat it often, but I don't eat it on Mondays.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous habitez à Accra depuis longtemps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Have you lived in Accra a long time?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'y habite depuis dix ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I've lived there for ten years.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276038,"_nanoseconds":361000000}},{"id":"czJzbcKJwFoD7bvuy4pz","level":"a2","lesson":6,"part":8,"type":"text","name":"a2-l06-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous allez au marché demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Are you going to the market tomorrow?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'y vais le matin.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm going there in the morning.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'y vais le matin.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":373000000}},{"id":"0sy04RfO3W1f3DeIjJTc","level":"a2","lesson":6,"part":9,"type":"text","name":"a2-l06-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous achetez des mangues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you buy mangoes?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'en achète deux kilos.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I buy two kilos of them.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'en achète deux kilos.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":370000000}},{"id":"2fRDYosxGiuAIkPoDpt8","level":"a2","lesson":6,"part":10,"type":"text","name":"a2-l06-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous mangez du poisson ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you eat fish?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'en mange souvent, mais je n'en mange pas le lundi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I eat it often, but I don't eat it on Mondays.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'en mange souvent, mais je n'en mange pas le lundi.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":875000000}},{"id":"ifEezy7wfNZxeGebXmAV","level":"a2","lesson":6,"part":11,"type":"text","name":"a2-l06-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous habitez à Accra depuis longtemps ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Have you lived in Accra a long time?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'y habite depuis dix ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I've lived there for ten years.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'y habite depuis dix ans.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":874000000}},{"id":"HSJyiPjSkof7P8YRc6zl","level":"a2","lesson":6,"part":12,"type":"text","name":"a2-l06-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Répondez vite avec y ou en.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Answer quickly with y or en.</p><p><b>Answer three questions with y or en.</b></p><p style=\"opacity:.7;\">For example: “Oui, j'y vais demain. J'en mange souvent. J'en ai trois.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Oui, j'y vais demain. J'en mange souvent. J'en ai trois.","size":null,"created":{"_seconds":1793276038,"_nanoseconds":887000000}},{"id":"siGcYFqaapXBsb0XwSGL","level":"a2","lesson":6,"part":13,"type":"text","name":"a2-l06-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⚡</div><p><b>Quick answers!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Y and en are small but powerful. Your answers are now shorter and more fluent.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276038,"_nanoseconds":922000000}}]