[{"id":"r7F2Y377DTM4cQ5oIryi","level":"a2","lesson":4,"part":1,"type":"text","name":"a2-l04-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you stop repeating nouns. Instead of saying 'je mange le gâteau', you say 'je le mange'. These are direct object pronouns: le, la, l', les. They go before the verb. It sounds more natural and speeds your speech.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276033,"_nanoseconds":954000000}},{"id":"m0JKrXtMmgokS6112GeH","level":"a2","lesson":4,"part":2,"type":"text","name":"a2-l04-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎯</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Direct object pronouns</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276033,"_nanoseconds":957000000}},{"id":"dmVkZthXdrbmSkylgu5Z","level":"a2","lesson":4,"part":2,"type":"text","name":"a2-l04-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le, la, l', les replace a direct object. Tu prends le bus ? Oui, je le prends. Tu vois Marie ? Oui, je la vois. Négation: je ne le prends pas. Au passé composé: je l'ai pris.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je le prends.</b><span style=\"opacity:.7;\"> · I take it.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je la vois.</b><span style=\"opacity:.7;\"> · I see her/it.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je ne les aime pas.</b><span style=\"opacity:.7;\"> · I don't like them.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je l'ai acheté.</b><span style=\"opacity:.7;\"> · I bought it.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276034,"_nanoseconds":635000000}},{"id":"S9omNvHAi3tDCqqLlFNE","level":"a2","lesson":4,"part":3,"type":"text","name":"a2-l04-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je le prends.</b></p><p style=\"opacity:.75;margin:0;\">I take it.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je le prends.","size":null,"created":{"_seconds":1793276034,"_nanoseconds":642000000}},{"id":"MG7fY7JbS78DtQleFziE","level":"a2","lesson":4,"part":4,"type":"text","name":"a2-l04-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je la vois.</b></p><p style=\"opacity:.75;margin:0;\">I see her/it.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je la vois.","size":null,"created":{"_seconds":1793276034,"_nanoseconds":626000000}},{"id":"eiIBQqXf0PeNmc2XRhj8","level":"a2","lesson":4,"part":5,"type":"text","name":"a2-l04-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je ne les aime pas.</b></p><p style=\"opacity:.75;margin:0;\">I don't like them.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je ne les aime pas.","size":null,"created":{"_seconds":1793276034,"_nanoseconds":621000000}},{"id":"3ZsDd7ZNC6WCmqs8gyQa","level":"a2","lesson":4,"part":6,"type":"text","name":"a2-l04-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je l'ai acheté.</b></p><p style=\"opacity:.75;margin:0;\">I bought it.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je l'ai acheté.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":82000000}},{"id":"20JvQwOnnQve2Hd5uzFV","level":"a2","lesson":4,"part":7,"type":"text","name":"a2-l04-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous prenez le bus pour aller au travail ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you take the bus to go to work?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je le prends tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I take it every day.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous regardez les infos ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you watch the news?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je ne les regarde pas souvent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't watch it often.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous connaissez ma collègue Marie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you know my colleague Marie?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je la connais. Je l'ai vue hier.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I know her. I saw her yesterday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez acheté ce livre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you buy this book?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je l'ai acheté la semaine dernière.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I bought it last week.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276035,"_nanoseconds":134000000}},{"id":"kfhdW3vkRHsVQ7YRTDiY","level":"a2","lesson":4,"part":8,"type":"text","name":"a2-l04-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous prenez le bus pour aller au travail ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you take the bus to go to work?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je le prends tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I take it every day.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je le prends tous les jours.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":98000000}},{"id":"BNz0wBGms0uWvlBFYtRK","level":"a2","lesson":4,"part":9,"type":"text","name":"a2-l04-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous regardez les infos ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And do you watch the news?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je ne les regarde pas souvent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't watch it often.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je ne les regarde pas souvent.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":84000000}},{"id":"dZIM2CIfbrP596NS6bRt","level":"a2","lesson":4,"part":10,"type":"text","name":"a2-l04-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous connaissez ma collègue Marie ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you know my colleague Marie?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je la connais. Je l'ai vue hier.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I know her. I saw her yesterday.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je la connais. Je l'ai vue hier.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":667000000}},{"id":"mpWIt9xr0MlbbMu99xQz","level":"a2","lesson":4,"part":11,"type":"text","name":"a2-l04-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez acheté ce livre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you buy this book?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je l'ai acheté la semaine dernière.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I bought it last week.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je l'ai acheté la semaine dernière.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":663000000}},{"id":"g23hxmiwFutpyezdbwBa","level":"a2","lesson":4,"part":12,"type":"text","name":"a2-l04-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Répondez sans répéter les noms.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Answer without repeating nouns.</p><p><b>Answer three questions using le, la, l' or les.</b></p><p style=\"opacity:.7;\">For example: “Oui, je le prends. Non, je ne les regarde pas. Oui, je l'ai acheté.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Oui, je le prends. Non, je ne les regarde pas. Oui, je l'ai acheté.","size":null,"created":{"_seconds":1793276035,"_nanoseconds":590000000}},{"id":"f1iG9bHselcMkM4twLGb","level":"a2","lesson":4,"part":13,"type":"text","name":"a2-l04-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎯</div><p><b>Pronouns on target!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can use direct object pronouns to avoid repetition. Your French sounds more natural already.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276035,"_nanoseconds":666000000}}]