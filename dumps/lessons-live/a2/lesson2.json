[{"id":"M0ZaEORDFCNYRDLC2UHL","level":"a2","lesson":2,"part":1,"type":"text","name":"a2-l02-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today we go back to your childhood. L'imparfait is the tense for habits and descriptions in the past: quand j'étais petit, j'habitais à Kumasi. Pour le former, prenez la forme nous du présent, enlevez -ons, et ajoutez les terminaisons.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276030,"_nanoseconds":580000000}},{"id":"L2t1S7VxqPwqnEqDrxad","level":"a2","lesson":2,"part":2,"type":"text","name":"a2-l02-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧒</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">The imperfect</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276030,"_nanoseconds":575000000}},{"id":"7vNpqFtssmgB7jsyAzjC","level":"a2","lesson":2,"part":2,"type":"text","name":"a2-l02-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 L'imparfait: je parlais, tu parlais, il parlait, nous parlions, vous parliez, ils parlaient. Être is special: j'étais, tu étais, il était. Use it for habits: tous les jours, souvent, chaque été.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'habitais à Kumasi.</b><span style=\"opacity:.7;\"> · I used to live in Kumasi.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous jouions dehors.</b><span style=\"opacity:.7;\"> · We used to play outside.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il était gentil.</b><span style=\"opacity:.7;\"> · He was kind.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Chaque été, on voyageait.</b><span style=\"opacity:.7;\"> · Every summer, we travelled.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276031,"_nanoseconds":92000000}},{"id":"1aYfzRJ520urdqJtKzZG","level":"a2","lesson":2,"part":3,"type":"text","name":"a2-l02-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'habitais à Kumasi.</b></p><p style=\"opacity:.75;margin:0;\">I used to live in Kumasi.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'habitais à Kumasi.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":89000000}},{"id":"jCEERaAZr7szQPXiDbMF","level":"a2","lesson":2,"part":4,"type":"text","name":"a2-l02-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous jouions dehors.</b></p><p style=\"opacity:.75;margin:0;\">We used to play outside.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous jouions dehors.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":138000000}},{"id":"yPLLwIxKdSqNjFULQ4io","level":"a2","lesson":2,"part":5,"type":"text","name":"a2-l02-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il était gentil.</b></p><p style=\"opacity:.75;margin:0;\">He was kind.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il était gentil.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":183000000}},{"id":"71VFoCfoLKppzsRUxSB2","level":"a2","lesson":2,"part":6,"type":"text","name":"a2-l02-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Chaque été, on voyageait.</b></p><p style=\"opacity:.75;margin:0;\">Every summer, we travelled.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Chaque été, on voyageait.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":592000000}},{"id":"WpZIgu47r42AW9EwTT7d","level":"a2","lesson":2,"part":7,"type":"text","name":"a2-l02-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quand vous étiez petit, vous habitiez où ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When you were little, where did you live?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'habitais à Kumasi avec mes grands-parents.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I lived in Kumasi with my grandparents.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous faisiez après l'école ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What did you do after school?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Nous jouions au football dehors.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We played football outside.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre grand-mère était comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What was your grandmother like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Elle était très gentille et elle cuisinait toujours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She was very kind and always cooked.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous aimiez l'école ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you like school?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'aimais beaucoup mes professeurs.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I loved my teachers a lot.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276031,"_nanoseconds":613000000}},{"id":"ATxsrd3Bar6C1ydubKeA","level":"a2","lesson":2,"part":8,"type":"text","name":"a2-l02-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quand vous étiez petit, vous habitiez où ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When you were little, where did you live?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'habitais à Kumasi avec mes grands-parents.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I lived in Kumasi with my grandparents.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'habitais à Kumasi avec mes grands-parents.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":593000000}},{"id":"p997SvuJIsmW74WgFqrx","level":"a2","lesson":2,"part":9,"type":"text","name":"a2-l02-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous faisiez après l'école ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What did you do after school?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Nous jouions au football dehors.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We played football outside.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Nous jouions au football dehors.","size":null,"created":{"_seconds":1793276031,"_nanoseconds":594000000}},{"id":"k6tQDQUaPXZgczNeCG8q","level":"a2","lesson":2,"part":10,"type":"text","name":"a2-l02-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Votre grand-mère était comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What was your grandmother like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Elle était très gentille et elle cuisinait toujours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">She was very kind and always cooked.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Elle était très gentille et elle cuisinait toujours.","size":null,"created":{"_seconds":1793276032,"_nanoseconds":9000000}},{"id":"HX4Wk3HyQ6yqEMjO1f8R","level":"a2","lesson":2,"part":11,"type":"text","name":"a2-l02-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous aimiez l'école ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Did you like school?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'aimais beaucoup mes professeurs.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I loved my teachers a lot.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'aimais beaucoup mes professeurs.","size":null,"created":{"_seconds":1793276032,"_nanoseconds":6000000}},{"id":"g3SEF5Km4L7naqxxVYMI","level":"a2","lesson":2,"part":12,"type":"text","name":"a2-l02-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez de votre enfance.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Talk about your childhood.</p><p><b>Describe your childhood with at least three imperfect verbs.</b></p><p style=\"opacity:.7;\">For example: “Quand j'étais petit, j'habitais à Kumasi. Je jouais dehors. C'était très bien.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Quand j'étais petit, j'habitais à Kumasi. Je jouais dehors. C'était très bien.","size":null,"created":{"_seconds":1793276032,"_nanoseconds":7000000}},{"id":"jM40f5XitgnNxdAkizh9","level":"a2","lesson":2,"part":13,"type":"text","name":"a2-l02-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧒</div><p><b>Childhood memories!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about your childhood with l'imparfait. Habits and descriptions in the past now belong to you.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276032,"_nanoseconds":18000000}}]