[{"id":"WJJGZFKIdI8zsw8zxYA2","level":"a2","lesson":3,"part":1,"type":"text","name":"a2-l03-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today two past tenses meet. Le passé composé is for actions, what happened. L'imparfait is for scenery, what was going on. Ensemble, they make a story. Listen to how they play together.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276032,"_nanoseconds":517000000}},{"id":"HCyLZD6O8OktgI4exBf7","level":"a2","lesson":3,"part":2,"type":"text","name":"a2-l03-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎬</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Which past?</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276032,"_nanoseconds":524000000}},{"id":"yhOoGhbU8yFfXiSDUVos","level":"a2","lesson":3,"part":2,"type":"text","name":"a2-l03-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Imparfait: description, habitude. Passé composé: action finie. Il pleuvait quand je suis sorti. It was raining when I left. J'étais fatigué, donc je me suis couché. I was tired, so I went to bed.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il pleuvait quand je suis sorti.</b><span style=\"opacity:.7;\"> · It was raining when I went out.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'étais fatigué, donc j'ai dormi.</b><span style=\"opacity:.7;\"> · I was tired, so I slept.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Soudain, le téléphone a sonné.</b><span style=\"opacity:.7;\"> · Suddenly, the phone rang.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous mangions quand il est arrivé.</b><span style=\"opacity:.7;\"> · We were eating when he arrived.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276032,"_nanoseconds":527000000}},{"id":"oY5pCTc9EPQdLVfwmOVM","level":"a2","lesson":3,"part":3,"type":"text","name":"a2-l03-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il pleuvait quand je suis sorti.</b></p><p style=\"opacity:.75;margin:0;\">It was raining when I went out.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il pleuvait quand je suis sorti.","size":null,"created":{"_seconds":1793276032,"_nanoseconds":525000000}},{"id":"AIOWNyiLsJTAuEa4HLhg","level":"a2","lesson":3,"part":4,"type":"text","name":"a2-l03-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'étais fatigué, donc j'ai dormi.</b></p><p style=\"opacity:.75;margin:0;\">I was tired, so I slept.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'étais fatigué, donc j'ai dormi.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":29000000}},{"id":"aht3KXKQedu4T3oIPmQb","level":"a2","lesson":3,"part":5,"type":"text","name":"a2-l03-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Soudain, le téléphone a sonné.</b></p><p style=\"opacity:.75;margin:0;\">Suddenly, the phone rang.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Soudain, le téléphone a sonné.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":38000000}},{"id":"t236iN96lcFMwC7Zdt1x","level":"a2","lesson":3,"part":6,"type":"text","name":"a2-l03-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous mangions quand il est arrivé.</b></p><p style=\"opacity:.75;margin:0;\">We were eating when he arrived.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Nous mangions quand il est arrivé.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":79000000}},{"id":"TszvU4J8kSoT5MY5vYOd","level":"a2","lesson":3,"part":7,"type":"text","name":"a2-l03-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Racontez-moi une journée spéciale de votre vie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about a special day in your life.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'était un samedi et il faisait beau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It was a Saturday and the weather was nice.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous faisiez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What were you doing?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je marchais dans la rue quand j'ai vu un vieil ami.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I was walking in the street when I saw an old friend.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et qu'est-ce qui s'est passé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what happened?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Nous avons parlé longtemps, puis nous avons mangé ensemble.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We talked for a long time, then we ate together.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>C'était sympa ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Was it nice?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'étais très content de le revoir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I was very happy to see him again.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276033,"_nanoseconds":77000000}},{"id":"WQQbx7jED5HfD9dt6COS","level":"a2","lesson":3,"part":8,"type":"text","name":"a2-l03-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Racontez-moi une journée spéciale de votre vie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about a special day in your life.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'était un samedi et il faisait beau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It was a Saturday and the weather was nice.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"C'était un samedi et il faisait beau.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":462000000}},{"id":"g2NIxB3Yp2WrH464DXGZ","level":"a2","lesson":3,"part":9,"type":"text","name":"a2-l03-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous faisiez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What were you doing?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je marchais dans la rue quand j'ai vu un vieil ami.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I was walking in the street when I saw an old friend.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je marchais dans la rue quand j'ai vu un vieil ami.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":462000000}},{"id":"bL4jXIBtAqnHrRPHCEQn","level":"a2","lesson":3,"part":10,"type":"text","name":"a2-l03-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et qu'est-ce qui s'est passé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what happened?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Nous avons parlé longtemps, puis nous avons mangé ensemble.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We talked for a long time, then we ate together.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Nous avons parlé longtemps, puis nous avons mangé ensemble.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":510000000}},{"id":"kZoIFNAHbmPXyYGjqf6G","level":"a2","lesson":3,"part":11,"type":"text","name":"a2-l03-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>C'était sympa ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Was it nice?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'étais très content de le revoir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I was very happy to see him again.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'étais très content de le revoir.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":480000000}},{"id":"7tK2RZvQBAZpsgKLzeso","level":"a2","lesson":3,"part":12,"type":"text","name":"a2-l03-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Racontez une petite histoire au passé.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Tell a short story in the past.</p><p><b>Tell a short story with one description and two actions.</b></p><p style=\"opacity:.7;\">For example: “C'était samedi et il faisait beau. J'ai vu un ami. Nous avons mangé ensemble.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"C'était samedi et il faisait beau. J'ai vu un ami. Nous avons mangé ensemble.","size":null,"created":{"_seconds":1793276033,"_nanoseconds":956000000}},{"id":"IBJWmK96Ds1jSyFX6G0t","level":"a2","lesson":3,"part":13,"type":"text","name":"a2-l03-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎬</div><p><b>Story told!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can mix the passé composé and the imparfait to tell a story. This is the heart of storytelling in French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276033,"_nanoseconds":965000000}}]