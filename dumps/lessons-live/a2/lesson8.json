[{"id":"YPJXHJ1dwKs6TDJGu67V","level":"a2","lesson":8,"part":1,"type":"text","name":"a2-l08-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you learn to be extra polite. French uses the conditionnel for requests: je voudrais, pourriez-vous, j'aimerais. It softens the request, a big thing in French culture. A polite request is always better.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276041,"_nanoseconds":64000000}},{"id":"BuBRAKzoheNMz4p11D5X","level":"a2","lesson":8,"part":2,"type":"text","name":"a2-l08-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎩</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Polite requests</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276041,"_nanoseconds":110000000}},{"id":"TwXrVdwdyc9a1YFCir3W","level":"a2","lesson":8,"part":2,"type":"text","name":"a2-l08-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Je voudrais, I would like. Pourriez-vous, could you. Auriez-vous, would you have. J'aimerais, I would like. Cela vous dérangerait si... Would it bother you if...</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pourriez-vous m'aider ?</b><span style=\"opacity:.7;\"> · Could you help me?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je voudrais un renseignement.</b><span style=\"opacity:.7;\"> · I'd like some information.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Auriez-vous une table ?</b><span style=\"opacity:.7;\"> · Would you have a table?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Cela vous dérangerait ?</b><span style=\"opacity:.7;\"> · Would it bother you?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276041,"_nanoseconds":530000000}},{"id":"AnWTZu3FLKMpDfa83X2r","level":"a2","lesson":8,"part":3,"type":"text","name":"a2-l08-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pourriez-vous m'aider ?</b></p><p style=\"opacity:.75;margin:0;\">Could you help me?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pourriez-vous m'aider ?","size":null,"created":{"_seconds":1793276041,"_nanoseconds":578000000}},{"id":"14w91E847ASGvS9ylriC","level":"a2","lesson":8,"part":4,"type":"text","name":"a2-l08-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je voudrais un renseignement.</b></p><p style=\"opacity:.75;margin:0;\">I'd like some information.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je voudrais un renseignement.","size":null,"created":{"_seconds":1793276041,"_nanoseconds":578000000}},{"id":"bym6tuJ3mcvAKEy4Xp9b","level":"a2","lesson":8,"part":5,"type":"text","name":"a2-l08-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Auriez-vous une table ?</b></p><p style=\"opacity:.75;margin:0;\">Would you have a table?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Auriez-vous une table ?","size":null,"created":{"_seconds":1793276041,"_nanoseconds":624000000}},{"id":"Im4AuZqLKw7w9njwkMdK","level":"a2","lesson":8,"part":6,"type":"text","name":"a2-l08-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Cela vous dérangerait ?</b></p><p style=\"opacity:.75;margin:0;\">Would it bother you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Cela vous dérangerait ?","size":null,"created":{"_seconds":1793276041,"_nanoseconds":938000000}},{"id":"WAtnhDVu2XEzICR2r8FP","level":"a2","lesson":8,"part":7,"type":"text","name":"a2-l08-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour, je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, can I help you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour, je voudrais un renseignement, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, I'd like some information, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bien sûr.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Pourriez-vous me dire où est la gare ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Could you tell me where the station is?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>C'est tout droit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's straight ahead.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci. Auriez-vous aussi un plan de la ville ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Would you also have a map of the city?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Vous êtes très aimable, merci beaucoup.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You are very kind, thank you very much.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276041,"_nanoseconds":979000000}},{"id":"383MO9SKSiEbrrVput7u","level":"a2","lesson":8,"part":8,"type":"text","name":"a2-l08-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour, je peux vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, can I help you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour, je voudrais un renseignement, s'il vous plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, I'd like some information, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour, je voudrais un renseignement, s'il vous plaît.","size":null,"created":{"_seconds":1793276041,"_nanoseconds":983000000}},{"id":"f7rzOPBGoU40fv0anVyz","level":"a2","lesson":8,"part":9,"type":"text","name":"a2-l08-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bien sûr.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Pourriez-vous me dire où est la gare ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Could you tell me where the station is?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Pourriez-vous me dire où est la gare ?","size":null,"created":{"_seconds":1793276042,"_nanoseconds":31000000}},{"id":"MoCb3rHKzlMppKcZ7zXD","level":"a2","lesson":8,"part":10,"type":"text","name":"a2-l08-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>C'est tout droit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's straight ahead.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci. Auriez-vous aussi un plan de la ville ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you. Would you also have a map of the city?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci. Auriez-vous aussi un plan de la ville ?","size":null,"created":{"_seconds":1793276042,"_nanoseconds":354000000}},{"id":"pwhwyigKNect7g0skIhm","level":"a2","lesson":8,"part":11,"type":"text","name":"a2-l08-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Vous êtes très aimable, merci beaucoup.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You are very kind, thank you very much.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Vous êtes très aimable, merci beaucoup.","size":null,"created":{"_seconds":1793276042,"_nanoseconds":389000000}},{"id":"8tfZlUgMnYNYseeY6iz0","level":"a2","lesson":8,"part":12,"type":"text","name":"a2-l08-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Demandez poliment de l'aide.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Politely ask for help.</p><p><b>Make two polite requests with pourriez-vous or je voudrais.</b></p><p style=\"opacity:.7;\">For example: “Pourriez-vous m'aider, s'il vous plaît ? Je voudrais un renseignement.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Pourriez-vous m'aider, s'il vous plaît ? Je voudrais un renseignement.","size":null,"created":{"_seconds":1793276042,"_nanoseconds":389000000}},{"id":"Xm4oPCO6hiKdTnjynNgA","level":"a2","lesson":8,"part":13,"type":"text","name":"a2-l08-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎩</div><p><b>Polite and proud!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can make polite requests with the conditionnel. French people will notice and appreciate it.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276042,"_nanoseconds":425000000}}]