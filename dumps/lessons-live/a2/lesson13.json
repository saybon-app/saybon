[{"id":"eo0YO1hpcJMewgi01TbH","level":"a2","lesson":13,"part":1,"type":"text","name":"a2-l13-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Aujourd'hui, vous voyagez avec des problèmes: un retard, un billet perdu, un changement. Travel doesn't always go as planned, and being able to explain a problem is a big step for independence.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276049,"_nanoseconds":465000000}},{"id":"BB2qShGmY3f9gAygtInA","level":"a2","lesson":13,"part":2,"type":"text","name":"a2-l13-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">✈️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Travelling</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276049,"_nanoseconds":415000000}},{"id":"3LRuEPcbJHEVZvwBK63V","level":"a2","lesson":13,"part":2,"type":"text","name":"a2-l13-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le train a du retard. J'ai perdu mon billet. Mon vol est annulé. Je voudrais changer ma réservation. Quelle est la solution ? Pouvez-vous m'aider ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il y a un retard.</b><span style=\"opacity:.7;\"> · There's a delay.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai perdu mon billet.</b><span style=\"opacity:.7;\"> · I lost my ticket.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le vol est annulé.</b><span style=\"opacity:.7;\"> · The flight is cancelled.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pouvez-vous m'aider ?</b><span style=\"opacity:.7;\"> · Can you help me?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276049,"_nanoseconds":418000000}},{"id":"BDzl74Mkfljera6vKdWr","level":"a2","lesson":13,"part":3,"type":"text","name":"a2-l13-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il y a un retard.</b></p><p style=\"opacity:.75;margin:0;\">There's a delay.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il y a un retard.","size":null,"created":{"_seconds":1793276049,"_nanoseconds":420000000}},{"id":"4hf573nRT4Avf2CyFPdS","level":"a2","lesson":13,"part":4,"type":"text","name":"a2-l13-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai perdu mon billet.</b></p><p style=\"opacity:.75;margin:0;\">I lost my ticket.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai perdu mon billet.","size":null,"created":{"_seconds":1793276049,"_nanoseconds":957000000}},{"id":"MERHYjML8mMoLJyB87V1","level":"a2","lesson":13,"part":5,"type":"text","name":"a2-l13-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le vol est annulé.</b></p><p style=\"opacity:.75;margin:0;\">The flight is cancelled.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le vol est annulé.","size":null,"created":{"_seconds":1793276049,"_nanoseconds":941000000}},{"id":"tMq5sOcOR3QJEQ6taVR2","level":"a2","lesson":13,"part":6,"type":"text","name":"a2-l13-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pouvez-vous m'aider ?</b></p><p style=\"opacity:.75;margin:0;\">Can you help me?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pouvez-vous m'aider ?","size":null,"created":{"_seconds":1793276049,"_nanoseconds":947000000}},{"id":"1o3bGCjak5qJBJipzIFk","level":"a2","lesson":13,"part":7,"type":"text","name":"a2-l13-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour, que puis-je faire pour vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, what can I do for you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour, mon train a deux heures de retard.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, my train is two hours late.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, il y a un problème technique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, there is a technical problem.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai une correspondance à quinze heures. Que dois-je faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a connection at three. What should I do?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je peux changer votre billet pour le prochain train.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I can change your ticket for the next train.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il part à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time does it leave?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À dix-sept heures, quai numéro deux.</b><br><span style=\"opacity:.7;font-size:.9rem;\">At five, platform two.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Parfait, merci beaucoup pour votre aide.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect, thank you very much for your help.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276049,"_nanoseconds":954000000}},{"id":"iVg7sjJOlp1NyhZW90fq","level":"a2","lesson":13,"part":8,"type":"text","name":"a2-l13-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour, que puis-je faire pour vous ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, what can I do for you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour, mon train a deux heures de retard.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, my train is two hours late.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour, mon train a deux heures de retard.","size":null,"created":{"_seconds":1793276050,"_nanoseconds":338000000}},{"id":"r47eogFpvt8QBGv6TgZB","level":"a2","lesson":13,"part":9,"type":"text","name":"a2-l13-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, il y a un problème technique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, there is a technical problem.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai une correspondance à quinze heures. Que dois-je faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a connection at three. What should I do?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai une correspondance à quinze heures. Que dois-je faire ?","size":null,"created":{"_seconds":1793276050,"_nanoseconds":344000000}},{"id":"8aLQCV8FsK60yQBcqB1O","level":"a2","lesson":13,"part":10,"type":"text","name":"a2-l13-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je peux changer votre billet pour le prochain train.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I can change your ticket for the next train.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il part à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time does it leave?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il part à quelle heure ?","size":null,"created":{"_seconds":1793276050,"_nanoseconds":406000000}},{"id":"RpFB9MRq6d41ghLbd8EO","level":"a2","lesson":13,"part":11,"type":"text","name":"a2-l13-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À dix-sept heures, quai numéro deux.</b><br><span style=\"opacity:.7;font-size:.9rem;\">At five, platform two.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Parfait, merci beaucoup pour votre aide.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Perfect, thank you very much for your help.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Parfait, merci beaucoup pour votre aide.","size":null,"created":{"_seconds":1793276050,"_nanoseconds":358000000}},{"id":"0h8xfSSxkJvEbQip2cWT","level":"a2","lesson":13,"part":12,"type":"text","name":"a2-l13-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Expliquez un problème de voyage.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Explain a travel problem.</p><p><b>Explain a delay or loss and ask for help.</b></p><p style=\"opacity:.7;\">For example: “Mon train a du retard. J'ai une correspondance. Pouvez-vous m'aider ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Mon train a du retard. J'ai une correspondance. Pouvez-vous m'aider ?","size":null,"created":{"_seconds":1793276051,"_nanoseconds":38000000}},{"id":"ggOkqVrvXh2e4dpQd5OG","level":"a2","lesson":13,"part":13,"type":"text","name":"a2-l13-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">✈️</div><p><b>Travel problems solved!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can explain a travel problem and ask for a solution. Never get stuck at a station again.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276050,"_nanoseconds":993000000}}]