[{"id":"0PxPQwLtzKBeqWM65CLO","level":"a2","lesson":22,"part":1,"type":"text","name":"a2-l22-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you invite, accept and refuse. Les invitations sont une partie importante de la vie sociale. You'll learn natural replies for yes, no, and maybe, and ways to refuse nicely without hurting feelings.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276063,"_nanoseconds":649000000}},{"id":"oSSVKvruK9Tg3JbRuYCT","level":"a2","lesson":22,"part":2,"type":"text","name":"a2-l22-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💌</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Invitations</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276063,"_nanoseconds":647000000}},{"id":"jYuTSbVhNrDBBmytrlwR","level":"a2","lesson":22,"part":2,"type":"text","name":"a2-l22-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Inviter: tu viens dîner ? Ça te dit de venir ? Accepter: avec plaisir ! Volontiers ! Refuser poliment: désolé, je ne peux pas, j'ai déjà quelque chose. Peut-être une autre fois ? Proposer: samedi, ça te va ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tu viens dîner samedi ?</b><span style=\"opacity:.7;\"> · Are you coming to dinner on Saturday?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Avec plaisir !</b><span style=\"opacity:.7;\"> · With pleasure!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Désolé, je ne peux pas.</b><span style=\"opacity:.7;\"> · Sorry, I can't.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Peut-être une autre fois ?</b><span style=\"opacity:.7;\"> · Maybe another time?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276063,"_nanoseconds":831000000}},{"id":"RG57bcxaBNk8HRUeiu2n","level":"a2","lesson":22,"part":3,"type":"text","name":"a2-l22-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu viens dîner samedi ?</b></p><p style=\"opacity:.75;margin:0;\">Are you coming to dinner on Saturday?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu viens dîner samedi ?","size":null,"created":{"_seconds":1793276063,"_nanoseconds":846000000}},{"id":"fMm5U1wOT60REgLnXYre","level":"a2","lesson":22,"part":4,"type":"text","name":"a2-l22-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Avec plaisir !</b></p><p style=\"opacity:.75;margin:0;\">With pleasure!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Avec plaisir !","size":null,"created":{"_seconds":1793276064,"_nanoseconds":59000000}},{"id":"FGmTXHLckog2u2JPrQXh","level":"a2","lesson":22,"part":5,"type":"text","name":"a2-l22-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Désolé, je ne peux pas.</b></p><p style=\"opacity:.75;margin:0;\">Sorry, I can't.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Désolé, je ne peux pas.","size":null,"created":{"_seconds":1793276064,"_nanoseconds":66000000}},{"id":"VVKSZB8H6YuzS9UQD6gq","level":"a2","lesson":22,"part":6,"type":"text","name":"a2-l22-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Peut-être une autre fois ?</b></p><p style=\"opacity:.75;margin:0;\">Maybe another time?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Peut-être une autre fois ?","size":null,"created":{"_seconds":1793276064,"_nanoseconds":232000000}},{"id":"7ZpgjRlfswgPxIKnECPk","level":"a2","lesson":22,"part":7,"type":"text","name":"a2-l22-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Tu viens dîner chez moi samedi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! Are you coming to dinner at my place on Saturday?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Avec plaisir ! À quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">With pleasure! What time?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>À dix-neuf heures. Tu peux amener un ami ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At seven. Can you bring a friend?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je peux amener mon frère, ça te va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I can bring my brother, is that OK?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bien sûr ! Et dimanche, tu es libre pour le cinéma ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course! And Sunday, are you free for the cinema?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Désolé, je ne peux pas, j'ai déjà quelque chose.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Sorry, I can't, I already have something.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pas de problème, une autre fois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No problem, another time.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, peut-être la semaine prochaine !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, maybe next week!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276064,"_nanoseconds":251000000}},{"id":"yUAwdiwZR34YR9XsREcJ","level":"a2","lesson":22,"part":8,"type":"text","name":"a2-l22-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Tu viens dîner chez moi samedi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! Are you coming to dinner at my place on Saturday?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Avec plaisir ! À quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">With pleasure! What time?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Avec plaisir ! À quelle heure ?","size":null,"created":{"_seconds":1793276064,"_nanoseconds":471000000}},{"id":"tZFK0GHu1UMT3jAlUtDP","level":"a2","lesson":22,"part":9,"type":"text","name":"a2-l22-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>À dix-neuf heures. Tu peux amener un ami ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">At seven. Can you bring a friend?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je peux amener mon frère, ça te va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I can bring my brother, is that OK?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je peux amener mon frère, ça te va ?","size":null,"created":{"_seconds":1793276064,"_nanoseconds":483000000}},{"id":"yp431RdfTP9rKqB6juRh","level":"a2","lesson":22,"part":10,"type":"text","name":"a2-l22-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bien sûr ! Et dimanche, tu es libre pour le cinéma ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Of course! And Sunday, are you free for the cinema?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Désolé, je ne peux pas, j'ai déjà quelque chose.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Sorry, I can't, I already have something.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Désolé, je ne peux pas, j'ai déjà quelque chose.","size":null,"created":{"_seconds":1793276064,"_nanoseconds":633000000}},{"id":"mpcSkRXr9jW9ur0LLFbW","level":"a2","lesson":22,"part":11,"type":"text","name":"a2-l22-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pas de problème, une autre fois.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No problem, another time.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, peut-être la semaine prochaine !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, maybe next week!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, peut-être la semaine prochaine !","size":null,"created":{"_seconds":1793276064,"_nanoseconds":650000000}},{"id":"jGgz3Ru0VhfADqdwcae7","level":"a2","lesson":22,"part":12,"type":"text","name":"a2-l22-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Invitez un ami, puis refusez poliment une autre invitation.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Invite a friend, then politely decline another invitation.</p><p><b>Invite someone, then decline an invitation politely.</b></p><p style=\"opacity:.7;\">For example: “Tu viens dîner samedi ? Désolé, je ne peux pas dimanche, peut-être une autre fois ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Tu viens dîner samedi ? Désolé, je ne peux pas dimanche, peut-être une autre fois ?","size":null,"created":{"_seconds":1793276064,"_nanoseconds":872000000}},{"id":"6GufpcZPBN11ay3N3cwd","level":"a2","lesson":22,"part":13,"type":"text","name":"a2-l22-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💌</div><p><b>Invitations mastered!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can invite, accept and refuse politely. Social French feels more natural now.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276064,"_nanoseconds":906000000}}]