[{"id":"qTOG6tiL7ijvBmYmkVti","level":"a2","lesson":18,"part":1,"type":"text","name":"a2-l18-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you talk about the weather and use it to make plans. Le temps est un sujet de conversation très courant. Tu l'utilises pour proposer une sortie ou changer de plan.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276057,"_nanoseconds":563000000}},{"id":"px8RknizhdJYTlQ83nSb","level":"a2","lesson":18,"part":2,"type":"text","name":"a2-l18-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌦️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Weather and plans</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276057,"_nanoseconds":761000000}},{"id":"Drh4rk4LNoBht58x0XeB","level":"a2","lesson":18,"part":2,"type":"text","name":"a2-l18-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Il fait beau, il fait chaud, il fait froid, il pleut, il y a du vent. Demain, il va pleuvoir. S'il fait beau, on ira à la plage. Sinon, on restera à la maison. Ça te dit ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il fait beau.</b><span style=\"opacity:.7;\"> · It's nice weather.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il va pleuvoir.</b><span style=\"opacity:.7;\"> · It's going to rain.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>S'il fait beau, on ira à la plage.</b><span style=\"opacity:.7;\"> · If the weather's nice, we'll go to the beach.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça te dit ?</b><span style=\"opacity:.7;\"> · Do you fancy it?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276057,"_nanoseconds":697000000}},{"id":"jKrVXgquWFvY1dC8fJ1B","level":"a2","lesson":18,"part":3,"type":"text","name":"a2-l18-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il fait beau.</b></p><p style=\"opacity:.75;margin:0;\">It's nice weather.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il fait beau.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":110000000}},{"id":"W88ZkQoJakKOxHYCtKIL","level":"a2","lesson":18,"part":4,"type":"text","name":"a2-l18-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il va pleuvoir.</b></p><p style=\"opacity:.75;margin:0;\">It's going to rain.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il va pleuvoir.","size":null,"created":{"_seconds":1793276057,"_nanoseconds":964000000}},{"id":"PzDuyo2XZGjbOPInqutT","level":"a2","lesson":18,"part":5,"type":"text","name":"a2-l18-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>S'il fait beau, on ira à la plage.</b></p><p style=\"opacity:.75;margin:0;\">If the weather's nice, we'll go to the beach.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"S'il fait beau, on ira à la plage.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":106000000}},{"id":"2IPBfX6bPqYmILU8J5yj","level":"a2","lesson":18,"part":6,"type":"text","name":"a2-l18-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça te dit ?</b></p><p style=\"opacity:.75;margin:0;\">Do you fancy it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça te dit ?","size":null,"created":{"_seconds":1793276058,"_nanoseconds":191000000}},{"id":"tqXalBkngfr8Tr9hvbMC","level":"a2","lesson":18,"part":7,"type":"text","name":"a2-l18-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quel temps il fait demain, tu sais ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What's the weather like tomorrow, do you know?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il va faire beau et chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's going to be nice and hot.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Alors, on fait quelque chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So shall we do something?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>S'il fait beau, on peut aller à la plage. Ça te dit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">If it's nice, we can go to the beach. Do you fancy it?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, super ! Et s'il pleut ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, great! And if it rains?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>S'il pleut, on ira au cinéma.</b><br><span style=\"opacity:.7;font-size:.9rem;\">If it rains, we'll go to the cinema.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>On se retrouve à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do we meet?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À dix heures devant ta maison.</b><br><span style=\"opacity:.7;font-size:.9rem;\">At ten in front of your house.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276058,"_nanoseconds":370000000}},{"id":"0NDjHqxf36N4OzQN8sP8","level":"a2","lesson":18,"part":8,"type":"text","name":"a2-l18-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quel temps il fait demain, tu sais ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What's the weather like tomorrow, do you know?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il va faire beau et chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's going to be nice and hot.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il va faire beau et chaud.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":504000000}},{"id":"A66w6myWl5AVfD7bw18g","level":"a2","lesson":18,"part":9,"type":"text","name":"a2-l18-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Alors, on fait quelque chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So shall we do something?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">S'il fait beau, on peut aller à la plage. Ça te dit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">If it's nice, we can go to the beach. Do you fancy it?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"S'il fait beau, on peut aller à la plage. Ça te dit ?","size":null,"created":{"_seconds":1793276058,"_nanoseconds":535000000}},{"id":"uiZWxcaq9zFpDkqHMNGA","level":"a2","lesson":18,"part":10,"type":"text","name":"a2-l18-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, super ! Et s'il pleut ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, great! And if it rains?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">S'il pleut, on ira au cinéma.</b><br><span style=\"opacity:.7;font-size:.9rem;\">If it rains, we'll go to the cinema.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"S'il pleut, on ira au cinéma.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":594000000}},{"id":"BGKyzQP5GgfRGgrbxHjS","level":"a2","lesson":18,"part":11,"type":"text","name":"a2-l18-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>On se retrouve à quelle heure ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What time do we meet?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À dix heures devant ta maison.</b><br><span style=\"opacity:.7;font-size:.9rem;\">At ten in front of your house.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À dix heures devant ta maison.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":770000000}},{"id":"xdWJ9M3MESyzSloLUO99","level":"a2","lesson":18,"part":12,"type":"text","name":"a2-l18-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Proposez un plan selon la météo.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Suggest a plan depending on the weather.</p><p><b>Suggest one plan for good weather and another for rain.</b></p><p style=\"opacity:.7;\">For example: “S'il fait beau, on ira à la plage. S'il pleut, on ira au cinéma.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"S'il fait beau, on ira à la plage. S'il pleut, on ira au cinéma.","size":null,"created":{"_seconds":1793276058,"_nanoseconds":904000000}},{"id":"FH86dwPUJhsQGym4T8Uy","level":"a2","lesson":18,"part":13,"type":"text","name":"a2-l18-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌦️</div><p><b>Plans for any weather!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can use the weather to make flexible plans with si and the future.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276058,"_nanoseconds":935000000}}]