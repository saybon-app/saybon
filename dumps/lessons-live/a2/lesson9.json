[{"id":"Q1h1raq5c5snnxgUL6qF","level":"a2","lesson":9,"part":1,"type":"text","name":"a2-l09-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Aujourd'hui, vous donnez des conseils. Il faut, tu devrais, tu peux are your friends. You will help a friend with a problem: fatigue, money, stress. Un bon conseil est clair et gentil.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276042,"_nanoseconds":863000000}},{"id":"1uEtjEEwmF0zvjV4mF9o","level":"a2","lesson":9,"part":2,"type":"text","name":"a2-l09-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💡</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Giving advice</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276042,"_nanoseconds":862000000}},{"id":"nHFWfIEyixFGLBN5fj0v","level":"a2","lesson":9,"part":2,"type":"text","name":"a2-l09-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Il faut + infinitif: il faut dormir. Tu devrais + infinitif: tu devrais te reposer. Tu peux + infinitif: tu peux essayer. À ta place, je... In your place, I would...</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il faut dormir plus.</b><span style=\"opacity:.7;\"> · You must sleep more.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tu devrais te reposer.</b><span style=\"opacity:.7;\"> · You should rest.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tu peux essayer le sport.</b><span style=\"opacity:.7;\"> · You can try sport.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À ta place, je partirais.</b><span style=\"opacity:.7;\"> · In your place, I would go.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276042,"_nanoseconds":867000000}},{"id":"WoVtaTzhBQPp2toGJ86T","level":"a2","lesson":9,"part":3,"type":"text","name":"a2-l09-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il faut dormir plus.</b></p><p style=\"opacity:.75;margin:0;\">You must sleep more.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il faut dormir plus.","size":null,"created":{"_seconds":1793276042,"_nanoseconds":867000000}},{"id":"BeuJeb7ru6vq1o5uVozR","level":"a2","lesson":9,"part":4,"type":"text","name":"a2-l09-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu devrais te reposer.</b></p><p style=\"opacity:.75;margin:0;\">You should rest.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu devrais te reposer.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":267000000}},{"id":"KrKQ6Z6W1GfMtrhibKbB","level":"a2","lesson":9,"part":5,"type":"text","name":"a2-l09-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu peux essayer le sport.</b></p><p style=\"opacity:.75;margin:0;\">You can try sport.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu peux essayer le sport.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":280000000}},{"id":"GnDEbFJn3nZ59gFuRnWR","level":"a2","lesson":9,"part":6,"type":"text","name":"a2-l09-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À ta place, je partirais.</b></p><p style=\"opacity:.75;margin:0;\">In your place, I would go.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"À ta place, je partirais.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":274000000}},{"id":"xc8VBmSX6gm1KNCnCYS9","level":"a2","lesson":9,"part":7,"type":"text","name":"a2-l09-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>J'ai un problème : je suis toujours fatiguée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a problem: I'm always tired.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tu devrais dormir plus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You should sleep more.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je me couche déjà à minuit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I already go to bed at midnight.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il faut te coucher plus tôt, vers dix heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You must go to bed earlier, around ten.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et pour le stress ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for the stress?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tu peux faire du sport ou marcher un peu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You can do sport or walk a little.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci pour tes conseils !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks for your advice!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À ta place, je commencerais demain.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In your place, I'd start tomorrow.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276043,"_nanoseconds":274000000}},{"id":"P4iHroXYSGTXW4oRktzE","level":"a2","lesson":9,"part":8,"type":"text","name":"a2-l09-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>J'ai un problème : je suis toujours fatiguée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a problem: I'm always tired.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tu devrais dormir plus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You should sleep more.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Tu devrais dormir plus.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":780000000}},{"id":"fn63vGpdxWJeyr9W5cTp","level":"a2","lesson":9,"part":9,"type":"text","name":"a2-l09-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je me couche déjà à minuit.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I already go to bed at midnight.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il faut te coucher plus tôt, vers dix heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You must go to bed earlier, around ten.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il faut te coucher plus tôt, vers dix heures.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":783000000}},{"id":"OPZpI8ReAeh9ShpVpEig","level":"a2","lesson":9,"part":10,"type":"text","name":"a2-l09-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et pour le stress ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for the stress?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tu peux faire du sport ou marcher un peu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You can do sport or walk a little.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Tu peux faire du sport ou marcher un peu.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":793000000}},{"id":"PUPQg7Mdxjg0RlrDumov","level":"a2","lesson":9,"part":11,"type":"text","name":"a2-l09-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci pour tes conseils !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks for your advice!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À ta place, je commencerais demain.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In your place, I'd start tomorrow.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"À ta place, je commencerais demain.","size":null,"created":{"_seconds":1793276043,"_nanoseconds":788000000}},{"id":"UPhilwFQPXw9QahVy5SK","level":"a2","lesson":9,"part":12,"type":"text","name":"a2-l09-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Un ami est fatigué. Donnez-lui des conseils.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">A friend is tired. Give them advice.</p><p><b>Give three pieces of advice with il faut, tu devrais or tu peux.</b></p><p style=\"opacity:.7;\">For example: “Il faut dormir plus. Tu devrais te reposer. Tu peux faire du sport.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Il faut dormir plus. Tu devrais te reposer. Tu peux faire du sport.","size":null,"created":{"_seconds":1793276044,"_nanoseconds":191000000}},{"id":"JXa0XFhb839FCS1LhaNr","level":"a2","lesson":9,"part":13,"type":"text","name":"a2-l09-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">💡</div><p><b>Advice given!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can give clear friendly advice. Helping others speak starts with helping them in French.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276044,"_nanoseconds":192000000}}]