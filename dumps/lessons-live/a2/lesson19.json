[{"id":"4taqzkWM3R3oohlo5nQs","level":"a2","lesson":19,"part":1,"type":"text","name":"a2-l19-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Aujourd'hui, vous décrivez un souvenir avec des détails. Un bon souvenir contient: le lieu, les gens, les sensations, ce que vous aimiez. You will use the imparfait for the scene and the passé composé for key moments.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276058,"_nanoseconds":986000000}},{"id":"UIPwVtH7Oqz5hOhnW1Zd","level":"a2","lesson":19,"part":2,"type":"text","name":"a2-l19-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌟</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Describing a memory</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276059,"_nanoseconds":170000000}},{"id":"Imuxsd8KOIcQvNxjcc04","level":"a2","lesson":19,"part":2,"type":"text","name":"a2-l19-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Décrivez avec les cinq sens: on voyait, on entendait, ça sentait bon, c'était délicieux. Introduisez le souvenir: je me souviens de... or un jour... Terminez avec une émotion: j'étais très heureux.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je me souviens de ce jour.</b><span style=\"opacity:.7;\"> · I remember that day.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça sentait très bon.</b><span style=\"opacity:.7;\"> · It smelled really good.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On entendait la musique.</b><span style=\"opacity:.7;\"> · We could hear the music.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'étais tellement heureux.</b><span style=\"opacity:.7;\"> · I was so happy.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276059,"_nanoseconds":312000000}},{"id":"cTkYbmbrPmWd9QDTMTEt","level":"a2","lesson":19,"part":3,"type":"text","name":"a2-l19-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je me souviens de ce jour.</b></p><p style=\"opacity:.75;margin:0;\">I remember that day.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je me souviens de ce jour.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":356000000}},{"id":"3kuHXTf0ZUJhZhxLcjPd","level":"a2","lesson":19,"part":4,"type":"text","name":"a2-l19-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça sentait très bon.</b></p><p style=\"opacity:.75;margin:0;\">It smelled really good.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça sentait très bon.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":420000000}},{"id":"9s7IbjcrpdqoiS5sWA1U","level":"a2","lesson":19,"part":5,"type":"text","name":"a2-l19-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On entendait la musique.</b></p><p style=\"opacity:.75;margin:0;\">We could hear the music.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"On entendait la musique.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":578000000}},{"id":"4xFxeFqsfKu9jDV5QWRa","level":"a2","lesson":19,"part":6,"type":"text","name":"a2-l19-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'étais tellement heureux.</b></p><p style=\"opacity:.75;margin:0;\">I was so happy.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'étais tellement heureux.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":721000000}},{"id":"ose0i1OoIqbn5IwUPZdu","level":"a2","lesson":19,"part":7,"type":"text","name":"a2-l19-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Parlez-moi d'un souvenir que vous aimez.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about a memory you love.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je me souviens d'un Noël chez ma grand-mère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I remember a Christmas at my grandmother's.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment c'était ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What was it like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il y avait beaucoup de monde et ça sentait très bon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">There were a lot of people and it smelled really good.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous avez fait ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What did you do?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Nous avons mangé, chanté et dansé toute la soirée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We ate, sang and danced all evening.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous étiez comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How were you feeling?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'étais tellement heureux que je n'ai pas voulu partir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I was so happy that I didn't want to leave.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276059,"_nanoseconds":763000000}},{"id":"Mv81o1S7PgfgnqLM067s","level":"a2","lesson":19,"part":8,"type":"text","name":"a2-l19-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Parlez-moi d'un souvenir que vous aimez.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tell me about a memory you love.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je me souviens d'un Noël chez ma grand-mère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I remember a Christmas at my grandmother's.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je me souviens d'un Noël chez ma grand-mère.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":842000000}},{"id":"8L7K0X8RPsWnSseJco4Y","level":"a2","lesson":19,"part":9,"type":"text","name":"a2-l19-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment c'était ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What was it like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il y avait beaucoup de monde et ça sentait très bon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">There were a lot of people and it smelled really good.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il y avait beaucoup de monde et ça sentait très bon.","size":null,"created":{"_seconds":1793276059,"_nanoseconds":977000000}},{"id":"0eFP8Z1FE3qp4i1rZ8qW","level":"a2","lesson":19,"part":10,"type":"text","name":"a2-l19-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous avez fait ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What did you do?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Nous avons mangé, chanté et dansé toute la soirée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We ate, sang and danced all evening.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Nous avons mangé, chanté et dansé toute la soirée.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":125000000}},{"id":"nP9v1JS9OrR8QR8nfGMw","level":"a2","lesson":19,"part":11,"type":"text","name":"a2-l19-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous étiez comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How were you feeling?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'étais tellement heureux que je n'ai pas voulu partir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I was so happy that I didn't want to leave.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'étais tellement heureux que je n'ai pas voulu partir.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":170000000}},{"id":"ApGzc38nERs81w6OmQ5v","level":"a2","lesson":19,"part":12,"type":"text","name":"a2-l19-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Décrivez un souvenir.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Describe a memory.</p><p><b>Describe a memory with detail: place, people, feelings.</b></p><p style=\"opacity:.7;\">For example: “Je me souviens d'un Noël chez ma grand-mère. Ça sentait très bon. J'étais tellement heureux.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je me souviens d'un Noël chez ma grand-mère. Ça sentait très bon. J'étais tellement heureux.","size":null,"created":{"_seconds":1793276060,"_nanoseconds":282000000}},{"id":"LZ1TTGWSd0axGBAqbqry","level":"a2","lesson":19,"part":13,"type":"text","name":"a2-l19-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌟</div><p><b>Memory shared!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can describe a vivid memory with detail and emotion. Your French now has colour.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276060,"_nanoseconds":373000000}}]