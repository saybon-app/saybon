[{"id":"bbEzziFxTrbQr6whNjFt","level":"a2","lesson":16,"part":1,"type":"text","name":"a2-l16-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Today you compare and choose. You've used plus and moins. Now you add le plus and le moins, the superlative. It's the best, the biggest, the cheapest. This helps you recommend and decide.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276054,"_nanoseconds":335000000}},{"id":"5HIehVpzYAQofk5eiDTd","level":"a2","lesson":16,"part":2,"type":"text","name":"a2-l16-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⭐</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Comparing and choosing</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276054,"_nanoseconds":332000000}},{"id":"fRES3HeajtGzDw9sQ48p","level":"a2","lesson":16,"part":2,"type":"text","name":"a2-l16-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le plus + adjectif, la plus, les plus. C'est le plus grand. Le meilleur, la meilleure. Le moins cher. Ajoutez de pour la catégorie: la plus belle ville du pays.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est le plus grand marché.</b><span style=\"opacity:.7;\"> · It's the biggest market.</span></li><li 