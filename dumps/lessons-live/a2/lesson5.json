[{"id":"KlqosRGbtbnnakwtbrK3","level":"a2","lesson":5,"part":1,"type":"text","name":"a2-l05-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello ! Après les pronoms COD, voici les pronoms COI: lui et leur. They replace à + a person: je parle à Marie becomes je lui parle. Use me, te, nous, vous for speaking to people directly. A small change, a big improvement.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276036,"_nanoseconds":5000000}},{"id":"CIjEb20yrCig8Usv0blt","level":"a2","lesson":5,"part":2,"type":"text","name":"a2-l05-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📬</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Indirect object pronouns</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276036,"_nanoseconds":65000000}},{"id":"UnjBkjFFH4trO5zclHjA","level":"a2","lesson":5,"part":2,"type":"text","name":"a2-l05-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Lui = à lui ou à elle. Leur = à eux, à elles. Me, te, nous, vous aussi. Je lui parle. Je leur téléphone. Il me donne un cadeau. Négation: je ne lui parle pas.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je lui parle.</b><span style=\"opacity:.7;\"> · I talk to him/her.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je leur téléphone.</b><span style=\"opacity:.7;\"> · I call them.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il me donne un cadeau.</b><span style=\"opacity:.7;\"> · He gives me a gift.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Elle nous écrit.</b><span style=\"opacity:.7;\"> · She writes to us.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276036,"_nanoseconds":75000000}},{"id":"jvmxGyEUp0tDzMtyEz0T","level":"a2","lesson":5,"part":3,"type":"text","name":"a2-l05-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je lui parle.</b></p><p style=\"opacity:.75;margin:0;\">I talk to him/her.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je lui parle.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":80000000}},{"id":"vSZPsYl1ClZ7IiXoKIkR","level":"a2","lesson":5,"part":4,"type":"text","name":"a2-l05-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je leur téléphone.</b></p><p style=\"opacity:.75;margin:0;\">I call them.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je leur téléphone.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":509000000}},{"id":"Dk44vDLdGAR6bDqaHpdo","level":"a2","lesson":5,"part":5,"type":"text","name":"a2-l05-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il me donne un cadeau.</b></p><p style=\"opacity:.75;margin:0;\">He gives me a gift.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il me donne un cadeau.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":513000000}},{"id":"5OfEa4FWz5AD6dhNHqN5","level":"a2","lesson":5,"part":6,"type":"text","name":"a2-l05-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Elle nous écrit.</b></p><p style=\"opacity:.75;margin:0;\">She writes to us.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Elle nous écrit.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":511000000}},{"id":"gyBVYaLc3vvuWDX94ZLH","level":"a2","lesson":5,"part":7,"type":"text","name":"a2-l05-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous parlez souvent à votre sœur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you often talk to your sister?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je lui parle tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I talk to her every day.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vos parents ? Vous leur téléphonez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your parents? Do you call them?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je leur téléphone le dimanche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I call them on Sundays.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous offrez à votre mère pour son anniversaire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you give your mother for her birthday?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je lui offre un sac et des fleurs.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I give her a bag and flowers.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vos amis, ils vous écrivent ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your friends, do they write to you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, ils m'écrivent souvent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, they write to me often.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276036,"_nanoseconds":516000000}},{"id":"HdHeprDBF4FMpVhHm7u6","level":"a2","lesson":5,"part":8,"type":"text","name":"a2-l05-p08-b1","partTitle":"Your turn 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous parlez souvent à votre sœur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you often talk to your sister?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je lui parle tous les jours.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I talk to her every day.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je lui parle tous les jours.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":914000000}},{"id":"1E9Cuw6tSBjxwqBjp2KC","level":"a2","lesson":5,"part":9,"type":"text","name":"a2-l05-p09-b1","partTitle":"Your turn 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vos parents ? Vous leur téléphonez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your parents? Do you call them?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je leur téléphone le dimanche.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I call them on Sundays.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je leur téléphone le dimanche.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":921000000}},{"id":"k4wYaLHYsKSeyzAXv4GE","level":"a2","lesson":5,"part":10,"type":"text","name":"a2-l05-p10-b1","partTitle":"Your turn 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous offrez à votre mère pour son anniversaire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you give your mother for her birthday?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je lui offre un sac et des fleurs.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I give her a bag and flowers.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je lui offre un sac et des fleurs.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":924000000}},{"id":"3eSpSMdznlOHfD5aamKc","level":"a2","lesson":5,"part":11,"type":"text","name":"a2-l05-p11-b1","partTitle":"Your turn 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vos amis, ils vous écrivent ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And your friends, do they write to you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, ils m'écrivent souvent.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, they write to me often.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, ils m'écrivent souvent.","size":null,"created":{"_seconds":1793276036,"_nanoseconds":923000000}},{"id":"IMDkHSh3PYjGwmbaM9Uz","level":"a2","lesson":5,"part":12,"type":"text","name":"a2-l05-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez à qui vous téléphonez et ce que vous offrez.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Talk about who you call and what you give.</p><p><b>Say who you call and what you give, using lui or leur.</b></p><p style=\"opacity:.7;\">For example: “Je lui téléphone souvent. Je leur offre un cadeau.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Je lui téléphone souvent. Je leur offre un cadeau.","size":null,"created":{"_seconds":1793276037,"_nanoseconds":332000000}},{"id":"Gf3mb5OfWCXM8FoXndIw","level":"a2","lesson":5,"part":13,"type":"text","name":"a2-l05-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📬</div><p><b>To whom? Done!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can now say to whom you speak or give something with lui and leur.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276037,"_nanoseconds":382000000}}]