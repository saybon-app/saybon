[{"id":"TYlLcl5mIigBZaUVoMNx","level":"a0-les-petits","lesson":22,"part":1,"type":"text","name":"ab-kids-l22-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we go outside, to a garden full of life. You'll say what you see: un arbre, une fleur, un oiseau, un papillon. And the useful sentence: je vois, meaning 'I see'.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234589,"_nanoseconds":792000000}},{"id":"egf6Mjbe6BeLBI2zCvIf","level":"a0-les-petits","lesson":22,"part":2,"type":"text","name":"ab-kids-l22-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🦋</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A garden with a tree, a blue bird, flowers and three butterflies</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234589,"_nanoseconds":949000000}},{"id":"2pkE2CjTm431Pm1JihM3","level":"a0-les-petits","lesson":22,"part":2,"type":"text","name":"ab-kids-l22-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Un arbre is a tree. Une fleur is a flower. Un oiseau is a bird. Un papillon is a butterfly. Je vois means 'I see'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un arbre</b><span style=\"opacity:.7;\"> · A tree</span></li><li style=\"padding: