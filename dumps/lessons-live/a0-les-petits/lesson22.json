90,"_nanoseconds":361000000}},{"id":"leZzWvXsZgx56vsGQdci","level":"a0-les-petits","lesson":22,"part":6,"type":"text","name":"ab-kids-l22-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je vois un oiseau.</b></p><p style=\"opacity:.75;margin:0;\">I see a bird.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je vois un oiseau.","size":null,"created":{"_seconds":1793234590,"_nanoseconds":411000000}},{"id":"9K7iBXbas5F1Sc8SEPJu","level":"a0-les-petits","lesson":22,"part":7,"type":"text","name":"ab-kids-l22-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il fait beau ! Qu'est-ce que tu vois ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's nice out! What do you see?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je vois un arbre.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I see a tree.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et dans l'arbre ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the tree?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je vois un oiseau bleu !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I see a blue bird!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et dans les fleurs ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And in the flowers?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je vois trois papillons.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I see three butterflies.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ils sont jolis !</b><br><span style=\"opacity:.7;font-size:.9rem;\">They're pretty!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'aime les papillons.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like butterflies.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234590,"_nanoseconds":463000000}},{"id":"RsjNF3V6nVmAHoFeWqU1","level":"a0-les-petits","lesson":22,"part":8,"type":"text","name":"ab-kids-l22-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234590,"_nanoseconds":591000000}},{"id":"85GuFLPs1wxyUlhD8YtC","level":"a0-les-petits","lesson":22,"part":9,"type":"text","name":"ab-kids-l22-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il fait beau ! Qu'est-ce que tu vois ?</b><br><span style=\"opacity:.7;font-