[{"id":"Cu3alJ8fovK5rs8jdIGF","level":"a0-les-petits","lesson":19,"part":1,"type":"text","name":"ab-kids-l19-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we talk about feelings. Not just 'good' or 'bad', but real ones: hungry, tired, scared, sad. And the great news: in French, many feelings use j'ai, 'I have'. J'ai faim. J'ai peur. J'ai sommeil.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234585,"_nanoseconds":237000000}},{"id":"K0Z8xp7v0TWNGbvuczvi","level":"a0-les-petits","lesson":19,"part":2,"type":"text","name":"ab-kids-l19-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙂</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Six cartoon faces: hungry, sleepy, scared, sad, calm and happy</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234585,"_nanoseconds":87000000}},{"id":"LeliB5m7Fbpc1gRU5irf","level":"a0-les-petits","lesson":19,"part":2,"type":"text","name":"ab-kids-l19-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 J'ai faim means 'I'm hungry'. J'ai peur means 'I'm scared'. J'ai sommeil means 'I'm sleepy'. Je suis triste means 'I'm sad'. Je suis calme means 'I'm calm'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai faim.</b><span style=\"opacity:.7;\"> · I'm hungry.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai peur.</b><span style=\"opacity:.7;\"> · I'm scared.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai sommeil.</b><span style=\"opacity:.7;\"> · I'm sleepy.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis triste.</b><span style=\"opacity:.7;\"> · I'm sad.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234585,"_nanoseconds":320000000}},{"id":"FbApgJPdpAPFi7kcxfnv","level":"a0-les-petits","lesson":19,"part":3,"type":"text","name":"ab-kids-l19-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai faim.</b></p><p style=\"opacity:.75;margin:0;\">I'm hungry.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai faim.","size":null,"created":{"_seconds":1793234585,"_nanoseconds":458000000}},{"id":"65N94EDPxGvcnGPrZOil","level":"a0-les-petits","lesson":19,"part":4,"type":"text","name":"ab-kids-l19-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai peur.</b></p><p style=\"opacity:.75;margin:0;\">I'm scared.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai peur.","size":null,"created":{"_seconds":1793234585,"_nanoseconds":503000000}},{"id":"dSB74nS0Ht96XUBzMdRR","level":"a0-les-petits","lesson":19,"part":5,"type":"text","name":"ab-kids-l19-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai sommeil.</b></p><p style=\"opacity:.75;margin:0;\">I'm sleepy.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai sommeil.","size":null,"created":{"_seconds":1793234585,"_nanoseconds":631000000}},{"id":"MwpiQwJUoVKOvMfZe4Hf","level":"a0-les-petits","lesson":19,"part":6,"type":"text","name":"ab-kids-l19-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis triste.</b></p><p style=\"opacity:.75;margin:0;\">I'm sad.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je suis triste.","size":null,"created":{"_seconds":1793234585,"_nanoseconds":726000000}},{"id":"C5I9UeOZNn3TmM5Uo39v","level":"a0-les-petits","lesson":19,"part":7,"type":"text","name":"ab-kids-l19-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, ça ne va pas. J'ai faim !</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, not great. I'm hungry!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu veux une pomme ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want an apple?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, je voudrais une pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'd like an apple.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà ! Ça va mieux ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here! Better?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, ça va bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm fine.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, j'ai sommeil.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm sleepy.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oh, tu es fatigué ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, are you tired?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, un peu !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a bit!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir ! Dors bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye! Sleep well!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234585,"_nanoseconds":852000000}},{"id":"vxX0Dnm3nL6EYa98IgyC","level":"a0-les-petits","lesson":19,"part":8,"type":"text","name":"ab-kids-l19-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, ça ne va pas. J'ai faim !</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, not great. I'm hungry!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, ça ne va pas. J'ai faim !","size":null,"created":{"_seconds":1793234585,"_nanoseconds":904000000}},{"id":"jQIEkMY7GMxJz5yY1XGj","level":"a0-les-petits","lesson":19,"part":9,"type":"text","name":"ab-kids-l19-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu veux une pomme ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want an apple?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, je voudrais une pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'd like an apple.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, je voudrais une pomme.","size":null,"created":{"_seconds":1793234586,"_nanoseconds":30000000}},{"id":"MaqvaEwenxKazBKZalyp","level":"a0-les-petits","lesson":19,"part":10,"type":"text","name":"ab-kids-l19-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà ! Ça va mieux ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here! Better?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, ça va bien.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I'm fine.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, ça va bien.","size":null,"created":{"_seconds":1793234586,"_nanoseconds":124000000}},{"id":"Ly7HqIipZ1jbn8qdJo4h","level":"a0-les-petits","lesson":19,"part":11,"type":"text","name":"ab-kids-l19-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, j'ai sommeil.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm sleepy.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oh, tu es fatigué ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, are you tired?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oh, tu es fatigué ?","size":null,"created":{"_seconds":1793234586,"_nanoseconds":243000000}},{"id":"pxoYBIAmq4PqlbjZkUuq","level":"a0-les-petits","lesson":19,"part":12,"type":"text","name":"ab-kids-l19-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, un peu !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a bit!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir ! Dors bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye! Sleep well!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir ! Dors bien !","size":null,"created":{"_seconds":1793234586,"_nanoseconds":309000000}},{"id":"wlrXpJB6IZJR7GVRPFys","level":"a0-les-petits","lesson":19,"part":13,"type":"text","name":"ab-kids-l19-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Comment tu te sens ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">How do you feel?</p><p><b>Say how you feel with j'ai or je suis.</b></p><p style=\"opacity:.7;\">For example: “J'ai faim. Je suis calme.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai faim. Je suis calme.","size":null,"created":{"_seconds":1793234586,"_nanoseconds":418000000}},{"id":"9wN8c4Xe6GEzPfNq85b8","level":"a0-les-petits","lesson":19,"part":14,"type":"text","name":"ab-kids-l19-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🙂</div><p><b>Feelings expert!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say how you feel in several ways. Real French speakers use these every day.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234586,"_nanoseconds":521000000}}]