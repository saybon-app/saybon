[{"id":"VQgxIbwJymm3vzkJAzZ2","level":"a0-les-petits","lesson":10,"part":1,"type":"text","name":"ab-kids-l10-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we look at a family photo. You'll say who's who: maman, papa, frère, sœur. And you'll use j'ai again, to say how many brothers or sisters you have. Let's open the photo album!</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234570,"_nanoseconds":573000000}},{"id":"8AXCNUNzP5Na7sbHDUpa","level":"a0-les-petits","lesson":10,"part":2,"type":"text","name":"ab-kids-l10-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A family photo on a wall: mum, dad, a brother and a sister</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234570,"_nanoseconds":738000000}},{"id":"xiRPhcUdLR4S90lkQ1sE","level":"a0-les-petits","lesson":10,"part":2,"type":"text","name":"ab-kids-l10-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Maman is mum. Papa is dad. Un frère is a brother. Une sœur is a sister. To introduce someone, you say voici, which means 'here is'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Voici ma maman.</b><span style=\"opacity:.7;\"> · Here is my mum.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Voici mon papa.</b><span style=\"opacity:.7;\"> · Here is my dad.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai un frère.</b><span style=\"opacity:.7;\"> · I have a brother.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai une sœur.</b><span style=\"opacity:.7;\"> · I have a sister.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234570,"_nanoseconds":963000000}},{"id":"myFxobzDZgoxH6zEozow","level":"a0-les-petits","lesson":10,"part":3,"type":"text","name":"ab-kids-l10-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Voici ma maman.</b></p><p style=\"opacity:.75;margin:0;\">Here is my mum.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Voici ma maman.","size":null,"created":{"_seconds":1793234570,"_nanoseconds":970000000}},{"id":"U3obPKcAO8QEf61pRv0q","level":"a0-les-petits","lesson":10,"part":4,"type":"text","name":"ab-kids-l10-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Voici mon papa.</b></p><p style=\"opacity:.75;margin:0;\">Here is my dad.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Voici mon papa.","size":null,"created":{"_seconds":1793234570,"_nanoseconds":984000000}},{"id":"uYTXoa3Xu7g82Vlq4heK","level":"a0-les-petits","lesson":10,"part":5,"type":"text","name":"ab-kids-l10-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai un frère.</b></p><p style=\"opacity:.75;margin:0;\">I have a brother.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai un frère.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":154000000}},{"id":"RztKhxFNGMMuOvi6RU8z","level":"a0-les-petits","lesson":10,"part":6,"type":"text","name":"ab-kids-l10-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai une sœur.</b></p><p style=\"opacity:.75;margin:0;\">I have a sister.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai une sœur.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":372000000}},{"id":"aSZAyjwdXCxHpQi4aIY3","level":"a0-les-petits","lesson":10,"part":7,"type":"text","name":"ab-kids-l10-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Regarde la photo. Tu as une famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at the photo. Do you have a family?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui ! Voici ma maman.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes! Here is my mum.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et lui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And him?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voici mon papa.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here is my dad.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as un frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a brother?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai un frère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a brother.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is he?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il a cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is five.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234571,"_nanoseconds":373000000}},{"id":"TQFsrZxDUz0synjuufm9","level":"a0-les-petits","lesson":10,"part":8,"type":"text","name":"ab-kids-l10-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234571,"_nanoseconds":387000000}},{"id":"LGEqQe5ZqCBlRPWHN21Q","level":"a0-les-petits","lesson":10,"part":9,"type":"text","name":"ab-kids-l10-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Regarde la photo. Tu as une famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at the photo. Do you have a family?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui ! Voici ma maman.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes! Here is my mum.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui ! Voici ma maman.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":549000000}},{"id":"rLME1Ku3B5Eat2mm8UcE","level":"a0-les-petits","lesson":10,"part":10,"type":"text","name":"ab-kids-l10-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et lui ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And him?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Voici mon papa.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here is my dad.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Voici mon papa.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":783000000}},{"id":"pOefmwioiCyxXXRJKFZE","level":"a0-les-petits","lesson":10,"part":11,"type":"text","name":"ab-kids-l10-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu as un frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a brother?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'ai un frère.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a brother.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'ai un frère.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":832000000}},{"id":"7333lUtV8n2C9HbEF3SC","level":"a0-les-petits","lesson":10,"part":12,"type":"text","name":"ab-kids-l10-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il a quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old is he?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il a cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is five.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il a cinq ans.","size":null,"created":{"_seconds":1793234571,"_nanoseconds":786000000}},{"id":"sX0YOe93E4SNCnQkibv8","level":"a0-les-petits","lesson":10,"part":13,"type":"text","name":"ab-kids-l10-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Montre-moi ta famille !</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Show me your family!</p><p><b>Introduce two family members with voici.</b></p><p style=\"opacity:.7;\">For example: “Voici ma maman. Voici mon papa.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Voici ma maman. Voici mon papa.","size":null,"created":{"_seconds":1793234572,"_nanoseconds":234000000}},{"id":"RTxlEQn1RAH5i507I4pO","level":"a0-les-petits","lesson":10,"part":14,"type":"text","name":"ab-kids-l10-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👨‍👩‍👧</div><p><b>Family photo taken!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can introduce your family now: voici ma maman, voici mon papa.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234572,"_nanoseconds":464000000}}]