d rgba(255,255,255,.15);\"><b>Bonjour ! Je m'appelle Sacha.</b><span style=\"opacity:.7;\"> · Hello! My name is Sacha.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va bien. J'ai cinq ans.</b><span style=\"opacity:.7;\"> · I'm good. I'm five.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'aime les chats. J'ai un chat noir.</b><span style=\"opacity:.7;\"> · I like cats. I have a black cat.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234594,"_nanoseconds":737000000}},{"id":"4aGvimUcQqYf13U876mU","level":"a0-les-petits","lesson":25,"part":3,"type":"text","name":"ab-kids-l25-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bonjour ! Je m'appelle Sacha.</b></p><p style=\"opacity:.75;margin:0;\">Hello! My name is Sacha.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bonjour ! Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234594,"_nanoseconds":826000000}},{"id":"k5CKm2n7iWrJ88Cpc4Ep","level":"a0-les-petits","lesson":25,"part":4,"type":"text","name":"ab-kids-l25-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va bien. J'ai cinq ans.</b></p><p style=\"opacity:.75;margin:0;\">I'm good. I'm five.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va bien. J'ai cinq ans.","size":null,"created":{"_seconds":1793234594,"_nanoseconds":851000000}},{"id":"i6X0bHzBh2NeDBWxb2WL","level":"a0-les-petits","lesson":25,"part":5,"type":"text","name":"ab-kids-l25-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'aime les chats. J'ai un chat noir.</b></p><p style=\"opacity:.75;margin:0;\">I like cats. I have a black cat.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'aime les chats. J'ai un chat noir.","size":null,"created":{"_seconds":1793234595,"_nanoseconds":89000000}},{"id":"ikNgcY5HCBGy83wnEhN1","level":"a0-les-petits","lesson":25,"part":6,"type":"text","name":"ab-kids-l25-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour à tous !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello everyone!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour ! Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Sacha.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va, Sacha ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How are you, Sacha?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I am very good! And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm five.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as un animal ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a pet?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai un chat noir. Il s'appelle Pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a black cat. His name is Pomme.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu aimes les fruits ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like fruit?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime les fraises. Je n'aime pas les bananes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like strawberries. I don't like bananas.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci, Sacha ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you, Sacha! Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234595,"_nanoseconds":154000000}},{"id":"fAMuqzvuFbmWVAWWB2Aw","level":"a0-les-petits","lesson":25,"part":7,"type":"text","name":"ab-kids-l25-p07-b1","partTitle":"Your turn 1/6","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour à tous !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello everyone!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour ! Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Sacha.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour ! Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234595,"_nanoseconds":240000000}},{"id":"LbpvCVbIz7gu9lzNfweY","level":"a0-les-petits","les