[{"id":"IzdtTqCsz5lBETPN9mwb","level":"a0-les-petits","lesson":5,"part":1,"type":"text","name":"ab-kids-l05-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you're helping at a very small fruit stand, and you'll need to count. We'll greet each other, talk about colours, and learn one to five: un, deux, trois, quatre, cinq.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234562,"_nanoseconds":621000000}},{"id":"y5EiBMoeAFT6ZbkSsNzs","level":"a0-les-petits","lesson":5,"part":2,"type":"text","name":"ab-kids-l05-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎈</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Five balloons of different colours tied to a chair</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234562,"_nanoseconds":703000000}},{"id":"FYJlo2kbiJhlAuSQqj2a","level":"a0-les-petits","lesson":5,"part":2,"type":"text","name":"ab-kids-l05-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Let's count together. Un, deux, trois, quatre, cinq. To ask how many, you say combien.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un, deux, trois</b><span style=\"opacity:.7;\"> · One, two, three</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Quatre, cinq</b><span style=\"opacity:.7;\"> · Four, five</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Combien ?</b><span style=\"opacity:.7;\"> · How many?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234562,"_nanoseconds":734000000}},{"id":"7Nf4yF5TkpI5Yfk3KGYV","level":"a0-les-petits","lesson":5,"part":3,"type":"text","name":"ab-kids-l05-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un, deux, trois</b></p><p style=\"opacity:.75;margin:0;\">One, two, three</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un, deux, trois","size":null,"created":{"_seconds":1793234562,"_nanoseconds":805000000}},{"id":"4bY5xyGDZbvfdIaYIWBo","level":"a0-les-petits","lesson":5,"part":4,"type":"text","name":"ab-kids-l05-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Quatre, cinq</b></p><p style=\"opacity:.75;margin:0;\">Four, five</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Quatre, cinq","size":null,"created":{"_seconds":1793234563,"_nanoseconds":96000000}},{"id":"xGYp9yfMxbBWpDu1rwRn","level":"a0-les-petits","lesson":5,"part":5,"type":"text","name":"ab-kids-l05-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Combien ?</b></p><p style=\"opacity:.75;margin:0;\">How many?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Combien ?","size":null,"created":{"_seconds":1793234563,"_nanoseconds":98000000}},{"id":"SC3e195vFdgfnnHBBDox","level":"a0-les-petits","lesson":5,"part":6,"type":"text","name":"ab-kids-l05-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Regarde mes ballons. Ils sont rouges et bleus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at my balloons. They are red and blue.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How many?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Compte avec moi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Count with me!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Un, deux, trois !</b><br><span style=\"opacity:.7;font-size:.9rem;\">One, two, three!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Encore !</b><br><span style=\"opacity:.7;font-size:.9rem;\">More!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quatre, cinq !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Four, five!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Cinq ballons !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Five balloons!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234563,"_nanoseconds":205000000}},{"id":"paTI8ruXVmjIue9FsJup","level":"a0-les-petits","lesson":5,"part":7,"type":"text","name":"ab-kids-l05-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234563,"_nanoseconds":223000000}},{"id":"5biV3uVhby21A1onQZt6","level":"a0-les-petits","lesson":5,"part":8,"type":"text","name":"ab-kids-l05-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Regarde mes ballons. Ils sont rouges et bleus.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look at my balloons. They are red and blue.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How many?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Combien ?","size":null,"created":{"_seconds":1793234563,"_nanoseconds":531000000}},{"id":"dJk5XgwV7Kni7YOCjvlV","level":"a0-les-petits","lesson":5,"part":9,"type":"text","name":"ab-kids-l05-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Compte avec moi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Count with me!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Un, deux, trois !</b><br><span style=\"opacity:.7;font-size:.9rem;\">One, two, three!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Un, deux, trois !","size":null,"created":{"_seconds":1793234563,"_nanoseconds":527000000}},{"id":"Z4daECdPvCyMGerGKpOp","level":"a0-les-petits","lesson":5,"part":10,"type":"text","name":"ab-kids-l05-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Encore !</b><br><span style=\"opacity:.7;font-size:.9rem;\">More!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Quatre, cinq !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Four, five!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Quatre, cinq !","size":null,"created":{"_seconds":1793234563,"_nanoseconds":632000000}},{"id":"7GFr90cuhSkYWroVtx5m","level":"a0-les-petits","lesson":5,"part":11,"type":"text","name":"ab-kids-l05-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Cinq ballons !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Five balloons!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Super !","size":null,"created":{"_seconds":1793234563,"_nanoseconds":655000000}},{"id":"D3AeWdwu9St224zp7mxO","level":"a0-les-petits","lesson":5,"part":12,"type":"text","name":"ab-kids-l05-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:cent