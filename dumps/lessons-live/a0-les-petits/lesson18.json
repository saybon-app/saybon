[{"id":"BRAZqk8Xq0OAo4vjTEbD","level":"a0-les-petits","lesson":18,"part":1,"type":"text","name":"ab-kids-l18-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we get dressed, in French! A pullover, a hat, shoes. You'll say what you're wearing, and describe the colour. New words: le pull, le chapeau, les chaussures, le pantalon. And the key verb: je porte, meaning 'I'm wearing'.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234583,"_nanoseconds":470000000}},{"id":"olEHGIZ6S8l36bEK44xc","level":"a0-les-petits","lesson":18,"part":2,"type":"text","name":"ab-kids-l18-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧢</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A child's wardrobe: a green sweater, a red hat, shoes and trousers</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234583,"_nanoseconds":726000000}},{"id":"NTWtIlWfxiCwvijY7bPq","level":"a0-les-petits","lesson":18,"part":2,"type":"text","name":"ab-kids-l18-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le pull is the sweater. Le chapeau is the hat. Les chaussures are the shoes. Le pantalon is the trousers. Je porte means 'I am wearing'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\">