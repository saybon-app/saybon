[{"id":"lQ72gsPHlo9ydAZ9HFqo","level":"a0-les-petits","lesson":16,"part":1,"type":"text","name":"ab-kids-l16-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we check the weather together, like a real weather reporter. New words: il fait beau, il pleut, il fait chaud, il fait froid. And a new question: quel temps fait-il?</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234580,"_nanoseconds":260000000}},{"id":"o5ajDtZHznLdjs47IIlg","level":"a0-les-petits","lesson":16,"part":2,"type":"text","name":"ab-kids-l16-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌦️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A window showing sun on one side and rain on the other</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234580,"_nanoseconds":302000000}},{"id":"7DaGjx24IvPepDhkXkpP","level":"a0-les-petits","lesson":16,"part":2,"type":"text","name":"ab-kids-l16-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Il fait beau means it's nice weather. Il pleut means it's raining. Il fait chaud means it's hot. Il fait froid means it's cold. To ask about the weather: quel temps fait-il.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il fait beau.</b><span style=\"opacity:.7;\"> · It's nice weather.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il pleut.</b><span style=\"opacity:.7;\"> · It's raining.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il fait chaud.</b><span style=\"opacity:.7;\"> · It's hot.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il fait froid.</b><span style=\"opacity:.7;\"> · It's cold.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234580,"_nanoseconds":326000000}},{"id":"zGEUdXt8m3KF9kMcliBj","level":"a0-les-petits","lesson":16,"part":3,"type":"text","name":"ab-kids-l16-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il fait beau.</b></p><p style=\"opacity:.75;margin:0;\">It's nice weather.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il fait beau.","size":null,"created":{"_seconds":1793234580,"_nanoseconds":636000000}},{"id":"1zlJTpRI98aFyVjHXV0N","level":"a0-les-petits","lesson":16,"part":4,"type":"text","name":"ab-kids-l16-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il pleut.</b></p><p style=\"opacity:.75;margin:0;\">It's raining.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il pleut.","size":null,"created":{"_seconds":1793234580,"_nanoseconds":656000000}},{"id":"7so9PaBAirZX0kJLe1vO","level":"a0-les-petits","lesson":16,"part":5,"type":"text","name":"ab-kids-l16-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il fait chaud.</b></p><p style=\"opacity:.75;margin:0;\">It's hot.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il fait chaud.","size":null,"created":{"_seconds":1793234580,"_nanoseconds":696000000}},{"id":"AfVYSBkF8j3B1ijTKVUP","level":"a0-les-petits","lesson":16,"part":6,"type":"text","name":"ab-kids-l16-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il fait froid.</b></p><p style=\"opacity:.75;margin:0;\">It's cold.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Il fait froid.","size":null,"created":{"_seconds":1793234580,"_nanoseconds":737000000}},{"id":"pZKMJ7q0hgtxkARIXENI","level":"a0-les-petits","lesson":16,"part":7,"type":"text","name":"ab-kids-l16-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Regarde par la fenêtre. Quel temps fait-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look out the window. What's the weather like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il fait beau !</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's nice out!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il fait chaud ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Is it hot?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, il fait chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, it's hot.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu aimes quand il pleut ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like it when it rains?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime la pluie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like the rain.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi aussi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234581,"_nanoseconds":49000000}},{"id":"BZVm7YmDzgKmMksB9GYY","level":"a0-les-petits","lesson":16,"part":8,"type":"text","name":"ab-kids-l16-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234581,"_nanoseconds":46000000}},{"id":"JeurMvuVIBatyCRGpKFH","level":"a0-les-petits","lesson":16,"part":9,"type":"text","name":"ab-kids-l16-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Regarde par la fenêtre. Quel temps fait-il ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Look out the window. What's the weather like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il fait beau !</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's nice out!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il fait beau !","size":null,"created":{"_seconds":1793234581,"_nanoseconds":102000000}},{"id":"14NFpZq5YxPsOiqW1V1T","level":"a0-les-petits","lesson":16,"part":10,"type":"text","name":"ab-kids-l16-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il fait chaud ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Is it hot?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, il fait chaud.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, it's hot.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, il fait chaud.","size":null,"created":{"_seconds":1793234581,"_nanoseconds":165000000}},{"id":"lr8KIli0a6UxsMgtBSRJ","level":"a0-les-petits","lesson":16,"part":11,"type":"text","name":"ab-kids-l16-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu aimes quand il pleut ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like it when it rains?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime la pluie.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like the rain.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime la pluie.","size":null,"created":{"_seconds":1793234581,"_nanoseconds":466000000}},{"id":"BvnDtWlCoIVXSJkDxUCf","level":"a0-les-petits","lesson":16,"part":12,"type":"text","name":"ab-kids-l16-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi aussi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Super !","size":null,"created":{"_seconds":1793234581,"_nanoseconds":448000000}},{"id":"Na67JaYWSircUSl8s0eA","level":"a0-les-petits","lesson":16,"part":13,"type":"text","name":"ab-kids-l16-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Quel temps fait-il aujourd'hui ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What's the weather like today?</p><p><b>Say what the weather is and what you like.</b></p><p style=\"opacity:.7;\">For example: “Il fait chaud. J'aime le soleil.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Il fait chaud. J'aime le soleil.","size":null,"created":{"_seconds":1793234581,"_nanoseconds":512000000}},{"id":"gmhx9xtBewhfCXtFPCU2","level":"a0-les-petits","lesson":16,"part":14,"type":"text","name":"ab-kids-l16-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌦️</div><p><b>Weather reporter!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can give a weather report: il fait beau, il pleut, il fait froid.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234581,"_nanoseconds":558000000}}]