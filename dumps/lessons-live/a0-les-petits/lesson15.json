[{"id":"opUsJc0wOhyOy2H921Ry","level":"a0-les-petits","lesson":15,"part":1,"type":"text","name":"ab-kids-l15-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we build a picture out of shapes. A circle, a square, a triangle, a star. You'll describe each shape, and say its colour. New words: le cercle, le carré, le triangle, l'étoile.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234578,"_nanoseconds":673000000}},{"id":"u5suRBdF4V2wgtIb8V5W","level":"a0-les-petits","lesson":15,"part":2,"type":"text","name":"ab-kids-l15-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">⭐</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A picture made of a blue circle, a red square, a yellow triangle and five stars</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234578,"_nanoseconds":741000000}},{"id":"kcRWHA1r13uMlf8GoFom","level":"a0-les-petits","lesson":15,"part":2,"type":"text","name":"ab-kids-l15-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le cercle is the circle. Le carré is the square. Le triangle is the triangle. L'étoile is the star. In French, the colour comes after the shape: un cercle rouge.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le cercle</b><span style=\"opacity:.7;\"> · The circle</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le carré</b><span style=\"opacity:.7;\"> · The square</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le triangle</b><span style=\"opacity:.7;\"> · The triangle</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un cercle rouge</b><span style=\"opacity:.7;\"> · A red circle</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234579,"_nanoseconds":0}},{"id":"HgaMhjiAte2sZZL53nxE","level":"a0-les-petits","lesson":15,"part":3,"type":"text","name":"ab-kids-l15-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le cercle</b></p><p style=\"opacity:.75;margin:0;\">The circle</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le cercle","size":null,"created":{"_seconds":1793234579,"_nanoseconds":60000000}},{"id":"AK5P3ILQbEnOZpgW0UxU","level":"a0-les-petits","lesson":15,"part":4,"type":"text","name":"ab-kids-l15-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le carré</b></p><p style=\"opacity:.75;margin:0;\">The square</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le carré","size":null,"created":{"_seconds":1793234579,"_nanoseconds":62000000}},{"id":"GrT26ogeONicxjbsKxon","level":"a0-les-petits","lesson":15,"part":5,"type":"text","name":"ab-kids-l15-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le triangle</b></p><p style=\"opacity:.75;margin:0;\">The triangle</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le triangle","size":null,"created":{"_seconds":1793234579,"_nanoseconds":126000000}},{"id":"C0MNEfhk5NzVdI1R7Ce7","level":"a0-les-petits","lesson":15,"part":6,"type":"text","name":"ab-kids-l15-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un cercle rouge</b></p><p style=\"opacity:.75;margin:0;\">A red circle</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un cercle rouge","size":null,"created":{"_seconds":1793234579,"_nanoseconds":405000000}},{"id":"7nSYMDkMXi5uTY60lKZV","level":"a0-les-petits","lesson":15,"part":7,"type":"text","name":"ab-kids-l15-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va. On dessine ? Qu'est-ce que c'est ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Fine. Shall we draw? What is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un cercle !</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a circle!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>De quelle couleur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What colour?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un cercle bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a blue circle.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ça ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And this?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est un triangle jaune.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's a yellow triangle.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Combien d'étoiles ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How many stars?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Cinq étoiles !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Five stars!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234579,"_nanoseconds":463000000}},{"id":"wN0OpYHpNYwdB3ippf3i","level":"a0-les-petits","lesson":15,"part":8,"type":"text","name":"ab-kids-l15-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien ! Et toi ?","size":null,"created":{"_seconds":1793234579,"_nanoseconds":471000000}},{"id":"pMy29kD6kBQBFFJtARWU","level":"a0-les-petits","lesson":15,"part":9,"type":"text","name":"ab-kids-l15-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑