[{"id":"cLa104BEHyGaONjCOF8L","level":"a0-les-petits","lesson":3,"part":1,"type":"text","name":"ab-kids-l03-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello again! Today you'll learn how to ask a friend how they are, and how to answer. We'll start with a greeting, say our names, and then, the new part: ça va. Listen carefully to how it sounds.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234558,"_nanoseconds":690000000}},{"id":"Yy1NeOwVCGWQwciN42md","level":"a0-les-petits","lesson":3,"part":2,"type":"text","name":"ab-kids-l03-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">😊</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two faces side by side: one smiling, one pulling a funny 'not so good' face</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234558,"_nanoseconds":851000000}},{"id":"QXNc3c4AqiV5o4KOFGrp","level":"a0-les-petits","lesson":3,"part":2,"type":"text","name":"ab-kids-l03-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Ça va means 'how are you?', and also 'I'm fine'. You can say ça va bien for 'I'm good', or ça va mal for 'not so good'. Say them after me.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va ?</b><span style=\"opacity:.7;\"> · How are you?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va bien !</b><span style=\"opacity:.7;\"> · I'm good!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ça va mal.</b><span style=\"opacity:.7;\"> · Not so good.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234559,"_nanoseconds":7000000}},{"id":"hFgzJfrxO0PPMFUF4GFk","level":"a0-les-petits","lesson":3,"part":3,"type":"text","name":"ab-kids-l03-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va ?</b></p><p style=\"opacity:.75;margin:0;\">How are you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va ?","size":null,"created":{"_seconds":1793234559,"_nanoseconds":34000000}},{"id":"c5mEpr0cX0fg0aHkFp7B","level":"a0-les-petits","lesson":3,"part":4,"type":"text","name":"ab-kids-l03-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va bien !</b></p><p style=\"opacity:.75;margin:0;\">I'm good!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234559,"_nanoseconds":95000000}},{"id":"ba0w1rZJgeIgCzCdjkAK","level":"a0-les-petits","lesson":3,"part":5,"type":"text","name":"ab-kids-l03-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ça va mal.</b></p><p style=\"opacity:.75;margin:0;\">Not so good.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Ça va mal.","size":null,"created":{"_seconds":1793234559,"_nanoseconds":559000000}},{"id":"cS1yFcaSpSqA7QkATzrt","level":"a0-les-petits","lesson":3,"part":6,"type":"text","name":"ab-kids-l03-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Salut !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina. And you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va mal. J'ai perdu mon chapeau !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Not so good. I lost my hat!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oh non !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh no!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234559,"_nanoseconds":531000000}},{"id":"coe6UxDJK2wQFtYUnouJ","level":"a0-les-petits","lesson":3,"part":7,"type":"text","name":"ab-kids-l03-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Salut !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Salut !","size":null,"created":{"_seconds":1793234559,"_nanoseconds":541000000}},{"id":"RjcbAljNkXUXxRXj4yL2","level":"a0-les-petits","lesson":3,"part":8,"type":"text","name":"ab-kids-l03-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina. And you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234559,"_nanoseconds":568000000}},{"id":"Wkzaw20gt0Lo8eeUe7t9","level":"a0-les-petits","lesson":3,"part":9,"type":"text","name":"ab-kids-l03-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien ! Et toi ?","size":null,"created":{"_seconds":1793234559,"_nanoseconds":932000000}},{"id":"vMxNGG4f6dEPc1LcoV0M","level":"a0-les-petits","lesson":3,"part":10,"type":"text","name":"ab-kids-l03-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça va mal. J'ai perdu mon chapeau !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Not so good. I lost my hat!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oh non !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh no!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oh non !","size":null,"created":{"_seconds":1793234560,"_nanoseconds":29000000}},{"id":"FHSUEijiW7lnsF0sEFSO","level":"a0-les-petits","lesson":3,"part":11,"type":"text","name":"ab-kids-l03-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793234560,"_nanoseconds":135000000}},{"id":"LWQeCtXNusOBrBLXhjCQ","level":"a0-les-petits","lesson":3,"part":12,"type":"text","name":"ab-kids-l03-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"