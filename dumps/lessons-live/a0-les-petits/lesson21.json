its","lesson":21,"part":12,"type":"text","name":"ab-kids-l21-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">De rien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"De rien !","size":null,"created":{"_seconds":1793234589,"_nanoseconds":556000000}},{"id":"hwvzLsoZkXJk4pqc2M6n","level":"a0-les-petits","lesson":21,"part":13,"type":"text","name":"ab-kids-l21-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Tu as un jouet préféré ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Do you have a favourite toy?</p><p><b>Say what toy you have and invite someone to play.</b></p><p style=\"opacity:.7;\">For example: “J'ai un train. Tu veux jouer ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai un train. Tu veux jouer ?","size":null,"created":{"_seconds":1793234589,"_nanoseconds":620000000}},{"id":"lnMappbhs0xDLJaq10I9","level":"a0-les-petits","lesson":21,"part":14,"type":"text","name":"ab-kids-l21-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧸</div><p><b>Playtime!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can talk about toys, and invite a friend to play with tu veux jouer.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234589,"_nanoseconds":663000000}}]