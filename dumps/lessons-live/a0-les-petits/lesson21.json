","size":null,"created":{"_seconds":1793234588,"_nanoseconds":862000000}},{"id":"cSAm6GSH1WJPuatj7SP2","level":"a0-les-petits","lesson":21,"part":6,"type":"text","name":"ab-kids-l21-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu veux jouer ?</b></p><p style=\"opacity:.75;margin:0;\">Do you want to play?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu veux jouer ?","size":null,"created":{"_seconds":1793234588,"_nanoseconds":979000000}},{"id":"toVXyGUCivtLB4muRyxN","level":"a0-les-petits","lesson":21,"part":7,"type":"text","name":"ab-kids-l21-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>J'ai un robot bleu. Et toi, tu as un jouet ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a blue robot. And you, do you have a toy?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai une balle rouge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a red ball.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu veux jouer ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want to play?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, s'il te plaît !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, please!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Un, deux, trois, lance la balle !</b><br><span style=\"opacity:.7;font-size:.9rem;\">One, two, three, throw the ball!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">There!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>De rien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234588,"_nanoseconds":819000000}},{"id":"WLTNYhCjeFyiTZgf76wP","level":"a0-les-petits","lesson":21,"part":8,"type":"text","name":"ab-kids-l21-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234589,"_nanoseconds":158000000}},{"id":"VP434oveBSnWe4kMwVTU","level":"a0-les-petits","lesson":21,"part":9,"type":"text","name":"ab-kids-l21-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>J'ai un robot bleu. Et toi, tu as un jouet ?</b><