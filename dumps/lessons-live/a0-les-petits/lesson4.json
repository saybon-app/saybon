[{"id":"rRxT1Q1beJwS5WAfa5mN","level":"a0-les-petits","lesson":4,"part":1,"type":"text","name":"ab-kids-l04-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today there's a mystery bag. Inside is a surprise, and you'll guess its colour. We'll keep greeting each other and checking how we are, and the new words are colours: rouge, bleu, jaune and vert. Let's find out what's in the bag!</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234560,"_nanoseconds":513000000}},{"id":"xkAb1VNk2bdngjPp92Qw","level":"a0-les-petits","lesson":4,"part":2,"type":"text","name":"ab-kids-l04-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎨</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A big mystery bag on a table with a blue ball peeking out</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234560,"_nanoseconds":540000000}},{"id":"FjrslmzBjzVxR01gkO3d","level":"a0-les-petits","lesson":4,"part":2,"type":"text","name":"ab-kids-l04-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Colours first. Rouge is red. Bleu is blue. Jaune is yellow. Vert is green. And to ask 'what colour is it?' you say c'est quelle couleur.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Rouge</