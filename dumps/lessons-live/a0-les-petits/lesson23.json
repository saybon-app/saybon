[{"id":"eRgvI99k2yhtKMCUWAGq","level":"a0-les-petits","lesson":23,"part":1,"type":"text","name":"ab-kids-l23-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today you'll say how old you are. In French, you don't say 'I am five'. You say 'I have five years': j'ai cinq ans. It sounds strange at first, but you'll get it right away.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234591,"_nanoseconds":246000000}},{"id":"7fr0UnPX858t5NrsQzJW","level":"a0-les-petits","lesson":23,"part":2,"type":"text","name":"ab-kids-l23-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎂</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A cake with five candles and the number 5</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234591,"_nanoseconds":370000000}},{"id":"VNuyHoVlL1PVFeFE6gtX","level":"a0-les-petits","lesson":23,"part":2,"type":"text","name":"ab-kids-l23-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To ask someone's age, say tu as quel âge. To answer, say j'ai, then your number, then ans. Quel âge, j'ai cinq ans.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tu as quel âge ?</b><span style=\"opacity:.7;\"> · How old are you?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai cinq ans.</b><span style=\"opacity:.7;\"> · I'm five years old.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai sept ans.</b><span style=\"opacity:.7;\"> · I'm seven years old.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234591,"_nanoseconds":611000000}},{"id":"slG8D8tbPMwOIunkvcBL","level":"a0-les-petits","lesson":23,"part":3,"type":"text","name":"ab-kids-l23-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu as quel âge ?</b></p><p style=\"opacity:.75;margin:0;\">How old are you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu as quel âge ?","size":null,"created":{"_seconds":1793234591,"_nanoseconds":639000000}},{"id":"DESmkqVNIN6CrhqdN7s0","level":"a0-les-petits","lesson":23,"part":4,"type":"text","name":"ab-kids-l23-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai cinq ans.</b></p><p style=\"opacity:.75;margin:0;\">I'm five years old.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai cinq ans.","size":null,"created":{"_seconds":1793234591,"_nanoseconds":684000000}},{"id":"NyVDCyoUA2k5K0jHBYXe","level":"a0-les-petits","lesson":23,"part":5,"type":"text","name":"ab-kids-l23-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai sept ans.</b></p><p style=\"opacity:.75;margin:0;\">I'm seven years old.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai sept ans.","size":null,"created":{"_seconds":1793234591,"_nanoseconds":792000000}},{"id":"1BnBXnlAQ8XnjBFNJkj5","level":"a0-les-petits","lesson":23,"part":6,"type":"text","name":"ab-kids-l23-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Nina. And you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Ça va, Sacha ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How are you, Sacha?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'ai cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm five.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi, j'ai six ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm six.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tu as un frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a brother?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oui, il a dix ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, he's ten.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234592,"_nanoseconds":26000000}},{"id":"dOLjYGMRDbAI3DuINqC5","level":"a0-les-petits","lesson":23,"part":7,"type":"text","name":"ab-kids-l23-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! My name is Nina. And you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234592,"_nanoseconds":30000000}},{"id":"TWPOntXiHroMdBXYopPM","level":"a0-les-petits","lesson":23,"part":8,"type":"text","name":"ab-kids-l23-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Ça va, Sacha ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How are you, Sacha?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234592,"_nanoseconds":99000000}},{"id":"D4MQsuyc7UG1QnNp9ulm","level":"a0-les-petits","lesson":23,"part":9,"type":"text","name":"ab-kids-l23-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu as quel âge ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How old are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'ai cinq ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm five.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'ai cinq ans.","size":null,"created":{"_seconds":1793234592,"_nanoseconds":179000000}},{"id":"UuB8GzBuG2bokF0cxmG3","level":"a0-les-petits","lesson":23,"part":10,"type":"text","name":"ab-kids-l23-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi, j'ai six ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm six.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tu as un frère ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a brother?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Tu as un frère ?","size":null,"created":{"_seconds":1793234592,"_nanoseconds":431000000}},{"id":"NVBTvcfhV4kmLAlo0mJb","level":"a0-les-petits","lesson":23,"part":11,"type":"text","name":"ab-kids-l23-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oui, il a dix ans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, he's ten.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Super !","size":null,"created":{"_seconds":1793234592,"_nanoseconds":437000000}},{"id":"dskCMXe0jyMnupaJpNXu","level":"a0-les-petits","lesson":23,"part":12,"type":"text","name":"ab-kids-l23-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Tu as quel âge ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">How old are you?</p><p><b>Say your age, and ask the teacher.</b></p><p style=\"opacity:.7;\">For example: “J'ai six ans. Et toi ?”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai six ans. Et toi ?","size":null,"created":{"_seconds":1793234592,"_nanoseconds":489000000}},{"id":"suihJgH3YjcRhD0X7uiw","level":"a0-les-petits","lesson":23,"part":13,"type":"text","name":"ab-kids-l23-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎂</div><p><b>Age unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say your age with j'ai ... ans, and ask tu as quel âge.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234592,"_nanoseconds":584000000}}]