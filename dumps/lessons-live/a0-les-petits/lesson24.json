[{"id":"63r0yV1U6KlHcFmtR7fZ","level":"a0-les-petits","lesson":24,"part":1,"type":"text","name":"ab-kids-l24-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today there's a party! It's a friend's birthday and you're invited. You'll greet, wish a happy birthday, give a present, and say how old they are. Happy birthday in French is joyeux anniversaire.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234592,"_nanoseconds":826000000}},{"id":"to7hkkL5ie3j84O4sKtS","level":"a0-les-petits","lesson":24,"part":2,"type":"text","name":"ab-kids-l24-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎉</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A birthday table: cake, a blue present, balloons</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234592,"_nanoseconds":872000000}},{"id":"tuaHsezf7StoXNBCGhUj","level":"a0-les-petits","lesson":24,"part":2,"type":"text","name":"ab-kids-l24-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Joyeux anniversaire means happy birthday. Un gâteau is a cake. Un cadeau is a present. Une bougie is a candle. And voici pour toi means 'here's something for you'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Joyeux anniversaire !</b><span style=\"opacity:.7;\"> · Happy birthday!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un gâteau</b><span style=\"opacity:.7;\"> · A cake</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un cadeau</b><span style=\"opacity:.7;\"> · A present</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Voici un cadeau pour toi.</b><span style=\"opacity:.7;\"> · Here's a present for you.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234592,"_nanoseconds":933000000}},{"id":"DHTxnc0ufRL1rGK3lMV8","level":"a0-les-petits","lesson":24,"part":3,"type":"text","name":"ab-kids-l24-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Joyeux anniversaire !</b></p><p style=\"opacity:.75;margin:0;\">Happy birthday!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Joyeux anniversaire !","size":null,"created":{"_seconds":1793234592,"_nanoseconds":984000000}},{"id":"OkTwCK1wFUZ2x0Y5hkG2","level":"a0-les-petits","lesson":24,"part":4,"type":"text","name":"ab-kids-l24-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un gâteau</b></p><p style=\"opacity:.75;margin:0;\">A cake</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un gâteau","size":null,"created":{"_seconds":1793234593,"_nanoseconds":232000000}},{"id":"gargFLDA9ZVqJEkWbDTz","level":"a0-les-petits","lesson":24,"part":5,"type":"text","name":"ab-kids-l24-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un cadeau</b></p><p style=\"opacity:.75;margin:0;\">A present</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Un cadeau","size":null,"created":{"_seconds":1793234593,"_nanoseconds":267000000}},{"id":"VErWC9reXjMVPMkYY6Sl","level":"a0-les-petits","lesson":24,"part":6,"type":"text","name":"ab-kids-l24-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Voici un cadeau pour toi.</b></p><p style=\"opacity:.75;margin:0;\">Here's a present for you.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Voici un cadeau pour toi.","size":null,"created":{"_seconds":1793234593,"_nanoseconds":346000000}},{"id":"rtAxr7OM6gKqFkUdUqsQ","level":"a0-les-petits","lesson":24,"part":7,"type":"text","name":"ab-kids-l24-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va très bien ! Joyeux anniversaire !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very good! Happy birthday!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci ! J'ai six ans aujourd'hui.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! I'm six today.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voici un cadeau pour toi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here's a present for you.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Oh, un cadeau bleu ! Merci !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, a blue present! Thank you!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>De rien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu veux du gâteau ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want some cake?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, s'il te plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci ! J'aime le gâteau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks! I like cake.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234593,"_nanoseconds":394000000}},{"id":"qhDVXGyqdqKsz713SVEa","level":"a0-les-petits","lesson":24,"part":8,"type":"text","name":"ab-kids-l24-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va très bien ! Joyeux anniversaire !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm very good! Happy birthday!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va très bien ! Joyeux anniversaire !","size":null,"created":{"_seconds":1793234593,"_nanoseconds":629000000}},{"id":"OmEqU5RZpWVbOU9E3MAc","level":"a0-les-petits","lesson":24,"part":9,"type":"text","name":"ab-kids-l24-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Merci ! J'ai six ans aujourd'hui.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you! I'm six today.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Voici un cadeau pour toi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here's a present for you.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Voici un cadeau pour toi.","size":null,"created":{"_seconds":1793234593,"_nanoseconds":661000000}},{"id":"s9HyrVssVgDOdI9BZCMv","level":"a0-les-petits","lesson":24,"part":10,"type":"text","name":"ab-kids-l24-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Oh, un cadeau bleu ! Merci !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Oh, a blue present! Thank you!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">De rien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"De rien !","size":null,"created":{"_seconds":1793234593,"_nanoseconds":762000000}},{"id":"qXEl2cITXe9v8034PHTK","level":"a0-les-petits","lesson":24,"part":11,"type":"text","name":"ab-kids-l24-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu veux du gâteau ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want some cake?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, s'il te plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, please.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, s'il te plaît.","size":null,"created":{"_seconds":1793234593,"_nanoseconds":789000000}},{"id":"9kmrKCEZfj4aXOADZP4y","level":"a0-les-petits","lesson":24,"part":12,"type":"text","name":"ab-kids-l24-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Merci ! J'aime le gâteau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks! I like cake.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Merci ! J'aime le gâteau.","size":null,"created":{"_seconds":1793234594,"_nanoseconds":284000000}},{"id":"19B11ORyKCSLJR511czS","level":"a0-les-petits","lesson":24,"part":13,"type":"text","name":"ab-kids-l24-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>C'est mon anniversaire ! Qu'est-ce que tu dis ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">It's my birthday! What do you say?</p><p><b>Wish happy birthday and offer a present.</b></p><p style=\"opacity:.7;\">For example: “Joyeux anniversaire ! Voici un cadeau pour toi.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Joyeux anniversaire ! Voici un cadeau pour toi.","size":null,"created":{"_seconds":1793234594,"_nanoseconds":330000000}},{"id":"XMg5CZNFdUPU6YkGH0oA","level":"a0-les-petits","lesson":24,"part":14,"type":"text","name":"ab-kids-l24-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎉</div><p><b>Party time!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can go to a French birthday party: you know how to greet, give a present, and say thank you.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234594,"_nanoseconds":433000000}}]