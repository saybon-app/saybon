[{"id":"1UtLygxiKSd2pcOxYkV5","level":"a0-les-petits","lesson":12,"part":1,"type":"text","name":"ab-kids-l12-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today's challenge: say what you like and what you don't. It's a very useful sentence, because friends love to talk about this. J'aime means 'I like'. Je n'aime pas means 'I don't like'.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234573,"_nanoseconds":968000000}},{"id":"GN8RlwTh12YFh1Lo9sge","level":"a0-les-petits","lesson":12,"part":2,"type":"text","name":"ab-kids-l12-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👍</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A smiling strawberry and a grumpy banana facing each other</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234574,"_nanoseconds":163000000}},{"id":"N3n9468bt4thUDo3LITH","level":"a0-les-petits","lesson":12,"part":2,"type":"text","name":"ab-kids-l12-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 J'aime is 'I like'. Je n'aime pas is 'I don't like'. You can use it with fruits, animals, colours, anything we have learned!</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'aime les fraises.</b><span style=\"opacity:.7;\"> · I like strawberries.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je n'aime pas les bananes.</b><span style=\"opacity:.7;\"> · I don't like bananas.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'aime le bleu.</b><span style=\"opacity:.7;\"> · I like blue.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234574,"_nanoseconds":218000000}},{"id":"RYy0Op7evwgeRAG0gtpn","level":"a0-les-petits","lesson":12,"part":3,"type":"text","name":"ab-kids-l12-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'aime les fraises.</b></p><p style=\"opacity:.75;margin:0;\">I like strawberries.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'aime les fraises.","size":null,"created":{"_seconds":1793234574,"_nanoseconds":343000000}},{"id":"geDFdS92CzfTfU1Z9Uxo","level":"a0-les-petits","lesson":12,"part":4,"type":"text","name":"ab-kids-l12-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je n'aime pas les bananes.</b></p><p style=\"opacity:.75;margin:0;\">I don't like bananas.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je n'aime pas les bananes.","size":null,"created":{"_seconds":1793234574,"_nanoseconds":359000000}},{"id":"jHp2pxYrgI6dHvYTFAw1","level":"a0-les-petits","lesson":12,"part":5,"type":"text","name":"ab-kids-l12-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'aime le bleu.</b></p><p style=\"opacity:.75;margin:0;\">I like blue.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'aime le bleu.","size":null,"created":{"_seconds":1793234574,"_nanoseconds":564000000}},{"id":"vCC3yGudBE8T4QBsON1A","level":"a0-les-petits","lesson":12,"part":6,"type":"text","name":"ab-kids-l12-p06-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu aimes les fraises ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like strawberries?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'aime les fraises !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like strawberries!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et les bananes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And bananas?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Non, je n'aime pas les bananes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't like bananas.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu aimes quelle couleur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which colour do you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime le bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like blue.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Moi aussi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234574,"_nanoseconds":637000000}},{"id":"gdnn1sFP73jT0A5xBJUF","level":"a0-les-petits","lesson":12,"part":7,"type":"text","name":"ab-kids-l12-p07-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234574,"_nanoseconds":742000000}},{"id":"nk2NU5ERiyWA1C3R4jGB","level":"a0-les-petits","lesson":12,"part":8,"type":"text","name":"ab-kids-l12-p08-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu aimes les fraises ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you like strawberries?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'aime les fraises !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I like strawberries!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'aime les fraises !","size":null,"created":{"_seconds":1793234574,"_nanoseconds":791000000}},{"id":"fINTSupC6MJVeIghVOTV","level":"a0-les-petits","lesson":12,"part":9,"type":"text","name":"ab-kids-l12-p09-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et les bananes ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And bananas?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Non, je n'aime pas les bananes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">No, I don't like bananas.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Non, je n'aime pas les bananes.","size":null,"created":{"_seconds":1793234574,"_nanoseconds":971000000}},{"id":"HfoeUC4mgWulY8iNEN2o","level":"a0-les-petits","lesson":12,"part":10,"type":"text","name":"ab-kids-l12-p10-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu aimes quelle couleur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which colour do you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime le bleu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like blue.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime le bleu.","size":null,"created":{"_seconds":1793234575,"_nanoseconds":32000000}},{"id":"oXgYlXnTEEyyYEahcRyV","level":"a0-les-petits","lesson":12,"part":11,"type":"text","name":"ab-kids-l12-p11-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Moi aussi !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Me too!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Super !","size":null,"created":{"_seconds":1793234575,"_nanoseconds":167000000}},{"id":"JA3pvbvwdS52BwVPBE1G","level":"a0-les-petits","lesson":12,"part":12,"type":"text","name":"ab-kids-l12-p12-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Tu aimes quoi ? Tu n'aimes pas quoi ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What do you like? What don't you like?</p><p><b>Say one thing you like and one you don't.</b></p><p style=\"opacity:.7;\">For example: “J'aime les chiens. Je n'aime pas les poissons.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'aime les chiens. Je n'aime pas les poissons.","size":null,"created":{"_seconds":1793234575,"_nanoseconds":204000000}},{"id":"F1UQXkcGZjW3L0hmK1Xg","level":"a0-les-petits","lesson":12,"part":13,"type":"text","name":"ab-kids-l12-p13-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👍</div><p><b>Opinions unlocked!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 J'aime and je n'aime pas let you say what you think. You can use them with everything you know.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234575,"_nanoseconds":392000000}}]