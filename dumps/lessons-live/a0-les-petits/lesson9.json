[{"id":"cYg335S2NaMgW3mVnTfN","level":"a0-les-petits","lesson":9,"part":1,"type":"text","name":"ab-kids-l09-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we talk about pets. Do you have a cat? A dog? You'll learn to say j'ai, which means 'I have', and to describe your pet with a colour. New words: le chat, le chien, le poisson, l'oiseau.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234569,"_nanoseconds":137000000}},{"id":"obXwUQBFyLf3mBYqgfKv","level":"a0-les-petits","lesson":9,"part":2,"type":"text","name":"ab-kids-l09-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🐾</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A black cat, a dog, a goldfish bowl and a bird on a windowsill</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234569,"_nanoseconds":317000000}},{"id":"pUIrpYhA1NP3gxl8nzn5","level":"a0-les-petits","lesson":9,"part":2,"type":"text","name":"ab-kids-l09-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Le chat is the cat. Le chien is the dog. Le poisson is the fish. L'oiseau is the bird. To say 'I have', say j'ai. To ask 'do you have?', say tu as.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le chat</b><span style=\"opacity:.7;\"> · The cat</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le chien</b><span style=\"opacity:.7;\"> · The dog</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai un chat.</b><span style=\"opacity:.7;\"> · I have a cat.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Tu as un animal ?</b><span style=\"opacity:.7;\"> · Do you have a pet?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234569,"_nanoseconds":339000000}},{"id":"NX9IvaDirbTq90sqF4ST","level":"a0-les-petits","lesson":9,"part":3,"type":"text","name":"ab-kids-l09-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le chat</b></p><p style=\"opacity:.75;margin:0;\">The cat</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le chat","size":null,"created":{"_seconds":1793234569,"_nanoseconds":366000000}},{"id":"7JwlJgrl75ruLiEdWWmC","level":"a0-les-petits","lesson":9,"part":4,"type":"text","name":"ab-kids-l09-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le chien</b></p><p style=\"opacity:.75;margin:0;\">The dog</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Le chien","size":null,"created":{"_seconds":1793234569,"_nanoseconds":540000000}},{"id":"ai4SMcZTG63vw2maEZKf","level":"a0-les-petits","lesson":9,"part":5,"type":"text","name":"ab-kids-l09-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai un chat.</b></p><p style=\"opacity:.75;margin:0;\">I have a cat.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"J'ai un chat.","size":null,"created":{"_seconds":1793234569,"_nanoseconds":717000000}},{"id":"3bijqNZ8W0Bp11JA9dUU","level":"a0-les-petits","lesson":9,"part":6,"type":"text","name":"ab-kids-l09-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Tu as un animal ?</b></p><p style=\"opacity:.75;margin:0;\">Do you have a pet?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Tu as un animal ?","size":null,"created":{"_seconds":1793234569,"_nanoseconds":748000000}},{"id":"DRVLFceYpO33aslJgy9a","level":"a0-les-petits","lesson":9,"part":7,"type":"text","name":"ab-kids-l09-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as un animal ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a pet?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, j'ai un chat !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a cat!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il est de quelle couleur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What colour is he?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il est noir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is black.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Il s'appelle comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What's his name?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il s'appelle Pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">His name is Pomme.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>J'ai deux poissons rouges !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have two goldfish!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234569,"_nanoseconds":765000000}},{"id":"apc1hOw4VtoXrrjVKAeP","level":"a0-les-petits","lesson":9,"part":8,"type":"text","name":"ab-kids-l09-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234569,"_nanoseconds":945000000}},{"id":"JR63igmyeHpuTuof8ZLz","level":"a0-les-petits","lesson":9,"part":9,"type":"text","name":"ab-kids-l09-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu as un animal ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you have a pet?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, j'ai un chat !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, I have a cat!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Oui, j'ai un chat !","size":null,"created":{"_seconds":1793234570,"_nanoseconds":129000000}},{"id":"m7F3l7ViQ3HbgvGidlW8","level":"a0-les-petits","lesson":9,"part":10,"type":"text","name":"ab-kids-l09-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il est de quelle couleur ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What colour is he?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il est noir.</b><br><span style=\"opacity:.7;font-size:.9rem;\">He is black.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il est noir.","size":null,"created":{"_seconds":1793234570,"_nanoseconds":162000000}},{"id":"6GjlyJAgm50XmC2REx2Q","level":"a0-les-petits","lesson":9,"part":11,"type":"text","name":"ab-kids-l09-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Il s'appelle comment ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What's his name?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il s'appelle Pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">His name is Pomme.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il s'appelle Pomme.","size":null,"created":{"_seconds":1793234570,"_nanoseconds":172000000}},{"id":"5TF5IsHsoSsNEW9W9dJH","level":"a0-les-petits","lesson":9,"part":12,"type":"text","name":"ab-kids-l09-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>J'ai deux poissons rouges !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have two goldfish!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Super !","size":null,"created":{"_seconds":1793234570,"_nanoseconds":340000000}},{"id":"GFeCUZzGubXhXCdMsmyV","level":"a0-les-petits","lesson":9,"part":13,"type":"text","name":"ab-kids-l09-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Tu as un animal ? Il est comment ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Do you have a pet? What's it like?</p><p><b>Say what animal you have (or want) and its colour.</b></p><p style=\"opacity:.7;\">For example: “J'ai un chien. Il est blanc.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"J'ai un chien. Il est blanc.","size":null,"created":{"_seconds":1793234570,"_nanoseconds":540000000}},{"id":"zDmpjTUUPtEPCdtSWNqW","level":"a0-les-petits","lesson":9,"part":14,"type":"text","name":"ab-kids-l09-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🐾</div><p><b>Pet club member!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Now you can talk about pets: j'ai un chat, il est noir, il s'appelle Pomme.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234570,"_nanoseconds":569000000}}]