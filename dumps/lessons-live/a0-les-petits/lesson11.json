n say it!","expectedText":"Je voudrais une pomme.","size":null,"created":{"_seconds":1793234572,"_nanoseconds":884000000}},{"id":"6czFBUdrj906POPFhl50","level":"a0-les-petits","lesson":11,"part":6,"type":"text","name":"ab-kids-l11-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Voilà !</b></p><p style=\"opacity:.75;margin:0;\">Here you go!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Voilà !","size":null,"created":{"_seconds":1793234573,"_nanoseconds":47000000}},{"id":"wuS8p8fBW6Dg6AQP4TOR","level":"a0-les-petits","lesson":11,"part":7,"type":"text","name":"ab-kids-l11-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Très bien. Qu'est-ce que tu veux ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Very good. What do you want?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je voudrais une pomme.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I would like an apple.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Rouge ou verte ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red or green?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Rouge !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Red!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà ! Combien ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go! How many?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Deux pommes.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Two apples.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et une banane ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And a banana?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, une banane.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a banana.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234573,"_nanoseconds":68000000}},{"id":"x52z6nvKHTEkIdz1Az6H","level":"a0-les-petits","lesson":11,"part":8,"type":"text","name":"ab-kids-l11-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien ! Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good! And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien ! Et toi ?","size":null,"created":{"_seconds":1793234573,"_nanoseconds":277000000}},{"id":"KWg8TUEsEg0Cf4f5VkWV","level":"a0-les-petits","lesson":11,"part":9,"type":"text","name":"ab-kids-l11-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Très bien. Qu'est-ce que tu v