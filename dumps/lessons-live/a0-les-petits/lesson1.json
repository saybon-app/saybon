[{"id":"XQSSXCrkv3wIpbhYw4J4","level":"a0-les-petits","lesson":1,"part":1,"type":"text","name":"ab-kids-l01-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello, and welcome! Today you're going to say hello in French. It's the very first thing you'll ever say to a French friend, so let's make it a good one. First you'll hear a tiny conversation. Then you'll say the lines yourself. Ready? Let's go!</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234555,"_nanoseconds":957000000}},{"id":"6kYD4CvBvg7nbLBSdeYv","level":"a0-les-petits","lesson":1,"part":2,"type":"text","name":"ab-kids-l01-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">👋</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A child waving at a friendly teacher at a sunny front door</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234555,"_nanoseconds":909000000}},{"id":"ORwKFgIqk5JeOSuAlHvc","level":"a0-les-petits","lesson":1,"part":2,"type":"text","name":"ab-kids-l01-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 In French, 'hello' is bonjour. 'Hi' is salut, and it's what you say to friends. 'Goodbye' is au revoir. Say them after me.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Bonjour !</b><span style=\"opacity:.7;\"> · Hello!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Salut !</b><span style=\"opacity:.7;\"> · Hi!</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Au revoir !</b><span style=\"opacity:.7;\"> · Goodbye!</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234556,"_nanoseconds":22000000}},{"id":"JKzpbyIwxm9tkVCLb2ax","level":"a0-les-petits","lesson":1,"part":3,"type":"text","name":"ab-kids-l01-p03-b1","partTitle":"Say it 1/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Bonjour !</b></p><p style=\"opacity:.75;margin:0;\">Hello!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Bonjour !","size":null,"created":{"_seconds":1793234555,"_nanoseconds":872000000}},{"id":"MdL9RlBdIhwWOF9Nki1I","level":"a0-les-petits","lesson":1,"part":4,"type":"text","name":"ab-kids-l01-p04-b1","partTitle":"Say it 2/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Salut !</b></p><p style=\"opacity:.75;margin:0;\">Hi!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Salut !","size":null,"created":{"_seconds":1793234556,"_nanoseconds":360000000}},{"id":"DI3lvpV17Xu19w1wtD1u","level":"a0-les-petits","lesson":1,"part":5,"type":"text","name":"ab-kids-l01-p05-b1","partTitle":"Say it 3/3","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Au revoir !</b></p><p style=\"opacity:.75;margin:0;\">Goodbye!</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793234556,"_nanoseconds":383000000}},{"id":"ymh57c6Ypr4Ssb53fpdX","level":"a0-les-petits","lesson":1,"part":6,"typ