[{"id":"ifVTGgxxqpPKpye5XNFe","level":"a0-les-petits","lesson":7,"part":1,"type":"text","name":"ab-kids-l07-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we play a game like Simon Says. I tell you to touch a part of your body, and you say it out loud. We'll start with a greeting, then add body parts: la tête, le nez, la bouche, les mains, les pieds. Ready to move?</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234565,"_nanoseconds":588000000}},{"id":"L6Vu0zHWbTImfajEqmiL","level":"a0-les-petits","lesson":7,"part":2,"type":"text","name":"ab-kids-l07-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🕺</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A child pointing to their nose, head and hands in a playful pose</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234565,"_nanoseconds":616000000}},{"id":"73VJYnFj8NCXxr8hE5ro","level":"a0-les-petits","lesson":7,"part":2,"type":"text","name":"ab-kids-l07-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Let's name them. La tête is the head. Le nez is the nose. La bouche is the mouth. Les mains are the hands. Les pieds are the feet. Touch each one as you say it.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,25