[{"id":"BjwBSon0qsImM9CLrigS","level":"a0-les-petits","lesson":20,"part":1,"type":"text","name":"ab-kids-l20-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we learn the magic words. Please, thank you, you're welcome, sorry. They make everything smoother, in any language. They also make people smile.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234586,"_nanoseconds":626000000}},{"id":"4U6YkdWI60h8vqOdLJ0w","level":"a0-les-petits","lesson":20,"part":2,"type":"text","name":"ab-kids-l20-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗝️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A golden key with the words please, thank you, you're welcome, sorry on its tag</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234586,"_nanoseconds":721000000}},{"id":"AU2VX9xyMtek5QLW4x2T","level":"a0-les-petits","lesson":20,"part":2,"type":"text","name":"ab-kids-l20-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 S'il te plaît means please, when you're talking to a friend. Merci means thank you. De rien means you're welcome. Pardon means sorry, or excuse me.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>S'il te plaît</b><span style=\"opacity:.7;\"> · Please</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Merci</b><span style=\"opacity:.7;\"> · Thank you</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>De rien</b><span style=\"opacity:.7;\"> · You're welcome</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pardon</b><span style=\"opacity:.7;\"> · Sorry</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234586,"_nanoseconds":818000000}},{"id":"DtuLA5rDMhcinrvYkKpB","level":"a0-les-petits","lesson":20,"part":3,"type":"text","name":"ab-kids-l20-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>S'il te plaît</b></p><p style=\"opacity:.75;margin:0;\">Please</p></div>","recordPrompt":"Listen, then say it!","expectedText":"S'il te plaît","size":null,"created":{"_seconds":1793234586,"_nanoseconds":920000000}},{"id":"XPgULGiNeKrel7sVDZsz","level":"a0-les-petits","lesson":20,"part":4,"type":"text","name":"ab-kids-l20-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Merci</b></p><p style=\"opacity:.75;margin:0;\">Thank you</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Merci","size":null,"created":{"_seconds":1793234587,"_nanoseconds":30000000}},{"id":"pf5MZo0UCXRKLGV6LdKn","level":"a0-les-petits","lesson":20,"part":5,"type":"text","name":"ab-kids-l20-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>De rien</b></p><p style=\"opacity:.75;margin:0;\">You're welcome</p></div>","recordPrompt":"Listen, then say it!","expectedText":"De rien","size":null,"created":{"_seconds":1793234587,"_nanoseconds":125000000}},{"id":"SrVm0lHp4ZtGT4Opo3Oa","level":"a0-les-petits","lesson":20,"part":6,"type":"text","name":"ab-kids-l20-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pardon</b></p><p style=\"opacity:.75;margin:0;\">Sorry</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Pardon","size":null,"created":{"_seconds":1793234587,"_nanoseconds":224000000}},{"id":"eWcz9CSMtNVBsJNS4qvw","level":"a0-les-petits","lesson":20,"part":7,"type":"text","name":"ab-kids-l20-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu veux un fruit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want a fruit?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, une fraise, s'il te plaît.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, a strawberry, please.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Voilà !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Here you go!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Merci !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thank you!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>De rien ! Oups, pardon, j'ai cassé ton crayon.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're welcome! Oops, sorry, I broke your pencil.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce n'est pas grave.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's okay.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Merci ! Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Thanks! Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234587,"_nanoseconds":323000000}},{"id":"eVtAyeX6F4EkAMxJb0hv","level":"a0-les-petits","lesson":20,"part":8,"type":"text","name":"ab-kids-l20-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Salut ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234587,"_nanoseconds":415000000}},{"id":"SuExtU858nGX7xbrCEna","level":"a0-les-petits","lesson":20,"part":9,"type":"text","name":"ab-kids-l20-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu veux un fruit ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you want a fruit?</span></p><p style=\"margin:12px 0 0;t