[{"id":"nGT8yEdrlsk2RSpAOkT9","level":"a0-les-petits","lesson":17,"part":1,"type":"text","name":"ab-kids-l17-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Hello! Today we learn the days of the week, with a little rhythm to help you. Lundi, mardi, mercredi, jeudi, vendredi, samedi, dimanche. Don't worry about saying them fast. We'll go slowly, then bit by bit faster.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234581,"_nanoseconds":850000000}},{"id":"6aTkivBe9NmkviTHeAhh","level":"a0-les-petits","lesson":17,"part":2,"type":"text","name":"ab-kids-l17-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📅</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">A big colourful weekly calendar with a different animal for each day</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234581,"_nanoseconds":893000000}},{"id":"fxqTZU3L7qSlVBFsG2oL","level":"a0-les-petits","lesson":17,"part":2,"type":"text","name":"ab-kids-l17-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Lundi, mardi, mercredi, jeudi, vendredi, samedi, dimanche. Clap on every day if you like. And to ask what day it is, you say on est quel jour.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Lundi, mardi, mercredi</b><span style=\"opacity:.7;\"> · Monday, Tuesday, Wednesday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Jeudi, vendredi</b><span style=\"opacity:.7;\"> · Thursday, Friday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Samedi, dimanche</b><span style=\"opacity:.7;\"> · Saturday, Sunday</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On est quel jour ?</b><span style=\"opacity:.7;\"> · What day is it?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234581,"_nanoseconds":907000000}},{"id":"fSgSzuKlyKtUJ3RdVfUa","level":"a0-les-petits","lesson":17,"part":3,"type":"text","name":"ab-kids-l17-p03-b1","partTitle":"Say it 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Lundi, mardi, mercredi</b></p><p style=\"opacity:.75;margin:0;\">Monday, Tuesday, Wednesday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Lundi, mardi, mercredi","size":null,"created":{"_seconds":1793234581,"_nanoseconds":954000000}},{"id":"9oCZm8Zi8xjJNgRDJRb4","level":"a0-les-petits","lesson":17,"part":4,"type":"text","name":"ab-kids-l17-p04-b1","partTitle":"Say it 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Jeudi, vendredi</b></p><p style=\"opacity:.75;margin:0;\">Thursday, Friday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Jeudi, vendredi","size":null,"created":{"_seconds":1793234582,"_nanoseconds":255000000}},{"id":"vFjn4oihjOwhVX4ptRLm","level":"a0-les-petits","lesson":17,"part":5,"type":"text","name":"ab-kids-l17-p05-b1","partTitle":"Say it 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Samedi, dimanche</b></p><p style=\"opacity:.75;margin:0;\">Saturday, Sunday</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Samedi, dimanche","size":null,"created":{"_seconds":1793234582,"_nanoseconds":287000000}},{"id":"8qA2Sk31kh75PELy4gMm","level":"a0-les-petits","lesson":17,"part":6,"type":"text","name":"ab-kids-l17-p06-b1","partTitle":"Say it 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On est quel jour ?</b></p><p style=\"opacity:.75;margin:0;\">What day is it?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"On est quel jour ?","size":null,"created":{"_seconds":1793234582,"_nanoseconds":321000000}},{"id":"Omilsk7GTgHixAnGAM6S","level":"a0-les-petits","lesson":17,"part":7,"type":"text","name":"ab-kids-l17-p07-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>On est quel jour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What day is it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>On est lundi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's Monday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And tomorrow?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Demain, c'est mardi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tomorrow is Tuesday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu aimes quel jour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which day do you like?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aime le samedi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like Saturday.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Il n'y a pas d'école !</b><br><span style=\"opacity:.7;font-size:.9rem;\">There's no school!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234582,"_nanoseconds":360000000}},{"id":"tqqLEVJSI8wEfRmcy0pX","level":"a0-les-petits","lesson":17,"part":8,"type":"text","name":"ab-kids-l17-p08-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour ! Ça va ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello! How are you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ça va bien !</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm good!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Ça va bien !","size":null,"created":{"_seconds":1793234582,"_nanoseconds":667000000}},{"id":"zJw1kfmhTvg18H5Up0A9","level":"a0-les-petits","lesson":17,"part":9,"type":"text","name":"ab-kids-l17-p09-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>On est quel jour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What day is it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">On est lundi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's Monday.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"On est lundi.","size":null,"created":{"_seconds":1793234582,"_nanoseconds":685000000}},{"id":"ZMn0Ur7r4Xj9PqupeCKd","level":"a0-les-petits","lesson":17,"part":10,"type":"text","name":"ab-kids-l17-p10-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et demain ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And tomorrow?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Demain, c'est mardi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Tomorrow is Tuesday.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Demain, c'est mardi.","size":null,"created":{"_seconds":1793234582,"_nanoseconds":721000000}},{"id":"CJrvVyTcalEyMuscFxhe","level":"a0-les-petits","lesson":17,"part":11,"type":"text","name":"ab-kids-l17-p11-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu aimes quel jour ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Which day do you like?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aime le samedi.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I like Saturday.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"J'aime le samedi.","size":null,"created":{"_seconds":1793234582,"_nanoseconds":759000000}},{"id":"MK4fHvXm7ARl4c2GrOgh","level":"a0-les-petits","lesson":17,"part":12,"type":"text","name":"ab-kids-l17-p12-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Il n'y a pas d'école !</b><br><span style=\"opacity:.7;font-size:.9rem;\">There's no school!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Il n'y a pas d'école !","size":null,"created":{"_seconds":1793234583,"_nanoseconds":386000000}},{"id":"KrNLZYTrNiluSuMndNHL","level":"a0-les-petits","lesson":17,"part":13,"type":"text","name":"ab-kids-l17-p13-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>On est quel jour ? Tu aimes quel jour ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">What day is it? Which day do you like?</p><p><b>Say a day and the day you like best.</b></p><p style=\"opacity:.7;\">For example: “On est mercredi. J'aime le dimanche.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"On est mercredi. J'aime le dimanche.","size":null,"created":{"_seconds":1793234583,"_nanoseconds":339000000}},{"id":"2OyoQkeN5uVpBFdPYh9t","level":"a0-les-petits","lesson":17,"part":14,"type":"text","name":"ab-kids-l17-p14-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📅</div><p><b>Week complete!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can say the seven days, and answer on est quel jour.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234583,"_nanoseconds":400000000}}]