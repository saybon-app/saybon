[{"id":"Bk8wWOup7HZ6OYkwGxsc","level":"a0-les-petits","lesson":2,"part":1,"type":"text","name":"ab-kids-l02-p01-b1","partTitle":"Teacher intro","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Teacher intro · video</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Welcome back! Last time you said hello. Today, your friend wants to know your name. We'll keep our hellos, and add one new sentence: 'My name is'. You'll say your own name at the end, so get ready!</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234557,"_nanoseconds":247000000}},{"id":"6q7WDfs4lySvMg4Z4qep","level":"a0-les-petits","lesson":2,"part":2,"type":"text","name":"ab-kids-l02-p02-b1","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🏷️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Picture to come</p><p style=\"opacity:.8;\">Two name badges on a table: 'Nina' and a blank one waiting to be filled</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234557,"_nanoseconds":344000000}},{"id":"STvhJBTY9wtebGBIDIO4","level":"a0-les-petits","lesson":2,"part":2,"type":"text","name":"ab-kids-l02-p02-b2","partTitle":"New words","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 To say your name, you say je m'appelle, then your name. And to ask back, you say et toi, which means 'and you?'.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je m'appelle Sacha.</b><span style=\"opacity:.7;\"> · My name is Sacha.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Et toi ?</b><span style=\"opacity:.7;\"> · And you?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234557,"_nanoseconds":405000000}},{"id":"0YAGNPIohCCuceBB3lML","level":"a0-les-petits","lesson":2,"part":3,"type":"text","name":"ab-kids-l02-p03-b1","partTitle":"Say it 1/2","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je m'appelle Sacha.</b></p><p style=\"opacity:.75;margin:0;\">My name is Sacha.</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234557,"_nanoseconds":688000000}},{"id":"7zMcJhTtfYWfBPHQGMZ1","level":"a0-les-petits","lesson":2,"part":4,"type":"text","name":"ab-kids-l02-p04-b1","partTitle":"Say it 2/2","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Et toi ?</b></p><p style=\"opacity:.75;margin:0;\">And you?</p></div>","recordPrompt":"Listen, then say it!","expectedText":"Et toi ?","size":null,"created":{"_seconds":1793234557,"_nanoseconds":761000000}},{"id":"F3RjeHRPpIkBoPHhQFFM","level":"a0-les-petits","lesson":2,"part":5,"type":"text","name":"ab-kids-l02-p05-b1","partTitle":"Listen to the conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Read and listen to the whole conversation first. You play the “You” part next.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina. And you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And you?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je m'appelle Nina !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Salut Nina !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi Nina!</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234557,"_nanoseconds":831000000}},{"id":"5EwAOfXYAU9CgJEx8UtS","level":"a0-les-petits","lesson":2,"part":6,"type":"text","name":"ab-kids-l02-p06-b1","partTitle":"Your turn 1/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Bonjour !","size":null,"created":{"_seconds":1793234558,"_nanoseconds":2000000}},{"id":"bzETOpq1NOuZ7ChqeH59","level":"a0-les-petits","lesson":2,"part":7,"type":"text","name":"ab-kids-l02-p07-b1","partTitle":"Your turn 2/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Nina. Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina. And you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je m'appelle Sacha.</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Sacha.</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234558,"_nanoseconds":149000000}},{"id":"E6aXGfu49YBADIeCOsMV","level":"a0-les-petits","lesson":2,"part":8,"type":"text","name":"ab-kids-l02-p08-b1","partTitle":"Your turn 3/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Super !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Great!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Et toi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And you?</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Et toi ?","size":null,"created":{"_seconds":1793234558,"_nanoseconds":186000000}},{"id":"AK09uuxUgfzTLhE9sHJc","level":"a0-les-petits","lesson":2,"part":9,"type":"text","name":"ab-kids-l02-p09-b1","partTitle":"Your turn 4/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je m'appelle Nina !</b><br><span style=\"opacity:.7;font-size:.9rem;\">My name is Nina!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Salut Nina !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hi Nina!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Salut Nina !","size":null,"created":{"_seconds":1793234558,"_nanoseconds":284000000}},{"id":"WhZzMGb9MiIU6MH3CP4j","level":"a0-les-petits","lesson":2,"part":10,"type":"text","name":"ab-kids-l02-p10-b1","partTitle":"Your turn 5/5","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Au revoir !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Goodbye!</span></p>","recordPrompt":"Your turn! Say your line.","expectedText":"Au revoir !","size":null,"created":{"_seconds":1793234558,"_nanoseconds":427000000}},{"id":"pLa1zf2omVNlyENudpzB","level":"a0-les-petits","lesson":2,"part":11,"type":"text","name":"ab-kids-l02-p11-b1","partTitle":"Speak freely","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Bonjour ! Je m'appelle Nina. Et toi ?</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Hello! My name is Nina. And you?</p><p><b>Say hello and say your own name.</b></p><p style=\"opacity:.7;\">For example: “Bonjour ! Je m'appelle Sacha.”</p></div>","recordPrompt":"Now it's your turn to speak!","expectedText":"Bonjour ! Je m'appelle Sacha.","size":null,"created":{"_seconds":1793234558,"_nanoseconds":606000000}},{"id":"371soImU43DPYIA3mhZZ","level":"a0-les-petits","lesson":2,"part":12,"type":"text","name":"ab-kids-l02-p12-b1","partTitle":"Well done","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🏷️</div><p><b>Name badge earned!</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 You can now say hello, and tell someone your name with je m'appelle. And you can ask et toi.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793234558,"_nanoseconds":607000000}}]