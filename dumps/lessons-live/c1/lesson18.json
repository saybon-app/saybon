[{"id":"Bjl46u2PbLSKZx3EDyX2","level":"c1","lesson":18,"part":1,"type":"text","name":"c1-l18-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, adapter son registre. Le même message ne se dit pas de la même manière à un ami, à un collègue ou à un directeur. Vous allez passer du familier au courant, puis au soutenu, selon la situation.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276334,"_nanoseconds":713000000}},{"id":"nv28z6wcddVpMOx3Fg0j","level":"c1","lesson":18,"part":2,"type":"text","name":"c1-l18-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎚️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Adapter son registre</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276335,"_nanoseconds":220000000}},{"id":"uGQQKFIjlzv8OS21oFf1","level":"c1","lesson":18,"part":2,"type":"text","name":"c1-l18-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Familier : t'inquiète, c'est ok, ça craint. Courant : ne vous inquiétez pas, c'est entendu, c'est dommage. Soutenu : soyez assuré que, il convient de, nous regrettons. Un même sens, trois niveaux : adaptez toujours à votre interlocuteur.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,