mpt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276335,"_nanoseconds":717000000}},{"id":"bUWL43W5xX9EOrNcfeZr","level":"c1","lesson":18,"part":8,"type":"text","name":"c1-l18-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Dites à un ami que vous serez en retard.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis à la bourre, t'inquiète, j'arrive dans dix minutes.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je suis à la bourre, t'inquiète, j'arrive dans dix minutes.","size":null,"created":{"_seconds":1793276335,"_nanoseconds":669000000}},{"id":"CoDJx3ABdwaFZSa0EHsU","level":"c1","lesson":18,"part":9,"type":"text","name":"c1-l18-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et à votre collègue ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je serai en retard, ne vous inquiétez pas, j'arrive dans dix minutes.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je serai en retard, ne vous inquiétez pas, j'arrive dans dix minutes.","size":null,"created":{"_seconds":1793276336,"_nanoseconds":145000000}},{"id":"INoDQBzl2OIYJhvMnDbT","level":"c1","lesson":18,"part":10,"type":"text","name":"c1-l18-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et à votre directeur, par courrier ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Veuillez m'excuser, un contretemps m'empêche d'arriver à l'heure, soyez assuré que je serai là avant dix heures.</b></p>","recordPrompt":"À vous ! 