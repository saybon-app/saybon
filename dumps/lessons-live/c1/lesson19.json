[{"id":"hMlMaALf3bavmkWI8n8h","level":"c1","lesson":19,"part":1,"type":"text","name":"c1-l19-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, la narration et le suspense. Raconter une histoire, c'est gérer le rythme : ralentir pour créer l'attente, accélérer pour l'action, ménager des silences. Vous allez travailler votre voix, vos pauses, vos phrases courtes et longues.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276336,"_nanoseconds":610000000}},{"id":"3wehGujGFZGwYCUiXZGr","level":"c1","lesson":19,"part":2,"type":"text","name":"c1-l19-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎭</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Narration et suspense</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276336,"_nanoseconds":585000000}},{"id":"RHsDOKSEC7UHYsyhaKxP","level":"c1","lesson":19,"part":2,"type":"text","name":"c1-l19-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Créer l'attente : ce que je ne savais pas encore, c'est que. Ménager un silence : une pause avant la révélation. Phrases courtes pour l'action : j'ouvre. Rien. Je pousse. La porte cède. Chute : et c'est là que tout a basculé.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Ce que je ne savais pas encore...</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Et c'est là que tout a basculé</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Un silence</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je retiens mon souffle</b></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276336,"_nanoseconds":859000000}},{"id":"QV0JfOmllwEphPaADj2Z","level":"c1","lesson":19,"part":3,"type":"text","name":"c1-l19-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Ce que je ne savais pas encore...</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Ce que je ne savais pas encore...","size":null,"created":{"_seconds":1793276337,"_nanoseconds":42000000}},{"id":"44pOh1Adq4pT89Aw3oFT","level":"c1","lesson":19,"part":4,"type":"text","name":"c1-l19-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Et c'est là que tout a basculé</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Et c'est là que tout a basculé","size":null,"created":{"_seconds":1793276336,"_nanoseconds":984000000}},{"id":"kPZcfi94PBoP6xVwcWz8","level":"c1","lesson":19,"part":5,"type":"text","name":"c1-l19-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Un silence</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Un silence","size":null,"created":{"_seconds":1793276337,"_nanoseconds":12000000}},{"id":"Y127hyHKIpAJMKsp5KdE","level":"c1","lesson":19,"part":6,"type":"text","name":"c1-l19-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je retiens mon souffle</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je retiens mon souffle","size":null,"created":{"_seconds":1793276337,"_nanoseconds":273000000}},{"id":"BdHVRQ7YIbCWbGbW0thS","level":"c1","lesson":19,"part":7,"type":"text","name":"c1-l19-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Racontez-moi une histoire avec du suspense.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'était un soir d'hiver, la maison était vide, et pourtant j'entendais des pas.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Que faites-vous ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je retiens mon souffle. J'avance. Une marche craque. Silence.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ensuite ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce que je ne savais pas encore, c'est que quelqu'un m'attendait derrière la porte.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quelle chute ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Et c'est là que tout a basculé : c'était mon frère, venu me faire une surprise.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276337,"_nanoseconds":381000000}},{"id":"IrE3vFzgDXU5YUucGmNY","level":"c1","lesson":19,"part":8,"type":"text","name":"c1-l19-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Racontez-moi une histoire avec du suspense.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'était un soir d'hiver, la maison était vide, et pourtant j'entendais des pas.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'était un soir d'hiver, la maison était vide, et pourtant j'entendais des pas.","size":null,"created":{"_seconds":1793276337,"_nanoseconds":408000000}},{"id":"nLyTtBQI50Kslr8Ia0vY","level":"c1","lesson":19,"part":9,"type":"text","name":"c1-l19-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Que faites-vous ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je retiens mon souffle. J'avance. Une marche craque. Silence.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je retiens mon souffle. J'avance. Une marche craque. Silence.","size":null,"created":{"_seconds":1793276337,"_nanoseconds":445000000}},{"id":"NISKwkBFnoS5JdYwxI9l","level":"c1","lesson":19,"part":10,"type":"text","name":"c1-l19-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et ensuite ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ce que je ne savais pas encore, c'est que quelqu'un m'attendait derrière la porte.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Ce que je ne savais pas encore, c'est que quelqu'un m'attendait derrière la porte.","size":null,"created":{"_seconds":1793276337,"_nanoseconds":671000000}},{"id":"OtTT0yvS3OINLKfxuPXc","level":"c1","lesson":19,"part":11,"type":"text","name":"c1-l19-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quelle chute ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Et c'est là que tout a basculé : c'était mon frère, venu me faire une surprise.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Et c'est là que tout a basculé : c'était mon frère, venu me faire une surprise.","size":null,"created":{"_seconds":1793276337,"_nanoseconds":792000000}},{"id":"zWmUf9poOAZHnzyxYxuU","level":"c1","lesson":19,"part":12,"type":"text","name":"c1-l19-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Racontez avec suspense.</b></p><p style=\"opacity:.75;margin:0 0 10px;\"></p><p><b>Racontez une courte histoire avec un rythme, une pause et une chute.</b></p><p style=\"opacity:.7;\">Par exemple: “C'était un soir d'hiver. J'entendais des pas. Silence. Ce que je ne savais pas, c'est que quelqu'un m'attendait.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"C'était un soir d'hiver. J'entendais des pas. Silence. Ce que je ne savais pas, c'est que quelqu'un m'attendait.","size":null,"created":{"_seconds":1793276337,"_nanoseconds":808000000}},{"id":"cXQDBw8MzE6H7LIcrPjU","level":"c1","lesson":19,"part":13,"type":"text","name":"c1-l19-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎭</div><p><b>Suspense maîtrisé !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous contrôlez le rythme et le suspense d'un récit. Votre auditoire est suspendu à vos lèvres.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276337,"_nanoseconds":843000000}}]