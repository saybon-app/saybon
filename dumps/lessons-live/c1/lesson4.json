[{"id":"PjZDetYYB4LWBOziimMj","level":"c1","lesson":4,"part":1,"type":"text","name":"c1-l04-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, le registre soutenu. Un vocabulaire plus recherché, des tournures plus élégantes, une syntaxe plus travaillée. Il ne s'agit pas de compliquer pour compliquer, mais de choisir le mot juste, surtout dans un contexte formel.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276313,"_nanoseconds":639000000}},{"id":"fmiHyI3txZzZY02MTdUU","level":"c1","lesson":4,"part":2,"type":"text","name":"c1-l04-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎩</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Le registre soutenu</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276313,"_nanoseconds":775000000}},{"id":"FEdCEW6COWjn8TMVaoT6","level":"c1","lesson":4,"part":2,"type":"text","name":"c1-l04-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Au lieu de beaucoup de : une multitude de. Au lieu de montrer : mettre en évidence. Au lieu de penser : estimer, considérer. Au lieu de problème : enjeu, difficulté, obstacle. Au lieu de commencer : entamer, initier.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une multitude de</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mettre en évidence</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Estimer que</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Entamer une réflexion</b></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276313,"_nanoseconds":856000000}},{"id":"PWMCilRqEBSL1T2xHLCW","level":"c1","lesson":4,"part":3,"type":"text","name":"c1-l04-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une multitude de</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Une multitude de","size":null,"created":{"_seconds":1793276313,"_nanoseconds":889000000}},{"id":"TGQg9byjlWjGPdu4saCE","level":"c1","lesson":4,"part":4,"type":"text","name":"c1-l04-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mettre en évidence</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Mettre en évidence","size":null,"created":{"_seconds":1793276314,"_nanoseconds":41000000}},{"id":"baOGzyVM01yLY8cj6TPd","level":"c1","lesson":4,"part":5,"type":"text","name":"c1-l04-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Estimer que</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Estimer que","size":null,"created":{"_seconds":1793276314,"_nanoseconds":230000000}},{"id":"4ToxtXeGgzCVuKuYAJyy","level":"c1","lesson":4,"part":6,"type":"text","name":"c1-l04-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Entamer une réflexion</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Entamer une réflexion","size":null,"created":{"_seconds":1793276314,"_nanoseconds":254000000}},{"id":"sqnMS69265l9NcjfSN5y","level":"c1","lesson":4,"part":7,"type":"text","name":"c1-l04-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Reformulez : « Il y a beaucoup de problèmes dans ce projet. »</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce projet présente une multitude de difficultés.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et : « Je pense que ça va marcher. »</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'estime que ce projet est viable.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>« Cette étude montre que les gens ont peur. »</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Cette étude met en évidence une inquiétude généralisée.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>« On va commencer à discuter. »</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Nous allons entamer la discussion sur ce point.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276314,"_nanoseconds":304000000}},{"id":"lL6oQi6IKaFidnVNx67f","level":"c1","lesson":4,"part":8,"type":"text","name":"c1-l04-p08-b1","partTitl