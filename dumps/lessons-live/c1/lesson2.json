[{"id":"d7r50tElmHcASMt9Am3P","level":"c1","lesson":2,"part":1,"type":"text","name":"c1-l02-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, les connecteurs logiques. Ils sont l'ossature d'un discours construit : ils annoncent la cause, la conséquence, l'opposition, l'addition, la conclusion. Bien employés, ils guident l'auditeur sans effort.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276310,"_nanoseconds":881000000}},{"id":"dKtVpDtn3KICQUcFAVjr","level":"c1","lesson":2,"part":2,"type":"text","name":"c1-l02-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🔗</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Les connecteurs logiques</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276310,"_nanoseconds":836000000}},{"id":"pBUrQuLSJ0DNskmbohzu","level":"c1","lesson":2,"part":2,"type":"text","name":"c1-l02-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Addition : de surcroît, qui plus est, en outre. Cause : d'autant que, dans la mesure où. Conséquence : de sorte que, si bien que, d'où. Opposition : en revanche, or, néanmoins, au contraire. Conclusion : en définitive, tout bien pesé.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>De surcroît</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Dans la mesure où</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Si bien que</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>En définitive</b></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276310,"_nanoseconds":929000000}},{"id":"JhoQvZ0nuXCsWCIcoU7E","level":"c1","lesson":2,"part":3,"type":"text","name":"c1-l02-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>De surcroît</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"De surcroît","size":null,"created":{"_seconds":1793276310,"_nanoseconds":999000000}},{"id":"KjuE9g6RGSXKjkZjm8kQ","level":"c1","lesson":2,"part":4,"type":"text","name":"c1-l02-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Dans la mesure où</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Dans la mesure où","size":null,"created":{"_seconds":1793276311,"_nanoseconds":236000000}},{"id":"E0HFxE8kdbXnFCmFKUUM","level":"c1","lesson":2,"part":5,"type":"text","name":"c1-l02-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Si bien que</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Si bien que","size":null,"created":{"_seconds":1793276311,"_nanoseconds":286000000}},{"id":"ZN135a8qMOfDqZBBaoWA","level":"c1","lesson":2,"part":6,"type":"text","name":"c1-l02-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>En définitive</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"En définitive","size":null,"created":{"_seconds":1793276311,"_nanoseconds":350000000}},{"id":"ohg5Dbyav3SLSPqBwUYt","level":"c1","lesson":2,"part":7,"type":"text","name":"c1-l02-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi la lecture est-elle essentielle selon vous ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Elle enrichit le vocabulaire et, qui plus est, développe l'esprit critique.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Mais beaucoup de gens lisent moins aujourd'hui.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est exact, d'autant que les écrans captent notre attention, si bien que le temps de lecture diminue.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Alors, faut-il s'inquiéter ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Néanmoins, on observe un regain d'intérêt pour les formats audio et courts.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Votre conclusion ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>En définitive, la lecture change de forme, mais elle ne disparaît pas.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276311,"_nanoseconds":406000000}},{"id":"1mdgj7hve0cEuJxUrQK8","lev