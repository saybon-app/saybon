[{"id":"ZWtQa7V2Knnbonw0kEv0","level":"c1","lesson":5,"part":1,"type":"text","name":"c1-l05-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour. Aujourd'hui, les figures de style. La métaphore, la comparaison, l'antithèse, l'hyperbole, la litote : elles donnent de la couleur et de la force à vos propos. L'objectif n'est pas de les accumuler, mais d'en placer une au bon moment.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276315,"_nanoseconds":325000000}},{"id":"Si0yD8BqKccgoMfJZI7o","level":"c1","lesson":5,"part":2,"type":"text","name":"c1-l05-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎨</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Les figures de style</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276315,"_nanoseconds":400000000}},{"id":"z4nMTKd5ZcdZ42bTiAI0","level":"c1","lesson":5,"part":2,"type":"text","name":"c1-l05-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 La comparaison : il est fort comme un lion. La métaphore : cet homme est un roc. L'antithèse oppose deux idées : le meilleur et le pire. L'hyperbole exagère : je meurs de faim. La litote atténue pour dire plus : ce n'est pas mauvais.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une métaphore</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une antithèse</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une hyperbole</b></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Une litote</b></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276315,"_nanoseconds":530000000}},{"id":"LU9lFV7BXmyccBYswJvs","level":"c1","lesson":5,"part":3,"type":"text","name":"c1-l05-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une métaphore</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Une métaphore","size":null,"created":{"_seconds":1793276315,"_nanoseconds":749000000}},{"id":"JG7mFsLsGYQxUJBcYK25","level":"c1","lesson":5,"part":4,"type":"text","name":"c1-l05-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une antithèse</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Une antithèse","size":null,"created":{"_seconds":1793276315,"_nanoseconds":727000000}},{"id":"hLZC6DaqZknWhHTrLVPG","level":"c1","lesson":5,"part":5,"type":"text","name":"c1-l05-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une hyperbole</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Une hyperbole","size":null,"created":{"_seconds":1793276315,"_nanoseconds":855000000}},{"id":"TADYPRuJ10DkyDbA9k7r","level":"c1","lesson":5,"part":6,"type":"text","name":"c1-l05-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Une litote</b></p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Une litote","size":null,"created":{"_seconds":1793276315,"_nanoseconds":957000000}},{"id":"ipxuyMe8FF1KxFvOpRqO","level":"c1","lesson":5,"part":7,"type":"text","name":"c1-l05-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment décririez-vous une ville qui ne dort jamais, avec une métaphore ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Cette ville est une ruche qui bourdonne jour et nuit.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Une antithèse maintenant : parlez du progrès.</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Le progrès est à la fois une chance et une menace, un espoir et un risque.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Une litote pour dire que c'était excellent ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Ce n'était pas mal du tout.</b></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et une hyperbole pour dire que vous êtes fatigué ?</b></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je suis mort de fatigue, je pourrais dormir un siècle.</b></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276316,"_nanoseconds":134000000}},{"id":"zEIxNoPPEgQXddY1CTOW","level":"c1","lesson":5,"part":8,"type":"text","name":"c1-l05-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment décririez-vous une ville qui ne dort jamais, avec une métaphore ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Cette ville est une ruche qui bourdonne jour et nuit.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Cette ville est une ruche qui bourdonne jour et nuit.","size":null,"created":{"_seconds":1793276316,"_nanoseconds":179000000}},{"id":"LwSQ7SWCVUF9K2VXRuOJ","level":"c1","lesson":5,"part":9,"type":"text","name":"c1-l05-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Une antithèse maintenant : parlez du progrès.</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Le progrès est à la fois une chance et une menace, un espoir et un risque.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Le progrès est à la fois une chance et une menace, un espoir et un risque.","size":null,"created":{"_seconds":1793276316,"_nanoseconds":274000000}},{"id":"fyQhlJrkXZSuE1ltbYiX","level":"c1","lesson":5,"part":10,"type":"text","name":"c1-l05-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Une litote pour dire que c'était excellent ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Ce n'était pas mal du tout.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Ce n'était pas mal du tout.","size":null,"created":{"_seconds":1793276316,"_nanoseconds":356000000}},{"id":"ouJcM2YSrxVk7yFOboYB","level":"c1","lesson":5,"part":11,"type":"text","name":"c1-l05-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et une hyperbole pour dire que vous êtes fatigué ?</b></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je suis mort de fatigue, je pourrais dormir un siècle.</b></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je suis mort de fatigue, je pourrais dormir un siècle.","size":null,"created":{"_seconds":1793276316,"_nanoseconds":539000000}},{"id":"uBN9jfJQBAWIed3cjQBO","level":"c1","lesson":5,"part":12,"type":"text","name":"c1-l05-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Employez des figures de style.</b></p><p style=\"opacity:.75;margin:0 0 10px;\"></p><p><b>Utilisez une métaphore, une antithèse et une litote dans un court discours.</b></p><p style=\"opacity:.7;\">Par exemple: “La ville est une ruche. Elle est à la fois belle et fatigante. Ce n'est pas mal du tout.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"La ville est une ruche. Elle est à la fois belle et fatigante. Ce n'est pas mal du tout.","size":null,"created":{"_seconds":1793276316,"_nanoseconds":581000000}},{"id":"iWcnRi8wQHdkBSXiZkMI","level":"c1","lesson":5,"part":13,"type":"text","name":"c1-l05-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎨</div><p><b>Style relevé !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous savez colorer votre discours avec des figures de style. Cela donne du relief et de la personnalité à vos propos.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276316,"_nanoseconds":678000000}}]