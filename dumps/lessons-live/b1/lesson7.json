[{"id":"bZjOwlR0akeiahXbvkX0","level":"b1","lesson":7,"part":1,"type":"text","name":"b1-l07-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, vous donnez votre opinion et vous la défendez simplement. À A2, vous disiez je pense que. Maintenant, vous ajoutez des arguments : d'abord, de plus, enfin. Une opinion avec trois arguments est beaucoup plus convaincante.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276161,"_nanoseconds":589000000}},{"id":"VtyrbMJYylTMwIUT5cVX","level":"b1","lesson":7,"part":2,"type":"text","name":"b1-l07-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📣</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Donner son opinion</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276161,"_nanoseconds":641000000}},{"id":"aJjIIs1emzc7xii0UyHD","level":"b1","lesson":7,"part":2,"type":"text","name":"b1-l07-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Donner son avis : à mon avis, selon moi, personnellement, je suis convaincu que. Argumenter : d'abord, de plus, en outre, enfin. Conclure : en somme, pour conclure.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Selon moi, c'est important.</b><span style=\"opacity:.7;\"> · In my view it's important.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>D'abord, c'est utile.</b><span style=\"opacity:.7;\"> · Firstly, it's useful.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>De plus, c'est gratuit.</b><span style=\"opacity:.7;\"> · Moreover, it's free.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>En somme, je suis pour.</b><span style=\"opacity:.7;\"> · In short, I'm in favour.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276161,"_nanoseconds":593000000}},{"id":"4NvrGwJchPZoYnVJZh0T","level":"b1","lesson":7,"part":3,"type":"text","name":"b1-l07-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Selon moi, c'est important.</b></p><p style=\"opacity:.75;margin:0;\">In my view it's important.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Selon moi, c'est important.","size":null,"created":{"_seconds":1793276161,"_nanoseconds":640000000}},{"id":"hVIE6Os5oaoF9qe1MAMq","level":"b1","lesson":7,"part":4,"type":"text","name":"b1-l07-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>D'abord, c'est utile.</b></p><p style=\"opacity:.75;margin:0;\">Firstly, it's useful.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"D'abord, c'est utile.","size":null,"created":{"_seconds":1793276161,"_nanoseconds":985000000}},{"id":"s34oWLkagP9h35r5Zpiw","level":"b1","lesson":7,"part":5,"type":"text","name":"b1-l07-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>De plus, c'est gratuit.</b></p><p style=\"opacity:.75;margin:0;\">Moreover, it's free.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"De plus, c'est gratuit.","size":null,"created":{"_seconds":1793276161,"_nanoseconds":994000000}},{"id":"HceFJqE66oRR3Pate94j","level":"b1","lesson":7,"part":6,"type":"text","name":"b1-l07-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>En somme, je suis pour.</b></p><p style=\"opacity:.75;margin:0;\">In short, I'm in favour.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"En somme, je suis pour.","size":null,"created":{"_seconds":1793276162,"_nanoseconds":40000000}},{"id":"tMkX9J6GFNteurk1IUTh","level":"b1","lesson":7,"part":7,"type":"text","name":"b1-l07-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pensez-vous qu'il faut apprendre plusieurs langues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you think we should learn several languages?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Selon moi, oui, c'est très important.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In my view, yes, it's very important.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'abord, cela aide à voyager et à rencontrer des gens.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Firstly, it helps to travel and meet people.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And next?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>De plus, cela ouvre des portes professionnelles.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Moreover, it opens professional doors.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Anything else?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Enfin, cela rend le cerveau plus actif. En somme, je suis pour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Finally, it makes the brain more active. In short, I'm in favour.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276162,"_nanoseconds":45000000}},{"id":"JmsuPWNYw7T1Br8Cj9Tc","level":"b1","lesson":7,"part":8,"type":"text","name":"b1-l07-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pensez-vous qu'il faut apprendre plusieurs langues ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Do you think we should learn several languages?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Selon moi, oui, c'est très important.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In my view, yes, it's very important.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Selon moi, oui, c'est très important.","size":null,"created":{"_seconds":1793276162,"_nanoseconds":581000000}},{"id":"DrrSQryYhEFhN51N6bjZ","level":"b1","lesson":7,"part":9,"type":"text","name":"b1-l07-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'abord, cela aide à voyager et à rencontrer des gens.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Firstly, it helps to travel and meet people.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"D'abord, cela aide à voyager et à rencontrer des gens.","size":null,"created":{"_seconds":1793276162,"_nanoseconds":569000000}},{"id":"ApJa7jTbHcBbRp7ZtQzR","level":"b1","lesson":7,"part":10,"type":"text","name":"b1-l07-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et ensuite ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And next?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">De plus, cela ouvre des portes professionnelles.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Moreover, it opens professional doors.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"De plus, cela ouvre des portes professionnelles.","size":null,"created":{"_seconds":1793276162,"_nanoseconds":571000000}},{"id":"zzE6wWNEGVi1TdVnHrkI","level":"b1","lesson":7,"part":11,"type":"text","name":"b1-l07-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Autre chose ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Anything else?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Enfin, cela rend le cerveau plus actif. En somme, je suis pour.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Finally, it makes the brain more active. In short, I'm in favour.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Enfin, cela rend le cerveau plus actif. En somme, je suis pour.","size":null,"created":{"_seconds":1793276162,"_nanoseconds":578000000}},{"id":"E93ZSvNyRvJ5vAUk29Z7","level":"b1","lesson":7,"part":12,"type":"text","name":"b1-l07-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Défendez une opinion avec trois arguments.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Defend an opinion with three arguments.</p><p><b>Donnez votre avis sur un sujet avec trois arguments.</b></p><p style=\"opacity:.7;\">Par exemple: “Selon moi, le sport est important. D'abord, c'est bon pour la santé. De plus, c'est amusant. Enfin, on rencontre des gens.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Selon moi, le sport est important. D'abord, c'est bon pour la santé. De plus, c'est amusant. Enfin, on rencontre des gens.","size":null,"created":{"_seconds":1793276163,"_nanoseconds":28000000}},{"id":"IalD9wyv5gVwWwGWYRgK","level":"b1","lesson":7,"part":13,"type":"text","name":"b1-l07-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">📣</div><p><b>Avis argumenté !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous donnez votre opinion avec une structure claire. Cela rend vos idées plus convaincantes.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276162,"_nanoseconds":973000000}}]