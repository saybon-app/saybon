[{"id":"cZzHbEmSCdtaVjjpEtNy","level":"b1","lesson":10,"part":1,"type":"text","name":"b1-l10-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, l'environnement : pollution, déchets, énergie, climat. Vous allez parler des problèmes et proposer des solutions. C'est un sujet de conversation fréquent, et il demande un vocabulaire précis.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276166,"_nanoseconds":411000000}},{"id":"ULSx6KWA94YJdMvMiXVq","level":"b1","lesson":10,"part":2,"type":"text","name":"b1-l10-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌍</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">L'environnement</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276166,"_nanoseconds":417000000}},{"id":"Kou4Twa2lFSR9rYFCGty","level":"b1","lesson":10,"part":2,"type":"text","name":"b1-l10-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Les problèmes : la pollution, le réchauffement climatique, les déchets, la déforestation. Les solutions : recycler, économiser l'énergie, utiliser les transports en commun, planter des arbres. Il faut + infinitif, on pourrait + infinitif.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Le réchauffement climatique</b><span style=\"opacity:.7;\"> · global warming</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il faut recycler.</b><span style=\"opacity:.7;\"> · We must recycle.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>On pourrait planter des arbres.</b><span style=\"opacity:.7;\"> · We could plant trees.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Économiser l'énergie</b><span style=\"opacity:.7;\"> · to save energy</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276167,"_nanoseconds":17000000}},{"id":"l0QdSIDusg08ATN8xkOQ","level":"b1","lesson":10,"part":3,"type":"text","name":"b1-l10-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Le réchauffement climatique</b></p><p style=\"opacity:.75;margin:0;\">global warming</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Le réchauffement climatique","size":null,"created":{"_seconds":1793276167,"_nanoseconds":67000000}},{"id":"YxwODmvB21w94JMvJY7G","level":"b1","lesson":10,"part":4,"type":"text","name":"b1-l10-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il faut recycler.</b></p><p style=\"opacity:.75;margin:0;\">We must recycle.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Il faut recycler.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":125000000}},{"id":"IaCUJ9ilATJW7zh125TX","level":"b1","lesson":10,"part":5,"type":"text","name":"b1-l10-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>On pourrait planter des arbres.</b></p><p style=\"opacity:.75;margin:0;\">We could plant trees.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"On pourrait planter des arbres.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":76000000}},{"id":"mkW9XlZ9FtsQOXIzWfch","level":"b1","lesson":10,"part":6,"type":"text","name":"b1-l10-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Économiser l'énergie</b></p><p style=\"opacity:.75;margin:0;\">to save energy</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Économiser l'énergie","size":null,"created":{"_seconds":1793276167,"_nanoseconds":418000000}},{"id":"vDxJRMdeF7MVWGIQ8VKH","level":"b1","lesson":10,"part":7,"type":"text","name":"b1-l10-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Quel est, selon vous, le plus grand problème environnemental ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is, in your view, the biggest environmental problem?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je pense que ce sont les déchets en plastique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think it's plastic waste.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Parce qu'ils polluent les rivières et les océans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Because they pollute rivers and oceans.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Que peut-on faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What can we do?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>On pourrait recycler plus et utiliser moins de plastique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We could recycle more and use less plastic.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous, que faites-vous personnellement ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And you, what do you personally do?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'utilise un sac en tissu et je trie mes déchets.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I use a cloth bag and sort my waste.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276167,"_nanoseconds":505000000}},{"id":"fOGWXhW1CnUoCbJng1yQ","level":"b1","lesson":10,"part":8,"type":"text","name":"b1-l10-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Quel est, selon vous, le plus grand problème environnemental ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What is, in your view, the biggest environmental problem?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je pense que ce sont les déchets en plastique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think it's plastic waste.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je pense que ce sont les déchets en plastique.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":521000000}},{"id":"1LT4XxniCFOcy3f2BYiJ","level":"b1","lesson":10,"part":9,"type":"text","name":"b1-l10-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Parce qu'ils polluent les rivières et les océans.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Because they pollute rivers and oceans.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Parce qu'ils polluent les rivières et les océans.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":566000000}},{"id":"XB58XmIB5W9kC5MEMctA","level":"b1","lesson":10,"part":10,"type":"text","name":"b1-l10-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Que peut-on faire ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What can we do?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">On pourrait recycler plus et utiliser moins de plastique.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We could recycle more and use less plastic.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"On pourrait recycler plus et utiliser moins de plastique.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":817000000}},{"id":"fIAlQmHLChXhmfrTJBWK","level":"b1","lesson":10,"part":11,"type":"text","name":"b1-l10-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous, que faites-vous personnellement ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And you, what do you personally do?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'utilise un sac en tissu et je trie mes déchets.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I use a cloth bag and sort my waste.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"J'utilise un sac en tissu et je trie mes déchets.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":899000000}},{"id":"qUyOD2ou6Y9d864ckeKJ","level":"b1","lesson":10,"part":12,"type":"text","name":"b1-l10-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez d'un problème d'environnement et proposez des solutions.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Talk about an environmental problem and suggest solutions.</p><p><b>Décrivez un problème et donnez deux solutions.</b></p><p style=\"opacity:.7;\">Par exemple: “Le problème, c'est le plastique. On pourrait recycler. Il faut utiliser moins de sacs.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Le problème, c'est le plastique. On pourrait recycler. Il faut utiliser moins de sacs.","size":null,"created":{"_seconds":1793276167,"_nanoseconds":931000000}},{"id":"BQhs5l8b65Bosq9B9CAm","level":"b1","lesson":10,"part":13,"type":"text","name":"b1-l10-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🌍</div><p><b>Planète en tête !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez parler d'environnement avec des problèmes et des solutions. Un vocabulaire utile dans beaucoup de contextes.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276167,"_nanoseconds":961000000}}]