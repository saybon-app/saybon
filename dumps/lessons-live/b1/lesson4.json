[{"id":"hfw77nUZnmPrY5TH0y8J","level":"b1","lesson":4,"part":1,"type":"text","name":"b1-l04-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, vous exprimez l'obligation et le souhait avec des expressions variées : devoir, avoir besoin de, il est nécessaire de, j'aimerais bien, j'espère que. Vous allez nuancer ce que vous devez faire et ce que vous voulez.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276155,"_nanoseconds":559000000}},{"id":"Pf7Ktqcmswjjso91dbuH","level":"b1","lesson":4,"part":2,"type":"text","name":"b1-l04-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎯</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Exprimer l'obligation et le souhait</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276155,"_nanoseconds":604000000}},{"id":"hDJ5qWEvutIKPITLhX7U","level":"b1","lesson":4,"part":2,"type":"text","name":"b1-l04-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 L'obligation : je dois, il faut, j'ai besoin de, il est obligatoire de. Le souhait : je voudrais, j'aimerais, j'espère que. Notez : j'espère que + indicatif, mais je souhaite que + subjonctif.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je dois partir tôt.</b><span style=\"opacity:.7;\"> · I must leave early.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'ai besoin de repos.</b><span style=\"opacity:.7;\"> · I need rest.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>J'espère que tu viendras.</b><span style=\"opacity:.7;\"> · I hope you will come.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je souhaite qu'il réussisse.</b><span style=\"opacity:.7;\"> · I wish him success.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276156,"_nanoseconds":331000000}},{"id":"eVeo1HjeB6ma4MQi2UCb","level":"b1","lesson":4,"part":3,"type":"text","name":"b1-l04-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je dois partir tôt.</b></p><p style=\"opacity:.75;margin:0;\">I must leave early.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je dois partir tôt.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":399000000}},{"id":"cORLQYI1PVfgqjaf9PpN","level":"b1","lesson":4,"part":4,"type":"text","name":"b1-l04-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'ai besoin de repos.</b></p><p style=\"opacity:.75;margin:0;\">I need rest.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"J'ai besoin de repos.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":331000000}},{"id":"MJ5kmZt78CppM7ax7Fsh","level":"b1","lesson":4,"part":5,"type":"text","name":"b1-l04-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>J'espère que tu viendras.</b></p><p style=\"opacity:.75;margin:0;\">I hope you will come.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"J'espère que tu viendras.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":408000000}},{"id":"j1clvUk1mZhhjhCrRDiZ","level":"b1","lesson":4,"part":6,"type":"text","name":"b1-l04-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je souhaite qu'il réussisse.</b></p><p style=\"opacity:.75;margin:0;\">I wish him success.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je souhaite qu'il réussisse.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":921000000}},{"id":"visrUqAVKXGxTC21eZzc","level":"b1","lesson":4,"part":7,"type":"text","name":"b1-l04-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Que devez-vous faire cette semaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What must you do this week?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je dois terminer un projet et j'ai besoin d'un peu de repos.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I must finish a project and I need some rest.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous souhaitez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you wish for?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'aimerais bien partir en vacances, mais je n'ai pas le temps.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'd really like to go on holiday, but I don't have time.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous espérez quoi pour l'avenir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you hope for the future?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>J'espère que j'aurai plus de temps libre l'année prochaine.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I hope I'll have more free time next year.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et pour votre famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for your family?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Je souhaite qu'elle soit en bonne santé et heureuse.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I wish that she be healthy and happy.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276156,"_nanoseconds":835000000}},{"id":"zj6zp4V6JWhd6PJ5zHNw","level":"b1","lesson":4,"part":8,"type":"text","name":"b1-l04-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Que devez-vous faire cette semaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What must you do this week?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je dois terminer un projet et j'ai besoin d'un peu de repos.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I must finish a project and I need some rest.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je dois terminer un projet et j'ai besoin d'un peu de repos.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":915000000}},{"id":"gEAHSiuPFFPlvUHpra0W","level":"b1","lesson":4,"part":9,"type":"text","name":"b1-l04-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous souhaitez ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you wish for?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'aimerais bien partir en vacances, mais je n'ai pas le temps.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'd really like to go on holiday, but I don't have time.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"J'aimerais bien partir en vacances, mais je n'ai pas le temps.","size":null,"created":{"_seconds":1793276156,"_nanoseconds":887000000}},{"id":"QCCNi8NoGGdjFKJ6gWB8","level":"b1","lesson":4,"part":10,"type":"text","name":"b1-l04-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous espérez quoi pour l'avenir ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What do you hope for the future?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">J'espère que j'aurai plus de temps libre l'année prochaine.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I hope I'll have more free time next year.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"J'espère que j'aurai plus de temps libre l'année prochaine.","size":null,"created":{"_seconds":1793276157,"_nanoseconds":354000000}},{"id":"jCTsS6iTcNcOZAOBjJkN","level":"b1","lesson":4,"part":11,"type":"text","name":"b1-l04-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et pour votre famille ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And for your family?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Je souhaite qu'elle soit en bonne santé et heureuse.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I wish that she be healthy and happy.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Je souhaite qu'elle soit en bonne santé et heureuse.","size":null,"created":{"_seconds":1793276157,"_nanoseconds":404000000}},{"id":"tMs2Bpti5gXCuCPw8IYz","level":"b1","lesson":4,"part":12,"type":"text","name":"b1-l04-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Parlez de vos obligations et de vos souhaits.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Talk about your obligations and wishes.</p><p><b>Dites une obligation, un besoin, un souhait.</b></p><p style=\"opacity:.7;\">Par exemple: “Je dois travailler. J'ai besoin de repos. J'aimerais voyager. J'espère que ce sera bientôt.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Je dois travailler. J'ai besoin de repos. J'aimerais voyager. J'espère que ce sera bientôt.","size":null,"created":{"_seconds":1793276157,"_nanoseconds":452000000}},{"id":"OOgasXeVbdpiqGZ2yUl6","level":"b1","lesson":4,"part":13,"type":"text","name":"b1-l04-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🎯</div><p><b>Obligations et souhaits !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez parler d'obligation et de souhait de plusieurs manières. Cela rend votre expression plus riche.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276157,"_nanoseconds":413000000}}]