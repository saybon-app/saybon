[{"id":"N10UqW8N25z5aacNlP8Q","level":"b1","lesson":8,"part":1,"type":"text","name":"b1-l08-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, vous débattez doucement : vous êtes d'accord, pas d'accord, ou en partie d'accord. L'objectif est de rester poli, même quand vous n'êtes pas d'accord. Les Français aiment débattre, et un bon débat est respectueux.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276163,"_nanoseconds":7000000}},{"id":"XG6fdEluFAeWUZ2awg1i","level":"b1","lesson":8,"part":2,"type":"text","name":"b1-l08-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🤝</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Débattre doucement</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276163,"_nanoseconds":31000000}},{"id":"8zZEjK68uLOGWHejNX88","level":"b1","lesson":8,"part":2,"type":"text","name":"b1-l08-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Être d'accord : je suis tout à fait d'accord, vous avez raison. Pas d'accord : je ne suis pas de votre avis, je vois les choses autrement. Nuancer : oui, mais, c'est vrai, cependant. Demander : qu'en pensez-vous ?</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Vous avez raison.</b><span style=\"opacity:.7;\"> · You're right.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je ne suis pas de votre avis.</b><span style=\"opacity:.7;\"> · I don't share your view.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est vrai, mais...</b><span style=\"opacity:.7;\"> · That's true, but...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Qu'en pensez-vous ?</b><span style=\"opacity:.7;\"> · What do you think?</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276163,"_nanoseconds":404000000}},{"id":"2C25LDp40jzfuHjBmzov","level":"b1","lesson":8,"part":3,"type":"text","name":"b1-l08-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Vous avez raison.</b></p><p style=\"opacity:.75;margin:0;\">You're right.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Vous avez raison.","size":null,"created":{"_seconds":1793276163,"_nanoseconds":429000000}},{"id":"m3xDjVTZAAOj6uDdl03z","level":"b1","lesson":8,"part":4,"type":"text","name":"b1-l08-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je ne suis pas de votre avis.</b></p><p style=\"opacity:.75;margin:0;\">I don't share your view.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je ne suis pas de votre avis.","size":null,"created":{"_seconds":1793276163,"_nanoseconds":446000000}},{"id":"YIPZWVJfwF1ODnsxgYsq","level":"b1","lesson":8,"part":5,"type":"text","name":"b1-l08-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est vrai, mais...</b></p><p style=\"opacity:.75;margin:0;\">That's true, but...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"C'est vrai, mais...","size":null,"created":{"_seconds":1793276163,"_nanoseconds":467000000}},{"id":"TDCn4tW4XJpIWhDNDwEs","level":"b1","lesson":8,"part":6,"type":"text","name":"b1-l08-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Qu'en pensez-vous ?</b></p><p style=\"opacity:.75;margin:0;\">What do you think?</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Qu'en pensez-vous ?","size":null,"created":{"_seconds":1793276163,"_nanoseconds":896000000}},{"id":"e1bqcIVqxKacALG8517E","level":"b1","lesson":8,"part":7,"type":"text","name":"b1-l08-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je pense que le télétravail est meilleur que le bureau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think working from home is better than the office.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est vrai, il y a des avantages, mais je ne suis pas tout à fait de votre avis.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's true, there are advantages, but I don't totally share your view.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>On perd le contact avec les collègues et c'est difficile de se concentrer.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You lose contact with colleagues and it's hard to concentrate.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Vous avez raison pour le contact, mais on gagne du temps.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're right about contact, but you save time.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'est vrai, on gagne du temps. Qu'en pensez-vous d'un système mixte ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's true, you save time. What do you think of a mixed system?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Excellente idée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excellent idea!</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Alors nous sommes d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">So we agree.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276163,"_nanoseconds":901000000}},{"id":"LFLu9RXQtB05tkOWCKHd","level":"b1","lesson":8,"part":8,"type":"text","name":"b1-l08-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je pense que le télétravail est meilleur que le bureau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I think working from home is better than the office.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est vrai, il y a des avantages, mais je ne suis pas tout à fait de votre avis.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's true, there are advantages, but I don't totally share your view.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'est vrai, il y a des avantages, mais je ne suis pas tout à fait de votre avis.","size":null,"created":{"_seconds":1793276163,"_nanoseconds":948000000}},{"id":"3IzSws5g3ZWN9zXlB9uN","level":"b1","lesson":8,"part":9,"type":"text","name":"b1-l08-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Pourquoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Why?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">On perd le contact avec les collègues et c'est difficile de se concentrer.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You lose contact with colleagues and it's hard to concentrate.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"On perd le contact avec les collègues et c'est difficile de se concentrer.","size":null,"created":{"_seconds":1793276163,"_nanoseconds":947000000}},{"id":"4IlvWRMOePR29K6pZv23","level":"b1","lesson":8,"part":10,"type":"text","name":"b1-l08-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Vous avez raison pour le contact, mais on gagne du temps.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're right about contact, but you save time.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'est vrai, on gagne du temps. Qu'en pensez-vous d'un système mixte ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">That's true, you save time. What do you think of a mixed system?</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'est vrai, on gagne du temps. Qu'en pensez-vous d'un système mixte ?","size":null,"created":{"_seconds":1793276164,"_nanoseconds":427000000}},{"id":"dwCX5xFnLC3T6FXGdlcN","level":"b1","lesson":8,"part":11,"type":"text","name":"b1-l08-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Excellente idée !</b><br><span style=\"opacity:.7;font-size:.9rem;\">Excellent idea!</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Alors nous sommes d'accord.</b><br><span style=\"opacity:.7;font-size:.9rem;\">So we agree.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Alors nous sommes d'accord.","size":null,"created":{"_seconds":1793276164,"_nanoseconds":465000000}},{"id":"xo1jAmJ5d0JPEmRgHxUl","level":"b1","lesson":8,"part":12,"type":"text","name":"b1-l08-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Débattez doucement.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Gently debate.</p><p><b>Réagissez à une opinion : nuancez, puis proposez un compromis.</b></p><p style=\"opacity:.7;\">Par exemple: “C'est vrai, mais je ne suis pas de votre avis. Qu'en pensez-vous d'un compromis ?”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"C'est vrai, mais je ne suis pas de votre avis. Qu'en pensez-vous d'un compromis ?","size":null,"created":{"_seconds":1793276164,"_nanoseconds":463000000}},{"id":"hZTDIIi6i65p6wd03nji","level":"b1","lesson":8,"part":13,"type":"text","name":"b1-l08-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🤝</div><p><b>Débat respectueux !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez débattre poliment et trouver un terrain d'entente. C'est très apprécié.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276164,"_nanoseconds":475000000}}]