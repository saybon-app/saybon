[{"id":"02Yzpfc0kdqZNHeErFsL","level":"b1","lesson":13,"part":1,"type":"text","name":"b1-l13-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, les problèmes en voyage et la façon de les résoudre. Vous avez déjà vu des situations simples. Maintenant, vous expliquez le problème avec précision, vous exprimez votre mécontentement avec calme, et vous proposez une solution.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276171,"_nanoseconds":65000000}},{"id":"yR8HlzaN49Adtt1sNAQz","level":"b1","lesson":13,"part":2,"type":"text","name":"b1-l13-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧳</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Voyager et s'adapter</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276171,"_nanoseconds":166000000}},{"id":"yIat0TSxseHtzNqt7e6Y","level":"b1","lesson":13,"part":2,"type":"text","name":"b1-l13-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Expliquer : il y a eu une erreur, on a perdu mes bagages, le vol a été annulé. Exprimer : je suis très déçu, c'est inacceptable. Demander : pouvez-vous me proposer une solution ? Je souhaite être remboursé.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Mes bagages ont été perdus.</b><span style=\"opacity:.7;\"> · My luggage has been lost.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je suis très déçu.</b><span style=\"opacity:.7;\"> · I'm very disappointed.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Pouvez-vous me proposer une solution ?</b><span style=\"opacity:.7;\"> · Can you suggest a solution?</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Je souhaite être remboursé.</b><span style=\"opacity:.7;\"> · I'd like a refund.</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276171,"_nanoseconds":209000000}},{"id":"WxC8UOndEP3UhH3DnBVx","level":"b1","lesson":13,"part":3,"type":"text","name":"b1-l13-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Mes bagages ont été perdus.</b></p><p style=\"opacity:.75;margin:0;\">My luggage has been lost.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Mes bagages ont été perdus.","size":null,"created":{"_seconds":1793276171,"_nanoseconds":248000000}},{"id":"2jAac9BeH8sPXdLJQqaZ","level":"b1","lesson":13,"part":4,"type":"text","name":"b1-l13-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je suis très déçu.</b></p><p style=\"opacity:.75;margin:0;\">I'm very disappointed.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je suis très déçu.","size":null,"created":{"_seconds":1793276171,"_nanoseconds":492000000}},{"id":"Xw3Y0hIGkew2I1DasVqe","level":"b1","lesson":13,"part":5,"type":"text","name":"b1-l13-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Pouvez-vous me proposer une solution ?</b></p><p style=\"opacity:.75;margin:0;\">Can you suggest a solution?</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Pouvez-vous me proposer une solution ?","size":null,"created":{"_seconds":1793276171,"_nanoseconds":578000000}},{"id":"1s8An3H6WYqglyPASYlB","level":"b1","lesson":13,"part":6,"type":"text","name":"b1-l13-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Je souhaite être remboursé.</b></p><p style=\"opacity:.75;margin:0;\">I'd like a refund.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Je souhaite être remboursé.","size":null,"created":{"_seconds":1793276171,"_nanoseconds":608000000}},{"id":"8KTMDZAtvFuKjGZr50Qu","level":"b1","lesson":13,"part":7,"type":"text","name":"b1-l13-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Bonjour, comment puis-je vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, how can I help you?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Bonjour. Mes bagages n'étaient pas sur le tapis à mon arrivée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello. My luggage wasn't on the belt when I arrived.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Je suis désolée. Pouvez-vous décrire votre valise ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm sorry. Can you describe your suitcase?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Elle est grande, noire, avec un ruban rouge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's large, black, with a red ribbon.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Nous allons la chercher. Elle sera livrée à votre hôtel.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We'll look for it. It will be delivered to your hotel.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Quand pensez-vous que ce sera ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When do you think that will be?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Dans les vingt-quatre heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Within twenty-four hours.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>D'accord. Si ce n'est pas le cas, je souhaite être remboursé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. If not, I'd like a refund.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276171,"_nanoseconds":652000000}},{"id":"ZOOFecVSA3rs8Z0SFyWg","level":"b1","lesson":13,"part":8,"type":"text","name":"b1-l13-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Bonjour, comment puis-je vous aider ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello, how can I help you?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Bonjour. Mes bagages n'étaient pas sur le tapis à mon arrivée.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Hello. My luggage wasn't on the belt when I arrived.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Bonjour. Mes bagages n'étaient pas sur le tapis à mon arrivée.","size":null,"created":{"_seconds":1793276171,"_nanoseconds":938000000}},{"id":"Xa5Swca8BWRTTV3XFQZp","level":"b1","lesson":13,"part":9,"type":"text","name":"b1-l13-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Je suis désolée. Pouvez-vous décrire votre valise ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">I'm sorry. Can you describe your suitcase?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Elle est grande, noire, avec un ruban rouge.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It's large, black, with a red ribbon.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Elle est grande, noire, avec un ruban rouge.","size":null,"created":{"_seconds":1793276171,"_nanoseconds":994000000}},{"id":"8Jlb8Qw1V4junXuuB0AR","level":"b1","lesson":13,"part":10,"type":"text","name":"b1-l13-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Nous allons la chercher. Elle sera livrée à votre hôtel.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We'll look for it. It will be delivered to your hotel.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Quand pensez-vous que ce sera ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">When do you think that will be?</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Quand pensez-vous que ce sera ?","size":null,"created":{"_seconds":1793276172,"_nanoseconds":28000000}},{"id":"pNr47thgNpyP1K2JwmgN","level":"b1","lesson":13,"part":11,"type":"text","name":"b1-l13-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Dans les vingt-quatre heures.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Within twenty-four hours.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">D'accord. Si ce n'est pas le cas, je souhaite être remboursé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">All right. If not, I'd like a refund.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"D'accord. Si ce n'est pas le cas, je souhaite être remboursé.","size":null,"created":{"_seconds":1793276172,"_nanoseconds":89000000}},{"id":"S0xgRFWIGvh0h4Ix832L","level":"b1","lesson":13,"part":12,"type":"text","name":"b1-l13-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Résolvez un problème en voyage.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Solve a travel problem.</p><p><b>Expliquez le problème, exprimez votre déception, demandez une solution.</b></p><p style=\"opacity:.7;\">Par exemple: “Mon vol a été annulé. Je suis très déçu. Pouvez-vous me proposer une solution ?”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Mon vol a été annulé. Je suis très déçu. Pouvez-vous me proposer une solution ?","size":null,"created":{"_seconds":1793276172,"_nanoseconds":659000000}},{"id":"Yk1hzlKo0ohWscs6NCKV","level":"b1","lesson":13,"part":13,"type":"text","name":"b1-l13-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🧳</div><p><b>Problème résolu !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez expliquer un problème de voyage et demander une solution, avec calme et précision.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276172,"_nanoseconds":723000000}}]