[{"id":"HPaRJcs6fPUW2Aqz2Leu","level":"b1","lesson":14,"part":1,"type":"text","name":"b1-l14-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, les relations : l'amitié, la famille, le couple, les collègues. Vous décrivez les relations, vous les analysez un peu et vous donnez des conseils. C'est un thème profond qui demande de la nuance.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276172,"_nanoseconds":720000000}},{"id":"g6cmiWIYOXBYH4bCO8Tn","level":"b1","lesson":14,"part":2,"type":"text","name":"b1-l14-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🫶</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Les relations</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276172,"_nanoseconds":769000000}},{"id":"NMgiHmI4pfsvyKRgfEpA","level":"b1","lesson":14,"part":2,"type":"text","name":"b1-l14-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Décrire : nous nous entendons bien, nous nous disputons parfois, il me fait confiance. Le conseil : à ta place, je lui parlerais. Tu devrais prendre du recul. Mots : la confiance, un malentendu, un conflit, se réconcilier.</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Nous nous entendons bien.</b><span style=\"opacity:.7;\"> · We get along well.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Il y a eu un malentendu.</b><span style=\"opacity:.7;\"> · There was a misunderstanding.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>À ta place, je lui parlerais.</b><span style=\"opacity:.7;\"> · In your place, I'd talk to him.</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Se réconcilier</b><span style=\"opacity:.7;\"> · to make up</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276173,"_nanoseconds":117000000}},{"id":"chqygvVp2B5JG5ekcpRU","level":"b1","lesson":14,"part":3,"type":"text","name":"b1-l14-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Nous nous entendons bien.</b></p><p style=\"opacity:.75;margin:0;\">We get along well.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Nous nous entendons bien.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":148000000}},{"id":"nNoYrye5374uKkfFQmY0","level":"b1","lesson":14,"part":4,"type":"text","name":"b1-l14-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Il y a eu un malentendu.</b></p><p style=\"opacity:.75;margin:0;\">There was a misunderstanding.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Il y a eu un malentendu.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":118000000}},{"id":"wcepj25cUFfWG9QACdBi","level":"b1","lesson":14,"part":5,"type":"text","name":"b1-l14-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>À ta place, je lui parlerais.</b></p><p style=\"opacity:.75;margin:0;\">In your place, I'd talk to him.</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"À ta place, je lui parlerais.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":163000000}},{"id":"a35h3AHEvjbj8b94oPzp","level":"b1","lesson":14,"part":6,"type":"text","name":"b1-l14-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Se réconcilier</b></p><p style=\"opacity:.75;margin:0;\">to make up</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Se réconcilier","size":null,"created":{"_seconds":1793276173,"_nanoseconds":514000000}},{"id":"bLEv7P1TkGojJwYtRbWE","level":"b1","lesson":14,"part":7,"type":"text","name":"b1-l14-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>J'ai un problème avec mon meilleur ami.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a problem with my best friend.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Qu'est-ce qui s'est passé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What happened?</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Nous nous sommes disputés à cause d'un malentendu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We argued because of a misunderstanding.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>À ta place, je lui parlerais calmement.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In your place, I'd talk to him calmly.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et s'il ne veut pas m'écouter ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And if he doesn't want to listen to me?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Tu devrais lui laisser un peu de temps, puis lui écrire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You should give him some time, then write to him.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Tu as raison. L'amitié est importante.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're right. Friendship is important.</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Oui, et je suis sûr que vous allez vous réconcilier.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, and I'm sure you'll make up.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276173,"_nanoseconds":521000000}},{"id":"HKiqbxcIpGnaZXojVoF0","level":"b1","lesson":14,"part":8,"type":"text","name":"b1-l14-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>J'ai un problème avec mon meilleur ami.</b><br><span style=\"opacity:.7;font-size:.9rem;\">I have a problem with my best friend.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Qu'est-ce qui s'est passé ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What happened?</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Qu'est-ce qui s'est passé ?","size":null,"created":{"_seconds":1793276173,"_nanoseconds":554000000}},{"id":"oGJ2Od0oKTLHPvCjX9Bl","level":"b1","lesson":14,"part":9,"type":"text","name":"b1-l14-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Nous nous sommes disputés à cause d'un malentendu.</b><br><span style=\"opacity:.7;font-size:.9rem;\">We argued because of a misunderstanding.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">À ta place, je lui parlerais calmement.</b><br><span style=\"opacity:.7;font-size:.9rem;\">In your place, I'd talk to him calmly.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"À ta place, je lui parlerais calmement.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":568000000}},{"id":"UyinLis4qXbu0mOzblq1","level":"b1","lesson":14,"part":10,"type":"text","name":"b1-l14-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et s'il ne veut pas m'écouter ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And if he doesn't want to listen to me?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Tu devrais lui laisser un peu de temps, puis lui écrire.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You should give him some time, then write to him.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Tu devrais lui laisser un peu de temps, puis lui écrire.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":967000000}},{"id":"x80AH7mdmRy2WebMVOOm","level":"b1","lesson":14,"part":11,"type":"text","name":"b1-l14-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Tu as raison. L'amitié est importante.</b><br><span style=\"opacity:.7;font-size:.9rem;\">You're right. Friendship is important.</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Oui, et je suis sûr que vous allez vous réconcilier.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Yes, and I'm sure you'll make up.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Oui, et je suis sûr que vous allez vous réconcilier.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":965000000}},{"id":"eGh0oYA2OkTpNp3wT7BB","level":"b1","lesson":14,"part":12,"type":"text","name":"b1-l14-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Conseillez un ami.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Advise a friend.</p><p><b>Décrivez un problème relationnel et conseillez avec le conditionnel.</b></p><p style=\"opacity:.7;\">Par exemple: “À ta place, je lui parlerais. Tu devrais lui laisser du temps.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"À ta place, je lui parlerais. Tu devrais lui laisser du temps.","size":null,"created":{"_seconds":1793276173,"_nanoseconds":971000000}},{"id":"yq6SGjwC6rem6b7hPfym","level":"b1","lesson":14,"part":13,"type":"text","name":"b1-l14-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🫶</div><p><b>Relations comprises !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez décrire une relation et donner un conseil avec tact. Une belle compétence sociale.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276174,"_nanoseconds":42000000}}]