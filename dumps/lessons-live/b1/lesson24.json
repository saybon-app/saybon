[{"id":"FJkKwVPslowS5aqUKsfX","level":"b1","lesson":24,"part":1,"type":"text","name":"b1-l24-p01-b1","partTitle":"Introduction du professeur","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1;\">🧑‍🏫</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Introduction · vidéo</p><p style=\"font-size:1.05rem;line-height:1.6;text-align:left;\">Bonjour ! Aujourd'hui, la conversation spontanée. Pas de notes, pas de préparation. Vous parlez avec moi de votre vie, d'actualité, de vos opinions. Si vous cherchez un mot, ne vous arrêtez pas : contournez, reformulez, continuez.</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276188,"_nanoseconds":0}},{"id":"52GD8epakr48HxD6YeYp","level":"b1","lesson":24,"part":2,"type":"text","name":"b1-l24-p02-b1","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗣️</div><p style=\"font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin:6px 0;\">Image à venir</p><p style=\"opacity:.8;\">Conversation spontanée</p></div>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276188,"_nanoseconds":3000000}},{"id":"DeTmIFKogpCWTVRx4343","level":"b1","lesson":24,"part":2,"type":"text","name":"b1-l24-p02-b2","partTitle":"Expressions clés","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"font-size:1.05rem;line-height:1.6;\">🧑‍🏫 Pour gagner du temps : eh bien, alors, voyons, comment dire. Pour reformuler : autrement dit, c'est-à-dire, enfin. Si vous ne trouvez pas un mot : c'est une sorte de..., ça ressemble à..., vous savez, le truc qui sert à...</p><ul style=\"list-style:none;padding:0;margin:10px 0 0;\"><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Comment dire...</b><span style=\"opacity:.7;\"> · How to say...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Autrement dit...</b><span style=\"opacity:.7;\"> · In other words...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>C'est une sorte de...</b><span style=\"opacity:.7;\"> · It's a kind of...</span></li><li style=\"padding:6px 0;border-bottom:1px solid rgba(255,255,255,.15);\"><b>Voyons...</b><span style=\"opacity:.7;\"> · Let me see...</span></li></ul>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276188,"_nanoseconds":238000000}},{"id":"xV42pdbxLW48NG6MBaqZ","level":"b1","lesson":24,"part":3,"type":"text","name":"b1-l24-p03-b1","partTitle":"Répétez 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Comment dire...</b></p><p style=\"opacity:.75;margin:0;\">How to say...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Comment dire...","size":null,"created":{"_seconds":1793276188,"_nanoseconds":240000000}},{"id":"7vvC5yVgRJ9gJ9aaOcnR","level":"b1","lesson":24,"part":4,"type":"text","name":"b1-l24-p04-b1","partTitle":"Répétez 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Autrement dit...</b></p><p style=\"opacity:.75;margin:0;\">In other words...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Autrement dit...","size":null,"created":{"_seconds":1793276188,"_nanoseconds":490000000}},{"id":"D87w31GweVW9O7zdlwsp","level":"b1","lesson":24,"part":5,"type":"text","name":"b1-l24-p05-b1","partTitle":"Répétez 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>C'est une sorte de...</b></p><p style=\"opacity:.75;margin:0;\">It's a kind of...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"C'est une sorte de...","size":null,"created":{"_seconds":1793276188,"_nanoseconds":429000000}},{"id":"zMMFqyLmbcPAlNJW5T2r","level":"b1","lesson":24,"part":6,"type":"text","name":"b1-l24-p06-b1","partTitle":"Répétez 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.7rem;margin:6px 0;\"><b>Voyons...</b></p><p style=\"opacity:.75;margin:0;\">Let me see...</p></div>","recordPrompt":"Écoutez, puis répétez !","expectedText":"Voyons...","size":null,"created":{"_seconds":1793276188,"_nanoseconds":643000000}},{"id":"gk3JHXrHNBsyYPPnuUov","level":"b1","lesson":24,"part":7,"type":"text","name":"b1-l24-p07-b1","partTitle":"Écoutez la conversation","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"opacity:.8;\">Lisez et écoutez toute la conversation d'abord. Vous jouez le rôle « You » ensuite.</p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Alors, qu'est-ce qui s'est passé de bien dans votre semaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So, what good happened in your week?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Eh bien, j'ai passé un entretien pour un nouveau poste.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Well, I had an interview for a new job.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Comment c'était ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How was it?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>C'était stressant, mais je pense que ça s'est bien passé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It was stressful, but I think it went well.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Qu'est-ce que vous allez faire si vous obtenez le poste ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do if you get the job?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Voyons... je déménagerais, c'est-à-dire que j'habiterais plus près du bureau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Let me see... I'd move, that is, I'd live closer to the office.</span></p><p style=\"margin:8px 0;\"><span style=\"opacity:.7;font-size:.8rem;\">🧑‍🏫</span><br><b>Et vous en pensez quoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what do you think?</span></p><p style=\"margin:8px 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b>Comment dire... je suis à la fois content et un peu inquiet.</b><br><span style=\"opacity:.7;font-size:.9rem;\">How to say... I'm both happy and a bit worried.</span></p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276188,"_nanoseconds":700000000}},{"id":"hwsgfsXUWQin5F03A2E6","level":"b1","lesson":24,"part":8,"type":"text","name":"b1-l24-p08-b1","partTitle":"À vous 1/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Alors, qu'est-ce qui s'est passé de bien dans votre semaine ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">So, what good happened in your week?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Eh bien, j'ai passé un entretien pour un nouveau poste.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Well, I had an interview for a new job.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Eh bien, j'ai passé un entretien pour un nouveau poste.","size":null,"created":{"_seconds":1793276188,"_nanoseconds":825000000}},{"id":"Rvod9fL673Jl0UuyCff4","level":"b1","lesson":24,"part":9,"type":"text","name":"b1-l24-p09-b1","partTitle":"À vous 2/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Comment c'était ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">How was it?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">C'était stressant, mais je pense que ça s'est bien passé.</b><br><span style=\"opacity:.7;font-size:.9rem;\">It was stressful, but I think it went well.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"C'était stressant, mais je pense que ça s'est bien passé.","size":null,"created":{"_seconds":1793276188,"_nanoseconds":910000000}},{"id":"jM3SdmcIZKJ2VG64VjPF","level":"b1","lesson":24,"part":10,"type":"text","name":"b1-l24-p10-b1","partTitle":"À vous 3/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Qu'est-ce que vous allez faire si vous obtenez le poste ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">What will you do if you get the job?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Voyons... je déménagerais, c'est-à-dire que j'habiterais plus près du bureau.</b><br><span style=\"opacity:.7;font-size:.9rem;\">Let me see... I'd move, that is, I'd live closer to the office.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Voyons... je déménagerais, c'est-à-dire que j'habiterais plus près du bureau.","size":null,"created":{"_seconds":1793276189,"_nanoseconds":306000000}},{"id":"uzchwWA8AQ8DA13ruYTf","level":"b1","lesson":24,"part":11,"type":"text","name":"b1-l24-p11-b1","partTitle":"À vous 4/4","transitionMode":"button","url":null,"imageUrl":null,"content":"<p style=\"margin:6px 0;\">🧑‍🏫 <b>Et vous en pensez quoi ?</b><br><span style=\"opacity:.7;font-size:.9rem;\">And what do you think?</span></p><p style=\"margin:12px 0 0;text-align:right;\"><span style=\"opacity:.7;font-size:.8rem;\">You</span><br><b style=\"font-size:1.3rem;\">Comment dire... je suis à la fois content et un peu inquiet.</b><br><span style=\"opacity:.7;font-size:.9rem;\">How to say... I'm both happy and a bit worried.</span></p>","recordPrompt":"À vous ! Dites votre réplique.","expectedText":"Comment dire... je suis à la fois content et un peu inquiet.","size":null,"created":{"_seconds":1793276189,"_nanoseconds":364000000}},{"id":"uVF1aQf0xWe6g9e9P0WV","level":"b1","lesson":24,"part":12,"type":"text","name":"b1-l24-p12-b1","partTitle":"Parlez librement","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><p style=\"font-size:1.4rem;margin:6px 0;\"><b>Conversation spontanée.</b></p><p style=\"opacity:.75;margin:0 0 10px;\">Spontaneous conversation.</p><p><b>Parlez librement de votre semaine pendant une minute, sans notes.</b></p><p style=\"opacity:.7;\">Par exemple: “Eh bien, cette semaine, j'ai beaucoup travaillé. C'est-à-dire que j'ai fini un projet. Je suis à la fois fatigué et content.”</p></div>","recordPrompt":"Maintenant, parlez !","expectedText":"Eh bien, cette semaine, j'ai beaucoup travaillé. C'est-à-dire que j'ai fini un projet. Je suis à la fois fatigué et content.","size":null,"created":{"_seconds":1793276189,"_nanoseconds":491000000}},{"id":"0Irc9XMzISHnYKncX15V","level":"b1","lesson":24,"part":13,"type":"text","name":"b1-l24-p13-b1","partTitle":"Bravo","transitionMode":"button","url":null,"imageUrl":null,"content":"<div style=\"text-align:center;\"><div style=\"font-size:64px;line-height:1.1;\">🗣️</div><p><b>Parole libre !</b></p></div><p style=\"line-height:1.6;\">🧑‍🏫 Vous pouvez tenir une conversation sans préparation en reformulant quand il manque un mot. C'est le signe du vrai niveau B1.</p>","recordPrompt":null,"expectedText":null,"size":null,"created":{"_seconds":1793276189,"_nanoseconds":572000000}}]