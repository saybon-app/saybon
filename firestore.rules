rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['adlaideduah@gmail.com', 'saybon.fr@gmail.com']; }

    // Default deny - nothing is accessible unless explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Translation jobs - signed-in users can read (job board); only admins can change them.
    match /translationJobs/{jobId} {
      allow read: if signedIn();
      allow update: if isAdmin();
    }

    // Job submissions - read for signed-in users (My Jobs / Under Review tabs).
    match /jobSubmissions/{submissionId} {
      allow read: if signedIn();
    }

    // Translator applications - public register + test flow, but only the fields
    // those pages write. Scores, status and anything else can only be set by the server.
    match /translatorApplications/{appId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','languages','createdAt','testCompleted'])
                    && request.resource.data.testCompleted == false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['englishTranslation','frenchTranslation','testCompleted','submittedAt']);
    }

    // Community chat rooms - signed-in users can read, create their own custom room,
    // and update only the last-message fields. Deleting a room is server-side only.
    match /chatRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
                      request.resource.data.createdBy == request.auth.uid
                      || request.resource.data.keys().hasOnly(['lastMessage','lastMessageAt','lastSenderName']));
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['lastMessage','lastMessageAt','lastSenderName']);
      allow delete: if false;
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
    }

  }
}